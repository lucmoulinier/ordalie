# Dépôt Ordalie : sources, bibliothèques Tcl non binaires, ressources (etc),
# sources de la documentation, tests. Tout le reste est ignoré.
/*
!/.gitignore
!/.gitmodules
!/LICENSE
!/README.md
!/src/
!/lib/
!/etc/
!/doc/
!/test/
!/packages/
!/Build/

# sauvegardes et fichiers d'éditeur, partout
*~
\#*#
.#*
*.bak*
*.sav
*_old
*.orig
log
Thumbs.db

# binaires, partout
*.so
*.so.*
*.dll
*.dylib
*.a
*.o
*.kit
*.exe

# src : les fichiers chargés par Ordalie (ordali_source.tcl) et le Gscope réduit
/src/*
!/src/ordali.tcl
!/src/ordali_source.tcl
