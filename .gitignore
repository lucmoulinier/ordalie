# doc : sources LaTeX, bibliographie, figures, scripts de construction
/doc/*
!/doc/ordalie_documentation.tex
!/doc/*.bib
!/doc/dodoc
!/doc/dohtml
!/doc/figures/

# Build : seulement les scripts et textes du packaging
/Build/*
!/Build/ordalie.iss
!/Build/Ressources/
/Build/Ressources/*
