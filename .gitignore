# lib : paquets Tcl pur utilisés par Ordalie (les paquets compilés sont fournis à part)
/lib/*
!/lib/tcllib1.20/
!/lib/tablelist6.11/
!/lib/struct-2.1/
!/lib/combobox-2.3/
!/lib/mime/
