proc NombreDeBasesEnCommun {FichierBlast BanqueId {Quoi Query} {WhatSens BothSens}} {

    if {![file exists $FichierBlast]} {return 0}

    Wup "   Nb de bases alignes (A) dans les segments alignes (X) de la query/subject"
    Wup "   ----------AAAXAAXA----AAXXAAXXA---------------  "
    Wup "             ||| || |    ||  ||  |                 "
    Wup "          ---AAAXAAXA----AAXXAAXXA-------          "
    Wup "   0000000000111011010000110011001000000000000000  Ex par rapport à Query"  
    Wup "   "
    Wup "   Nb de bases alignees = Somme des 1"

    if {[string equal -nocase $Quoi "Query"]} {
	set LeProfil [LeProfilDeLAlignementDeLaQuery $FichierBlast $BanqueId $WhatSens]
    } else {
	set LeProfil [LeProfilDeLAlignementDuSubject $FichierBlast $BanqueId $WhatSens]
