    foreach e [lsort [array names TkCol]] {
	regsub -all "_" $e " " e
	$P.names insert end $e
    }
    
    #lm je commentarise ...
    ##while {[gets $f line] >= 0} {
    #    if {[llength $line] == 4} {
    #$P.names insert end [lindex $line 3]
    #    }
    #}
    #	close $f
    #	break
    #    }
		
# Create the three scales for editing the color, and the entry for
