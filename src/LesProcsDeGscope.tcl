	set Tableau(BiaisEnSequencesNoInf,Couleur)    "palegreen3"
	set Tableau(BiaisEnSequencesNoInf,Unit)       ""
    }

    lappend LesVariablesProposees            "Length"                     
    set Tableau(Length)                      "Taille"
    set Tableau(Taille,Couleur)              "chartreuse"
    set Tableau(Taille,Unit)                 "pb"

    lappend LesVariablesProposees            "Base percentage"                     
    set Tableau(Base_percentage)             "PourcentageBase"
    set Tableau(PourcentageBase,Couleur)     "yellow"
    set Tableau(PourcentageBase,Unit)        "\%"

