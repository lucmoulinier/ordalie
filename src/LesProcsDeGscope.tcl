proc BonneDate dori {

    if {$dori eq "99-Jan-9999"} {return $dori}

    set dori [string tolower $dori]
    set dori [string map {"/" " " - " "} $dori]
    set Ld [split $dori " "]
    lassign $Ld d mo y
    
    # traite jour
    if {$d eq "1er"} {set d 1}
    if {[string index $d 0] eq "0"} {
	set d [string range $d 1 end]
    }
    if {! [string is integer -strict $d]} {
	puts "\nMAUVAISE DATE ! >>$dori<<\n"
	return -1
    }

    # traite mois 
    set mo [string map {é e è e û u ô o ê e î i} $mo]
    set q [string range $mo 0 3]
    set m ""

    # check if month is integer , 01-12
    if {[string index $q 0] eq "0"} {
	set q [string range $q 1 end]
    }

    switch $q {
	"1" -
	"janv" {set m Jan}
	"2" -
	"févr" -
	"fevr" {set m Feb}
	"3" -
	"mars" {set m Mar}
	"4" -
	"avri" {set m Apr}
	"5" -
	"mai"  {set m May}
	"6" -
	"juin" {set m Jun}
	"7" -
	"juil" {set m Jul}
	"8" -
	"août" -
	"aout" -
	"aôut" {set m Aug}
	"9" -
	"sept" {set m Sep}
	"10" -
	"octo" {set m Oct}
	"11" -
	"nove" {set m Nov}
	"12" -
	"déce" -
	"dece" {set m Dec}
    }
    if {$m eq ""} {
	set q [string range $mo 0 1]
	if {$q eq "ao"} {set m Aug}
	set q [string index $mo 0]
	if {$q eq "f"} {set m Feb}
	if {$q eq "d"} {set m Dec}
    }
    if {$m eq ""} {return -1}

    # traie annee
    set y [string range $y 0 3]
    # date a deux chiffre : 18
    if {$y < 100} {
	set ytod [string range [clock format [clock scan now] -format %Y] 2 end]
	if {$y > ($ytod+1)} {
	    # dans les 19--
	    set y "19$y"
	} else {
	    set y "20$y"
	}
    }
    set date "${d}-${m}-$y"

    return $date

}

