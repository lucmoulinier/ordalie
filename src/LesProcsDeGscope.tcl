proc ::Blast::commify number {

		regsub -all \\d(?=(\\d{3})+([regexp -inline {\.\d*$} $number]$)) $number {\0,}
	
}

proc ::Blast::compareLines {a b} {

		regexp {...[ ]{2,}([0-9]+(.[0-9]+e\+[0-9]+)?)} $a -> scorea
		regexp {...[ ]{2,}([0-9]+(.[0-9]+e\+[0-9]+)?)} $b -> scoreb

		if { $scorea < $scoreb } {
			return -1
		} elseif { $scoreb > $scoreb } {
			return 1
		} else {
			return 0
		}
	
}

proc ::Blast::getFooter f {

		set fd [open $f r]
		set start 0
		set lines {}
		while {[gets $fd l] >= 0} {
			if { [regexp "^  Database:" $l] } { set start 1 }
			if { $start } {
				lappend lines $l
			}
		}
		close $fd

		return [join $lines "\n"]
	
}

proc ::Blast::getHeader f {

		set lines {}
		set fd [open $f r]
		while {[gets $fd l] >= 0} {
			lappend lines $l
			if { [regexp "^Sequences producing significant alignments" $l] } { break }
			if { [regexp "No hits found" $l] } {
				return 0
			}
		}
		close $fd

		return [join $lines "\n"]
	
}

proc ::Blast::getLines {f alines aentries} {

		upvar $alines lines
		set lines {}
		set data {}
		set fd [open $f r]
		set nohitsfound 0
		while {[gets $fd line] >= 0} {
			if {[regexp "No hits found" $line]} {
				set nohitsfound 1
				break
			}
			lappend data $line
		}
		close $fd
		set start 0
		set stop 0

		if { !$nohitsfound } {
			if { ![regexp "^\[TXY\]?BLAST" [lindex $data 0]] } { return 0 }
			set i 0
			while { !$stop && $i < [llength $data] } {
				set l [lindex $data $i]
				if { [regexp "^Sequences producing significant alignments" $l] } {
					set start 1
					incr i 2
					continue
				}
				if {$start} {
					if { $l == "" } { set stop 1 } else {
						lappend lines $l
					}
				}
				incr i
			}

			upvar $aentries entries
			set start 0
			set curentry ""

			while { $i < [llength $data] } {
				set l [lindex $data $i]
				if { [regexp "^>" $l] || [regexp "^  Database:" $l] } {
					if { $start } {
						regexp -line {^>([^ ]*) } $curentry -> id
						set entries($id) $curentry
						set curentry ""
					}
					set start 1
				}
				if { [regexp "^  Database:" $l] } { break }
				append curentry $l "\n"
				incr i
			}
		}
		return [llength $lines]
	
}

proc ::Blast::mergeLegacyBlast {infile outfile dbname} {

		set output $outfile
		set filename $infile
		set filelist [lsort [glob -nocomplain -type f "$filename.*"]]

		set candidate_filelist $filelist
		set filelist {}
		foreach f $candidate_filelist {
			if {[file exists $f]} {
				lappend filelist $f
			}
		}

		set lines {}
		array set entries {}
		set lines_list {}

		foreach f $filelist {
			set tmplines {}
			getLines $f tmplines entries
			set tmplines [lsort -decreasing -command compareLines $tmplines]
			lappend lines_list $tmplines
		}

		while { 1 } {
			set i 0
			set best ""
			set scorebest 0
			foreach dblines $lines_list db $filelist {
				if { [llength $dblines] > 0 } {
					set curline [lindex $dblines 0]
					regexp {...[ ]{2,}([0-9]+(.[0-9]+e\+[0-9]+)?)} $curline -> score
					if { $score > $scorebest } {
						set scorebest $score
						set best $curline
						set tmplines_list [lreplace $lines_list $i $i [lreplace $dblines 0 0]]
					}
				}
				incr i
			}
			if { $best != "" } {
				set lines [lappend lines $best]
				set lines_list $tmplines_list
			} else { break }
		}

	#	foreach l $lines {
	#		set id 0
	#		regexp {^([^ ]*) } $l -> id
	#	}

		set sumprops {
			"Number of letters in database"
			"Number of sequences in database"
			"Number of Sequences"
			"Number of Hits to DB"
			"Number of extensions"
			"Number of successful extensions"
			"Number of sequences better than 10.0"
			"Number of HSP's gapped"
			"Number of HSP's successfully gapped"
			"Window for multiple hits"
		}
		set props_commas {
			"Number of letters in database"
			"Number of sequences in database"
			"Number of Hits to DB"
		}
		set props {
			"Length adjustment"
			"Effective length of database"
			"Effective length of query"
			"Effective search space"
			"Effective search space used"
			"Neighboring words threshold"
			"Window for multiple hits"
			"X1"
			"X2"
			"X3"
			"S1"
			"S2"
		}

		array set metadata {}
		foreach p $sumprops {
			set metadata($p) 0
		}

		foreach f $filelist {
			set tmpfooter [getFooter $f]

			foreach p $sumprops {
				set val ""
				if { ![regexp -line "$p\: (.*)" $tmpfooter match val] } { continue }
				regsub -all {\,} $val {} val
				incr metadata($p) $val
			}
		}
		set tmpfooter [getFooter [lindex $filelist 0]]
		set footer {}
		foreach l [split $tmpfooter "\n"] {
			if { [regexp "(\[ \]*)(.*)\: " $l match spaces key] && [lsearch $sumprops $key] != -1 } {
				set val $metadata($key)
				if { [lsearch $props_commas $key] != -1 } { set val [commify $val] }
				lappend footer [concat $spaces "$key: " $val]
			} elseif { [regexp "^  Database: " $l] } {
				lappend footer "  Database: $dbname"
			} else {
				lappend footer $l
			}
		}

		set tmpheader 0
		foreach f $filelist {
			set tmpheader [getHeader [lindex $f]]
			if {$tmpheader != 0} {
				break
			}
		}

		set header {}
		foreach l [split $tmpheader "\n"] {
			if { [regexp "^Database: " $l] } {
				lappend header "Database: $dbname"
			} elseif { [regexp "total letters" $l] } {
				set key1 "Number of sequences in database"
				set key2 "Number of letters in database"
				set newl "          "
				append newl [commify $metadata($key1)] " sequences; " [commify $metadata($key2)] " total letters"
				lappend header $newl
			} else {
				lappend header $l
			}
		}

		set fd [open $output w]

		puts $fd [join $header "\n"]
		puts $fd ""
		foreach l $lines { puts $fd $l }
		puts $fd ""
		foreach l $lines {
			regexp {^([^ ]*) } $l -> id
			if {[info exists entries($id)]} {puts $fd $entries($id)}
		}
		puts $fd [join [lreplace $footer end end] "\n"]

		close $fd
	
}

proc ::Blast::mergeTabularBlast {infiles outfile {limit -1}} {

		proc readHeader {fname} {
			set header {}
			set nhits 0
			set f [open $fname r]
			while {[gets $f line] >= 0} {
				if {![regexp {^#} $line] } break
				if {[regexp {# ([0-9]+) hits found} $line matches nhits]} {
					break
				}
				if {[regexp {# Database} $line]} {
					regsub {.[0-9]+$} $line {} line
				}
				lappend header $line
			}
			close $f
			return [list $header $nhits]
		}

		# liste des fichiers
		#set candidates [lsort [glob -nocomplain -type f $infile.*]]
		set filelist $infiles

		if {[llength $filelist] == 1} {
			file copy [lindex $filelist 0] $outfile
			return
		}
		#foreach f $candidates {
		#	if {[file exists $f]} {
		#		lappend filelist $f
		#	}
		#}
		#for {set i 0} {$i<=99} {incr i} {
		#	set f "$infile.$dbname.[format "%02d" $i]"
		#	puts $f
		#	if {[file isfile $f]} {
		#		lappend filelist $f
		#	} else {
		#		break
		#	}
		#}

		# lecture header
		set header {}
		if {[llength $filelist] > 0} {
			foreach f $filelist {
				lassign [readHeader $f] header nhits
				if {$nhits > 0} break
			}
		} else {
			return
		}
		# lecture hits
		set hits {}
		foreach fname $filelist {
			set inf [open $fname r]
			while {[gets $inf line] >= 0} {
				if {![regexp {^#} $line]} {
					lappend hits $line
				}
			}
			close $inf
		}
		# score
		set hits [lsort -index 11 -real -decreasing $hits]
		# expect
		set hits [lsort -index 10 -real $hits]

		set nHits [expr $limit>0 ? $limit: [llength $hits]]
		set nHits [expr min($nHits, [llength $hits])]
		#regsub {# [0-9]+ hits found} $header "# $nHits hits found" header
		lappend header "# $nHits hits found"
		set outf [open $outfile w]
		foreach l $header {
			puts $outf $l
		}
		set i $nHits
		set count 0
		foreach h $hits {
			puts $outf $h
			incr count
			incr i -1
			if {$i == 0} break
		}
		puts $outf "# BLAST processed 1 queries"
		close $outf
	
}

proc ::Blast::putl args {

		if {[llength $args] > 1} {
			set channel [lindex $args 0]
			set output [lindex $args 1]
		} else {
			set channel stdout
			set output [lindex $args 0]
		}
		puts $channel [join $output "\n"]
	
}

proc ::Blast::splitLegacyBlast {inputfilename {outputfilename {}}} {

		if {$outputfilename == ""} { set outputfilename $inputfilename }
		set infile [open $inputfilename r]
		set header {}
		set footer {}
		seek $infile -1000 end
		set start 0

		while 1 {
			set length [gets $infile line]
			if [eof $infile] break
			if {[regexp {^  Database: } $line]} {
				set start 1
				lappend footer {} {}
			}
			if {$start} {lappend footer $line}
		}

		seek $infile 0

		set firstline ""
		while 1 {
			set length [gets $infile line]
			if [eof $infile] break
			if [regexp {Query= .*} $line] {
				set firstline $line
				break
			}
			lappend header $line
		}

		set i 0
		set outfile [open $outputfilename.$i w]
		putl $outfile $header
		puts $outfile $firstline
		while 1 {
			set length [gets $infile line]
			if [eof $infile] break
			if {[regexp {^  Database: } $line]} {
				putl $outfile $footer
				close $outfile
				file delete $inputfilename.$i
				break
			}
			if {[regexp {^BLASTP } $line]} {
				while {![regexp {Query=} $line]} {
					gets $infile line
				}
				putl $outfile $footer
				close $outfile

				incr i
				set outfile [open $outputfilename.$i w]
				putl $outfile $header
			}
			puts $outfile $line
		}
		close $infile
		return [expr $i+1]
	
}

proc ::Blast::splitTabularBlast {infile outfile} {

		set inf [open $infile r]
		set outf {}
		set i 0
		set files {}
		set header {}
		set footer "# BLAST processed 1 queries"

		while {[gets $inf line] >= 0} {
			if {[regexp {^# BLAST} $line]} {
				if {[regexp {^# BLAST processed} $line]} {
					break
				}
				if {$outf != {}} {
					puts $outf $footer
					close $outf
				}
				set outf [open $outfile.$i w]
				lappend files $outfile.$i

				incr i
			} else {
				incr nqueries
			}
			puts $outf $line
		}
		puts $outf $footer
		close $outf
		return $files
	
}

proc BlastAli {Fichier {Nieme {}} {SeuilExpect {}} {MaxListe {}}} {

    global BlastIndel

    set DisplayStats 0
    set ShowStats 0
    if {[regexp -nocase "ShowStats|DisplayStats" $Nieme]} {
	if {[regexp -nocase "DisplayStats" $Nieme]} { set DisplayStats 1 }
	set ShowStats 1
	set Nieme ""
    }
    if {[EstUnPAB $Fichier]} {
	set Nom $Fichier
	set Fichier    [GscopeFile $Nom "blastOri"]
	set Memo       [GscopeFile $Nom "memo"]
	set FichierTfa [GscopeFile $Nom "tfaFromBOri"]
    } else { 
	set Memo "${Fichier}_[join $Nieme _].memo"
	set FichierTfa $Fichier
	regsub {.txt$} $FichierTfa "" FichierTfa
	append FichierTfa .tfa
    }

    if {[file exists $Memo]} {
	array set BlastIndel [ContenuDuFichier $Memo]
    } else {
	BlastIndel $Fichier $Nieme $SeuilExpect $MaxListe
	Sauve [array get BlastIndel] dans $Memo
    }
    set GapApres(trululu) ""
    foreach K [array names BlastIndel "wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww"] {
	Espionne BlastIndel($K)=$BlastIndel($K)=
    }
    #exit
    set AVoir "WP_049995565.1==================="
    foreach AC $BlastIndel(ListOf,AC) {
	set MontreAC 0
	if {$AC==$AVoir} { set MontreAC 1 }
	#Espionne
	#Espionne $BlastIndel($AC,AC)  $BlastIndel($AC,OS) $BlastIndel($AC,LE) $BlastIndel($AC,DE)
	set IemeH 0
	foreach H $BlastIndel($AC,LH) {
	    incr IemeH	    
	    lassign $H Access nCops nCopsDansCetteSequence OS Score Expect DebutQuery FinQuery DebutSbjct FinSbjct SeqQuery SeqConse SeqSbjct
	    set IQ [expr $DebutQuery-1]
	    set IS [expr $DebutSbjct-1]
	    set J  [expr $IQ-1]
	    if {$MontreAC} {
		Espionne AC $AC
		EspionneL $H
		Espionne IQ=$IQ IS=$IS
		Espionne SeqQuery
		Espionne =$SeqQuery=
		Espionne SeqSbjct
		Espionne =$SeqSbjct=
	    }
	    foreach AQ [split $SeqQuery ""]  AS [split $SeqSbjct ""] {
		incr J
		if {$AQ=="-" && $AS=="-"} {
		    set GapAt(Query,$J) 1
		    set GapAt($Access,$J) 1
		    #incr GapApres(Q,$AC,$IQ)
		    incr GapApres(S,$AC,$IS)
		    continue
		}
		if {$AQ=="-" && $AS!="-"} {
		    set GapAt(Query,$J) 1
		    incr IS
		    incr GapApres(Q,$AC,$IQ)
		    lappend SousQueryEtendu($IQ) "$AC $IS"
		    #Espionne SousQueryEtendu($IQ) "$AC $IS $GapApres(Q,$AC,$IQ)"
		    continue
		}
		if {$AQ!="-" && $AS=="-"} {
		    set GapAt($Access,$J) 1
		    incr IQ
		    incr GapApres(S,$AC,$IS)
		    continue
		}
		if {$AQ!="-" && $AS!="-"} {
		    incr IQ
		    incr IS
		    lappend SousQuery($IQ) "$AC $IS"
		    continue
		}
	    }	    
	}
    }
    foreach Key [array names GapAt(*$AVoir*)] {
	Espionne GapAt($K) $GapAt($K)
    }
    #exit
    set LengthWithGap $BlastIndel(Query,LE)
    set SeqGap ""
    set Seq $BlastIndel(Query,SQ)
    foreach IQ [NombresEntre 0 [expr $BlastIndel(Query,LE)-1]] {
	set MaxGap 0
	foreach K [array names GapApres -glob "Q,*,$IQ"] {
	    set MaxGap [Maxi $MaxGap $GapApres($K)]
	    #Espionne $IQ GapApres($K) $GapApres($K) $MaxGap
	}
	if {$ShowStats} {
	    set Message "[format {%4d %3d} $IQ $MaxGap] [string repeat * $MaxGap]"
	    lappend LesStats $Message
	    Espionne $Message
	}
	incr LengthWithGap $MaxGap
	append SeqGap [string index $Seq $IQ-1]
	append SeqGap [string repeat "-" $MaxGap]
    }
    if {$DisplayStats} { return [AfficheListe $LesStats "" "Couvert/$Nom"] }
    if {$ShowStats} { return "FinShowStats" }
    #parray SousQuery
    #parray GapApres
    #Espionne $LengthWithGap
    set IQ 0
    set J 0
    foreach Q [split $SeqGap ""] {
	set Ali(Query,$J) $Q
	if {$Q!="-"} { incr IQ }
	if {[info exists SousQuery($IQ)]} { 
	    foreach ACPos $SousQuery($IQ) {
		scan $ACPos "%s %s" AC Pos
		set Ali($AC,$J) [string index $BlastIndel($AC,SS) $Pos-1]	    
	    }
	    unset SousQuery($IQ)
	}
	if {[info exists SousQueryEtendu($IQ)]} {
	    if {[info exists iDe]} { unset iDe }
	    foreach ACPos $SousQueryEtendu($IQ) {
		scan $ACPos "%s %s" AC Pos
		incr iDe($AC)
		set Ali($AC,[expr $J+$iDe($AC)]) [string index $BlastIndel($AC,SS) $Pos-1]
	    }
	    unset SousQueryEtendu($IQ)
	}
	incr J
    }

    set LesLignes {}
    foreach AC [concat [list Query] $BlastIndel(ListOf,AC)] {
	set MontreAC 0
	set Previous ""
	set Ligne ""
	set IS 0
	foreach J [NombresEntre 0 [expr $LengthWithGap-1]] {
	    if {$MontreAC} { Espionne $AC $J info exists Ali($AC,$J) [info exists Ali($AC,$J)] [info exists GapAt($AC,$J)] }
	    if {[info exists Ali($AC,$J)]} {
		append Ligne $Ali($AC,$J)
		set Previous $Ali($AC,$J)
		incr IS
	    } elseif {$Previous=="-"} {
		#Espionne 2 $J -
		append Ligne "-"
		set Previous "-"
	    } elseif {[info exists GapAt($AC,$J)]} {
		#Espionne 3 $J -
		append Ligne "-"
		set Previous "-"
	    } else {		    
		#Espionne 4 $J .
		append Ligne .
		set Previous .
	    }
	}
	#Espionne [string range $Ligne 0 250]
	lappend LesLignes ">$AC"
	regsub -all {\.} $Ligne "-" Ligne
	regsub -all {\?} $Ligne "X" Ligne
	lappend LesLignes $Ligne
    }
    return [SauveLesLignes $LesLignes dans $FichierTfa]

}

proc BlastDesMeilleursESTDuBlast {FichierBlastnEST FichierTFA Organism {ID 0.98} {TailleAliMin 50}} {

    Espionne "$FichierBlastnEST $FichierTFA $Organism"
    ##########################################################################
    ### Reduction du blast en blast reduit aux EST specifiques de la query ###
    ##########################################################################
    if {![file exists $FichierTFA]} {return}
    set FichierBlastnESTReduced "$FichierBlastnEST.reduced"
    #Les fichiers suivants sont effaces à la fin de la procedure
    set FichierSeqTFAsEST       "$FichierBlastnEST.esttfas"
    set FichierESTDB            "[RepertoireDeTravail]/[file tail $FichierBlastnEST].dbest"

    #########Selection des EST specifiques de la query sans regions repeat#########
    ###Reduction des subjects du blastnEST aux EST avec minimum d'identite et d'alignement###
    File copy -force   $FichierBlastnEST        $FichierBlastnESTReduced
    Espionne "IdentityWithoutFilter"
    FichierBlastReduit $FichierBlastnESTReduced $FichierBlastnESTReduced IdentityWithoutFilter $ID
    Espionne "TailleAlignementMin"
    FichierBlastReduit $FichierBlastnESTReduced $FichierBlastnESTReduced TailleAlignementMin   $TailleAliMin

    ###Extraction des id de mes EST dans le blast reduit###
    set LesBId [LesBanqueIdDuBlast $FichierBlastnESTReduced 1e200 1e200]
    ###Extraction des sequences de mes EST a partir des Id du blast et selection de l'organisme###
    Sauve [join [LesSeqTFAsDesBanqueId $LesBId est $Organism] "\n"] dans $FichierSeqTFAsEST
    ###Creation de la database de mes EST dans le repertoire junkdir###
    File copy -force $FichierSeqTFAsEST $FichierESTDB
    TFAs2DB $FichierESTDB
    #debutLP
    set FichierBlastnESTReducedPourVide [TmpFile]
    file copy -force $FichierBlastnESTReduced $FichierBlastnESTReducedPourVide
    #finLP

    #########Alignement des EST selectionnees avec toute la sequence query, dont les repeat########
    ###Blastn sans filtre du fichier tfa initial non masque contre la database d'EST creee###

    #BlastNDuFichier $FichierTFA $FichierESTDB $FichierBlastnESTReduced F 2000 0.1 0
    if {1} {
	set Commande "eval exec blastall -p blastn -i \$FichierTFA -o \$FichierBlastnESTReduced  -d \$FichierESTDB -v 2000 -K 0 -b 2000 -e 0.01 -F F"
	if {[catch {eval $Commande} Message]} {
	    Espionne "Problem with $FichierBlastnESTReduced"
	    Espionne $Message
	    #debutLP
	    if {[regexp "Database is empty" $Message]} {
		if {[file exists  $FichierSeqTFAsEST     ]} {File delete -force  $FichierSeqTFAsEST}
		if {[file exists  $FichierSeqTFAsEST     ]} {File delete -force  $FichierESTDB     }
		if {[file exists "$FichierSeqTFAsEST.nhr"]} {File delete -force "$FichierESTDB.nhr"}
		if {[file exists "$FichierSeqTFAsEST.nin"]} {File delete -force "$FichierESTDB.nin"}
		if {[file exists "$FichierSeqTFAsEST.nsq"]} {File delete -force "$FichierESTDB.nsq"}
		file copy -force $FichierBlastnESTReducedPourVide $FichierBlastnESTReduced
		file delete $FichierBlastnESTReducedPourVide
		return $FichierBlastnESTReduced
	    }
	    #finLP
	}
    }

    ###Selection des EST specifiques de la sequence query complete non masquee###
    Espionne "IdentityWithoutFilter"
    FichierBlastReduit $FichierBlastnESTReduced $FichierBlastnESTReduced IdentityWithoutFilter $ID
    Espionne "TailleAlignementMin"
    FichierBlastReduit $FichierBlastnESTReduced $FichierBlastnESTReduced TailleAlignementMin   $TailleAliMin
    Espionne "JusteLePremierAlignementDesSubjects"
    FichierBlastReduit $FichierBlastnESTReduced $FichierBlastnESTReduced JusteLePremierAlignementDesSubjects
    Espionne "RegionsAligneesSurRegionsAlignables"
    FichierBlastReduit $FichierBlastnESTReduced $FichierBlastnESTReduced RegionsAligneesSurRegionsAlignables $ID

    if {[file exists  $FichierSeqTFAsEST     ]} {File delete -force  $FichierSeqTFAsEST}
    if {[file exists  $FichierSeqTFAsEST     ]} {File delete -force  $FichierESTDB     }
    if {[file exists "$FichierSeqTFAsEST.nhr"]} {File delete -force "$FichierESTDB.nhr"}
    if {[file exists "$FichierSeqTFAsEST.nin"]} {File delete -force "$FichierESTDB.nin"}
    if {[file exists "$FichierSeqTFAsEST.nsq"]} {File delete -force "$FichierESTDB.nsq"}

    return $FichierBlastnESTReduced

}

proc BlastDesMeilleursHTGDuBlast {FichierBlastnHTG FichierTFA Organism {ID 0.80} {TailleAliMin 50}} {

    #########################################################################
    ### Reduction du blast en blast reduit aux HTG specifiques de la query###  
    #########################################################################
    if {![file exists $FichierTFA]} {return}
    set FichierBlastnHTGReduced "$FichierBlastnHTG.reduced"
    set FichierSeqTFAsHTG       "$FichierBlastnHTG.htgtfas"
    set FichierHTGDB            "[RepertoireDeTravail]/$FichierBlastnHTG.dbhtg"
 
    #########Selection des HTG specifiques de la query sans regions repeat#########
    ###Reduction des subjects du blastnHTG aux HTG avec minimum d'alignement et d'identite###
    File copy -force   $FichierBlastnHTG        $FichierBlastnHTGReduced
    Espionne "TailleAlignementMin"
    FichierBlastReduit $FichierBlastnHTGReduced $FichierBlastnHTGReduced TailleAlignementMin   $TailleAliMin
    Espionne "IdentityWithoutFilter"
    FichierBlastReduit $FichierBlastnHTGReduced $FichierBlastnHTGReduced IdentityWithoutFilter $ID

    ###Extraction des id de mes HTG dans le blast reduit###
    set LesBId [LesBanqueIdDuBlast $FichierBlastnHTGReduced 1e200 1e200]
    ###Extraction des sequences de mes HTG a partir des Id du blast et selection de l'organisme###
    Sauve [join [LesSeqTFAsDesBanqueId $LesBId htg $Organism] "\n"] dans $FichierSeqTFAsHTG
    ###Creation de la database de mes HTG dans le repertoire junkdir###
    File copy -force $FichierSeqTFAsHTG $FichierHTGDB
    TFAs2DB $FichierHTGDB

    #########Alignement des HTG selectionnees avec toute la sequence query, dont les repeat########
    ###Blastn sans filtre du fichier tfa initial non masque contre la database d'HTG creee###
    #BlastNDuFichier $FichierTFA $FichierHTGDB $FichierBlastnHTGReduced F 2000 0.1 0
    if {1} {
	set Commande "eval exec blastall -p blastn -i \$FichierTFA -o \$FichierBlastnHTGReduced  -d \$FichierHTGDB -v 2000 -K 0 -b 2000 -e 0.01 -F F -a 4"
	if {[catch {eval $Commande} Message]} {
	    Espionne "Problem with $FichierBlastnHTGReduced\n$Message"
	}
    }

    ###Reduction des subjects du blastnHTG aux HTG avec minimum d'ID de aligne query sur taille query###
    ###La query doit etre totalement presente dans ces contigs###
    Espionne "RegionsAligneesSurTailleQueryDansLeMeilleurDesSens"
    FichierBlastReduit $FichierBlastnHTGReduced $FichierBlastnHTGReduced RegionsAligneesSurTailleQueryDansLeMeilleurDesSens $ID

    return $FichierBlastnHTGReduced

}

