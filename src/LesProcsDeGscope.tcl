proc LesAcNucsDeLAccess_PageInfo PageInfo {

    #set PageInfo [join [LaSequenceDesBanques $Access $Access AccessOk "OnVeutNature"] "\n"]
    set LesAcNucs   [LesAcNucsDeLaProt_PageInfo $PageInfo]
    return $LesAcNucs

