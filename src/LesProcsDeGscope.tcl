    entry  $E2Tm -textvariable TmRange -width  "5" -justify "center"
    button $BTm  -background "yellow"  -text  "OK" -padx    "2"      -command {
	if {$TmVar!="" && $TmRange!=""} {
	    if {$TmVar>120 | $TmVar<=0 | $TmRange>=$TmVar | $TmRange<0} {
		set Warning "Please enter a regular value for Tm and Range\nTm: 0.0<Tm<=120.0\nRange: 0.0<=Range<TmVar"
		AjouteAuLog $Warning
	    } else {
		set TmVar   [format "%.1f" $TmVar]
		set TmRange [format "%.1f" $TmRange]
		LesParametresDuDesign TmLimit $TmVar   "Positionne"
		LesParametresDuDesign TmRange $TmRange "Positionne"
		AjouteAuLog "Tm: $TmVar \°C +/- $TmRange \°C"
	    }
	} else {
	    LesParametresDuDesign TmLimit "Reset"
	    LesParametresDuDesign TmRange "Reset"
	    set Warning "Choose one value for both Tm and Tm Range."
	    AjouteAuLog $Warning
	}
    }
    button $B2Tm  -background "orange"  -text  "Best" -padx "3" -borderwidth "2" -relief "groove" -command {
	if {[LesParametresDuDesign Query "LaValeurMerci"]!=""} {
	    BestTmAnalysis
	} else {
	    AjouteAuLog "Query must exist and also being validated to calculate Best Tm analysis"
	}
    }
    set_balloon $LTm  "Melting temperature (Tm) in degree (between 0 and 120 °C)"
    set_balloon $L2Tm "Tm Range in degree < Tm"
    set_balloon $B2Tm "Calculate and display best Tm analysis"

    #2.2.1.6 GC content panel
    set FGCContent   "$FParameters1.fgccontent"
    set  LGCContent  "$FGCContent.lgccontent"
    set  L2GCContent "$FGCContent.l2gccontent"
    set  L3GCContent "$FGCContent.l3gccontent"
    set  EGCContent  "$FGCContent.egccontent"
    set  E2GCContent "$FGCContent.e2gccontent"
    set  BGCContent  "$FGCContent.bgccontent"
    set  B2GCContent "$FGCContent.b2gccontent"

    frame  $FGCContent  -background "#808080" -relief "groove"
    label  $LGCContent  -background "#808FFF" -relief "groove" -width "10" -text "GC % from" -anchor "w"
    label  $L2GCContent -background "#808FFF" -relief "groove" -width  "3" -text "to"        -anchor "center"
    label  $L3GCContent -background "#808FFF" -relief "groove" -width  "3" -text "%"         -anchor "w"
    entry  $EGCContent  -textvariable GCContentMinusVar        -width  "5" -justify "center" 
    entry  $E2GCContent -textvariable GCContentPlusVar         -width  "5" -justify "center"
    button $BGCContent  -background "yellow"  -text   "OK"     -padx   "2" -command {
	if {$GCContentMinusVar!="" && $GCContentPlusVar!=""} {
	    if {$GCContentMinusVar>100 | $GCContentMinusVar<0 | $GCContentPlusVar>100 | $GCContentPlusVar<0 | $GCContentMinusVar>$GCContentPlusVar} {
		set Warning "Please enter a regular value for the GC Content:\n0<\%GC<=100\nFirst<Second"
		AjouteAuLog $Warning
	    } else {
		set GCContentMinusVar [format "%.1f" $GCContentMinusVar]
		set GCContentPlusVar  [format "%.1f" $GCContentPlusVar]

		LesParametresDuDesign GCContentMinus $GCContentMinusVar "Positionne"
		LesParametresDuDesign GCContentPlus  $GCContentPlusVar  "Positionne"
		AjouteAuLog "% GC lower: $GCContentMinusVar \%"
		AjouteAuLog "% GC upper: $GCContentPlusVar \%" 
	    }
	} else {
	    LesParametresDuDesign GCContentMinus "Reset"
	    LesParametresDuDesign GCContentPlus  "Reset"
	    set Warning "GC Content is an option."
	    AjouteAuLog $Warning
	}
    }
    button $B2GCContent -background "orange"  -text "Best" -padx "3" -borderwidth "2" -relief "groove" -command {
	if {[LesParametresDuDesign Query "LaValeurMerci"]!=""} {
	    BestGCAnalysis
	} else {
	    AjouteAuLog "Query must exist and also being validated to calculate Best Tm analysis"
	}
    }
    set_balloon $LGCContent  "GC content to avoid strong or weak interaction (0.0-100.0 %)"
    set_balloon $B2GCContent "Calculate and display best GC analysis"

    #2.2.1.7 Prohibited panel
    set FProhib   "$FParameters1.fprohib"
    set  LProhib  "$FProhib.lprohib"
    set  EProhib  "$FProhib.eprohib"
    set  BProhib  "$FProhib.bprohib"
    set  B2Prohib "$FProhib.bprohib2"
    set  B3Prohib "$FProhib.bprohib3"

    frame  $FProhib  -background "#808080" -relief "groove"
    label  $LProhib  -background "#808FFF" -relief "groove" -text "Prohibited" -width "10" -anchor "w"
    entry  $EProhib  -textvariable ProhibVar
    button $BProhib  -background "yellow"  -padx "2"        -text "Add"        -command {
	if {$ProhibVar!=""} {
	    set LesProhibExistant [LesParametresDuDesign LesProhibes "LaValeurMerci"]
	    LesParametresDuDesign LesProhibes $ProhibVar "Ajoute"
	    AjouteAuLog "Prohibited Sequence $ProhibVar added to previous: $LesProhibExistant"
	} else {
	    set Warning "Prohibited Sequence is an option."
	    AjouteAuLog $Warning
	}
    }
    button $B2Prohib -background "yellow"  -padx "2"        -text "Reset"      -command {
	LesParametresDuDesign LesProhibes "Reset"
	set Warning "Prohibited Sequence reset to null."
	AjouteAuLog $Warning
    }
    button $B3Prohib -background "yellow"  -padx "2"        -text "OK"         -command {
	if {$ProhibVar!=""} {
	    LesParametresDuDesign LesProhibes $ProhibVar "Positionne"
	    AjouteAuLog "Prohibited Sequence: $ProhibVar"
	} else {
	    set Warning "Prohibited Sequence is an option."
	    AjouteAuLog $Warning
	}
    }
    set_balloon $LProhib  "Sequence you want to avoid from the oligo (only A,T,G,or C)\nex: AAA TTT GCCC (blank separated)"
    
    #2.2.1.8 Database panel
    global EDataBase   
    set FDataBase   "$FParameters1.fdatabase"
    set  LDataBase  "$FDataBase.ldatabase"
    set  EDataBase  "$FDataBase.edatabase"
    set  BDataBase  "$FDataBase.bdatabase"
    set  B2DataBase "$FDataBase.b2database"

    frame  $FDataBase  -background "#808080"                  -relief "groove"
    label  $LDataBase  -background "#808FFF" -text "DataBase" -relief "groove" -width "10" -anchor "w" 
    entry  $EDataBase  -textvariable DataBaseVar              
    button $B2DataBase -background "yellow"  -text "Browse"   -padx   "2"      -command {
	set     BLASTDBDIR [set env(BLASTDB)]
	if {   $BLASTDBDIR == ""} {
	    set BLASTDBDIR [RepertoireDuGenome]
	}
	#Les types de fichier autorises
	set types {
	    {{Nt blast Files} {.nsq}}
	    {{All Files}      *     }
	}
	set BrowsedDB [tk_getOpenFile -title "Choose one database." -initialdir "$BLASTDBDIR" -filetypes $types]

	$EDataBase delete 0 end
	$EDataBase insert   end $BrowsedDB
    }
    button $BDataBase  -background "yellow"  -text "OK"       -padx   "2"      -command {
	if {$DataBaseVar!=""} {
	    if {$DataBaseVar=="none"} {
		set Warning "Database is none, that means that you already have blastn files."
		AjouteAuLog $Warning
		LesParametresDuDesign DataBase $DataBaseVar "Positionne"
	    } else {
		if {![file exists $DataBaseVar]} {
		    set Warning "$DataBaseVar does not exists, try another one."
		    AjouteAuLog $Warning
		} else {
		    LesParametresDuDesign DataBase $DataBaseVar "Positionne"
		    AjouteAuLog "DataBase Sequence: $DataBaseVar"
		}
	    }
	} else {
	    LesParametresDuDesign DataBase "Reset"	    
	    set Warning "You must define a DataBase for Specificity analysis."
	    AjouteAuLog $Warning
	}
    }
    set_balloon $LDataBase "Blast formatted database for homology searches (ex: .nsq)\nSet to \"none\" to reuse previous blastn file, for example in redesign."
       
    #2.2.1.9 WorkingDir panel
    global EWorkingDir   
    set FWorkingDir   "$FParameters1.fworkingdir"
    set  LWorkingDir  "$FWorkingDir.lworkingdir"
    set  EWorkingDir  "$FWorkingDir.eworkingdir"
    set  BWorkingDir  "$FWorkingDir.bworkingdir"
    set  B2WorkingDir "$FWorkingDir.b2workingdir"

    frame  $FWorkingDir  -background "#808080"                          -relief "groove"
    label  $LWorkingDir  -background "#808FFF" -text "Saving Directory" -relief "groove" -width "15" -anchor "w"
    entry  $EWorkingDir  -textvariable WorkingDirVar              
    button $B2WorkingDir -background "yellow"  -text "Browse" -padx "2" -command {
	set BrowsedWDir [tk_chooseDirectory -title "Choose the saving directory." -initialdir "[RepertoireDuGenome]"]
	$EWorkingDir delete   0 end
	$EWorkingDir insert end $BrowsedWDir
    }
    button $BWorkingDir  -background "yellow"  -text "OK"     -padx "2" -command {
	if {$WorkingDirVar!=""} {
	    if {![file exists $WorkingDirVar]} {
		set Warning "$WorkingDirVar does not exists, try another one."
		AjouteAuLog $Warning
	    } elseif {![file isdirectory $WorkingDirVar]} {
		set Warning "$WorkingDirVar is not a directory, try another one."
		AjouteAuLog $Warning
	    } else {
		LesParametresDuDesign WorkingDir $WorkingDirVar "Positionne"
		AjouteAuLog "WorkingDir : $WorkingDirVar"
	    }
	} else {
	    LesParametresDuDesign WorkingDir "Reset"	
	    set Warning "You must define a WorkingDir."
	    AjouteAuLog $Warning
	}
    }
    set_balloon $LWorkingDir "Directory where to save your results"

    #2.2.2.1 Tm Method Panel
    global TmMethod
    global LTmMethod2
    set FTmMethod    "$FParameters2.ftmmethod"
    set  LTmMethod   "$FTmMethod.ltmmethod"
    set  LTmMethod2  "$FTmMethod.l2tmmethod"
    set  RBTmMethod1 "$FTmMethod.rbtmmethod1"
    set  RBTmMethod2 "$FTmMethod.rbtmmethod2"
    set  RBTmMethod3 "$FTmMethod.rbtmmethod3"
    set  RBTmMethod4 "$FTmMethod.rbtmmethod4"
    set  RBTmMethod5 "$FTmMethod.rbtmmethod5"
