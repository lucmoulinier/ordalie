proc ::Taxo::getParent {input {name id}} {

	set field [identifyInput $input]
	set sql "SELECT nparent.id, nparent.name, r.name
			FROM taxon AS t
			  INNER JOIN taxon AS tparent ON tparent.id = t.parent
			  INNER JOIN name AS nparent ON nparent.taxon_id = tparent.id
			  INNER JOIN name AS n ON n.taxon_id = t.id
			  LEFT OUTER JOIN rank AS r ON r.id = tparent.rank_id
			WHERE $field = \$1"
	set res ""
	set rows [DB::queryPg [getConn] $sql [list [string tolower $input]]]
	set res [lindex [formatData $rows $name] 0]
	return $res

}

