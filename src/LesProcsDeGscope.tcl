    label  $LSpecificity  -background "#808FFF" -relief "groove" -width "10" -text "Specificity"      -anchor "w"
    label  $L2Specificity -background "#808FFF" -relief "groove" -width  "3" -text "%"                -anchor "center"
    label  $L3Specificity -background "#808FFF" -relief "groove" -width "10" -text "contiguous bases" -anchor "w"
    entry  $ESpecificity  -textvariable SpecificityVar           -width  "5" -justify "center"
    entry  $E2Specificity -textvariable NbContiguous             -width  "3" -justify "center"
