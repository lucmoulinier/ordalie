proc BoutADN {{Debut 1} {Fin -1} {Orient F} {Banque {}} {aProbleme {}}} {

    global ADN TDN RAC
    global DerniereBase LongueurADN

    if {$aProbleme!=""} { upvar $aProbleme Probleme }

    if {$Banque!=""} { return [BoutADNDeLaBanque $Debut $Fin $Orient $Banque $aProbleme] }

    Wup "Attention on a mis un 'x' en position 0 pour que la 1ere base soit en 1"

    set Status "ADNetTDNetRACAvailable"
    if { ! [info exists ADN]} {	set Status [ChargeADNetTDNetRAC] }
    if {$Debut=="Existe"} {
	if {$Status=="ADNetTDNetRACNotAvailable"} { return 0 } else { return 1 }
    }

    if {$Status=="ADNetTDNetRACNotAvailable"} { return "" }

    if { ! [info exists DerniereBase]} {
	set LongueurADN [string length $ADN]
	set DerniereBase [expr $LongueurADN-1]
    }
    if {$Fin==-1} { set Fin $DerniereBase }

    if { $Orient == "F" } {
	if { $Debut>=1 && $Fin <= $DerniereBase } {
	    set Probleme 0
	    return [string range $ADN $Debut $Fin]
	} else {
	    if {$Debut < 1} {
		set Probleme [expr $Debut-1]
		return "[BoutADN [expr $DerniereBase+$Debut] $DerniereBase $Orient][BoutADN 1 $Fin $Orient]"
	    }
	    if {$Fin > $DerniereBase} {
		set Probleme [expr $Fin-$DerniereBase]
		return "[BoutADN $Debut $DerniereBase $Orient][BoutADN 1 [expr $Fin-$DerniereBase] $Orient]"
	    }
	}
    } else {
	if {$Debut>=1 && $Fin <=$DerniereBase} {
	    set Probleme 0
	    return [string range $RAC [expr $LongueurADN-$Fin] [expr $LongueurADN-$Debut]]
	} else {
	    if {$Debut < 1} {
		set Probleme [expr $Debut-1]
		return "[BoutADN 1 $Fin $Orient][BoutADN [expr $DerniereBase+$Debut] $DerniereBase $Orient]"
	    }
	    if {$Fin > $DerniereBase} {
		set Probleme [expr $Fin-$DerniereBase]
		return "[BoutADN 1 [expr $Fin-$DerniereBase] $Orient][BoutADN $Debut $DerniereBase $Orient]"
	    }
	}
    }

}

proc BoutADNDeLaBanque {Deb Fin Orient Bank aProbleme} {

    upvar $aProbleme Probleme

    #Bank est le nom de la banque tblastn
    #on considere que le genome est circulaire
    set FichierGBK [UnixFileName $Bank]
    puts "Fichier Banque: $FichierGBK"
    if {![file exists $FichierGBK]} {
	puts "Fichier $FichierGBK non trouve"
	return ""
    }
    if {[regexp "^ID  " [PremiereLigneDuFichier $FichierGBK]]} {
	set SeqADN [LaSequenceDuFichierEMBL $FichierGBK]
    } else {
	DecortiqueGenBank OS OC SeqADN $FichierGBK
    }
    set LongueurTotale [string length $SeqADN]
    if {$Fin=="end"} {set Fin $LongueurTotale}
    incr Deb -1 ; incr Fin -1
    set LongueurDesiree [expr $Fin - $Deb + 1]
    if {$Deb>=0} {
	if {$Fin<$LongueurTotale} {
	    set Probleme 0
	    set Seq [string range $SeqADN $Deb $Fin]
	} else {
	    set Seq1  [string range $SeqADN $Deb end]
	    set LongueurRestante [expr $LongueurDesiree - [string length $Seq1]]
	    set Seq2  [string range $SeqADN 0 [expr $LongueurRestante-1]]
	    set Seq   "$Seq1$Seq2"
	    set Probleme $LongueurRestante
	}
    } else {
	if {$Fin<$LongueurTotale} {
	    set Seq2  [string range $SeqADN 0 $Fin]
	    set LongueurRestante [expr $LongueurDesiree - [string length $Seq2]]
	    set Seq1  [string range $SeqADN [expr $LongueurTotale - $LongueurRestante] end]
	    set Seq   "$Seq1$Seq2"
	    set Probleme [expr $LongueurRestante * -1]
	} else {
	    set Seq $SeqADN
	    Probleme -9876543210
	}
    }
    if {$Orient=="R"} {
	set Seq [NucToReverseAndComplementNuc $Seq] 
    }
    return $Seq

}

