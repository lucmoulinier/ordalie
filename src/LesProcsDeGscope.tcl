    if {$e eq "Corogne-Alaves"} {set e "Alaves"}
    if {$e eq "Augsburg"} {set e "Augsbourg"}
    if {$e eq "Mariti"} {set e "Maritimo"}
    if {$e eq "Gerone"} {set e "Girona"}
    if {$e eq "Estoril-Praia"} {set e "Estoril"}

    return $e

}

