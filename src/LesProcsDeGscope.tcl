proc Vectoriel {u v} {

    #lM Produit Vectoriel definit pour 3d.
    #lM  ... on va plus vite ....
    set zu 0.0 ; set zv 0.0
    lassign $u xu yu zu
    lassign $v xv yv zv

    set xw [expr {$yu*$zv - $zu*$yv}]
    set yw [expr {$zu*$xv - $xu*$zv}]
    set zw [expr {$xu*$yv - $yu*$xv}]

    return [list $xw $yw $zw]

}

