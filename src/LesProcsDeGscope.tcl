proc BonneOrthographePourScience Science {

    Wup "To eliminate troubles with UPPER lower case"
    if {[regexp -nocase "^(Animateur|Cafe)$"   $Science]} { return "Animateur" } 
    if {[regexp -nocase "^QuidSeq$"            $Science]} { return "QuidSeq" } 
    if {[regexp -nocase "^GeneQuid$"           $Science]} { return "GeneQuid" } 
    if {[regexp -nocase "^Genoret$"            $Science]} { return "Genoret" } 
    if {[regexp -nocase "^Gx$"                 $Science]} { return "Gx" } 
