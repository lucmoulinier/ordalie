	"MSF_" { # OnList
	    switch -regexp $Nom  "[PreFixe]" { set FichierMSF "$RepertoireDuGenome/$MsfDir/$Nom" }  "ARN"       { set FichierMSF "" }  "TRNA"      { set FichierMSF "" }  "TROU"      { set FichierMSF "$RepertoireDuGenome/$MsfDir/$Nom" }  default     { set FichierMSF $FichierExcuse }
	    if {$FichierMSF==$FichierExcuse} {
		set FichierMSF "$RepertoireDuGenome/$MsfDir/$Nom"
		if {[FileAbsent $FichierMSF]} { set FichierMSF $FichierExcuse }
	    } 
	    set FenetreMSF [AfficheFichier $FichierMSF "AvecEtudeMSFGrandeLargeur"]
