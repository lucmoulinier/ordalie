    set Ld {{  1   3   9   27  81 243 729}  {  2   6  18   54 162 486}  {  4  12  36  108 324}  {  8  24  72  216 648}  { 16  48  144 432}  { 32  96 288}  { 64 192 576}  {128 384}  {256 768}  {512}}
    
    set d 0
    foreach e $Ld {
	set Nt [llength $e]
	for {set t 0} {$t < $Nt} {incr t} {
	    set Loto(14,$d,$t) [lindex $e $t]
	    set Loto(15,$d,$t) [lindex $e $t]
	}
	incr d
    }
    
    return

}

