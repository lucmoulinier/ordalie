    append Entete "<span onclick='FontSize(\"8\");'>8</span>"
    append Entete "&nbsp;&nbsp;"
    append Entete "<span onclick='FontSize(\"10\");'>10</span>"
    append Entete "&nbsp;&nbsp;"
    append Entete "<span onclick='FontSize(\"12\");'>12</span>"
    append Entete "&nbsp;&nbsp;"
