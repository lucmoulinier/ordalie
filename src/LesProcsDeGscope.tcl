proc ::Taxo::identifyInput {input {aliasId t} {aliasName n}} {

	if {[string is int $input]} {
		return "$aliasId.id"
	}
	return "LOWER($aliasName.name)"

}

proc ::Taxo::insertFromFile infile {

	if {![file readable $infile]} {
		throw 1 "Can't read file $infile"
	}
	puts "Reading data"
	set ::Taxo::data [dict create]
	set ::Taxo::children [dict create]
	set rank2id [dict create]
	set cur_rank_index 0

	set f [smartopen $infile r]
	gets $f header

	while {[gets $f l] >= 0} {
		#lassign [split $l "\t"] taxid mnemonic name commonname synonym othernames reviewed rank lineage parent
		lassign [split $l "\t"] taxid mnemonic name commonname synonym othernames lineage reviewed rank parent hosts
		if {$rank ne "" && $rank ne "no rank"} {
			if {![dict exists $rank2id $rank]} {
				dict set rank2id $rank [incr cur_rank_index]
			}
			set rank [dict get $rank2id $rank]
		} else {
			set rank 0
		}
		dict set Taxo::data $taxid [list $name $synonym $rank]
		dict lappend Taxo::children $parent $taxid
	}
	close $f

	# Create root node
	dict set Taxo::data 1 [list root "" 0]
	#set primogeniture {10239 12884 12908 28384 131567}
	set primogeniture {10239 12908 28384 131567}
	dict lappend Taxo::children 1 {*}$primogeniture
	# Fix duplicates
	set duplicates {  115366 "Craniata (brachiopod)"  1261581 "Vertebrata (algae)"  }
	#	35510 "Equus (subgenus)"
	foreach {taxid newname} $duplicates {
		set data [dict get $Taxo::data $taxid]
		lset data 0 $newname
		dict set Taxo::data $taxid $data
	}

	# Insert ranks
	set rows {}
	dict for {rank rankid} $rank2id {
		lappend rows [list $rankid $rank]
	}
	DB::massInsertPg [getConn] update.rank {id name} $rows
	unset rows

	puts "Walking tree"
	set ::Taxo::toInsertTaxons {}
	set ::Taxo::toInsertNames {}
	set ::Taxo::cur_name_id 0

	proc walkTree {{taxid 1} {parent 0} {i 0}} {
		set left [incr i]
		if {[dict exists $Taxo::children $taxid]} {
			foreach child [dict get $Taxo::children $taxid] {
				set i [walkTree $child $taxid $i]
			}
		}
		set right [incr i]
		lassign [dict get $Taxo::data $taxid] name synonym rank
		lappend Taxo::toInsertTaxons [list $taxid $rank $parent $left $right]

		lappend Taxo::toInsertNames [list [incr Taxo::cur_name_id] $taxid $name true]
		if {$synonym ne ""} {
			lappend Taxo::toInsertNames [list [incr Taxo::cur_name_id] $taxid $synonym false]
		}
		return $i
	}
	walkTree
	unset Taxo::data
	unset Taxo::children
	unset Taxo::cur_name_id

	puts "Inserting data"
	DB::massInsertPg [getConn] update.taxon {id rank_id parent l r} $Taxo::toInsertTaxons 500000
	unset Taxo::toInsertTaxons
	DB::massInsertPg [getConn] update.name {id taxon_id name current} $Taxo::toInsertNames 500000
	unset Taxo::toInsertNames

}

