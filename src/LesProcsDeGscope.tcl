    }
    if { ! [info exists LesOrganismesAyantMemeOperon(LaListeMerci,Compte)] } {
	foreach {Clef Valeur} [array get LesOrganismesAyantMemeOperon] {
	    if { ! [regexp ",Compte$" $Clef]} { continue }
	    lappend LesComptes $Valeur
