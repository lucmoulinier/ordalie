proc DeterminationSeuil {Distances DescendDansArbre} {

    #on recherche parmi la liste des distances 
    #quel est le plus grand ecart entre 2 valeurs consecutives

    set Max [expr [llength $Distances]-1]
    for {set i 0} {$i<$Max} {incr i} {
	set Ecart($i) [expr [lindex $Distances [expr $i+1]]-[lindex $Distances $i]]
    }
    set i 0
    set EcartMax 0
    set IndexGrandEcart $Max
    while {$i<$Max} {
	if {[set Ecart($i)]>$EcartMax} {
	    set IndexGrandEcart $i
	    set EcartMax [set Ecart($i)]
	}
	incr i
    }
    #un -1 est rajoute pour le clustering sequences
    if {$DescendDansArbre} {incr IndexGrandEcart -1}
    return [lindex $Distances $IndexGrandEcart]   

}

proc DetermineLePlusGrand Liste {

    set premierefois 1
    foreach elmt $Liste {
	if {$premierefois} {
	    set Max $elmt
	    set premierefois 0
	}
	if {!$premierefois} {
	    if {$elmt>$Max} {
		set Max $elmt
	    }
	}
    }
    return $Max

}

