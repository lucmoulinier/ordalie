	ChefDOrchestreDuCalculDEnrichissement "append" Valeur ZscoreMax $ZscoreMax

	set LesZscore [ChefDOrchestreDuCalculDEnrichissement "Calcul"            ]
	set KCanva    [ChefDOrchestreDuCalculDEnrichissement "Affiche" $LesZscore]

	if {$KCanva != ""} {
	    $KCanva bind "GO" <Enter>     "AfficheInfoBulle $KCanva %x %y Enter"
	    $KCanva bind "GO" <Leave>     "AfficheInfoBulle $KCanva %x %y Leave"
	}
	set QuelEntryPourLeGroupe ""
	set QuelEntryPourLaPop    ""
    }

    $KCanva bind "GO" <Enter>     "AfficheInfoBulle $KCanva %x %y Enter"
    $KCanva bind "GO" <Leave>     "AfficheInfoBulle $KCanva %x %y Leave"

