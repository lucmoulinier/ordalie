proc DrawBlast {{FichierBlast {}} {ExpectMax 1.e200} {NbSubjectMax 1.e200} {IdMin 0.0} {TailleMaxDUneRegionNonAlignee 1.e200}} {

    global TabOptionsDeDrawBlast

    if {[winfo children .] != ""} {
	set       w [NomDe drawblast]
	toplevel $w
	wm title    $w "DrawBlast"
	wm iconname $w "DrawBlast"
    } else {
	set w "."
	$w config -bd 3 -relief flat
	wm title    $w "DrawBlast"
	wm iconname $w "DrawBlast"
    }

    AskOptionsDeDrawBlast set $w ExpectMax                     $ExpectMax
    AskOptionsDeDrawBlast set $w NbSubjectMax                  $NbSubjectMax
    AskOptionsDeDrawBlast set $w IdMin                         $IdMin
    AskOptionsDeDrawBlast set $w FichierBlast                  $FichierBlast
    AskOptionsDeDrawBlast set $w BanqueId                      ""
    AskOptionsDeDrawBlast set $w TailleMaxDUneRegionNonAlignee $TailleMaxDUneRegionNonAlignee

    if {$w == "."} {set w ""}
    set    FrameGeneral                    "${w}.frame"
    set       FramePanel                   "$FrameGeneral.framepanel"
    set          FrameFileBlast            "$FramePanel.framefileblast"
    set             ButtonFileBlast        "$FrameFileBlast.buttonfileblast"
    set             EntryFileBlast         "$FrameFileBlast.entryfileblast"
    set       FrameCanva                   "$FrameGeneral.framecanva"
    set          FrameCanvaMosaic          "$FrameCanva.framecanvamosaic"  
    set          FrameCanvaMapping         "$FrameCanva.framecanvamapping"
    set    BoutonLaunch                    "${w}.boutonlaunch"
    set    BoutonFlatFile                  "${w}.boutonflatfile"
    set    BoutonOptions                   "${w}.boutonoptions"
    set    BoutonReset                     "${w}.boutonreset"
    set    BoutonClose                     "${w}.boutonclose"
    if {$w == ""} {set w "."}
    #############################################################
    frame  $FrameGeneral
    frame     $FramePanel 
    frame        $FrameFileBlast
    button          $ButtonFileBlast       -borderwidth 1 -text "Blast File"
    entry           $EntryFileBlast        -borderwidth 1 -textvariable TabOptionsDeDrawBlast($w,FichierBlast)
    frame     $FrameCanva
    frame        $FrameCanvaMosaic
    frame        $FrameCanvaMapping
    button $BoutonLaunch                   -borderwidth 1 -text "LAUNCH"
    button $BoutonFlatFile                 -borderwidth 1 -text "FLAT FILE"
    button $BoutonOptions                  -borderwidth 1 -text "OPTIONS"
    button $BoutonReset                    -borderwidth 1 -text "RESET MEM"
    button $BoutonClose                    -borderwidth 1 -text "CLOSE"      -background "red"
    
    ######################################################################
    
    pack   $FrameGeneral                   -side top -fill both -expand 1
    pack      $FramePanel                  -side top -fill x -expand 0
    pack         $FrameFileBlast           -side top -fill x -expand 0
    pack            $ButtonFileBlast       -side top -fill x -expand 0
    pack            $EntryFileBlast        -side top -fill x -expand 0
    pack      $FrameCanva                  -fill both -side right -expand 1
    pack         $FrameCanvaMosaic         -fill both -side top   -expand 1
    pack         $FrameCanvaMapping        -fill both -side top   -expand 0
    pack   $BoutonLaunch                   -side left -fill x -expand 1
    pack   $BoutonFlatFile                 -side left -fill x -expand 0
    pack   $BoutonOptions                  -side left -fill x -expand 0
    pack   $BoutonReset                    -side left -fill x -expand 0
    pack   $BoutonClose                    -side left -fill x -expand 1
    
    set LargeurFenetre        [expr [winfo screenwidth  .] * 2.0 / 3]
    set HauteurFenetreMosaic  [expr [winfo screenheight .] * 2.0 / 9]
    set HauteurFenetreMapping [expr [winfo screenheight .] * 4.0 / 9]
    
    AskOptionsDeDrawBlast set $w LargeurFenetre        $LargeurFenetre
    AskOptionsDeDrawBlast set $w HauteurFenetreMosaic  $HauteurFenetreMosaic
    AskOptionsDeDrawBlast set $w FrameCanvaMosaic      $FrameCanvaMosaic
    AskOptionsDeDrawBlast set $w HauteurFenetreMapping $HauteurFenetreMapping
    AskOptionsDeDrawBlast set $w FrameCanvaMapping     $FrameCanvaMapping

    if {$FichierBlast != "" && [file exists $FichierBlast]} {
	DrawMosaic  $FichierBlast    $ExpectMax $NbSubjectMax $IdMin ""               $LargeurFenetre $HauteurFenetreMosaic  $FrameCanvaMosaic  $w
	DrawMapping $FichierBlast "" $ExpectMax $IdMin $TailleMaxDUneRegionNonAlignee $LargeurFenetre $HauteurFenetreMapping $FrameCanvaMapping $w
    } else {
	set K [Canva $LargeurFenetre $HauteurFenetreMosaic  $LargeurFenetre $HauteurFenetreMosaic  "NoY" "" "" $FrameCanvaMosaic]
	$K configure -background white
	set K [Canva $LargeurFenetre $HauteurFenetreMapping $LargeurFenetre $HauteurFenetreMapping "NoY" "" "" $FrameCanvaMapping]
	$K configure -background white
    }

    $ButtonFileBlast  configure -command "ChooseBlastFileDrawBlast $w"
    $BoutonLaunch     configure -command "LaunchOrApplyDrawBlast   $w"
    $BoutonFlatFile   configure -command "FlatFileDrawBlast        $w"
    $BoutonOptions    configure -command "DrawBlastOptions         $w"
    $BoutonReset      configure -command "ResetFenetreDrawBlast    $w"
    $BoutonClose      configure -command "CloseFenetreDrawBlast    $w"
    return $w

}

