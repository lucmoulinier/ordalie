proc ::GO::getEvidence2id {} {

	set sql "SELECT code, id FROM update.evidence"
	set rows [DB::queryPg [getConn] $sql {} llist]

	set d {}
	foreach row $rows {
		dict set d {*}$row
	}
	return $d

}

proc ::GO::getGoid2id {} {

	set sql "SELECT goid, id FROM update.term"
	set rows [DB::queryPg [getConn] $sql {} llist]

	set d {}
	foreach row $rows {
		dict set d {*}$row
	}
	return $d

}

proc ::GO::insertProteins d {

	set rows {}
	dict for {access val} $d {
		lassign $val id taxid
		lappend rows [list $id $access $taxid]
	}
	DB::massInsertPg [getConn] update.protein {id access taxid} $rows 100000

}

proc ::GO::insertVersionInfo {ontology annotations} {

	puts "Updating version info"
	set f [smartopen $ontology r]
	while {[gets $f l] >= 0} {
		if {[regexp {^data-version: (.*)} $l matches ontology_version]} break
		if {[regexp {^ } $l]} break
	}
	close $f
	set f [smartopen $annotations r]
	while {[gets $f l] >= 0} {
		if {[regexp {^!date-generated: ([^ ]+)} $l matches annot_version]} break
		if {![regexp {^!} $l]} break
	}
	close $f

	set sql "INSERT INTO update.info (id,key,value) VALUES (1,'ontology version',\$1), (2,'annotations version',\$2)"
	DB::queryPg [getConn] $sql [list $ontology_version $annot_version]

}

proc ::GO::parseAnnotations args {

	set GO::goid2id [getGoid2id]
	set GO::access2protid {}
	set GO::evidence2id [getEvidence2id]

	set id 0
	foreach gaf $args {
		puts "Parsing file $gaf"
		set id [parseGaf $gaf $id]
	}
	insertProteins $GO::access2protid

	set GO::goid2id {}
	set GO::access2protid {}
	set GO::evidence2id {}

}

proc ::GO::parseGaf {gaf {curid 0}} {

	set f [smartopen $gaf r]

	set fields {id protein_id term_id evidence_id}
	set batchsize 100000
	set rows {}

	while {[gets $f l] >= 0} {
		if {[regexp {^!} $l]} continue
		if {![regexp {^UniProtKB} $l]} continue

		lassign [split $l "\t"] db access symbol qualifier goid dbref evidence from aspect dboname dbosyn dbotype taxon assignedby extension formid
		if {![regexp {taxon:([0-9]+)} $taxon -> taxid]} {
			throw 1 "Can't read taxon $taxon"
		}

		if {[dict exists $GO::access2protid $access]} {
			lassign [dict get $GO::access2protid $access] protid taxid
		} else {
			set protid [expr [dict size $GO::access2protid]+1]
			dict set GO::access2protid $access [list $protid $taxid]
		}
		if {[dict exists $GO::goid2id $goid]} {
			lappend rows [list [incr curid] $protid [dict get $GO::goid2id $goid] [dict get $GO::evidence2id $evidence]]
		}

		if {[llength $rows] >= $batchsize} {
			DB::massInsertPg [getConn] update.annotation $fields $rows $batchsize
			set rows {}
		}
	}
	close $f

	DB::massInsertPg [getConn] update.annotation $fields $rows $batchsize
	return $curid

}

proc ::GO::parseOntology fname {

	# relation types used for grouping annotation
	set grouping_relations {part_of occurs_in}
	set aspect_codes [dict create "biological_process" P "molecular_function" F "cellular_component" C]

	set terms {}
	set go {}
	set altids {}
	set allnames {}

	puts "Reading file"
	set f [smartopen $fname r]

	while {[gets $f l] >= 0} {
		if {[regexp {^\[Typedef\]} $l]} break

		if {[regexp {^\[Term\]} $l] && [dict exists $go id]} {
			#puts "id: $id\nname: $name\naspect: $aspect\nsynonyms: [join $synonyms ", "]\nrelationships: [join $relationships ", "]\n"
			lappend terms $go
			set go [dict create relationships {}]
		} elseif {[regexp {^id: (.*)} $l matches id]} {
			#lappend curterm $id
			dict set go id $id
		} elseif {[regexp {^name: (.*)} $l matches name]} {
			#lappend curterm $name
			dict set go name $name
		} elseif {[regexp {^namespace: (.*)} $l matches aspect]} {
			#lappend aspect $aspect
			dict set go aspect [dict get $aspect_codes $aspect]
		} elseif {[regexp {^synonym: "([^"]*)" ([^ ]+)} $l matches altname type]} {
			#dict lappend go synonyms $altname
			dict lappend synonyms [dict get $go id] $altname
		} elseif {[regexp {^is_a: (GO:[0-9]+)} $l matches parent]} {
			#lappend relationships "is_a:$parent"
			dict lappend go relationships $parent
		} elseif {[regexp {^(?:relationship|intersection_of): ([^ ]*) (GO:[0-9]+)} $l matches relation relative]} {
			if {[lsearch -exact $grouping_relations $relation] >= 0} {
				dict lappend go relationships $relative
			}
		} elseif {[regexp {^is_obsolete: true} $l]} {
			set go [dict create relationships {}]
			#dict set go obsolete 1
		} elseif {[regexp {^alt_id: (GO:[0-9]+)} $l matches alt]} {
			dict lappend altids [dict get $go id] $alt
		}
	}
	#puts "id: $id\nname: $name\naspect: $aspect\nsynonyms: [join $synonyms ", "]\nrelationships: [join $relationships ", "]\n"
	lappend terms $go

	close $f

	puts "Building graph"
	package require struct::graph
	struct::graph g

	set row {}
	set curid 0
	set goid2id {}

	foreach go $terms {
		dict with go {
			g node insert $id
			if {![info exists obsolete]} {
				set obsolete false
			}
			lappend rows [list [incr curid] $id $name $aspect]
			dict set goid2id $id $curid
		}
	}
	set conn [GO::getConn]
	DB::massInsertPg $conn update.term {id goid name aspect} $rows 100000

	puts "Listing alternative ids & synonyms"
	set rows_alt {}
	set rows_syn {}
	set curid_alt 0
	set curid_syn 0

	foreach go $terms {
		dict with go {
			set realid [dict get $goid2id $id]

			lappend rows_alt [list [incr curid_alt] $id $realid]
			if {[dict exists $altids $id]} {
				foreach altgoid [dict get $altids $id] {
					lappend rows_alt [list [incr curid_alt] $altgoid $realid]
				}
			}

			lappend rows_syn [list [incr curid_syn] $name $realid false]
			if {[dict exists $synonyms $id]} {
				foreach syn [dict get $synonyms $id] {
					lappend rows_syn [list [incr curid_syn] $syn $realid true]
				}
			}
		}
	}
	DB::massInsertPg $conn update.identifier {id goid term_id} $rows_alt 100000
	DB::massInsertPg $conn update.name {id name term_id synonym} $rows_syn 100000
	unset altids synonyms rows_alt rows_syn

	foreach go $terms {
		dict with go {
			foreach relative $relationships {
				g arc insert $id $relative
				#puts "$id has parent $relative"
			}
		}
	}

	puts "Listing descendants"
	set rows {}
	set curid 0
	proc add {mode g n} {
		upvar descendants descendants
		lappend descendants $n
	}
	foreach go $terms {
		set descendants {}
		dict with go {
			g walk $id -order pre -dir backward -type dfs -command add
			#set descendants [lrange $descendants 1 end]
			set direct_children [g nodes -in $id]

			foreach relative $descendants {
				set direct false
				if {[lsearch $direct_children $relative] >= 0} {
					set direct true
				}
				lappend rows [list [incr curid] [dict get $goid2id $id] [dict get $goid2id $relative] $direct]
			}
		}
	}
	DB::massInsertPg $conn update.relation {id parent_term_id child_term_id direct} $rows 100000
	g destroy

}

proc ::GO::rotate {} {

	puts "Rotating schemas"
	set sql "DROP SCHEMA IF EXISTS old CASCADE;
			ALTER SCHEMA public RENAME TO old;
			ALTER SCHEMA update RENAME TO public;"
	DB::queryPg [getConn] $sql

}

proc ::GO::update {obofile args} {

	createSchema
	insertVersionInfo $obofile [lindex $args 0]
	parseOntology $obofile
	parseAnnotations $args
	createIndexes
	vacuum
	rotate

}

proc ::GO::vacuum {} {

	set c [getConn]
	foreach table {term relation annotation protein evidence} {
		set sql "VACUUM ANALYZE update.$table;"
		DB::queryPg $c $sql
	}

}

proc GODB args {

    # OPTIONS de GODB
    
    # Load   
    # Exists (...)
    # set    (...) valeur
    # append (...) valeur
    # unset  (...)
    # unset

    # LesTypes
    # LesGO
    # Type $Type LesGO
    # GO   $GO   LesTypes 
    # Type $Type GO            $GO        LesSynonymes
    # Type $Type GOSynonyme    $Synonyme  GODeRef
    # Type $Type GO            $GO        LesNiveaux
    # Type $Type LesNiveaux
    # Type $Type Niveau        $Niveau    LesGO
    # Type $Type GO            $GO        LesEC

    # Type $Type GO            $GO        LesParents
    # Type $Type GO            $GO        LesConstituants
    # Type $Type GO            $GO        LesContributions
    # Type $Type GO            $GO        LesEnfants
    # Type $Type GO            $GO        LesDefinitions

    # set  GONothing  "GO:nothing"
    # Type $Type Nothing
    # Type $Type GO            $GONothing LesSynonymes
    # Type $Type GO            $GONothing LesNiveaux
    # Type $Type GO            $GONothing LesEC
    # Type $Type GO            $GONothing LesParents
    # Type $Type GO            $GONothing LesConstituants
    # Type $Type GO            $GONothing LesContributions
    # Type $Type GO            $GONothing LesEnfants
    # Type $Type TousLesGO
    # Type $Type LesNiveaux
    
    global TableauArbreGeneOntology

    set FirstArg [lindex $args 0]

    if {[string equal -nocase $FirstArg "Exists"]} {
	if {![info exists TableauArbreGeneOntology]} {return 0}
	set Quoi   [join [lrange $args 1 end] ","]
	if {$Quoi == ""} {return 0}
	return [info exists TableauArbreGeneOntology($Quoi)]
    }
    if {[string equal -nocase $FirstArg "append"]} {
	if {![info exists TableauArbreGeneOntology]} {return}
	set Quoi   [join [lrange $args 1 end-1] ","]
	set Valeur [lindex $args end]
	if {$Quoi == ""} {return}
	return [lappend TableauArbreGeneOntology($Quoi) $Valeur]
    }
    if {[string equal -nocase $FirstArg "set"]} {
	if {![info exists TableauArbreGeneOntology]} {return}
	set Quoi   [join [lrange $args 1 end-1] ","]
	set Valeur [lindex $args end]
	if {$Quoi == ""} {return}
	return [set TableauArbreGeneOntology($Quoi) $Valeur]
    }
    if {[string equal -nocase $FirstArg "unset"]} {
	if {![info exists TableauArbreGeneOntology]} {return}
	set Quoi [join [lrange $args 1 end] ","]
	if {$Quoi == ""} {
	    return [info exists TableauArbreGeneOntology]
	} else {
	    catch {unset TableauArbreGeneOntology($Quoi)}
	}
	return
    }
    if {[string equal -nocase $FirstArg "Load"] && ![info exists TableauArbreGeneOntology(EstCharge)]} {
	if {[info exists TableauArbreGeneOntology]} {unset TableauArbreGeneOntology}
	set TableauArbreGeneOntology(EstCharge) 1
	LoadGODB TableauArbreGeneOntology
	return
    }

    set Quoi [join $args ","]

    if {[info exists TableauArbreGeneOntology($Quoi)]} {return [set TableauArbreGeneOntology($Quoi)] }
    if {[info exists TableauArbreGeneOntology(EstCharge)]} {return}
    LoadGODB TableauArbreGeneOntology
    set TableauArbreGeneOntology(EstCharge) 1

    if {[info exists TableauArbreGeneOntology($Quoi)]} { return [set TableauArbreGeneOntology($Quoi)] }
    return

}

proc GODBDir {} {

    global RepGODBDir
    global RepertoireDuGenome

    if {[info exists RepertoireDuGenome]} {
	set Rep "[OntologyDir]"
	if {![file exists $Rep]} {return}
	set RepGODBDir $Rep
    } else {
	set Rep "[ProgSourceDir]/GODB"
	if {![file exists $Rep]} {return}
	set RepGODBDir $Rep
    }
    return $RepGODBDir

}

proc GOPanel {{w {}}} {

    global LesAccessPourLeGO
    global AccessPourLeGO
    global LesProjGscopePourLeGO
    global ProjGscopePourLeGO
    global LesBoxGscopePourLeGO
    global BoxGscopePourLeGO
    global LesBlastPPourLeGO
    global BlastPPourLeGO
    global LesFichiersDPC2GO
    global FichierDPC2GO
    global LesGOPourLeGO
    global GOPourLeGO
    global LesRequetesPourLeGO
    global RequetePourLeGO
    global TabValidationDesGO
    global TypeSelectionne
    global OptionsSelect
    global DensitySelect

    set DensitySelect         "No"
    set TypeSelectionne       [lindex [LesTypesOntologiques] 0]
    set OptionsSelect         "OnlyMyGO"
    set LesAccessPourLeGO     {}
    set LesProjGscopePourLeGO {}
    set LesBoxGscopePourLeGO  {}
    set LesBlastPPourLeGO     {}
    set LesGOPourLeGO         {}
    set LesRequetesPourLeGO   {}
    set LesFichiersDPC2GO     {}

    if {$w == ""} {set w "."} else {toplevel $w}
    wm geometry $w +300+100
    wm title     $w "ONTOLOGY PANEL"
    wm resizable $w false false
    if {$w == "."} {set w ""}

    set   FRequetes       "$w.frequetes"
    set   FType           "$w.ftype"
    set   FDensity        "$w.fdensity"
    set   FOptions        "$w.foptions"
    set   FBoutons        "$w.fboutons"
    frame $FRequetes      -borderwidth 3 -relief ridge
    frame $FType          -borderwidth 3 -relief ridge
    frame $FDensity       -borderwidth 3 -relief ridge
    frame $FOptions       -borderwidth 3 -relief ridge 
    frame $FBoutons       -borderwidth 3 -relief ridge 
    pack  $FRequetes      -side top -fill both
    pack  $FType          -fill x
    pack  $FDensity       -fill x
    pack  $FOptions       -fill x
    pack  $FBoutons       -fill x

    set LTitre "$FRequetes.ltitre"
    label $LTitre -text "ONTOLOGY" -borderwidth 3 -relief ridge 
    pack $LTitre -side top -fill x 

    ###Access###
    set    FAccess "$FRequetes.faccess"
    set    LAccess "$FAccess.laccess"
    set    EAccess "$FAccess.eaccess"
    set    BAccess "$FAccess.baccess"
    frame  $FAccess
    label  $LAccess -text "Access or Id"  -background yellow -width 20 -anchor w
    entry  $EAccess -textvariable AccessPourLeGO
    button $BAccess -text "ADD" -background RoyalBlue -command {
	set AccessPourLeGO [string toupper $AccessPourLeGO]
	if {    ![info exists TabValidationDesGO($AccessPourLeGO)] &&  [regexp -nocase {[0-9a-z]} $AccessPourLeGO]} {
	    Espionne $AccessPourLeGO
	    set TabValidationDesGO($AccessPourLeGO) 1
	    lappend LesAccessPourLeGO $AccessPourLeGO
	    set AccessPourLeGO ""
	}
    }
    ###Gscope###
    set    FProjGscope "$FRequetes.fprojgscope"
    set    LProjGscope "$FProjGscope.lprojgscope"
    set    EProjGscope "$FProjGscope.eprojgscope"
    set    BProjGscope "$FProjGscope.bprojgscope"
    frame  $FProjGscope
    label  $LProjGscope -text "Gscope DataBase" -background yellow  -width 20 -anchor w
    entry  $EProjGscope -textvariable ProjGscopePourLeGO
    button $BProjGscope -text "ADD" -background RoyalBlue  -command {
	if {    [file exists [GscopeDatabaseDir $ProjGscopePourLeGO]] &&  ![info exists TabValidationDesGO($ProjGscopePourLeGO)]  &&  [regexp -nocase {[0-9a-z]} $ProjGscopePourLeGO]} {
