	if {$Append == ""} { return "[ContenuDuFichier $FichierInfo]" }
	if {[OuiOuNon "$Append\n doit etre rajoute a la page info $Nom/$Access\n  La page info est deja ouverte.\n  Dois-je abandonner ?"]} { return -1 }
