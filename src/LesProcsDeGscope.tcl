proc EntreMinEtMax {Angle m M} {

    set D [expr $M-$m]
    while {$Angle < $m} { set Angle [expr $Angle + $D] }
    while {$Angle >= $M} { set Angle [expr $Angle - $D] }
    return $Angle

}

