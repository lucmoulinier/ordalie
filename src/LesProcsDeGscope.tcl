    if {$AliasDuSujet==""} { return 1 }
    set LesBonsCouples [list  "XPDhs p80hs"  "NURR1 hNURR1"  "ITK SH1-ITK"  "LXRb hLXRb"  "hCOUP-TFIIH hCOUP-TFII"  "hsTFIIEA TF2EAHS"  "SSL1 YLR005WSSL1"  "TFB1 YDR311WTFB1"  "RARa HRARA"]
