proc ::NSPopulateAssemblyDbGui::selectLibrary lBox {

	variable libraries
	variable batchs
	variable libraryPk
	variable batchsInLib {}
	variable batchPk ""
	
	if {[$lBox size] != 0} {
	    set selectedName [$lBox get [$lBox curselection]]
	    
	    if {[info exists libraries($selectedName,pk)]} {
		set libraryPk $libraries($selectedName,pk)
		foreach b $batchs(index) {
		    if {$batchs($b,pkLibrary) == $libraryPk} {lappend batchsInLib $b}
		}
	    } else {
		set libraryPk ""
	    }
	}
    
}

proc ::NSPopulateAssemblyDbGui::setupAndLockBatchFields {batchNameEntry gscopeDirEntry gscopeDirBrowse DEUpdButton args} {

	variable batchs
	variable batchPk
	variable batchName
	variable gscopeProjectDir

	if {$batchPk ne ""} {
	    foreach b $batchs(index) {
		if {$batchs($b,pk) == $batchPk} {
		    set batchName $batchs($b,name)
		    set gscopeProjectDir $batchs($b,gscopeDirectory)
		    $batchNameEntry configure -state disabled
		    $gscopeDirEntry configure -state disabled
		    $gscopeDirBrowse configure -state disabled
		    $DEUpdButton configure -state normal
		}
	    }
	} else {
	    newBatch $batchNameEntry $gscopeDirEntry $gscopeDirBrowse
	    $DEUpdButton configure -state disabled
	}
    
}

