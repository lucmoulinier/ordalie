     bind $P.name <Return> {tc_loadNamedColor $CouleurNommeePourPaletteDeCouleurs $PEnGlobalPourPaletteDeCouleurs}
    
# Create the color display swatch on the right side of the window.
    
    frame $P.middle.right
     pack $P.middle.right -side left -pady .25c -padx .25c -anchor s
    frame $P.swatch -width 2c -height 5c -background $color
    label $P.value -textvariable color -width 13  -font -Adobe-Courier-Medium-R-Normal--*-120-*-*-*-*-*-*
     pack $P.swatch -in $P.middle.right -side top -expand yes -fill both
     pack $P.value -in $P.middle.right -side bottom -pady .25c

#lm rajoute grab
     update idletasks
     set OldGrab [grab current]
     grab set $P
     wm attributes $P -topmost 1
     wm transient $P .

    changeColorSpace hsb $P
    tkwait variable LaCouleurDePaletteDeCouleurs

    destroy $P

#lm remet le grab si necessaire
     if {$OldGrab ne ""} {grab [lindex $OldGrab 0]}

    return $LaCouleurDePaletteDeCouleurs

}

proc ::Palign::annoterBlast {blastfile anchorfile} {

	# lecture ballast
	set danchors [dict create]
	set seqanchors [dict create]

	set fd [open $anchorfile r]
	gets $fd line
	while {[gets $fd line] >= 0} {
		if {[regexp {seq: [^ \t]+ ([^ \t]+)[ \t]*pos:[ \t]*[^ \t]+[ \t]*beg:[ \t]*([^ \t]+)[ \t]*([^ \t]+)[ \t]*len:[ \t]*([^ \t]+)[ \t]*weight:[ \t]*([^ \t]+)} $line matches seq begin_query begin_subject length weight]} {
			dict lappend seqanchors $seq "$begin_query $length"
		}
	}
	close $fd

	# lecture blast
	set output {}
	set curseq ""
	set curanchors {}
	set fd [open $blastfile r]

	while {[gets $fd line] >= 0} {
		regexp {^>([^ ]+) } $line matches curseq
		if {[regexp {^Query: } $line]} {
			if {[dict exists $seqanchors $curseq]} {
				set curanchors [lsort -decreasing -index 0 -integer [dict get $seqanchors $curseq]]
			} else {
				set curanchors {}
			}
			# inserer balises
			lappend output [drawLMS $line $curanchors]
		} else {
			lappend output $line
		}
	}
	close $fd
	return $output

}

proc ::Palign::drawLMS {input anchors} {

	regexp {Query: ([0-9]+)[ ]*[^ ]+[ ]*([0-9]+)$} $input matches linestart lineend
	set output $input

	foreach a $anchors {
		# bornes inclusives
		lassign $a anchorstart anchorlength
		set anchorend [expr $anchorstart + $anchorlength - 1]

		if {($anchorstart >= $linestart && $anchorstart <= $lineend) || ($anchorend >= $linestart && $anchorend <= $lineend)} {
			set end [expr min($lineend, $anchorend)]
			set start [expr max($linestart, $anchorstart)]
			set realstart [expr 11 + $start - $linestart]
			set realend [expr 11 + $end - $linestart + 1]

			set output [string_insert $output $realend "</span>"]
			set output [string_insert $output $realstart [format {<span style="color:red;" title="pos:%s,len:%s">} $anchorstart $anchorlength]]
		}
	}
	return $output

}

proc ::Palign::string_insert {input index toinsert} {

	set res [string range $input 0 [expr $index-1]]
	append res $toinsert
	append res [string range $input $index end]
	return $res

}

