	foreach Type [GODB GO $GO LesTypes] {
	    if {[info exists TabTmp($Type)]} {continue}
	    set TabTmp($Type) 1
	    lappend LesTypes $Type
	}
	if {[llength $LesTypes] >= [llength [GODB LesTypes]]} {break}
    }
    return $LesTypes

}

