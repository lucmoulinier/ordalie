proc ChargeOntology {aTableauGO Type {Action {}}} {

    global TableauGO 
    
    upvar $aTableauGO TableauGO

    if {$Action == "Erase" && [info exists TableauGO]} {
	unset TableauGO
	return ""
    }
    if {[info exists TableauGO($Type)]} {return $aTableauGO}

    Espionne "Load $Type ontology"

    set Fichier "[OntologyDir]/$Type.ontology"
    if {![file exists $Fichier]} {Espionne "$Fichier does not exist";return ""}

    if {![info exists TableauGO(TousLesGO)]} {set TableauGO(TousLesGO) {}}

    set TousLesGO {}
    set F [open $Fichier]
    while {[gets $F Ligne]>=0} {
	if {[string first "!" $Ligne] == 0 || $Ligne == ""} {continue}

	set Espace ""
	regexp {^([ ]*)} $Ligne tmp Espace
	set Niveau 0
	set Niveau [string length $Espace]

	set PosTmp    [string first "GO:" $Ligne]
	set GOTmp     [string range $Ligne [expr $PosTmp] end]
	set GOTmp     [lindex [split $GOTmp {;|%|<}] 0]
	regsub -all " " $GOTmp "" GOTmp

	set LesGO      [split  $GOTmp   ","]
	set GO         [lindex $LesGO 0    ]
	set LesJumeaux [lrange $LesGO 1 end]
	set TableauGO($Type,$GO,LesJumeaux) $LesJumeaux
	set TableauGO($GO,LesJumeaux) $LesJumeaux
	foreach Jumeau $LesJumeaux {set TableauGO($Jumeau,MonJumeau) $GO}

	if {0 < [string first "<" $GO]} {
	    set GO [string range $GO 0 [expr [string first "<" $GO ] - 1]]
	}
	if {0 < [string first "%" $GO]} {
	    set GO [string range $GO 0 [expr [string first "%" $GO ] - 1]]
	}
	set Ligne [string trim $Ligne]
	set TabTmp($Niveau) $GO
	if {![info exists TableauGO($Type,$GO,LesNiveaux)]} {set TableauGO($Type,$GO,LesNiveaux) {}}
	if {![info exists TableauGO($Type,LesNiveaux)    ]} {set TableauGO($Type,LesNiveaux) {}}
	if {![info exists TableauGO($Type,$Niveau)       ]} {
	    lappend TableauGO($Type,LesNiveaux) $Niveau;set TableauGO($Type,$Niveau) {}
	}
	if {![info exists TableauGO($Type,$GO,EC)   ]}            {set TableauGO($Type,$GO,EC)              ""}
	if {![info exists TableauGO($GO,Type)                  ]} {set TableauGO($GO,Type) $Type}
	if {![info exists TableauGO($Type,$GO,LesParents)      ]} {set TableauGO($Type,$GO,LesParents)      {}}
	if {![info exists TableauGO($Type,$GO,LesConstituants) ]} {set TableauGO($Type,$GO,LesConstituants) {}}
	if {![info exists TableauGO($Type,$GO,LesContributions)]} {set TableauGO($Type,$GO,LesContributions) {}}
	if {![info exists TableauGO($Type,$GO,LesEnfants)      ]} {set TableauGO($Type,$GO,LesEnfants)      {}}
	
	lappend TableauGO($Type,$GO,LesNiveaux) $Niveau
	lappend TableauGO($Type,$Niveau)   $GO
	
	if {![info exists TabTmp(DejaVu,$GO)]} {
	    lappend TousLesGO $GO
	    set TabTmp(DejaVu,$GO) 1
	    lappend TableauGO(TousLesGO) $GO
	}
	
	if {[regexp "^\\$" $Ligne]} {
	    set Definition [string trim [string range [lindex [split $Ligne ";"] 0] 1 end]]
	    regsub -all {\\} $Definition "" Definition
		set TableauGO($Type,$GO,LesDefinitions) $Definition
	    continue     
	}
	if {[regexp -nocase "^%" $Ligne]} {
	    set LOrigineDesEnfants "LesEnfants";      set LOrigineDesParents "LesParents"
	    regsub "^%" $Ligne "" Ligne
	}
	if {[regexp -nocase "^<" $Ligne]} {
	    set LOrigineDesEnfants "LesContributions";set LOrigineDesParents "LesConstituants"
	    regsub "^<" $Ligne "" Ligne
	}
	set NiveauInf [expr   $Niveau - 1]
	set GOInf     [set TabTmp($NiveauInf)]
	if {![info exists TableauGO($Type,$GOInf,LesEnfants)]} {
	    set TableauGO($Type,$GOInf,LesEnfants) {}
	}
	if {![info exists TableauGO($Type,$GOInf,LesContributions)]} {
	    set TableauGO($Type,$GOInf,LesContributions) {}
	}
	if {![info exists TabTmp($GO,$GOInf)] && ![info exists TabTmp($GOInf,$GO)]} {
	    lappend TableauGO($Type,$GO,$LOrigineDesParents)    $GOInf
	    lappend TableauGO($Type,$GOInf,$LOrigineDesEnfants) $GO
	    set TabTmp($GO,$GOInf) 1
	    set TabTmp($GOInf,$GO) 1
	}
	
	set Pos1 [string first  "%" $Ligne]
	set Pos2 [string first  "<"  $Ligne ]
	#######Le GO principal de la ligne##################
	if {      $Pos1 != -1 && $Pos2 != -1 && $Pos1 < $Pos2} {
	    set ElementsDuGO [string range $Ligne 0 [expr $Pos1-1]]
	    set Ligne        [string range $Ligne $Pos1 end]
	} elseif {$Pos1 != -1 && $Pos2 != -1 && $Pos2 < $Pos1} {
	    set ElementsDuGO [string range $Ligne 0 [expr $Pos2-1]]
	    set Ligne        [string range $Ligne $Pos2 end]
	} elseif {$Pos1 == -1 && $Pos2 != -1} {
	    set ElementsDuGO [string range $Ligne 0 [expr $Pos2-1]]
	    set Ligne        [string range $Ligne $Pos2 end]
	} elseif {$Pos1 != -1 && $Pos2 == -1} {
	    set ElementsDuGO [string range $Ligne 0 [expr $Pos1-1]]
	    set Ligne        [string range $Ligne $Pos1 end]
	} else {
	    set ElementsDuGO $Ligne
	    set Ligne ""
	}
	set LesElementsTmp [split [string trim $ElementsDuGO] "\;"]
	
	set LesElementsDuGO {}
	foreach Element $LesElementsTmp {lappend LesElementsDuGO [string trim $Element]}
	
	if {![info exists TableauGO($Type,$GO,LesDefinitions)]} {
	    set TableauGO($Type,$GO,LesDefinitions) {}
	    set Definition [lindex $LesElementsDuGO 0]
	    regsub -all {\\} $Definition "" Definition
	    lappend TableauGO($Type,$GO,LesDefinitions) $Definition
	    
	    foreach Element $LesElementsDuGO {
		if {[regexp "synonym:" $Element]} {
		    regsub "synonym:" $Element "" Element
		    regsub -all {\\} $Element "" Element
		    lappend TableauGO($Type,$GO,LesDefinitions) [string trim $Element]
		} elseif {[regexp "EC:" $Element]} {
		    set TableauGO($Type,$GO,EC) [string trim $Element]
		}
	    }
	}
    }
    #######GO Nothing##########################################
    set GONothing  "GO:nothing"
    set Niveau     1
    set Definition "No $Type ontology"
    set GOPere     [set TableauGO($Type,[expr $Niveau - 1])]
    
    set     TableauGO($Type,Nothing)                     $GONothing
    set     TableauGO($Type,$GONothing,LesJumeaux)       {}
    set     TableauGO($Type,$GONothing,LesNiveaux)       {}
    set     TableauGO($Type,$GONothing,EC)               ""
    set     TableauGO($Type,$GONothing,LesParents)       {}
    set     TableauGO($Type,$GONothing,LesConstituants)  {}
    set     TableauGO($Type,$GONothing,LesContributions) {}
    set     TableauGO($Type,$GONothing,LesEnfants)       {}

    lappend TableauGO($Type,$GOPere,LesEnfants)          $GONothing
    lappend TableauGO($Type,$GONothing,LesNiveaux)       $Niveau
    lappend TableauGO($Type,$GONothing,LesDefinitions)   $Definition
    lappend TableauGO($Type,$Niveau)                     $GONothing
    lappend TableauGO($Type,$GONothing,LesParents)       $GOPere
    lappend TousLesGO                                    $GONothing
    #######GO Nothing##########################################

    set TableauGO($Type,TousLesGO) [ElimineLesRedondancesDansUneListe $TousLesGO]

    set LesNiveaux {}
    foreach Niveau [set TableauGO($Type,LesNiveaux)] {
	lappend LesNiveaux $Niveau
    }
    set TableauGO($Type,LesNiveaux) $LesNiveaux

    set TableauGO($Type) 1

    Espionne "$Type ontology loaded"
    close $F
    if {[info exists TabTmp]} {unset TabTmp}
    return $aTableauGO

}

proc ChargeOrf2Cluster2Access2Def2Expression {aTab Fichier} {

    upvar $aTab Tab
    set F [open $Fichier]
    set Tab($Fichier,LesClusters) {}
    set Tab($Fichier,LesNoms)     {}
    while {[gets $F Ligne]>=0} {
	if {$Ligne == ""} {continue}

	if {[string first "#" $Ligne] == 0} {
	    set LaLigne [split [string range $Ligne 1 end] "\t"]

	    set Tab($Fichier,LesPointsTemporels) {}
	    set Tab($Fichier,LesConditions)      {}
	    for {set i 4} {$i < [llength $LaLigne]} {incr i} {
		set     Pos                              [expr $i - 3]
		set     Legende                          [lindex $LaLigne $i]

		scan $Legende "%s %s"                    When What

		if {![info exists Tab($Fichier,Condition,$What,LesPointsTemporels)]} {
		    set     Tab($Fichier,Condition,$What,LesPointsTemporels) {}
		    lappend Tab($Fichier,LesConditions)                     $What
		}
		if {![info exists Tab($Fichier,PointTemporel,$When,LesConditions)]} {
		    set     Tab($Fichier,PointTemporel,$When,LesConditions) {}
		    lappend Tab($Fichier,LesPointsTemporels)                $When
		}
		set     Tab($Pos,When)                   $When
		set     Tab($Pos,What)                    $What
	    }
	    continue
	}
	set LaLigne [split $Ligne "\t"]
	set Nom     [lindex $LaLigne 0]
	set Cluster [lindex $LaLigne 1]
	set Access  [lindex $LaLigne 2]
	set Def     [lindex $LaLigne 3]

	lappend Tab($Fichier,LesNoms)               $Nom
	set Tab($Fichier,$Nom,Cluster)              $Cluster
	set Tab($Fichier,$Nom,Access)               $Access
	set Tab($Fichier,$Nom,Definition)           $Def
	set Tab($Fichier,Access,$Access,Definition) $Def
	set Tab($Fichier,$Nom,LesExpressions)       {}

	if {![info exists Tab($Fichier,Access,LesNoms)]} {
	    set Tab($Fichier,Access,LesNoms) {}
	}
	lappend Tab($Fichier,Access,LesNoms) $Nom
	if {![info exists Tab($Fichier,Cluster,$Cluster,LesAccess)]} {
	    set Tab($Fichier,Cluster,$Cluster,LesAccess) {}
	}
	lappend Tab($Fichier,Cluster,$Cluster,LesAccess) $Access
	if {![info exists Tab($Fichier,Cluster,$Cluster,LesNoms)]} {
	    set Tab($Fichier,Cluster,$Cluster,LesNoms) {}
	    set Tab($Fichier,Cluster,$Cluster,nNoms)   0
	    lappend Tab($Fichier,LesClusters) $Cluster
	}
	incr    Tab($Fichier,Cluster,$Cluster,nNoms)
	lappend Tab($Fichier,Cluster,$Cluster,LesNoms) $Nom

	for {set i 4} {$i < [llength $LaLigne]} {incr i} {
	    set Pos  [expr   $i - 3        ]
	    set Expr [lindex $LaLigne    $i]
	    if {[info exists Tab($Fichier,LesPointsTemporels)]} {
		set When [set    Tab($Pos,When)]
		set What [set    Tab($Pos,What)]
		set Tab($Fichier,$Nom,PointTemporel,$When,Condition,$What,Expression) $Expr
		set Tab($Fichier,$Nom,Condition,$What,PointTemporel,$When,Expression) $Expr

		if {![info exists Tab($Fichier,$Nom,Condition,$What,LesPointsTemporels)]} {
		    set  Tab($Fichier,$Nom,Condition,$What,LesExpressions)     {}
		    set  Tab($Fichier,$Nom,Condition,$What,LesPointsTemporels) {}
		}
		lappend Tab($Fichier,$Nom,Condition,$What,LesExpressions)     $Expr
		lappend Tab($Fichier,$Nom,Condition,$What,LesPointsTemporels) $When
		if {![info exists Tab($Fichier,$Nom,PointTemporel,$When,LesConditions)]} {
		    set  Tab($Fichier,$Nom,PointTemporel,$When,LesConditions) {}
		}
		lappend Tab($Fichier,$Nom,PointTemporel,$When,LesConditions) $What
	    }
	    lappend Tab($Fichier,$Nom,LesExpressions) $Expr
	}

	if {[info exists Tab($Fichier,LesPointsTemporels)]} {
	    foreach When [set Tab($Fichier,LesPointsTemporels)] {
		foreach What1 [set Tab($Fichier,LesConditions)] {
		    if {![info exists     Tab($Fichier,$Nom,PointTemporel,$When,Condition,$What1,Expression)]} {continue}
		    foreach What2 [set Tab($Fichier,LesConditions)] {
			if {![info exists Tab($Fichier,$Nom,PointTemporel,$When,Condition,$What2,Expression)]} {continue}

			if {[info exists Tab($Fichier,$Nom,PointTemporel,Fold,$What1,sur,$What2)]} {continue}

			set Expr1 [set Tab($Fichier,$Nom,PointTemporel,$When,Condition,$What1,Expression)]
			set Expr2 [set Tab($Fichier,$Nom,PointTemporel,$When,Condition,$What2,Expression)]
			
			if {$Expr1 == "" || $Expr2 == ""} {continue}

			set Tab($Fichier,$Nom,PointTemporel,$When,Fold,$What1,sur,$What2) [expr $Expr1*1.0/$Expr2]
			set Tab($Fichier,$Nom,PointTemporel,$When,Fold,$What2,sur,$What1) [expr $Expr2*1.0/$Expr1]
		    }
		}
	    }
	}
    }
    close $F
    return $aTab

}

proc ChargeOrf2Cluster2Operon {aTab {Fichier {}}} {

    upvar $aTab Tab
    if {$Fichier == ""} {
	global RepertoireDuGenome
	set Fichier "$RepertoireDuGenome/fiches/orf2cluster2operon"
    } 
    if {![file exists $Fichier]} {return ""}
    set Tab(LesClusters)    {}
    set Tab(LesOrfs)        {}
    set Tab(LesOperons)     {}
    set Tab(NbClusters)     0
    set Tab(NbOrfs)         0
    set Tab(NbOperons)      0

    set F [open $Fichier]
    while {[gets $F Ligne]>=0} {
	if {$Ligne == ""} {continue}

	set LaLigne [split $Ligne "\t"]
	set Orf        [lindex $LaLigne 0]
	set Cluster    [lindex $LaLigne 1]
	set TCluster   [lindex $LaLigne 2]
	set Operon     [lindex $LaLigne 3]
	set TOperon    [lindex $LaLigne 4]
	set Definition [lindex $LaLigne 5]

	############INITIALISATION DU TABLEAU###################

	if {![info exists Tab(Orf,$Orf,Definition)]} {
	    incr    Tab(NbOrfs) 
	    set     Tab(Orf,$Orf,Definition)                                     $Definition
	    lappend Tab(LesOrfs)                                                 $Orf
	    if {$Cluster != "Not in Cluster"} {
		set Tab(Orf,$Orf,Cluster)                                        $Cluster
		set Tab(Orf,$Orf,TailleCluster)                                  $TCluster
	    }
	    if {$Operon != "Not in Operon"} {
		set Tab(Orf,$Orf,Operon)                                         $Operon
		set Tab(Orf,$Orf,TailleOperon)                                   $TOperon
	    }
	}
	if {$Cluster != "Not in Cluster" && ![info exists Tab(Cluster,$Cluster,TailleCluster)] } {
	    lappend Tab(LesClusters)                                             $Cluster
	    incr    Tab(NbClusters)
	    set     Tab(Cluster,$Cluster,TailleCluster)                          $TCluster
	    set     Tab(Cluster,$Cluster,LesOrfs)                                {}  
	    set     Tab(Cluster,$Cluster,LesDefinitions)                         {}
	    set     Tab(Cluster,$Cluster,LesOperons)                             {}
	    set     Tab(Cluster,$Cluster,NbOperonsDansCluster)                   0
	}
	if {$Operon != "Not in Operon" && ![info exists Tab(Operon,$Operon,TailleOperon)]} {
	    lappend Tab(LesOperons)                                              $Operon
	    incr    Tab(NbOperons) 
	    set     Tab(Operon,$Operon,TailleOperon)                             $TOperon
	    set     Tab(Operon,$Operon,LesOrfs)                                  {}  
	    set     Tab(Operon,$Operon,LesDefinitions)                           {}
	    set     Tab(Operon,$Operon,LesClusters)                              {}
	    set     Tab(Operon,$Operon,NbClustersDansOperon)                     0
	}
	if {    $Cluster != "Not in Cluster" && $Operon != "Not in Operon" &&  ![info exists Tab(Cluster,$Cluster,Operon,$Operon,LesOrfsEnCommun)]} {
	    set Tab(Cluster,$Cluster,Operon,$Operon,LesOrfsEnCommun)             {}
	    set Tab(Cluster,$Cluster,Operon,$Operon,LesDefinitionsEnCommun)      {}
	    set Tab(Cluster,$Cluster,Operon,$Operon,NbOrfsEnCommun)              0
	    set Tab(Operon,$Operon,Cluster,$Cluster,LesOrfsEnCommun)             {}
	    set Tab(Operon,$Operon,Cluster,$Cluster,LesDefinitionsEnCommun)      {}
	    set Tab(Operon,$Operon,Cluster,$Cluster,NbOrfsEnCommun)              0

	    lappend Tab(Cluster,$Cluster,LesOperons)                             $Operon
	    lappend Tab(Operon,$Operon,LesClusters)                              $Cluster

	    incr Tab(Cluster,$Cluster,NbOperonsDansCluster)
	    incr Tab(Operon,$Operon,NbClustersDansOperon)
	}

	######################################################

	if {$Cluster != "Not in Cluster"} {
	    lappend Tab(Cluster,$Cluster,LesOrfs)                                $Orf
	    lappend Tab(Cluster,$Cluster,LesDefinitions)                         $Definition
	}
	if {$Operon != "Not in Operon"} {
	    lappend Tab(Operon,$Operon,LesOrfs)                                  $Orf
	    lappend Tab(Operon,$Operon,LesDefinitions)                           $Definition
	}
	if {$Cluster != "Not in Cluster" && $Operon != "Not in Operon"} {
	    lappend Tab(Cluster,$Cluster,Operon,$Operon,LesOrfsEnCommun)         $Orf
	    lappend Tab(Cluster,$Cluster,Operon,$Operon,LesDefinitionsEnCommun)  $Definition
	    incr    Tab(Cluster,$Cluster,Operon,$Operon,NbOrfsEnCommun)

	    lappend Tab(Operon,$Operon,Cluster,$Cluster,LesOrfsEnCommun)         $Orf
	    lappend Tab(Operon,$Operon,Cluster,$Cluster,LesDefinitionsEnCommun)  $Definition
	    incr    Tab(Operon,$Operon,Cluster,$Cluster,NbOrfsEnCommun)
	}
    }
    close $F
    set Tab(LesClusters) [lsort -integer [set Tab(LesClusters)]]
    set Tab(LesOperons)  [lsort -integer [set Tab(LesOperons) ]]

    return $aTab

}

proc ChargeOrthologueDans {} {

    global RepertoireDuGenome
    global OrthologueDans

    foreach O [LesOrganismesTresProches] {
	set OrthologueDans($O) Bidon
	if { ! [file exists "$RepertoireDuGenome/fiches/orthologuedans$O"]} { continue }
	foreach Ligne [LesLignesDuFichier "$RepertoireDuGenome/fiches/orthologuedans$O"] {
	    scan $Ligne "%s %s" Nom Rapport
	    if {[regexp "Mort" $Rapport]} {
		set OrthologueDans($O,$Nom) 0
	    } else {
		set OrthologueDans($O,$Nom) 1
	    }
	}
    }

}

proc ChargePathway {aTab Fichier} {

    upvar $aTab Tab
    if {![file exists $Fichier]} {return}
 
    set Pathway [file tail $Fichier]
    regsub {\..+$} $Pathway "" Pathway

    set OrgaC     [string range $Pathway 0 2  ]
    set Organisme [InterrogeGenomeKEGG OrgaCourt $OrgaC Organisme]
    set Pathway   [string range $Pathway 3 end]

    set LesDefs      [list [InterrogeKEGG Pathway $Pathway Definition]]
    if {$LesDefs == ""} {continue}

    set Tab($Fichier,Pathway)        $Pathway
    set Tab($Fichier,Definition)     $LesDefs
    set Tab($Fichier,Organisme)      $Organisme
    set Tab($Fichier,LesCoordonnees) {}
    set Tab($Fichier,LesPathway)     {}
    set Tab($Fichier,LesCompound)    {}
    set Tab($Fichier,LesKegg)        {}

    set F [open $Fichier]
    while {[gets $F Ligne]>=0} {
	set Ligne [string trim $Ligne]
	if {$Ligne == ""} {continue}
	set LaLigne   [split         $Ligne        "\t"]
	set LesCoords [split [lindex $LaLigne   0] " " ]
	set Lien             [lindex $LaLigne   1]
	set Forme            [lindex $LesCoords 0]
	set Coord1           [lindex $LesCoords 1]
	set Coord2           [lindex $LesCoords 2]

	if {[info exists XMin]} {unset XMin;unset YMin;unset XMax;unset YMax}
	if {[string equal -nocase $Forme "rect"]} {
	    regexp {([0-9]+),([0-9]+)} $Coord1 tmp XMin YMin
	    regexp {([0-9]+),([0-9]+)} $Coord2 tmp XMax YMax
	    set Forme "rectangle"
	} elseif {[string equal -nocase $Forme "circ"]} {
	    regexp {([0-9]+),([0-9]+)} $Coord1 tmp X Y
	    set XMin [expr $X - $Coord2]
	    set YMin [expr $Y - $Coord2]
	    set XMax [expr $X + $Coord2]
	    set YMax [expr $Y + $Coord2]
	    set Forme "oval"
	}
	set LesConcernes {}
	if {[regexp -nocase "/KEGG/pathway/" $Lien]} {
	    set OtherPathway [file tail $Lien]
	    regsub "\.html" $OtherPathway "" OtherPathway
	    
	    set Quoi         "Pathway"
	    set OrgaC        [string range $OtherPathway 0 2  ]
	    set Qui          [string range $OtherPathway 3 end]
	    set Couleur      "blue"      

	    set  LesDefs     [list [InterrogeKEGG Pathway $Qui Definition]]
	    if {$LesDefs     == ""} {continue}

	    lappend Tab($Fichier,LesPathway) [list $Quoi $Qui $OrgaC $LesDefs $XMin $YMin $XMax $YMax $Forme $Couleur] 
	    lappend LesConcernes             [list $Quoi $Qui $OrgaC $LesDefs $XMin $YMin $XMax $YMax $Forme $Couleur]
	} elseif {[regexp -nocase {compound\+(.+)} $Lien tmp Compounds]} {
	    foreach Compound [split [string trim $Compounds] "+"] {
		set Quoi     "Compound"
		set OrgaC    ""
		set Qui      $Compound
		set LesDefs  {}
		set Couleur  "pink"
		lappend Tab($Fichier,LesCompound) [list $Quoi $Qui $OrgaC $LesDefs $XMin $YMin $XMax $YMax $Forme $Couleur]
		lappend LesConcernes              [list $Quoi $Qui $OrgaC $LesDefs $XMin $YMin $XMax $YMax $Forme $Couleur]
	    }
	} elseif {[regexp {/dbget\-bin/www_bget\?([a-z]+)\+(.+)} $Lien tmp OrgaCourt References]} {
	    set LesKegg {}
	    set Quoi    "Kegg"
	    set Couleur "yellow"
	    foreach Ref [split [string trim $References] "+"] {
		if {$Ref == ""} {continue}
		if       {$OrgaCourt == "enzyme"} {
		    set Ref              [CorrigeLEC $Ref]
		    set LesDefs          [InterrogeECDuPathway Pathway $Pathway EC $Ref LesDefinitions]
		    lappend LesConcernes [list EC $Ref "" $LesDefs $XMin $YMin $XMax $YMax $Forme "yellow"]
		    set LesKeggDeLaRef [InterrogeKEGG Lien $Ref LesKegg]
		    foreach Kegg $LesKeggDeLaRef {lappend LesKegg $Kegg}
		} elseif {$OrgaCourt == "sptr" || $OrgaCourt == "spt" } {
		    foreach Req [Access2Requetes $Ref] {
			regsub         {^[a-z]+\:} $Req "" Req
			if {[regexp -nocase "^ec " $Req]} {
			    regsub  -nocase "^ec " $Req "" Req

			    set Req              [CorrigeLEC $Req]
			    set LesDefs          [InterrogeECDuPathway Pathway $Pathway EC $Req LesDefinitions]
			    lappend LesConcernes [list EC $Req "" $LesDefs $XMin $YMin $XMax $YMax $Forme "yellow"]
			}
			regsub -nocase "^go:"      $Req "" Req
			foreach Kegg [InterrogeKEGG Lien $Req LesKegg] {lappend LesKegg $Kegg}
		    }
		} elseif {$OrgaCourt == "gb"} {
		    set nCDS ""
		    regexp {\#cds([0-9]+)} $Ref tmp nCDS
		    regsub $tmp $Ref "" Ref

		    set LesProteines [LesProteinesDeLAcNuc $Ref ]
		    if {$nCDS != ""} {set LesProteines [list [lindex $LesProteines [expr $nCDS-1]]]}
		    foreach     Prot $LesProteines {
			foreach Req  [Access2Requetes      $Prot] {
			    regsub         {^[a-z]+\:} $Req "" Req

			    if {[regexp -nocase "^ec " $Req]} {
				regsub  -nocase "^ec " $Req "" Req
				set Req              [CorrigeLEC $Req]
				set LesDefs          [InterrogeECDuPathway Pathway $Pathway EC $Req LesDefinitions]
				lappend LesConcernes [list EC $Req "" $LesDefs $XMin $YMin $XMax $YMax $Forme "yellow"]
			    }

			    regsub -nocase "^go:"      $Req "" Req
			    foreach Kegg [InterrogeKEGG Lien $Req LesKegg] {lappend LesKegg $Kegg}
			}
		    }
		} else {
		    regexp {^([a-z]+):} $Ref tmp OrgaCourt
		    regsub $tmp         $Ref ""  Ref
		    set Organisme [InterrogeGenomeKEGG OrgaCourt $OrgaCourt Organisme]
		    foreach Kegg  [InterrogeKEGG Organisme $Organisme Enzyme $Ref LesKegg] {lappend LesKegg $Kegg}
		}
	    }
	    if {$LesKegg != {}} {
		foreach Qui [lsort -unique $LesKegg] {
		    set     LesDefs      [list [InterrogeKEGG Kegg $Qui Definition]]
		    lappend Tab($Fichier,LesKegg) [list $Quoi $Qui $OrgaC $LesDefs $XMin $YMin $XMax $YMax $Forme $Couleur]
		    lappend LesConcernes          [list $Quoi $Qui $OrgaC $LesDefs $XMin $YMin $XMax $YMax $Forme $Couleur]
		}
	    }
	} elseif {[regexp {/dbget\-bin/get_linkdb\?pathway\+(.+)} $Ligne tmp Pathways] ||  [regexp {/kegg\-bin/print_enz\?(.+)}            $Ligne tmp Pathways] } {
	    foreach OtherPathway [split [string trim $Pathways] "+"] {
		if {$OtherPathway == ""} {continue}
		set Quoi             "Pathway"
		set OrgaCourt        [string range $OtherPathway 0 2  ]
		set Qui              [string range $OtherPathway 3 end]
		
		set LesDefs      [list [InterrogeKEGG Pathway $Qui Definition]]
		if {$LesDefs == {}} {continue}
		
		set Couleur          "blue" 
		lappend Tab($Fichier,LesPathway) [list $Quoi $Qui $OrgaCourt $LesDefs $XMin $YMin $XMax $YMax $Forme $Couleur]
		lappend LesConcernes             [list $Quoi $Qui $OrgaCourt $LesDefs $XMin $YMin $XMax $YMax $Forme $Couleur]
	    }
	} elseif {[regexp {/dbget\-bin/hfind_www_sub\?htext\=EC\&keywords\=(.+)} $Ligne Tmp ECs]} {
	    set Quoi    "Kegg"
	    set Couleur "yellow"
	    set LesKegg {}

	    foreach EC [split [string trim $ECs] "+"] {
		if {$EC == ""} {continue}
		
		set EC               [CorrigeLEC $EC]
		set LesDefs          [InterrogeECDuPathway Pathway $Pathway EC $EC LesDefinitions]
		lappend LesConcernes [list EC $EC "" $LesDefs $XMin $YMin $XMax $YMax $Forme "yellow"]
		foreach Kegg [InterrogeKEGG Lien $EC LesKegg] {lappend LesKegg $Kegg}
	    }
	    if {$LesKegg != {}} {
		foreach Qui [lsort -unique $LesKegg] {
		    set     LesDefs      [list [InterrogeKEGG Kegg $Qui Definition]]
		    lappend Tab($Fichier,LesKegg) [list $Quoi $Qui $OrgaC $LesDefs $XMin $YMin $XMax $YMax $Forme $Couleur]
		    lappend LesConcernes          [list $Quoi $Qui $OrgaC $LesDefs $XMin $YMin $XMax $YMax $Forme $Couleur]
		}
	    }
	} else {
	    Espionne $Ligne
	    continue
	}
	if {$LesConcernes == {}} {continue}

	if {![info exists Tab($Fichier,Forme,$Forme,XMin,$XMin,YMin,$YMin,XMax,$XMax,YMax,$YMax,LesConcernes)]} {
	    lappend Tab($Fichier,LesCoordonnees) [list $Forme $XMin $YMin $XMax $YMax]
	    set Tab($Fichier,Forme,$Forme,XMin,$XMin,YMin,$YMin,XMax,$XMax,YMax,$YMax,LesConcernes) $LesConcernes
	} else {
	    set LesAutresConcernes [set Tab($Fichier,Forme,$Forme,XMin,$XMin,YMin,$YMin,XMax,$XMax,YMax,$YMax,LesConcernes)]
	    set Tab($Fichier,Forme,$Forme,XMin,$XMin,YMin,$YMin,XMax,$XMax,YMax,$YMax,LesConcernes) [concat $LesAutresConcernes $LesConcernes]
	}
    }
    close $F
    return $aTab

}

proc ChargePhylons {} {

    global RepertoireDuGenome
    global Phylons PhylonsOrgaEtDistance

    if { ! [file exists "$RepertoireDuGenome/fiches/distancesphylo"]} {
	set Phylons Bidon
	set PhylonsOrgaEtDistance Bidon
	return
    }

    foreach Ligne [LesLignesDuFichier "$RepertoireDuGenome/fiches/distancesphylo"] {
	set Liste [split $Ligne " "]
	set Nom [lindex $Liste 0]
	set ListeOrgaDistance [lrange $Liste 1 end]
	set ListeOrgas {} 
	foreach {Orga Distance Access} $ListeOrgaDistance {
	    lappend ListeOrgas $Orga
	}
	set Phylons($Nom) $ListeOrgas
	set PhylonsOrgaEtDistance($Nom) $ListeOrgaDistance
    }
    
    set FichierPhylosFolles "$RepertoireDuGenome/fiches/phylosfolles"
    if { ! [file exists $FichierPhylosFolles] &&  [OuiOuNon "Dois-je creer le fichier $FichierPhylosFolles ? "]} {
	foreach Nom [array names Phylons] {
	    lappend ListePhylons "$Nom [PhyloFolle $Nom]"
	}
	Espionne [SauveLesLignes $ListePhylons dans $FichierPhylosFolles]
    }

}

proc ChargePresencesDeTousLesClusters {aTab {Fichier {}}} {

 upvar $aTab Tab
    if {$Fichier == ""} {
	global RepertoireDuGenome
	set Fichier "RepertoireDuGenome/fiches/presences_tous_clusters"
    }
    if {![file exists $Fichier]} {return "File does not exists, please create it"}
    
    set F [open $Fichier]
    while {[gets $F Ligne] >=0} {
	if {[string first ">" $Ligne] == 0} {
	    set LesCategories [lrange [split $Ligne "\t"] 1 end]
	    continue
	}
	set LaLigne           [split $Ligne "\t"]
	set Cluster           [lindex $LaLigne 0]

	if {![info exists TabTmp(Cluster,$Cluster)]} {
	    set TabTmp(Cluster,$Cluster) 1
	    set i 0
	    foreach Presence  [lrange $LaLigne 1 end] {
		set Categorie [lindex $LesCategories $i]
		set Tab(Cluster,$Cluster,Categorie,$Categorie,Presence) $Presence
		incr i
	    }
	    set Tab(Cluster,$Cluster,LesPresences) [lrange $LaLigne 1 end]
	}
    }
    if {[info exists TabTmp]} {unset TabTmp}
    close $F

    return $aTab

}

proc ChargeProtAndmRNA {aTab File} {

    upvar $aTab Tab

    set LesRangs {}
    if {![file exists $File]} {return}
    set F [open $File]
    while {[gets $F Ligne]>=0} {
	if {$Ligne == ""} {continue}
	if {[info exists Quoi]} {unset Quoi}

	set LaLigne [split $Ligne ":"]
	set Quoi  [lindex $LaLigne 0]
	set LeReste {}
	foreach Element [split [join [lrange $LaLigne 1 end] ":"] " "] {
	    if {$Element != ""} {lappend LeReste $Element}
	}
	if {[string equal -nocase $Quoi "Box"      ]} {
	    set Nom                                                          [join $LeReste " "]
	    continue
	}
	if {[string equal -nocase $Quoi "LengthBox"]} {
	    set Tab($Nom,Taille)                                         [join $LeReste " "]
	    continue
	}
	if {[string equal -nocase $Quoi "Masking"]} {
	    set Tab($Nom,Masking)                                        [join $LeReste " "]
	    continue
	}
	if {[string equal -nocase $Quoi "ReMasking"]} {
	    set Tab($Nom,ReMasking)                                      [join $LeReste " "]
	    continue
	}
	if {[string equal -nocase $Quoi "MRM"]} {
	    set Tab($Nom,MRM)                                            [join $LeReste " "]
	    continue
	}
	if {[string equal -nocase $Quoi "Rank"]} {
	    set     Rang                                                 [join $LeReste " "]
	    lappend LesRangs                                             $Rang
	    continue
	}
	if {[string equal -nocase $Quoi "Type"]} {
	    set Type                                                     [join $LeReste " "]
	    set Tab($Nom,Rang,$Rang,Type)                                $Type

	    set Tab($Nom,Rang,$Rang,LesmRNAs)                            {}
	    set Tab($Nom,Rang,$Rang,LesProteines)                        {}

	    continue
	}
	if {[string equal -nocase $Quoi "BanqueId_Access"]} {
	    set Access   [lindex $LeReste 1]
	    set Tab($Nom,Rang,$Rang,BanqueId)                            [lindex $LeReste 0]
	    set Tab($Nom,Rang,$Rang,Access)                              $Access

	    if {![info exists  Tab($Nom,Access,$Access,LesRangs)]} {
		set Tab($Nom,Access,$Access,LesRangs) {}
	    }
	    lappend Tab($Nom,Access,$Access,LesRangs)                    $Rang

	    if {$Type == "mRNA"   } {lappend Tab($Nom,Rang,$Rang,LesmRNAs)     $Access}
	    if {$Type == "PROTEIN"} {lappend Tab($Nom,Rang,$Rang,LesProteines) $Access}

	    continue
	}
	if {[string equal -nocase $Quoi "EquivalentAccess"]} {	    
	    set Tab($Nom,Rang,$Rang,LesAccessEquivalents)                $LeReste
	    foreach AutreAccess $LeReste {
		if {![info exists  Tab($Nom,Access,$AutreAccess,LesRangs)]} {
		    set Tab($Nom,Access,$AutreAccess,LesRangs) {}
		}
		lappend Tab($Nom,Access,$AutreAccess,LesRangs)           $Rang

		if {[string equal -nocase $Type "mRNA"]} {
		    lappend Tab($Nom,Rang,$Rang,LesmRNAs)                $AutreAccess
		} 
		if {[string equal -nocase $Type "PROTEIN"]} {
		    lappend Tab($Nom,Rang,$Rang,LesProteines)            $AutreAccess
		}
	    }
	    continue
	}
	if {[string equal -nocase $Quoi "AbsentAccess"]} {
	    set Tab($Nom,Rang,$Rang,LesAccessAbsentsDuBlast)             $LeReste
	    continue
	}
	if {[string equal -nocase $Quoi "Definition"]} {
	    set Tab($Nom,Rang,$Rang,Definition)                          [join $LeReste " "]
	    continue
	}
	if {[string equal -nocase $Quoi "Organism"]} {
	    set Tab($Nom,Rang,$Rang,Organism)                            [join $LeReste " "]
	    continue
	}

	if {[string equal -nocase $Quoi "Length"]} {
	    set Tab($Nom,Rang,$Rang,Taille)                              [join $LeReste " "]
	    continue
	}
	if {[string equal -nocase $Quoi "PROTEIN"]} {
	    set Tab($Nom,Rang,$Rang,LesProteines)                        $LeReste
	    
	    foreach Prot $LeReste {
		if {![info exists Tab($Nom,Access,$Prot,LesRangs)]} {
		    set Tab($Nom,Access,$Prot,LesRangs) {}
		}
		lappend Tab($Nom,Access,$Prot,LesRangs) $Rang
	    }
	    continue
	}
	if {[string equal -nocase $Quoi "AbsentPROTEIN"]} {
	    set Tab($Nom,Rang,$Rang,LesProteinesAbsentesDuBlast)         $LeReste
	    continue
	}
	if {[string equal -nocase $Quoi "mRNA"]} {
	    set Tab($Nom,Rang,$Rang,LesmRNAs)                            $LeReste
	    foreach mRNA $LeReste {
		if {![info exists Tab($Nom,Access,$mRNA,LesRangs)]} {
		    set Tab($Nom,Access,$mRNA,LesRangs) {}
		}
		lappend Tab($Nom,Access,$mRNA,LesRangs) $Rang
	    }
	    continue
	}
	if {[string equal -nocase $Quoi "AbsentmRNA"]} {
	    set Tab($Nom,Rang,$Rang,LesmRNAsAbsentesDuBlast)             $LeReste
	    continue
	}
	if {[string equal -nocase $Quoi "NTot"]} {
	    set Tab($Nom,Rang,$Rang,NbElementsDeLaQuery,DansLAlignement) [join $LeReste " "]
	    continue
	}
	if {[string equal -nocase $Quoi "NTot_5UTR_CDS_3UTR"]} {
	    set Tab($Nom,Rang,$Rang,NbElementsDeLaQuery,DansLAlignement) [lindex $LeReste 0]
	    set Tab($Nom,Rang,$Rang,NbElementsDeLaQuery,DansLe5UTR)      [lindex $LeReste 1]
	    set Tab($Nom,Rang,$Rang,NbElementsDeLaQuery,DansLeCDS)       [lindex $LeReste 2]
	    set Tab($Nom,Rang,$Rang,NbElementsDeLaQuery,DansLe3UTR)      [lindex $LeReste 3]
	    continue
	}
	if {[string equal -nocase $Quoi "Expect_Score_Id"]} {
	    set Tab($Nom,Rang,$Rang,Expect)                              [lindex $LeReste 0]
	    set Tab($Nom,Rang,$Rang,Score)                               [lindex $LeReste 1]
	    set Tab($Nom,Rang,$Rang,Id)                                  [lindex $LeReste 2]
	    continue
	}
	if {[string equal -nocase $Quoi "WARNING"]} {
	    if {![info exists Tab($Nom,Rang,$Rang,LesWarning)]} {set Tab($Nom,Rang,$Rang,LesWarning) {}}
	    lappend Tab($Nom,Rang,$Rang,LesWarning)                      [join $LeReste " "]
	    continue
	}
    }
    set Tab($Nom,LesRangs) $LesRangs

    close $F
    return $aTab

}

