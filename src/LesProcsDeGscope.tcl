    label  $L2CheckQuery -background "#808FFF" -relief "groove" -width  "3" -text    "Database Validation" -anchor "center"
    radiobutton $RB1CheckQuery -relief "groove" -anchor "w" -variable CheckQueryVar -text "Yes" -value "1" -command {
	LesParametresDuDesign QueryCheck $CheckQueryVar "Positionne"	     
	AjouteAuLog "Query: database validation"				     
    }									     
    radiobutton $RB2CheckQuery -relief "groove" -anchor "w" -variable CheckQueryVar -text "No"  -value "0" -command {
	LesParametresDuDesign QueryCheck $CheckQueryVar "Positionne"		     
	AjouteAuLog "Query: no database validation"				     
    }									     
    set_balloon $L1CheckQuery  "Additional query parameters"
    set_balloon $L2CheckQuery  "Perform or not sequence validation with % ID and % cover of your query in database."
    set_balloon $RB1CheckQuery "Yes for query validation in database."
    set_balloon $RB2CheckQuery "No for no query validation in database."

