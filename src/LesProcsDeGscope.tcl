proc NouvelleGrille {} {

    global Defs

    set url "http://www.sport4tune.com/lotofoot_grille.php"
    set res [::http::data [::http::geturl $url]]
    dom parse -html $res doc
    set RId [$doc documentElement root]

    set Ltitre [list]
    set Ldate [list]
    set Lh4 [$RId selectNodes "//h4"]
    foreach h $Lh4 {
	if {[$h hasAttribute class] && [$h getAttribute class] eq "titre-liste-loto"} {
	    set titre [$h selectNodes string(.)]
	    if {[regexp {Les 10 derniers} $titre]} {continue}
	    lappend Ltitre $titre
	}
    }
    set Lp [$RId selectNodes "//p"]
    foreach p $Lp {
	if {[$p hasAttribute class] && [$p getAttribute class] eq "date-loto"} {
	    lappend Ldate [$p selectNodes string(.)]
	}
    }

    set Lul [$RId selectNodes "//ul"]
    foreach u $Lul {
	if {[$u hasAttribute class] && [regexp {liste-lotofoot} [$u getAttribute class]]} { 
	    set Ldiv [$u selectNodes .//div]
	    set Lmtmp [list]
	    set eq1 [list] ; set eq2 [list]
	    foreach d $Ldiv {
		if {[$d hasAttribute class]} {
		    set v [$d getAttribute class]
		    if {$v eq "equipe_A right"} {
			set e1 [$d selectNodes string(.)]
			lappend eq1 [NettoieNom $e1]
		    }
		    if {$v eq "equipe_B left"} {
			set e2 [$d selectNodes string(.)]
			lappend eq2 [NettoieNom $e2]
		    }
		}
	    }
	    foreach e1 $eq1 e2 $eq2 {
		lappend Lmtmp [list $e1 $e2]
	    }
	    lappend Lmatch $Lmtmp
	}
    }

    set Bon [list]
    foreach t $Ltitre d $Ldate Lm $Lmatch {
	if {$Defs(Jeu) != [llength $Lm]} {continue}

	set Llg [list]
	set Ltyp [TraiteTypeNG $t]
	foreach e $Ltyp {
	    lassign $e typ no
	    if {$typ eq "$Defs(Jeu)"} {break}
	}
	set Ldat [TraiteTypeNG $d]
	foreach e $Ldat {
	    lassign $e typ date
	    if {$typ eq "$Defs(Jeu)"} {break}
	}
	puts "[TraiteTypeNG $t]"
	puts "[TraiteDateNG $d]"
	foreach m $Lm {
	    lassign $m e1 e2
	    set lg1 [LigueDeEqp $e1]
	    set lg2 [LigueDeEqp $e2]
	    lappend Llg $lg1 $lg2
	    puts "    $e1 (${lg1}) - $e2 (${lg2})"
	}
	puts ""
	if {$Defs(LigueRef) in $Llg} {
	    lappend Bon $Lm
	}
    }
    
    return [list $no $date $Bon]

}

proc Nuance {Amour {UnPeu {}} {Passion {}} {Format {}} {Saturation {}} {Brightness {}}} {

    #biotcl shade {}
    #rR réécrit 2014/11/17
    #rR Amour va de 0 à 1 et de ca fait correspondra à Hue de UnPeu à Passion
    if {$Saturation==""} { set Saturation 1.  }
    if {$Brightness==""} { set Brightness 1.  }
    if {$UnPeu     ==""} { set UnPeu      0.1 }
    if {$Passion   ==""} { set Passion    0.6 }
    if {$Format    ==""} { set Format  "hexa" }

    if {$UnPeu<=$Passion} {
	set Hue [expr {$UnPeu + ($Passion-$UnPeu)*$Amour}]
    } else {
	set Hue [expr {$UnPeu - ($UnPeu-$Passion)*$Amour}]
    }

    set rgb [hsbToRgb $Hue $Saturation $Brightness]
    return [CouleurFormat $rgb $Format]

}

