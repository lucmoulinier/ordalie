proc NumeroDuChromosome Chromosome {

    set Numero $Chromosome
    regexp -nocase {([0-9]{1})$} $Chromosome tmp Numero
    regexp -nocase {([0-9]{2})$} $Chromosome tmp Numero
    regexp -nocase {([XY]{1})$}  $Chromosome tmp Numero
    regexp -nocase {(un)$}       $Chromosome tmp Numero
    regsub         "^0"          $Numero     "" Numero
    return $Numero

}

