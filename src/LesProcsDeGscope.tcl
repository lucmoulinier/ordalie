proc ::NSPopulateAssemblyDbGui::fetchLibsAndBatchs {} {

	variable libraryPk ""
	variable batchPk ""
	variable batchsInLib {}
	variable libraries
	variable batchs

	#canalSqlAssemblyDb
	NSAssemblyDb::getCanal
	set sql "SELECT pk_library, name FROM library ORDER BY name"
	set libList [SqlExec $sql GetList]
	set sql "SELECT pk_assembly, pk_library, name, date, gscope_project_directory, archived, date_part('epoch', date) AS ts FROM assembly ORDER BY name ASC, date DESC"
	set batchList [SqlExec $sql GetList]
	CanalSqlDisconnect

	array set libraries {index {}}
	foreach {pk name} $libList {
	    set libraries($name,pk) $pk
	    set libraries($name,name) $name
	    lappend libraries(index) $name
	}
	#set libraries(index) [lsort $libraries(index)]

	array set batchs {index {}}
	foreach {pk pklib name date gDir archiv ts} $batchList {
	    set idx "$name ($date)"
	    set batchs($idx,pk) $pk
	    set batchs($idx,pkLibrary) $pklib
	    set batchs($idx,name) $name
	    set batchs($idx,date) $date
	    set batchs($idx,gscopeDirectory) $gDir
	    if {$archiv eq "t"} {set batchs($idx,archived) 1} else {set batchs($idx,archived) 0}
	    set batchs($idx,timestamp) $ts
	    lappend batchs(index) $idx
	}

	clearParameters
    
}

proc ::NSPopulateAssemblyDbGui::initNS {} {

	clearParameters
	fetchLibsAndBatchs
    
}

proc ::NSPopulateAssemblyDbGui::newBatch {batchNameEntry gscopeDirEntry gscopeDirBrowse} {

	clearParameters
	
	$batchNameEntry configure -state normal
	$gscopeDirEntry configure -state normal
	$gscopeDirBrowse configure -state normal
    
}

proc ::NSPopulateAssemblyDbGui::populate {} {

	variable libraryPk
	variable libraries

	variable batchName
	variable gscopeProjectDir
	variable cap3params
	variable seqFile
	variable qualFile
	variable aceFile
	variable singletsFile

	foreach lib $libraries(index) {
	    if {$libraries($lib,pk) == $libraryPk} {
		set libName $libraries($lib,name)
		break
	    }
	}
	
	PopulateAssemblyDb $libName $batchName $cap3params $gscopeProjectDir $seqFile $qualFile $aceFile $singletsFile
	fetchLibsAndBatchs
    
}

