	set Tableau(BiaisEnSequencesPlus,Couleur)    "royalblue"
	set Tableau(BiaisEnSequencesPlus,Unit)       ""
	lappend LesVariablesProposees            "Skew in sequences Minus"
	set Tableau(Skew_in_sequences_Minus)           "BiaisEnSequencesMinus"
	set Tableau(BiaisEnSequencesMinus,Couleur)    "tomato2"
	set Tableau(BiaisEnSequencesMinus,Unit)       ""
	lappend LesVariablesProposees            "Skew in sequences NoInf"
