proc ChargeProteinesJumelles {FichierProteinesJumelles aTab} {

    upvar $aTab Tab
    if {![file exists $FichierProteinesJumelles]} {return}
    set F [open $FichierProteinesJumelles]
    set Tab($FichierProteinesJumelles,LesNoms) {}

    while {[gets $F Ligne]>=0} {
	if {$Ligne == ""} {continue}

	set LesJumeaux [lsort -unique [split $Ligne "\t"]]

	foreach Nom $LesJumeaux {
	    lappend Tab(LesNoms) $Nom
	    if {![info exists Tab($FichierProteinesJumelles,$Nom,LesProteinesJumelles)]} {
		set Tab($FichierProteinesJumelles,$Nom,LesProteinesJumelles) {}
	    }
	    foreach NomJum $LesJumeaux {
		if {$Nom == $NomJum} {continue}
		lappend Tab($FichierProteinesJumelles,$Nom,LesProteinesJumelles) $NomJum
	    }
	}
    }
    close $F
    return $aTab

}

proc ChargeTaxIJNC {} {

    global TaxI
    global TaxJ
    global TaxN
    global TaxC

    set TaxI("EstCharge") 1
    set TaxJ("EstCharge") 1
    set TaxN("EstCharge") 1
    set TaxC("EstCharge") 1

    set FichierSwiss "/prot/gcgswissprot/swissprot.ref"
#    set FichierSwiss "[HomeRipp]/sw.ref"

    set FichierTaxI "[GscopeDatabaseDir Common]/fiches/taxi"
    set FichierTaxJ "[GscopeDatabaseDir Common]/fiches/taxj"
    set FichierTaxN "[GscopeDatabaseDir Common]/fiches/taxn"
    set FichierTaxC "[GscopeDatabaseDir Common]/fiches/taxc"
    set ErrorLogI   "[GscopeDatabaseDir Common]/fiches/error_taxi.log"
    set ErrorLogN   "[GscopeDatabaseDir Common]/fiches/error_taxn.log"
    set ErrorLogC   "[GscopeDatabaseDir Common]/fiches/error_taxc.log"

    if {[file exists $FichierTaxI]} {
	if {[file exists $FichierTaxI]} { array set TaxI [LesLignesDuFichier $FichierTaxI] }
	if {[file exists $FichierTaxJ]} { array set TaxJ [LesLignesDuFichier $FichierTaxJ] }
	if {[file exists $FichierTaxN]} { array set TaxN [LesLignesDuFichier $FichierTaxN] }
	if {[file exists $FichierTaxC]} { array set TaxC [LesLignesDuFichier $FichierTaxC] }
	return
    }

    catch {unset OS}
    catch {unset OX}
    catch {unset OC}
    catch {unset LOS}
    catch {unset LOX}
    catch {unset LesOS}
    catch {unset LesOX}
    set OX ""
    set OldAccess ""
    set n 9999
    set FS [open $FichierSwiss "r"]
    while {[gets $FS Ligne]>=0} {
	if {[regexp "^>" $Ligne]} {
	    if { [expr $n%100==0] } { Espionne $n }
	    if { ! [incr n -1] } { break }
	    if {[info exists DejaVu($OX)] || ! [regexp -nocase "NCBI_TaxID=" $OX]} { continue }
	    set LesS [LesChampsIndividuels $OS]
	    regsub -nocase "NCBI_TaxID=" $OX "" OX
	    set LesX [LesChampsIndividuels $OX] 
	    if {[llength $LesS]!=[llength $LesX]} {
		FaireLire "Different list length\n $OS\n$OX"
		catch {unset OS}
		catch {unset OX}
		catch {unset OC}
		catch {unset LOS}
		catch {unset LOX}
		catch {unset LOC}
		catch {unset LesOS}
		catch {unset LesOX}
		regsub {>+} $Ligne "" OldAccess
		continue
	    }
	    if {[llength $LesS]==1} {
		foreach S $LesS X $LesX {
		    if { ! [info exists TaxN($X)]} { set TaxN($X) $S }
		    if { ! [info exists TaxI($S)]} { set TaxI($S) $X }
		    if {$S!=[set TaxN($X)]} {
			AppendAuFichier $ErrorLogI  "\nI saw already \n[set TaxN($X)]\n instead of\n$S\n$OldAccess for $X" 
			break 
		    }
		    if {$X!=[set TaxI($S)]} {
			AppendAuFichier $ErrorLogN  "\nI saw already \n[set TaxI($S)]\n instead of\n$X\n$OldAccess for $X" 
			break
		    }
		    set TN $S
		    while {[set TN [CondenseTaxName $TN]]!=""} {
			set TaxJ($TN) $X
		    }
		}
		if {[info exists OC]} {
		    set X [lindex $LesX 0]
		    set Class $OC
		    if {[info exists TaxC($X)] && [set TaxC($X)]!=$Class} {
			AppendAuFichier $ErrorLogC  "\nI saw already \n[set TaxC($X)]\n instead of\n[set TaxC($X)] \n$\n$OldAccess for $X"
			break
		    }
		    set TaxC($X) $Class
		    set S [lindex $LesS 0]
		    if {[info exists TaxC($S)] && [set TaxC($S)]!=$Class} {
			AppendAuFichier $ErrorLogClass  "\nI saw already \n[set TaxC($S)]\n instead of\n[set TaxC($S)] \n$\n$OldAccess for $S"
			break
		    }
		    set TaxC($S) $Class
		}
	    }
	    set DejaVu($OX) 1
	    catch {unset OS}
	    catch {unset OX}
	    catch {unset OC}
	    catch {unset LOS}
	    catch {unset LOX}
	    catch {unset LOC}
	    catch {unset LesOS}
	    catch {unset LesOX}
	    regsub {>+} $Ligne "" OldAccess
	    continue
	}
	if {[regexp "^OS " $Ligne]} {
	    if { ! [info exists LOS]} { set LOS {} }
	    regsub {^OS +} $Ligne "" O
	    lappend LOS $O
	    if {[regexp {\.$} $Ligne]} {
		set OS [join $LOS " "]
	    }
	}
	if {[regexp "^OC " $Ligne]} {
	    if { ! [info exists LOC]} { set LOC {} }
	    regsub {^OC +} $Ligne "" O
	    lappend LOC $O
	    if {[regexp {\.$} $Ligne]} {
		set OC [join $LOC " "]
	    }
	}
	if {[regexp "^OX " $Ligne]} {
	    if { ! [info exists LOX]} { set LOX {} }
	    regsub {^OX +} $Ligne "" O
	    lappend LOX $O
	    if {[regexp {\;$} $Ligne]} {
		set OX [join $LOX " "]
	    }
	}
    }
    close $FS
    SauveLesLignes [array get TaxI] dans $FichierTaxI
    SauveLesLignes [array get TaxJ] dans $FichierTaxJ
    SauveLesLignes [array get TaxN] dans $FichierTaxN
    SauveLesLignes [array get TaxC] dans $FichierTaxC
    return

}

proc ChargeTissueType {aTab FichierTissueType} {

    upvar $aTab Tab
    set Tab(LesTissues) {}

    if {![file exists $FichierTissueType]} {return}

    set Tab(LesNoms) {}
    set F [open $FichierTissueType]
    while {[gets $F Ligne]>=0} { 
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne "\t"]
	set Nom     [lindex $LaLigne 0]
	set Acc     [lindex $LaLigne 1]
	if {$Acc == "NoESTFound"} {continue}

	set Tissue  [string tolower [lindex $LaLigne 3]]

	if {![info exists Tab($Nom,LesTissues)]} {
	    lappend Tab(LesNoms)                  $Nom
	    set Tab($Nom,LesTissues)              {}
	    set Tab($Nom,LesEST)                  {}
	}
	if {![info exists Tab(EST,$Acc,LesTissues)]} {
	    set Tab(EST,$Acc,LesTissues)          {}
	    set Tab(EST,$Acc,LesNoms)             {}
	}
	if {![info exists Tab(Tissue,$Tissue,LesNoms)]} {
	    set     Tab(Tissue,$Tissue,LesNoms)   {}
	    set     Tab(Tissue,$Tissue,LesEST)    {}
	    set     Tab(Tissue,$Tissue,n)         0
	    lappend Tab(LesTissues)               $Tissue
	}
	incr Tab(Tissue,$Tissue,n)

	if {![info exists Tab($Nom,Tissue,$Tissue,n)]} {
	    set Tab($Nom,Tissue,$Tissue,n)      0
	    set Tab($Nom,Tissue,$Tissue,LesEST) {}
	    lappend Tab($Nom,LesTissues)        $Tissue
	    lappend Tab(Tissue,$Tissue,LesNoms) $Nom
	}
	incr Tab($Nom,Tissue,$Tissue,n)

	if {![info exists Tab($Nom,Tissue,$Tissue,EST,$Acc,n)]} {
	    set     Tab($Nom,Tissue,$Tissue,EST,$Acc,n) 0
	    lappend Tab($Nom,Tissue,$Tissue,LesEST)     $Acc
	}
	incr Tab($Nom,Tissue,$Tissue,EST,$Acc,n)

	if {![info exists Tab(EST,$Acc,Tissue,$Tissue,n)]} {
	    set Tab(EST,$Acc,Tissue,$Tissue,n)  0
	    lappend Tab(EST,$Acc,LesTissues)    $Tissue
	    lappend Tab(Tissue,$Tissue,LesEST)  $Acc
	}
	incr Tab(EST,$Acc,Tissue,$Tissue,n)
    }
    close $F
    return $aTab

}

proc ChargeTmCount {{PAB {}}} {

    
    Wup "Calcul le Tm pour les regions de PAB et comptabilise le nombre de fois qu il est rencontre"
    Wup "Stock les resultats dans TabDesTms"
    Wup "Utilisable pour un PAB ou une sequence"

    global TabDesTms
    
    if {$PAB==""} {return ""}
      
    #Attention il faut une query, sinon pas de taille ....
    set RepmRNA   "[RepertoireDuGenome]/mrnatfa_Homo_sapiens"
    set Repnuctfa "[RepertoireDuGenome]/nuctfa"

    set FichierQuery $PAB
    if {[regexp {/} $PAB]} {set PAB [file tail $PAB]}
    if {[file exists $FichierQuery]} {
	set FichierQuery $FichierQuery
    } elseif { [file exists "$RepmRNA/$PAB"]} {
	set FichierQuery    "$RepmRNA/$PAB"
    } elseif  {[file exists "$Repnuctfa/$PAB"]} {
	set FichierQuery    "$Repnuctfa/$PAB"
    } else {
	set  LaSeq      $PAB
	if {         $LaSeq ==""}   {Espionne "$FichierQuery no sequence available";return ""}
	if {[IsItDNA $LaSeq]=="-1"} {Espionne "$LaSeq is not a valid DNA sequence";return ""}
	set TailleQuery [string length $LaSeq]
    }
    
    if {! [info exists LaSeq]} {
	set  LaSeq      [QueLaSequenceDuFichierTFA $FichierQuery]
	if {$LaSeq==""} {Espionne "$FichierQuery no sequence available";return ""}
	set TailleQuery [string length $LaSeq]
    }
    set  LaSeq [split $LaSeq ""]

    if {! [info exists TabDesTms(TmMin)]}     {set TabDesTms(TmMin)  99999.9}
    if {! [info exists TabDesTms(TmMax)]}     {set TabDesTms(TmMax)      0.0}
    if {! [info exists TabDesTms(TmMoyenne)]} {set TabDesTms(TmMoyenne)  0.0} 
    if {! [info exists TabDesTms(TmTotal)]}   {set TabDesTms(TmTotal)    0.0} 
    if {! [info exists TabDesTms(NbTm)]}      {set TabDesTms(NbTm)         0} 
    if {! [info exists TabDesTms(NbSeq)]}     {set TabDesTms(NbSeq)        0} 
    
    incr TabDesTms(NbSeq)

    set nbTm         0
    set TmTotal    0.0
    set DebutSeq     1

    set  LengthOligo [LesParametresDuDesign LengthOligo "LaValeurMerci"]
    if {$LengthOligo==""} {set LengthOligo 60}

    set  Methode     [LesParametresDuDesign TmMethod "LaValeurMerci"]
    if {$Methode    ==""} {set Methode "NearestNeighbor"}

    set  Pas         [LesParametresDuDesign Step "LaValeurMerci"]
    if {$Pas        ==""} {set Pas 10}
 
    set Fin         $LengthOligo

    #Calcul des Tms sur une sliding window de taille LengthOligo et de pas j
    for {set Debut $DebutSeq} {$Fin <= $TailleQuery} {incr Debut $Pas} {
	set Fin [expr $Debut + $LengthOligo - 1] 
	if {![expr $Fin <= $TailleQuery]}          {break}
		
	set Seq [join [lrange $LaSeq [expr $Debut - 1] [expr $Fin - 1]] ""]
	if {[string length $Seq]<$LengthOligo}     {continue}

	set Tm [format "%.1f" [CalculTmDeLaSeq $Seq "" "" "$Methode"]]
	if {$Tm=="-1"} {continue} elseif {$Tm==""} {return ""}	

	if {! [info exists TabDesTms($Tm)]} {
	    set  TabDesTms($Tm) 1
	} else {
	    incr TabDesTms($Tm)
	}
	incr nbTm
	set TmTotal [expr $TmTotal + $Tm]

	if {$Tm > [set TabDesTms(TmMax)]} {set TabDesTms(TmMax) $Tm}
	if {$Tm < [set TabDesTms(TmMin)]} {set TabDesTms(TmMin) $Tm}
    }
    
    #Pour la moyenne des Tms
    if {[set TabDesTms(TmTotal)]!="0.0"} {
	set  TabDesTms(TmTotal) [expr [set TabDesTms(TmTotal)] + $TmTotal]
    } else {
	set  TabDesTms(TmTotal) $TmTotal
    } 
    if {[set TabDesTms(NbTm)]!="0"} {
	set  TabDesTms(NbTm) [expr [set TabDesTms(NbTm)] + $nbTm]
    } else {
	set  TabDesTms(NbTm) $nbTm
    } 

    if {0} {
	#Moyenne des Tms
	Espionne "On est qd meme passe pas Tmmoyenne"
	set Moyennetmp [format "%.1f" [expr ($TmTotal*1.0)/$nbTm]]
	if {[set TabDesTms(TmMoyenne)]!="0.0"} {
	    set  TabDesTms(TmMoyenne) [format "%.1f" [expr (([set TabDesTms(TmMoyenne)] + $Moyennetmp)*1.0)/2.0] ]
	} else {
	    set  TabDesTms(TmMoyenne) $Moyennetmp
	}
	
	#Espionne "$PAB -- Moyen $Moyennetmp Nb $nbTm [set TabDesTms(NbTm)] Total $TmTotal [set TabDesTms(TmTotal)]"
    }
    return ""

}

proc CheckCompletion {Qui {Quoi {}}} {

    global CheckCompletion

    if {$Quoi=="Signification"} { return $CheckCompletion($Qui) }
    if {$Quoi=="Color"} {
	set CC [CheckCompletion $Qui]
	set OK [CheckCompletion StatOk]
	if {$CC==$OK} {
	    set CheckCompletion(green) "CheckCompletion Ok"
	    return "green"
	} else {
	    set CheckCompletion(red) "CheckCompletion no copplete"
	    return "red"
	}   
    }

    if {[info exists CheckCompletion($Qui)]} { return $CheckCompletion($Qui) }
    if {[info exists CheckCompletion("EstCharge")]} { return $CheckCompletion("EstCharge") }

    set LesReps [list  prottfa  blastp  daedalushits  msf  msfLeon  macsimXml  ]
    foreach Nom [ListeDesPABs] {
	set N 1
	set Status 0
	set StatOk 0
	foreach Rep $LesReps {
	    set Fichier "[RepertoireDuGenome]/$Rep/$Nom"
	    if {[file exists $Fichier]} { incr Status $N }
	    incr StatOk $N
	    set CheckCompletion($StatOk) $Rep
	    set CheckCompletion($Rep) $StatOk
	    set N [expr $N*2]
	}
	set CheckCompletion(StatOk) $StatOk
	set CheckCompletion($Nom) $Status
    }
    set CheckCompletion("EstCharge") -1
    return [CheckCompletion $Qui]

}

proc CheckForBestHitInDatabase {PAB Rep} {

    Wup "Permet de verifier si la query a un access dans le blast et de le rendre"
    Wup "Utilise InterrogeBestHitInDatabase qui va faire le calcul"
    Wup "Utiliser dans GUI ou voir aussi ReturnBestHitInDatabase"

    if {$PAB =="" || $Rep==""} {return ""}

    set FichierBlast "$Rep/${PAB}.blastn"
    
    if {![file exists $FichierBlast]} {Espionne "$FichierBlast do not exists";return ""}

    set Texte             ""
    set TailleQuery       [AskBlast                   $FichierBlast  Taille]
    set NbSubject         [AskBlast                   $FichierBlast  NbSubject]
    set AccessDeRef       [InterrogeBestHitInDatabase $FichierBlast  AccessDeRef]
    set BId               [InterrogeBestHitInDatabase $FichierBlast  BId]
    set LesBIdsBases      [InterrogeBestHitInDatabase $FichierBlast  LesBIdsBases]
    set InitialBId        [InterrogeBestHitInDatabase $FichierBlast  InitialBId]
    set InitialBIdAligned [InterrogeBestHitInDatabase $FichierBlast $InitialBId Aligned]

    #Test de la presence de la Query dans le blast
    ##############################################
    if {$NbSubject>0} {
	lappend Texte "Checking for $PAB with $TailleQuery nt(s)."
	if {$LesBIdsBases==""} {
	    lappend Texte "Seems not to have any equivalent in database."
	    lappend Texte "Be Careful with Design."
	} else {
 	    set BId           [InterrogeBestHitInDatabase $FichierBlast BId]
	    set PIdentity     0.95
	    set PRecouvrement 0.70
	    
	    lappend Texte "Best Id choosen : $InitialBId with $InitialBIdAligned nt(s) aligned."
	    
	    #Pourcentage d identite global: Aligne sur Total dans les alignements 
	    set IdGlobal      [InterrogeBestHitInDatabase $FichierBlast IdGlobal]
	    #Recouvrement de Q sur S ou inversement
	    #PCoverQuery   Query   par rapport au Subject
	    #PCoverSubject Subject par rapport au Query
	    set PCoverQuery   [InterrogeBestHitInDatabase $FichierBlast PCoverQuery]
	    set PCoverSubject [InterrogeBestHitInDatabase $FichierBlast PCoverSubject]
	    
	    if {$IdGlobal <= $PIdentity || $PCoverQuery<$PRecouvrement || $PCoverSubject<$PRecouvrement} {
		if {($PCoverQuery <= 0.2 || $PCoverSubject <= 0.2) || $IdGlobal <= 0.90} {
		    #On met tout de meme a zero car trop limite
		    lappend Texte "Is not equivalent to our query (\%Id [format "%.2f" $IdGlobal], Cover Q/S [format "%.2f" $PCoverQuery], Cover S/Q [format "%.2f" $PCoverSubject])."
		} else {
		    lappend Texte "Is weakly similar to our query (\%Id [format "%.2f" $IdGlobal], Cover Q/S [format "%.2f" $PCoverQuery], Cover S/Q [format "%.2f" $PCoverSubject])."
		}
		lappend Texte "Be Careful with this design."
	    } else {
		lappend Texte "Seems to be equivalent (\%Id [format "%.2f" $IdGlobal], Cover Q/S [format "%.2f" $PCoverQuery], Cover S/Q [format "%.2f" $PCoverSubject])."
		lappend Texte "Go on confident with this design."
	    }
	}
    } else {
	lappend Texte "Seems not to have any equivalent in database."
	lappend Texte "Be Careful with this design."
    }
    
    after idle {.fairelire.msg configure -wraplength 10i -background red -font "Courier 10 bold"}
    tk_dialog .fairelire "Please press OK" "[join $Texte "\n"]" {} 0 Acknowledge
    catch {destroy .fairelire}
    return ""

}

proc CheckForOligo {PAB FichierBlast {LogFile {}} {Output {}}} {

    
    Wup "Analyse la sequence pour le Tm, GC, Specificite ..."
    Wup "Ajout du classement de la sortie, des zones specifiques pour un design a facon."
    Wup "Ajout du choix de la query dans la banque (AccessDeRef) et design que pour cet access"
    Wup "Ajout de la gestion de AccessDeRef si vide"
    Wup "Ajout de la gestion des design ou il y trop de sequences par candidat au moment de la sauvegarde"
    Wup "22/10/2003"

    if {$PAB=="" || $FichierBlast==""} {return ""}
    if {    [file exists "$PAB"]} {
	set FichierQuery "$PAB"
    } else {AjouteAuLog "No File for the Query ($PAB)";return ""} 

    if {$LogFile == ""} {set LogFile "${PAB}.log"}
    if {$Output  == ""} {set Output  "${PAB}.oligo"}
    if {[file exists $Output] || [file exists $LogFile]} {AjouteAuLog "$PAB existe deja";return ""}
 
    #Les parametres du design
    #########################
    if {[BonNombreDeParametres]} {
	foreach  Parametre [list Step DataBase LengthOligo TmMethod TmLimit GCContentMinus GCContentPlus TmRange LesProhibes NbOligo NbContiguous IdLimit] {
	    set $Parametre [LesParametresDuDesign $Parametre "LaValeurMerci"]
	}
    } else {return ""}
    
    if {[regexp {\.masked$} $PAB]} {regsub -all {\.masked$} $PAB "" PAB}
    set PAB             [file tail $PAB]
    set AccessDeLaBoite [AccessDeLaBoite $PAB]
    #set AccessDeLaBoite [AccessDeLaBoite [file tail $PAB]]

    set TmLimitSup      [expr $TmLimit + $TmRange]
    set TmLimitInf      [expr $TmLimit - $TmRange]
    if {[expr $TmLimitInf<0]} {set TmLimitInf 0}
    set CaractereMasque "N"
    set LesProhibes     [linsert $LesProhibes 0 $CaractereMasque]
    set Pas             $Step
    set Tab(OnEnTient)  0
    #Qiagen parameters
    #set NbContiguous 20
 
    #Charge les resultats du Blast
    ##############################
    set SeuilId      "None"
    set TailleQuery  [AskBlast $FichierBlast Taille]
    set NbSubject    [AskBlast $FichierBlast NbSubject]

    set LaSeq [split [QueLaSequenceDuFichierTFA $FichierQuery] ""]
    set EnteteQuery  [   PremiereLigneDuFichier $FichierQuery]

    #Si on vient de nuctfa
    if {[regexp ":" $EnteteQuery]} {regsub -all -nocase " :" $EnteteQuery "" EnteteQuery}	
    AppendAuFichier $LogFile "Query Length : $TailleQuery"
    AppendAuFichier $LogFile "Oligo Requested: $LengthOligo nt between $TmLimitInf and $TmLimitSup with less than $NbContiguous contiguous and $IdLimit for X-hybridisation"

    #CHECK Query
    if {[LesParametresDuDesign QueryCheck "LaValeurMerci"]=="1"} {
	#Test de la presence de la Query dans le blast
	##############################################
	set AccessDeRef       ""
	if {$NbSubject>0} {
	    set PIdentity     0.95
	    set PRecouvrement 0.70
	    set LesBIdsBases  ""
	    set IdGlobal      0.0
	    set PCoverQuery   0.0
	    set PCoverSubject 0.0
	    
	    set     BId           [InterrogeBestHitInDatabase $FichierBlast InitialBId]
	    set  LesBIdsBases     [InterrogeBestHitInDatabase $FichierBlast LesBIdsBases]
	    if {$LesBIdsBases==""} {
		AppendAuFichier $LogFile "Query has no equivalent sequence in DataBase: No fitting sequence in Blast searches"
	    } else {
		#Pourcentage d identite global: Aligne sur Total dans les alignements 
		set  IdGlobal     [InterrogeBestHitInDatabase $FichierBlast IdGlobal]
		#Recouvrement de Q sur S ou inversement
		#PCoverQuery   Query   par rapport au Subject
		#PCoverSubject Subject par rapport au Query
		set PCoverQuery   [InterrogeBestHitInDatabase $FichierBlast PCoverQuery]
		set PCoverSubject [InterrogeBestHitInDatabase $FichierBlast PCoverSubject]
		set AccessDeRef   $BId
		
		if {$IdGlobal<$PIdentity || $PCoverQuery<$PRecouvrement || $PCoverSubject<$PRecouvrement} {
		    AppendAuFichier $LogFile "Query has no equivalent sequence in DataBase: $BId (\%Id [format "%.2f" $IdGlobal], Cover S/Q [format "%.2f" $PCoverQuery], Cover Q/S [format "%.2f" $PCoverSubject])."
		    #On ne met pas a zero pour preserver les cas limites de nos cutoffs
		    #set AccessDeRef ""
		    if {($PCoverQuery <= 0.2 || $PCoverSubject <= 0.2) || $IdGlobal <= 0.90} {
			#On met tout de meme a zero car trop limite
			set AccessDeRef ""
		    }
		} else {
		    AppendAuFichier $LogFile "Query has an equivalent sequence in DataBase: $BId (\%Id [format "%.2f" $IdGlobal], Cover S/Q [format "%.2f" $PCoverQuery], Cover Q/S [format "%.2f" $PCoverSubject])."
		}
	    }
	} else {
	    AppendAuFichier $LogFile "Query has no equivalent sequence in DataBase: No Hit found in Blast searches"
	    set AccessDeRef ""
	}
    } else {
	AppendAuFichier $LogFile "Query has maybe an equivalent sequence in DataBase but we did not check"
	set AccessDeRef ""
    }

    #Pour commencer a un autre endroit sur la Query
    ###############################################
    #Si il existe une zone particuliere pour la query on l utilise sinon on voit si il y en a une globale
    set     LesZones   [LesParametresDuDesign LesZones $PAB "LaValeurMerci"]
    if {   $LesZones==""} {
	set LesZones   [LesParametresDuDesign LesZones      "LaValeurMerci"]
    }
    if {   $LesZones == ""} {
	set LesZones   [list 1 $TailleQuery]
    } else {
	set LesTmps    [lsort -integer -increasing -index 0 $LesZones]
	set FinAvant   ""
	set DebutAvant ""
	set LesZones   ""
	set NbZones    [llength $LesTmps]
	set nb         0
	foreach Tmp $LesTmps {
	    set EdgeBegin [lindex $Tmp 0]
	    set EdgeEnd   [lindex $Tmp 1]
	    incr nb

	    if {$FinAvant=="" && $DebutAvant==""} {
		set DebutAvant $EdgeBegin
		set FinAvant   $EdgeEnd
		if {$nb==$NbZones} {lappend LesZones [list $DebutAvant $FinAvant]}
		continue
	    }
	    if {$EdgeBegin > $FinAvant} {
		lappend LesZones [list $DebutAvant $FinAvant]
		set DebutAvant $EdgeBegin
		set FinAvant   $EdgeEnd
	    } elseif {$EdgeEnd> $FinAvant} {
		set FinAvant   $EdgeEnd
	    }
	    if {$nb==$NbZones} {lappend LesZones [list $DebutAvant $FinAvant]}
	    continue
	}
    }

    foreach Zones $LesZones {
	set DebutDesign 1
	set Fin         $LengthOligo
	set FinDesign   $TailleQuery
	set EdgeBegin   [lindex $Zones 0]
	set EdgeEnd     [lindex $Zones 1]
	if {[info exists EdgeBegin] && $EdgeBegin!="" && $EdgeBegin>$DebutDesign} {set DebutDesign $EdgeBegin}
	if {[info exists EdgeEnd]   && $EdgeEnd  !="" && $EdgeEnd  <$TailleQuery} {set FinDesign   $EdgeEnd}
		
	#On teste la zone de design
	###########################
	for {set Debut $DebutDesign} {$Fin <= $FinDesign} {incr Debut $Pas} {
	    set nbGarde          0
	    set nbVire           0
	    set ProhibOnContinue 0

	    set Fin [expr $Debut  + $LengthOligo - 1] 
	    if {!   [expr $Fin   <= $FinDesign]} {break}
	    
	    set Seq [join [lrange $LaSeq [expr $Debut - 1] [expr $Fin - 1]] ""]
	    
	    AppendAuFichier $LogFile "\nMoving on: $Debut $Fin"
	    AppendAuFichier $LogFile "Sequence: $Seq"
	    
	    #Fin de la sequence ou non
	    ##########################
	    if {[string length $Seq]<$LengthOligo} {AppendAuFichier $LogFile "Length: TOOSHORT";continue} else {AppendAuFichier $LogFile "Length: OK"}
	    
	    #Module Determination de Sequences Prohibees
	    ############################################
	    if {$LesProhibes!=""} {
		foreach Prohib $LesProhibes {
		    if {[regexp $Prohib $Seq]} {set ProhibOnContinue 1;break}
		}
		if {$ProhibOnContinue==1} {
		    AppendAuFichier $LogFile "Prohibited: PROHIBES"
		    continue
		} else {
		    AppendAuFichier $LogFile "Prohibited: OK"}
	    } else {AppendAuFichier $LogFile "Prohibited: OK"}
	    
	    #Module Determination du GC Content
	    ###################################
	    if {[info exists GCContentMinus] && [info exists GCContentPlus] && $GCContentMinus!="" && $GCContentPlus!=""} {
		set xGC [NombreDeBaseDe $Seq "G|C"]
		set GC  [format "%.1f" [expr (($xGC)/($LengthOligo*1.0))*100.0]]
		if {$GC<$GCContentMinus || $GC>$GCContentPlus} {
		    AppendAuFichier $LogFile "GC: $GC Not OK"
		    continue
		} else {
		    AppendAuFichier $LogFile "GC: $GC OK"
		}
	    }
	    
	    #Module Calcul du Tm
	    ####################
	    set  Tm [format "%.1f" [CalculTmDeLaSeq $Seq "" "" $TmMethod]]
	    if {$Tm=="-1"} {
		AppendAuFichier $LogFile "Tm: Illegal caracter for Tm calculation"
		continue
	    } elseif {$Tm==""} {
		AppendAuFichier $LogFile "Tm: No Tm calculation"
		return ""
	    } elseif {$Tm>$TmLimitSup} {
		AppendAuFichier $LogFile "Tm: $Tm > $TmLimitSup"
		continue
	    } elseif {$Tm<$TmLimitInf} {
		AppendAuFichier $LogFile "Tm: $Tm < $TmLimitInf"
		continue
	    } else {
		AppendAuFichier $LogFile "Tm: $Tm OK"
	    }
	
	    #Traitements cas particuliers
	    #############################
	    #1-Pas de hit du tout dans le blast
	    #  On ne calcul donc pas de specificite mais au moins le reste
	    if {$NbSubject==0 && $nbGarde>=0} {
		if {$nbGarde==0} {set Tab($Debut,$Fin,candidat)   "No Hit found during DataBase searches"}
		if {   ! [info exists Tab($Debut,$Fin,contigue)]} {set Tab($Debut,$Fin,contigue) 0}
		set Tab($Debut,$Fin,oligo)    $Seq
		set Tab($Debut,$Fin,Tm)       $Tm
		#set Tab($Debut,$Fin,GC)       $GC
		set Tab(OnEnTient)            1
		set Tab($Debut,$Fin,nbGarde)  $nbGarde
		lappend Tab($nbGarde)         "$Debut $Fin"
		continue
	    }
	    
	    #Module Calcul de la Specificite
	    ################################
	    set  LesInfos          ""
	    set  LesPetitesRegions [list [list $Debut $Fin]]
	    set  LesInfos          [LesInfosDesRegionsDansLeBlast $FichierBlast $LesPetitesRegions All $SeuilId]
	    if {$LesInfos!=""} {
		#On a des hits dans cette zone
		#Cette zone est sans l AccessDeRef donc pas la peine de la traiter 
		#Si AccessDeRef est vide on passe quand meme 
		if {$AccessDeRef==""} {
		    #On calcul quand meme
		} elseif {! [regexp -nocase "$AccessDeRef" $LesInfos]} {
		    AppendAuFichier $LogFile "No query $AccessDeRef in this part $Debut $Fin"
		    continue
		}
		
		foreach Ligne $LesInfos {
		    #Description des informations rendues par LesInfosDesRegionsDansLeBlast
		    #1  60 3       1     NM001100 {Plus/Plus} +    67 126 60     60        60
		    #DQ FQ NAliTot NArea BId      Orient      Sens DS FS  NDsAli NDsAliTot NCont
		    #Pour Pallier au probleme de plusieurs Access pour un seul Id
		    #1 60 77 2 RSHUM:CD97 {Plus / Minus} - {147 147} {157 157} 14 22 3

		    set Facteur      [llength [lindex $Ligne 8]]
		    set NbBIdentique ""
		    set NbBAlignee   ""
		    set NbContigue   ""
		    set NbBIdentique [lindex $Ligne  9]
		    set NbBAlignee   [lindex $Ligne 10]
		    set NbContigue   [lindex $Ligne 11]
		    set IdGlobal     [format "%.2f" [expr ((1.0*$NbBIdentique)/($LengthOligo*$Facteur))*100.0]]

		    #Petit test de la query
		    #On teste si la query est suffisemment presente dans cette region
		    set LeCandidat   [lindex $Ligne 4]
		    if {$LeCandidat=="$AccessDeRef"} {
			if {$IdGlobal<70.0} {continue}
		    }
		    
		    #On est pas assez identique
		    if {$IdGlobal<=$IdLimit} {
			#Mais on a trop de bases identiques successives
			if {$NbContigue >= $NbContiguous} {
			    AppendAuFichier $LogFile "Spec: We keep TOOMUCHCONTIGUE    $Ligne"
			    AppendAuFichier $LogFile "\tID G $IdGlobal"
			    
			    incr nbGarde
			    #On compte le nombre de sequences de 15 nts contigues
			    if {![info exists Tab($Debut,$Fin,contigue)]} {
				set Tab($Debut,$Fin,contigue) 1
			    } else {incr Tab($Debut,$Fin,contigue)}
			    
			    lappend Tab($Debut,$Fin,candidat) [lindex $Ligne 4]
			    continue
			}
			AppendAuFichier $LogFile "Spec: We left NOTENOUGHIDENTICAL $Ligne"
			incr nbVire
			continue
		    }
		    #On compte le nombre de sequences de 15 nts contigues meme pour ceux gardes avec IdGlobal important
		    if {$NbContigue >= $NbContiguous} {
			if {![info exists Tab($Debut,$Fin,contigue)]} {
			    set Tab($Debut,$Fin,contigue) 1
			} else {incr Tab($Debut,$Fin,contigue)}
		    }
		    AppendAuFichier $LogFile "Spec: We keep TOOMUCHIDENTICAL   $Ligne"
		    AppendAuFichier $LogFile "\tID G $IdGlobal"	
		    incr nbGarde
		    
		    lappend Tab($Debut,$Fin,candidat) [lindex $Ligne 4]
		}
		AppendAuFichier $LogFile ">>>\tWe keep $nbGarde\tWe left $nbVire"
	    }

	    if {$nbGarde>=0} {
		if {$LesInfos==""} {
		    #1 - On n a pas de hits dans le blast dans cette zone
		    #    On le garde quand meme
		    AppendAuFichier $LogFile      "$Debut $Fin NoHitFound"
		    set Tab($Debut,$Fin,candidat) "No Hit found during DataBase searches"
		} else {
		    #2 - On a des hits dans le blast dans cette zone
		    if {$nbGarde==0} {
			#2 - 1 - On a des hits mais aucun suffisamment proche pour le retenir
			#        On le garde
			AppendAuFichier $LogFile      "$Debut $Fin NoHitWithEnoughIdentity"
			set Tab($Debut,$Fin,candidat) "No Hit found or retained during DataBase searches"
		    } else {
			#Equivalent a nbGarde > 0
			#2 - 2 - On a des hits et au moins un suffisamment proche pour le(s) retenir
			if {$AccessDeRef==""} {
			    #2 - 2 - 1 - On le garde quand meme car il n y a pas de query
			    AppendAuFichier $LogFile "$Debut $Fin NoHitWithEnoughIdentity"
			} elseif {! [regexp -nocase "$AccessDeRef" [set Tab($Debut,$Fin,candidat)]]} {
			    #2 - 2 - 2 - Cette zone ne contient pas (ou pas suffisamment) notre AccessDeRef
			    #On ne le garde pas
			    AppendAuFichier $LogFile "No query $AccessDeRef in this Candidat $Debut $Fin"
			    continue   
			}
		    }
		}
		if {! [info exists Tab($Debut,$Fin,contigue)]} {set Tab($Debut,$Fin,contigue) 0}
		set Tab($Debut,$Fin,oligo)   $Seq
		set Tab($Debut,$Fin,Tm)      $Tm
		#set Tab($Debut,$Fin,GC)      $GC
		set Tab(OnEnTient)           1
		set Tab($Debut,$Fin,nbGarde) $nbGarde
		lappend Tab($nbGarde)        "$Debut $Fin"
	    }
	}
    }
    
    set FirstTime 1
    #On va classer et sauvegarder les oligos si on en a trouve
    ##########################################################
    if {[set Tab(OnEnTient)] == 0} {
	#Pour les sequences sans oligos
	###############################
	scan $EnteteQuery "%s" PAB
	regsub {\>} $PAB "" PAB

	regsub ">$PAB" $EnteteQuery ">$PAB NoOligo Available" EnteteQuery
	AppendAuFichier "$Output" $EnteteQuery
	AppendAuFichier "$Output" [join $LaSeq ""]
    } else {
	#Pour les sequences avec oligos
	###############################
	while {1} {
	    if {$FirstTime} {
		set FirstTime 0
		#On enregistre dans le fichier de sortie les oligos avec moins de 30 candidats (MaxToStore) de specificite
		#On garde tout ceux qui ont 0, 1 ou 2 candidat(s) (MinimumAGarder), et pour ceux au dela jusqu a NbOligo
		set MinimumAGarder 2
		set CompteurDOligo 0
		set NumeroDeLOligo 1
		set OnAFini        0
		set OnEnASauverUn  0
		set MaxToStore     30
		#j nombre de candidats maximum a garder par oligo
		#CompteurDOligo et nbOligo nombre de d oligos a garder
	    } else {
		#On est au dessus de 30 candidats de specificite par oligo (MaxToStore)
		#Mais on a des candidats donc on recupere les categories de nb candidats (le j)
		set LesNbGarder       ""
		set LesEntetesNbGarde [array get Tab "*,*,nbGarde"]
		foreach {E NbGarder} $LesEntetesNbGarde {
		    lappend LesNbGarder $NbGarder
		}
		set LesNbGarder [lsort -unique -increasing -integer $LesNbGarder]

		#On va enregistrer dans le fichier de sortie les oligos en desespoir les 5 moins bon
		set NbOligo        5
		set MinimumAGarder 2
		set CompteurDOligo 0
		set NumeroDeLOligo 1
		set OnAFini        0
		set OnEnASauverUn  0
		set MaxToStore     [lindex $LesNbGarder end]
		#j nombre de candidats maximum a garder par oligo
		#CompteurDOligo et nbOligo nombre de d oligos a garder
	    }

	    for {set j 0} {$j <= $MaxToStore} {incr j} {
		#On recherche toutes les positions avec j candidats pour cet oligo
		if {$OnAFini=="1"}         {break}
		if {[info exists Tab($j)]} {
		    set LesPositions ""
		    set MesPositions ""
		    set MesPositions [set Tab($j)]
		    
		    foreach PosDeJ $MesPositions {
			set MonDebut   [lindex $PosDeJ 0]
			set MaFin      [lindex $PosDeJ 1]
			set NbContigue [set Tab($MonDebut,$MaFin,contigue)]
			lappend LesPositions "$PosDeJ $NbContigue"
		    }
		    #On trie selon le nombre de sequences contigues
		    set LesPositions [lsort -integer -increasing -index 2 $LesPositions]
		    
		    foreach UnePosition $LesPositions {
			if {$j>$MinimumAGarder} {
			    incr CompteurDOligo
			    if {$CompteurDOligo>$NbOligo} {
				set OnAFini 1
				break
			    }
			}
			set  EnteteDeLOligo ""
			set  NomDeLOligo    "${PAB}_Oligo${NumeroDeLOligo}_${AccessDeLaBoite}"
			#set  NomDeLOligo    "Oligo${NumeroDeLOligo}_${AccessDeLaBoite}"
			incr NumeroDeLOligo
			set  UnDebut        [lindex $UnePosition 0]
			set  UneFin         [lindex $UnePosition 1]
			set  Contigue       [lindex $UnePosition 2]
			
			#Format: EnteteQuery Taille Tm debut_fin candidats_nbcontigue candidats
			lappend EnteteDeLOligo [linsert $EnteteQuery 1 "$NomDeLOligo"]
			lappend EnteteDeLOligo $LengthOligo
			lappend EnteteDeLOligo "[set Tab($UnDebut,$UneFin,Tm)]"
			#lappend EnteteDeLOligo "[set Tab($UnDebut,$UneFin,GC)]"
			lappend EnteteDeLOligo "$UnDebut $UneFin"
			lappend EnteteDeLOligo "[set Tab($UnDebut,$UneFin,nbGarde)] $Contigue"
			lappend EnteteDeLOligo [join [set Tab($UnDebut,$UneFin,candidat)] " "]
			set     EnteteDeLOligo [join $EnteteDeLOligo "\t"]
			
			AppendAuFichier $Output $EnteteDeLOligo
			AppendAuFichier $Output "[set Tab($UnDebut,$UneFin,oligo)]"
			
			set OnEnASauverUn 1
			continue
		    }
		} else {continue}
	    }
	    if {$OnEnASauverUn} {break}
	}
	if {[info exists Tab]}  {unset Tab}
    }
    AskBlast         unsetfile $FichierBlast
    InterrogeBestHitInDatabase $FichierBlast Decharge 
    if {[info exists Tab]}      {unset Tab}
    if {[info exists LesInfos]} {unset LesInfos}
    
    AppendAuFichier $LogFile "FIN"
    return ""

}

proc CheckForRestrictedParameter {Value NomDuCutOff} {

    Wup "Permet de tester les parametres restreints selon la valeur donnee"
    Wup "3 classes de test Equal pour egal, Both pour 1 encadrement et Regexp pour une recherche de texte"

    if {$Value == ""} {return ""}
    if {[RestrictedParameter $NomDuCutOff "" Existe]=="0"} {return ""}

    set ValueDuCutOff [RestrictedParameter $NomDuCutOff "" LaValeurMerci]
    set Categorie     [LaCategorieDeCuttOffDe $NomDuCutOff]

    #Both   recherche les 2 criteres
    #Equal  recherche exactement ce critere
    #Regxep recherche la presence de tous en meme temps
    set Keep 1
    switch -exact -- $Categorie {
	"Equal"  {if {$Value !="" && $Value != $ValueDuCutOff} {set Keep 0}}
	"Both"   {
	    set  ValueDuCutOff2 [RestrictedParameter ${NomDuCutOff}_2 "" LaValeurMerci]
	    if {$ValueDuCutOff==""} {set ValueDuCutOff 0.0} elseif {$ValueDuCutOff2==""} {set ValueDuCutOff2 10000000}
	    if {$Value < $ValueDuCutOff || $Value > $ValueDuCutOff2} {set Keep 0} else {set Keep 1}   
	}
 	"Regexp" {
	    if {$Value !="" && ![regexp -nocase "$ValueDuCutOff" $Value]} {
		foreach V $ValueDuCutOff {
		    if {![regexp -nocase "$V" $Value]} {set Keep 0;break}
		    set Keep 1
		}
	    }
	}
    }
    if {$Keep} {return "1"} else {return "0"}

}

