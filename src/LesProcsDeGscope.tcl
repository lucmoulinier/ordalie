proc ExecuteLaSelectionDeCheck Selection {

    set LesCommandes {}
    foreach Ligne [split $Selection "\n"] {
	if { ! [regexp " run " $Ligne]} { continue }
	lappend LesCommandes [StringSuivant " run " dans  $Ligne]
    }

    set N [llength $LesCommandes]

    if {$N==0} { return 0 }

    if {$N==1 && ! [OuiOuNon "Do I execute $LesCommandes ?"]} {
	return [expr -$N]
    }

    if {$N>1 && ! [OuiOuNon "Do I execute all these commands\n[join $LesCommandes "\n"]\n ?"]} {
	FaireLire "Please select the right one and retry."
	return [expr -$N]
    }
    
    foreach Commande $LesCommandes {
	eval exec gscope $Commande &
    }
    return $N

}

