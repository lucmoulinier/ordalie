proc IndexsPlusProches {Nl d t} {

    global Loto

    # cherche triple max pour un double donne
    set Lt [array names Loto "$Nl,${d},*"]
    set Lt [lsort -decreasing -dictionary $Lt]
    lassign [split [lindex $Lt 0] ,] x y Tm
    #puts "pour $d doubles, Tm = $Tm"

    # cherche double max possibles pour un triple
    set Ld [array names Loto "${Nl},*,$t"]
    set Ld [lsort -decreasing -dictionary $Ld]
    lassign [split [lindex $Ld 0] ,] x Dm y
    #puts "pour $t triples, Dm = $Dm"

    #set dd [expr {abs($Dm - $d)}]
    #set dt [expr {abs($Tm - $t)}]
    set dd [expr {$Dm - $d}]
    set dt [expr {$Tm - $t}]

    if {$dd == 0 && $dt == 0} {
	#return [list 0 0 $Dm $Tm]
	return [list $d $t]
    } elseif {($Dm + $t) > ($d + $Tm)} {
	#return [list $dd 0 $Dm $t]
	return [list $Dm $t]
    } elseif {($Dm + $t) < ($d + $Tm)} {
	#return [list 0 $dt $d $Tm]
	return [list $d $Tm]
    } else {
	if {$Dm >= $d} {
	    return [list $Dm $t]
	} else {
	    return [list $d $Tm]
	}
    }

}

