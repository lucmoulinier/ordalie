    set Tableau(EspaceDisponible,Unit)       "pb"

    lappend LesVariablesProposees            "Skew in sequences"
    set Tableau(Skew_in_sequences)           "BiaisEnSequences"
    set Tableau(BiaisEnSequences,Couleur)    "MediumOrchid"
    set Tableau(BiaisEnSequences,Unit)       ""

    if {$Fold} {
	lappend LesVariablesProposees            "Skew in sequences Plus"
