proc TrieLes1N2 Ld {

    set md 0.0 ; set m2 0.0
    set L1n2 {}
    foreach d $Ld {
	lassign $d what e1 e2 g n p
	set nd [list 1 $g N $n 2 $p]
	set nd [lsort -real -decreasing -stride 2 -index 1 $nd]
	set what [lindex $nd 0]

	# calcule ... comme une distance
	set val [expr {sqrt($g**2 + $n**2 + $p**2)}]
	set md [expr {$md + $val}]
	set m2 [expr {$m2 + $val*$val}]

	lappend L1n2 [list $what $e1 $e2 $g $n $p $val]
    }
    set Ltmp [lsort -real -decreasing -index 6 $L1n2]
    
    set Nb [llength $Ltmp]
    set md [expr {$md / $Nb}]
    set variance [expr {$m2/$Nb - $md*$md}]
    set ec 0.0
    if {$variance > 0.0} {
        set ec [expr {sqrt($variance)}]
    }
    set L1n2 {}
    foreach d $Ltmp {
	lassign $d what e1 e2 g n p val
	set cok [expr {$val >= ($md + 0.5*$ec)}]

	lappend L1n2 [list $what $e1 $e2 $g $n $p $val $md $ec $cok]
    }

    return $L1n2

}

proc TrieLesDoubles Ld {

    set Ldbl {}
    set md 0.0 ; set m2 0.0
    foreach d $Ld {
	lassign $d what e1 e2 go no po

	# trie du + au -
	set nd [list G $go N $no P $po]
	set nd [lsort -decreasing -real -stride 2 -index 1 $nd]
	lassign $nd a g b n c p
	set ab [string map {G 1 P 2} [join [lsort [list $a $b]] ""]]
	set what "D$ab"

	# meilleur double est: 50. 50. 0.
	# g et n etant les deux plus grandes valeurs,
	# on mesure l'ecart avec 50. et l'ecart entre elles
	set val [expr {(($g - 50.)**2 + ($n - 50.)**2 + ($g - $n)**2)/3.}]
	set md [expr {$md + $val}]
	set m2 [expr {$m2 + $val*$val}]

	lappend Ldbl [list $what $e1 $e2 $go $no $po $val]
    }
    set Ltmp [lsort -real -index 6 $Ldbl]

    # stats : moy, ecart-type
    set Nb [llength $Ldbl]
    set md [expr {$md / $Nb}]
    set variance [expr {$m2/$Nb - $md*$md}]
    set ec 0.0
    if {$variance > 0.0} {
	set ec [expr {sqrt($variance)}]
    }
    set Ldbl {}
    foreach t $Ltmp {
	lappend Ldbl [lappend t $md $ec 0]
    }

    return $Ldbl

}

proc TrieLesExons ListeDesExons {

    foreach Homologie $ListeDesExons {
	ScanLaListe [split $Homologie "\t"] ChroContigTroncon nCops nCopsDansCetteSequence Orga  PourcentageIdentiteCacheDansScore Expect  DebutQuery FinQuery DebutSbjct FinSbjct
