proc FaitClassement id {

    global db

    $db eval {begin transaction}
    foreach pkj [$db eval {select pk_journee from journee where ligue=$id order by pk_journee}] {
	set Lpkm [$db eval {select pk_match from match where pk_journee=$pkj}]
	foreach c {1 2 3 4 5 6} {
	    if {$c == 1} {
		set tbl data ; set spk "pk_data"
	    } else {
		set tbl "data$c" ; set spk "pk_data$c"
	    }

	    # classement general
	    set Lpke [$db eval "select $spk from $tbl where pk_match in ([join $Lpkm ,]) order by points, diff, butpour, butcontre DESC"] 
	    set i 0
	    foreach p $Lpke {
		$db eval "update $tbl set classement=$i where $spk=$p"
		incr i
	    }

	    # classement DOMICILE
	    set Lpke [$db eval "select $spk from $tbl where pk_match in ([join $Lpkm ,]) order by pointsDom, butpourdom, butcontredom DESC"] 
	    set i 0
	    foreach p $Lpke {
		$db eval "update $tbl set classementDom=$i where $spk=$p"
		incr i
	    }

	    # classement Exterieur
	    set Lpke [$db eval "select $spk from $tbl where pk_match in ([join $Lpkm ,]) order by pointsExt, butpourext, butcontreext DESC"] 
	    set i 0
	    foreach p $Lpke {
		$db eval "update $tbl set classementExt=$i where $spk=$p"
		incr i
	    }
	}
    }
    
    $db eval {commit}
    
    return

}

