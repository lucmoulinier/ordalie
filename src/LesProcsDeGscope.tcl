	}
    
}

proc ::NSLibraryEditorGui::fetchLibraries {} {

	variable libraries

	#canalSqlAssemblyDb
	NSAssemblyDb::getCanal
	set sql "SELECT pk_library, name, organism, tissue, normalized, construction_method, vector, adapter, growing_stage, samples_count, strain, sampling_date, sampling_place, comments FROM library"
	set libList [SqlExec $sql GetList]
	CanalSqlDisconnect

	array set libraries {index {}}
	foreach {pk name org tiss norm const vect adapt grow sCount strain sDate sPlace comments} $libList {
	    set libraries($name,pk) $pk
	    set libraries($name,name) $name
	    set libraries($name,organism) $org
	    set libraries($name,tissue) $tiss
	    if {$norm eq "f"} {set libraries($name,normalized) 0} else {set libraries($name,normalized) 1}
	    set libraries($name,construction) $const
	    set libraries($name,vector) $vect
	    set libraries($name,adapter) $adapt
	    set libraries($name,growingStage) $grow
	    set libraries($name,samplesCount) $sCount
	    set libraries($name,strain) $strain
	    set libraries($name,samplingDate) $sDate
	    set libraries($name,samplingPlace) $sPlace
	    set libraries($name,comments) $comments
	    lappend libraries(index) $name
	}
	set libraries(index) [lsort $libraries(index)]
    
}

