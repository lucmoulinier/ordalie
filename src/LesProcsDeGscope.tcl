proc ShowTD1 Ld {

    # 0   = T, D1N, 1, 2 ...
    # 1   = eq1
    # 2   = eq2
    # ... = double
    # end = ok
    set lg1 [PlusLongEltDe [ExtraitListeDeListe $Ld 1]]
    set lg2 [PlusLongEltDe [ExtraitListeDeListe $Ld 2]]
    set fmt "%3s %${lg1}s %${lg2}s %1d %5.2f %5.2f %5.2f"
    puts ""
    foreach l $Ld {
	set w  [lindex $l 0]
	set e1 [lindex $l 1]
	set e2 [lindex $l 2]
	set g  [lindex $l 3]
	set n  [lindex $l 4]
	set p  [lindex $l 5]
