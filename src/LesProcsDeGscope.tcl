    set TousLesHits {}
    if {[lsearch $Cif(ListOf,LoopKeyClass) "_entity_src_gen"]>=0} {
	set LesHits [CifEx _entity_src_gen =entity,entity_id,=gene_src_taxid,pdbx_gene_src_ncbi_taxonomy_id,=gene_src_Name,pdbx_gene_src_scientific_name,=pdbx_org_TaxId,pdbx_host_org_ncbi_taxonomy_id,=pdbx_org_Name,pdbx_host_org_scientific_name DISTINCT I ne -1]
	LConcat TousLesHits $LesHits
    }
    if {[lsearch $Cif(ListOf,SimpleKeyClass) "_entity_src_gen"]>=0} {
	set LesHits [CifEx _entity_src_gen =entity,entity_id,=gene_src_taxid,pdbx_gene_src_ncbi_taxonomy_id,=gene_src_Name,pdbx_gene_src_scientific_name,=pdbx_org_TaxId,pdbx_host_org_ncbi_taxonomy_id,=pdbx_org_Name,pdbx_host_org_scientific_name DISTINCT I ne -1]
	LConcat TousLesHits $LesHits
    }
    if {[lsearch $Cif(ListOf,SimpleKeyClass) "_entity_src_gen"]>=0} {
	set LesHits [CifEx _entity_src_gen =entity,entity_id,=gene_host_taxid,pdbx_host_org_ncbi_taxonomy_id,=gene_host_Name,pdbx_host_org_scientific_name,=pdbx_org_TaxId,pdbx_host_org_ncbi_taxonomy_id,=pdbx_org_Name,pdbx_host_org_scientific_name DISTINCT I ne -1]
	LConcat TousLesHits $LesHits
    }
    if {[lsearch $Cif(ListOf,LoopKeyClass) "_entity_src_nat"]>=0} {
	set LesHits [CifEx _entity_src_nat =entity,entity_id,=nat_pdbx_taxid,pdbx_ncbi_taxonomy_id,=nat_Name,pdbx_organism_scientific DISTINCT I ne -1]
	LConcat TousLesHits $LesHits
    }
    if {[lsearch $Cif(ListOf,SimpleKeyClass) "_entity_src_nat"]>=0} {
	set LesHits [CifEx _entity_src_nat =entity,entity_id,=nat_pdbx_taxid,pdbx_ncbi_taxonomy_id,=nat_Name,pdbx_organism_scientific DISTINCT I ne -1]
