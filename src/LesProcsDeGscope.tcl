proc DefineBestMsfClRasPipe file {

    set Ll   [LesLignesDuFichier $file]
    
    set Vd ""
    set Vr ""
    
    foreach l $Ll {
	if {[regexp "clustal" $l]} {
	    set Vd [string range $l [expr [string first ":" $l] +2] end]
	}
	if {[regexp "rascal" $l]} {
	    set Vr [string range $l [expr [string first ":" $l] +2] end]
	}
    }
    
    if {$Vd == "undetermined"} {set Vd -999.}
    if {$Vr == "undetermined"} {set Vr -999.}
    
    set max [Maxi $Vd $Vr]
    if {$max == -999.} {return "no file"}
    if {$max == $Vd} {
	return "Msf"
    } else {
	return "Rascal"
    }    

}

proc DefineBestMsfPipe {file {chx auto}} {

    
    # choisi leon si normd > 0.5
    # sinon prend le meilleur NorMD
    
    if {$chx ne "auto"} {return $chx}

    set Ll [LesLignesDuFichier $file]
    
    set Vd ""
    set Vr ""
    set Vl ""
    
    foreach l $Ll {
	if {[regexp "clustal" $l]} {
	    set Vd [string range $l [expr [string first ":" $l] +2] end]
	}
	if {[regexp "rascal" $l]} {
	    set Vr [string range $l [expr [string first ":" $l] +2] end]
	}
	if {[regexp "leon" $l]} {
	    set Vl [string range $l [expr [string first ":" $l] +2] end]
	}
    }
    
    if {$Vd == "undetermined"} {set Vd -999.}
    if {$Vr == "undetermined"} {set Vr -999.}
    if {$Vl == "undetermined"} {set Vl -999.}
    
    if {$Vl <= 0.5} {
	set max [Maxi $Vl $Vr]
	set max [Maxi $Vd $max]
	if {$max == -999.} {return "no file"}
	if {$max == $Vl} {
	    return "Leon"
	} elseif {$max == $Vr} {
	    return "Rascal"
	} else {
	    return "Msf"
	}
    }
    
    return "Leon"

}

