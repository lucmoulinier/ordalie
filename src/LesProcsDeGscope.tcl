proc ::NSAssemblyDb::getCanal {} {

	variable canalName
	variable canalData

	if {$canalName == ""} {
	    puts "Canal is not set"
	    exit 1
	} else {
	    set c [CanalSql "host=$canalData($canalName,pgHost) dbname=$canalData($canalName,pgDb) user=$canalData($canalName,pgUser) password=$canalData($canalName,pgPass)"]
	    if {[info exists canalData($canalName,schema)]} {
		SqlExec "SET search_path TO $canalData($canalName,schema)"
	    }
	    return $c
	}
    
}

proc ::NSAssemblyDb::setCanal {{name {}}} {

	variable canalName
