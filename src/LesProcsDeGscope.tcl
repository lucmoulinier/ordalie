proc DetruitLesInfosDe K {

    Wup "Nettoie les informations liees au canvas qu on a plus besoin"
    Wup "A faire quand le canvas va etre detruit"

    global TabCanvas

    #Espionne "On Decharge $K"

    #Decharge les infos des oligos
    if {[info exists TabCanvas($K,MesFichiersOligo)]} {
	foreach Fichier [lsort -unique [set TabCanvas($K,MesFichiersOligo)]] {
	    InterrogeInfoDeLOligo $Fichier Decharge
	}
	#unset TabCanvas($K,MesFichiersOligo)
    }

    #Decharge les infos des BestHitInDataBase
    if {[info exists TabCanvas($K,MesBlasts)]} {
	foreach Fichier [lsort -unique [set TabCanvas($K,MesBlasts)]] {
	    InterrogeBestHitInDatabase $Fichier Decharge 
	    AskBlast         unsetfile $Fichier
	}
	#unset TabCanvas($K,MesBlasts)
    }

    #Decharge les infos des logs
    if {[info exists TabCanvas($K,MesLogs)]} {
	foreach Fichier [lsort -unique [set TabCanvas($K,MesLogs)]] {
	    InterrogeInfoDuLogDeLOligo $Fichier Decharge
	}
	#unset TabCanvas($K,MesLogs)
    }
    #On supprime les fenetres crees et enregistrees pas K
    DetruitLesWinDe $K

    array unset TabCanvas "$K*"

    if {0} {
	#Old detruit les infos du canvas
	foreach Stocker [list MesDirs MesLogs MesBlasts MonPAB MonFichierQuery MaTailleDeQuery MonAccessQuery] {
	    if {[info exists TabCanvas($K,$Stocker)]} {unset TabCanvas($K,$Stocker)}
	}
    }
    return ""

}

