proc BlastPPourBallast {FichierTFA {FichierBlast {}} {EditCommand 0} {Banque protall} {Expect 10} {Filtre 1} {ShowSubject 250}} {

    global RepertoireDuGenome

    AttendreTantQueExiste "/gcg/Update/.updtgcgnew_running"

    if {$Filtre} {	set Filtre "T"
    } else {   	        set Filtre "F"}
    
    set BlastPDataBase "/blast/$Banque"
    if { ! [file exists "$BlastPDataBase.pal"] && ! [file exists "$BlastPDataBase.phr"]} {
	return ""
    }
    set CommandeBlastX "eval exec blastall  -p blastp  -i \$FichierTFA  -o \$FichierBlast  -d \$BlastPDataBase  -F \$Filtre  -e \$Expect  -v \$ShowSubject  -b \$ShowSubject"

    if {$EditCommand == 1 && [OuiOuNon "Do You want to edit the BlastP command ?" 0]} {
