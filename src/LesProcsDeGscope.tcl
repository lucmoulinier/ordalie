	puts "bmsf est $bmsf"
	# si on a 1 best MSF 
	if {$bmsf ne "no file"} {
	    if {$bmsf == "Leon"} {
		if {$lBestPdb != ""} {
		    foreach pdb $lBestPdb {
			# Verifie la presence du BestPDB si le meilleur msf est leon
			set test [VerifPresencePDB $fileLeon $pdb]
			if {$test == 0} {
			    catch {set bmsf [DefineBestMsfClRasPipe $fileNormd]}
