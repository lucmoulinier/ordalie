		file delete -force $FichierSelection
	    } elseif {! [OuiOuNon "It will append to it\nYou still want to save ?"]} {return ""}
	}
	foreach Id $NosIds {
	    set MesTags   [$K gettags $Id]
	    set NomOligo  [lindex $MesTags 4]
	    set Selection [join [ExtraitOligoDuTFA $PAB $NomOligo $DirOligo] "\n"]
