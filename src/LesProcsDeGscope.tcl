    if {![AskOptionsDeDrawBlast exists $w ListBox]} {
	AskOptionsDeDrawBlast set $w ListBox [DrawInfo Brut ""]
    }
    set ListBox [AskOptionsDeDrawBlast ask $w ListBox]
    if {![winfo exists $ListBox]                        } {
