proc CalculDesBiaisEnCompositionDeLaSequence Sequence {

    Wup "N PN A PA T PT G PG C PC AT PAT AG PAG AC PAC TG PTG TC PTC GC PGC Taille"

    regsub -all -nocase {[^ATGCNXMKRSYWVHDB]| } $Sequence "" Sequence
    set T [string length $Sequence]
    if {$T == 0} {return ""}

    set nN  0;set nA  0;set nT  0;set nG  0;set nC  0
    foreach Base [split [string toupper $Sequence] ""] {
	if {$Base == "N"                } {incr nN;continue}
	if {$Base == "A"                } {incr nA;continue}
	if {$Base == "T"                } {incr nT;continue}
	if {$Base == "G"                } {incr nG;continue}
	if {$Base == "C"                } {incr nC;continue}
    }
    set PN  [format "%.1f" [expr $nN*100.0/$T]]
    set PA  [format "%.1f" [expr $nA*100.0/($T-$nN)]]
    set PT  [format "%.1f" [expr $nT*100.0/($T-$nN)]]
    set PG  [format "%.1f" [expr $nG*100.0/($T-$nN)]]
    set PC  [format "%.1f" [expr $nC*100.0/($T-$nN)]]

    set nAT [expr $nA + $nT]
    set nAG [expr $nA + $nG]
    set nAC [expr $nA + $nC]
    set nTG [expr $nT + $nG]
    set nTC [expr $nT + $nC]
    set nGC [expr $nG + $nC]
    set PAT [format "%.1f" [expr $nAT*100.0/($T-$nN)]]
    set PAG [format "%.1f" [expr $nAG*100.0/($T-$nN)]]
    set PAC [format "%.1f" [expr $nAC*100.0/($T-$nN)]]
    set PTG [format "%.1f" [expr $nTG*100.0/($T-$nN)]]
    set PTC [format "%.1f" [expr $nTC*100.0/($T-$nN)]]
    set PGC [format "%.1f" [expr $nGC*100.0/($T-$nN)]]

    return [list $nN $PN $nA $PA $nT $PT $nG $PG $nC $PC $nAT $PAT $nAG $PAG $nAC $PAC $nTG $PTG $nTC $PTC $nGC $PGC $T]

}

proc CalculDesBiaisEnCompositionDuFichierTFA FichierTFA {

    if {![file exists $FichierTFA]} {return}
    return [CalculDesBiaisEnCompositionDeLaSequence [QueLaSequenceDuTFA $FichierTFA]]

}

