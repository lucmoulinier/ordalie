proc V_VV {u op v} {

    set w {}
    switch $op {
	"+" {
	    foreach e $u f $v {
		lappend w [expr {$e + $f}]
	    }
	}
	"-" {
	    foreach e $u f $v {
		lappend w [expr {$e - $f}]
	    }
	}
	"*" {
	    #lm Attention ! 
	    #lm Ce n'est pas le produit vectoriel !
	    foreach e $u f $v {
		lappend w [expr {$e * $f}]
	    }
	}
	"/" {
	    foreach e $u f $v {
		lappend w [expr {$e / $f}]
	    }
	}
    }

    return $w

}

