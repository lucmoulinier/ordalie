proc TailleDeLaQueryDuBlast FichierBlast {

    if {[file exists $FichierBlast]} {
	set F [open $FichierBlast]
	set nHits 0
	set Taille ""
	while {[gets $F Ligne]>=0} {
	    if {[regexp {^Length=([0-9]+)$} $Ligne tmp Taille]} {
		break
	    }
	    if {[regexp {[0-9\,]+ letters} $Ligne tmp]} {
		regsub " letters" $tmp "" Taille
		regsub "\," $Taille "" Taille
		break
	    }
	}
	close $F
	return "$Taille"
    } else {
	return ""
    }

}

