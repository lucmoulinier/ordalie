	return [lindex $rows 1]

}

proc ::Taxo::getDepth input {

	set field [identifyInput $input tchild nchild]
	set sql "SELECT COUNT(tparent.id)
			FROM taxon AS tchild
			  INNER JOIN taxon AS tparent ON tchild.l BETWEEN tparent.l AND tparent.r
			  INNER JOIN name AS nchild ON nchild.taxon_id = tchild.id
			AND $field = \$1"

	set rows [DB::queryPg [getConn] $sql [list [string tolower $input]]]
	set res [expr [lindex $rows 0 0] - 1]
	return $res

}

proc ::Taxo::getDescendants {input {name id}} {

	set field [identifyInput $input parent pn]
	set sql "SELECT node.id, nn.name, r.name
			FROM taxon AS node
			  INNER JOIN taxon AS parent ON (node.l > parent.l AND node.l < parent.r)
			  INNER JOIN name AS nn ON (nn.taxon_id = node.id AND nn.current)
			  INNER JOIN name AS pn ON pn.taxon_id = parent.id
			  LEFT OUTER JOIN rank r ON r.id = node.rank_id
			WHERE $field = \$1"
	set rows [DB::queryPg [getConn] $sql [list [string tolower $input]]]
	return [formatData $rows $name]

}

