proc RejetteLaBoite Boite {

    global LimiteGauche LimiteDroite
    
    set Nom [Box $Boite nom]
    if { ! [YaPABouTROUouTRNAouARNenDebutDe $Nom]} { return 1 }

    if { ! [info exists LimiteGauche]} { return 0 }

