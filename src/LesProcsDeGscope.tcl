proc RelieLesOperons {K Position} {

    global LesOrdresPourGif

    set PourGif [string equal $K "OrdrePourGif"]

    foreach Boite [ListeDesPABs] {

	set Nom   [Box $Boite nom]

	set ListeOMO [ListeDesOrganismesAyantMemeOperon $Nom]
	if { [llength $ListeOMO] < 2 } { continue }
	set Voisin [lindex $ListeOMO 0]

	set Couleur [CouleurSuivantOrganismesAyantMemeOperon $Nom]

	if { [Box $Nom orient] == "F" } {
	    set yHautMoi [expr $Position-30]
	    set yBasMoi  [expr $Position-3]
	    set StartMoi 270.
	} else {
	    set yHautMoi [expr $Position+3]
	    set yBasMoi  [expr $Position+30]
	    set StartMoi  0.
	}

	if { [Box $Voisin orient] == "F" } {
	    set yHautLui [expr $Position-30]
	    set yBasLui [expr $Position-3]
	    set StartLui 180.
	} else {
	    set yHautLui [expr $Position+3]
	    set yBasLui [expr $Position+30]
	    set StartLui  90.
	}

	if {$PourGif || 1} {
	    set xMoi [Milieu $Nom]
	    set xLui [Milieu $Voisin]
	} else {
	    set Moi [$K find withtag $Nom]
	    set Lui [$K find withtag $Voisin]
	    
	    scan [$K coords $Moi] "%f %f %f %f" a b c d
	    set xMoi [expr ($a+$c)/2]
	    set yMoi [expr ($b+$d)/2]
	    scan [$K coords $Lui] "%f %f %f %f" a b c d
	    set xLui [expr ($a+$c)/2]
	    set yLui [expr ($b+$d)/2]
	}
	$K create arc $xLui $yHautLui $xMoi $yBasLui  -start $StartLui -extent 90. -style arc -outline $Couleur -width 2  -tags [list "WebEnter" [TexteOMO $Nom "Long"]]
	$K create arc $xLui $yHautMoi $xMoi $yBasMoi  -start $StartMoi -extent 90. -style arc -outline $Couleur -width 2  -tags [list "WebEnter" [TexteOMO $Nom "Long"]]

	set xMilieu [expr ($xMoi+$xLui)/2]
	set yMilieu [expr ($yHautMoi+$yBasMoi)/2]
	$K create text $xMilieu $yMilieu  -anchor center  -font {Courier 2}  -text [TexteOMO $Nom "Court"]  -tags [list "Arc" "$Nom/$Voisin"]
	$K bind "Arc" <Enter> "PiqueArc $K %x %y"
	$K bind "Arc" <Leave> "PiqueArc $K %x %y Efface"
     }
     if {$PourGif && [info exists LesOrdresPourGif]} { return $LesOrdresPourGif }

}

proc RemplitDB_Foot {id {JNo 1}} {

    global db CalJ Eqp LgE Res

    $db eval {begin transaction}

    # remplit table equipes
    foreach e [set Eqp($id)] {
	$db eval {insert into equipe values (NULL, $e , $id)}
    }

    # remplit table matches    
    set Lres [array names Res "$id,$JNo,*"]
    while {$Lres != {}} {
	set Done 0
	foreach e $Lres {
	    lassign [split $e ,] idr jnor jdate jidate date idate e1 e2
	    lassign [set Res($e)] s1 s2 note
	    set report 0
	    set note ""
	    lassign [PointsDuMatch $s1 $s2] pt1 pt2 s1N2

	    # on enregistre la journee, une seule fois.
	    if {! $Done} {
		$db eval {insert into journee values (NULL, $id, $jnor, $jdate, $jidate)}
		set pkj [$db last_insert_rowid]
		set Done 1
	    }
	    $db eval {insert into match values (NULL, $pkj, $idr, $date, $idate, $JNo, $report, $e1, $e2, $s1, $s2, $s1N2, $note)}
	}
	
	incr JNo
	set Lres [array names Res "$id,$JNo,*"]
    }

    $db eval {commit}

    return

}

proc RemplitDB_Loto Lres {

    global db

    $db eval {begin transaction}
    foreach e $Lres {
	lassign $e date Ljeu Lm Lr
	if {[string range $date 0 1] == 99} {
	    set idate -1
	} else {
	    set idate [clock scan "$date 12:00"]
	}
	if {$idate < 0} {
	    continue
	}
	
	lassign $Ljeu jeu No

	$db eval {insert into jeu values (NULL, $jeu, $No, $date, $idate)}
	set pkjeu [$db last_insert_rowid]
	foreach m $Lm {
	    lassign $m id jrnm dtm idtm e1 e2 s1 s2 s1n2 note
	    $db eval {insert into grille values (NULL, $pkjeu, $id, $jrnm, 0, $dtm, $idtm, $e1, $e2, $s1, $s2, $s1n2, $note)}
	}

	foreach r $Lr {
	    lassign $r jeu nbon gain nwin
	    $db eval {insert into gain values (NULL, $pkjeu, $nbon, $gain, $nwin)}
	}
	puts "inserted jeu $date"
    }
    $db eval {commit}

    return

}

proc RemplitMoyenne {} {

    global db
    
    $db eval {begin transaction}
    set pke 1
    foreach ilot {1 5 10 20} {
	set pki [$db eval {select pk_ilot from ilot where nbilots=$ilot}]

	set Lgen [lsort -integer -unique [$db eval {select gen from data where pk_ilot=$pki and pk_exp=$pke}]]
	
	foreach gen $Lgen {
	    set Lv [$db eval {select time,best,avg from data where pk_ilot=$pki and pk_exp=$pke and gen=$gen}]
	    set mt 0.0 ; set mb 0.0 ; set mm 0.0
	    foreach {tim bst avg} $Lv {
		set mt [expr {$tim + $mt}]
		set mb [expr {$bst + $mb}]
		set mm [expr {$avg + $mm}]
	    }
	    set n [expr {[llength $Lv]/2.}]
	    set mt [expr {$mt/$n}]
	    set mb [expr {$mb/$n}]
	    set mm [expr {$mm/$n}]

	    $db eval {insert into moy values (NULL,$pki,$pke,$gen,$mt,$mb,$mm)}
	}
    }
    $db eval {commit}
    $db eval {create index idx_moy on moy (pk_ilot, pk_exp, gen)}
    
    return

}

proc RenaissanceDuWidget {K Id {Action {}}} {
 
    global BufferMainLevee

    set Type [$K type $Id]

    set LesOptions {}
    foreach OptionValeurs [$K itemconfigure $Id] {
	set Option [lindex $OptionValeurs 0]
	set Valeur [lindex $OptionValeurs 4]
	if {$Valeur=={}} { set Valeur "\{\}" }
	if {[regexp " " $Valeur]} { set Valeur "\{$Valeur\}" }
	lappend LesOptions "$Option $Valeur"
    }
    set Ancien "$K create $Type [$K coords $Id] [join $LesOptions " "]"

    if {$Action=="Copy"} {
	set BufferMainLevee $Ancien
	return $Ancien
    }

    while 1 { 
	set Nouveau [Entre $Ancien]
	if {$Nouveau==$Ancien} { return $Id }
	if {$Nouveau==""} { return "" }
	catch {set NouveauId [eval $Nouveau]} Message
	if { ! [regexp {[^0-9]} $Message]} { break }
	FaireLire "I got this message : \n$Message"
	if {[OuiOuNon "Do I keep the widget ?"]} { return $Id }
    }
    if {[OuiOuNon "Do I delete the old Widget ? "]} { $K delete $Id }
    return $Nouveau

}

