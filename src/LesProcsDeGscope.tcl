proc Cif {{Qui {}} {Quoi {}} {File {}}} {

    global Cif
    #rR Cif extracts all info from a Crystallographic Information File
    #rR     as command line by                gscope putl Cif ...
    #rR     or through CafeDesSciences with   qds Zero Cif ...
    #rR     webservice                        https://lbgi.fr/wscoperr?science=Zero&CifCr&ListOf&Key&store/1ASY.cif 
    #rR                                       https://lbgi.fr/wscoperr?science=Zero&Cif&Text&&store/1ASY.cif 
    #rR     on the web at                     https://lbgi.fr/cif
    #rR     ... to get the correct format use Cif, CifCr, CifPre or CifCrPre 
    #rR Cif Help                           ; # return this Help
    #rR Cif Qui Quoi {File ""}             ; # if File is absent it uses the previous one, otherwise reloads
    #rR Cif File Value store/1qru.cif      ; # returns store/1qru.cif              
    #rR Cif File Value                     ; # returns the previous one
    #rR Cif Text                           ; # returns the content of the Cif file
    #rR Cif ListOf Key                     ; # returns all keys (simple and loop)
    #rR Cif ListOf SimpleKey               ; # returns all simple keys
    #rR Cif ListOf SimpleKeyClass          ; # returns all simple key classes
    #rR Cif ListOf LoopKey                 ; # returns all loopkeys (as integer)
    #rR Cif ListOf LoopKeyClass            ; # returns all loop key classes (as text)
    #rR Cif AsymAndEntities                ; # returns all LabelAsym AuthLabel Entity
    #rR Cif _entity ListOfLines            ; # returns all entities
    #rR Cif _entry.id                      ; # returns the value of the key _entry.id
    #rR Cif _citation.title                ; # returns the list of the title from the loop _citation.title
    #rR Cif _citation LoopLength           ; # returns the length of the loop _citation
    #rR Cif _citation ListOfKey            ; # returns the keys the loop _citation
    #rR Cif _citation ListOfLines          ; # returns the lines from the loop _citation
    #rR Cif _citation Loop                 ; # returns the loop number of _citation (from 1 to n)
    #rR Cif _citation KeyClass             ; # returns the keyClass of _citation (it is _citation)
    #rR Cif 2 Loop                         ; # returns the lopp number of loop 2 (it is 2)
    #rR Cif 2 KeyClass                     ; # returns the KeyClass of loop 2
    #rR CifEntity Help                     ; # if you want information about Entities
    #rR CifAsym Help                       ; # if you want information about Asymetric Units
    #rR CifEx Help                         ; # to query loops with conditions
    
    # attention avec Help on ne recharge pas même si File est non vide
    if {[string equal -nocase "Help" $Qui]} { return [HelpDeLaProcedure] }

    if {$Qui =="."} { set Qui  "" }
    if {$Quoi=="."} { set Quoi "" }

    # On réinitialise si nouveau
    set CifFilePath [CifFilePath $File]
	
    if {$Qui ==""} { set Qui  "Help" } 
    if {$Quoi==""} { set Quoi "Value" }
    if {[info exists Cif("EstCharge")] && [info exists Cif($Qui,$Quoi)]} { return $Cif($Qui,$Quoi) }
    if {[info exists Cif("EstCharge")]} {
	if {$Qui=="Text" && $Quoi=="Value"} { return [CifToken Text] }
	if {[regexp {^[0-9]+$} $Quoi]} {
	    if {[info exists Cif($Qui,Value)]} {
		return [lindex $Cif($Qui,Value) $Quoi-1]
	    }
	}
	if {$Qui=="ValuesOf" && $Quoi=="SimpleKeys"} {
	    set LesLignes {}
	    foreach Key $Cif(ListOf,SimpleKey) {
		set Value $Cif($Key,Value)
		regsub {^\{} $Value "" Value
		regsub {\}$} $Value "" Value
		lappend LesLignes "[format %-52s $Key] $Value"
	    }
	    return $LesLignes
	}
	if {$Qui=="AsymAndEntities"} {
	    set LesLignes [CifEx _atom_site label_asym_id,auth_asym_id,label_entity_id DISTINCT I NE -1]
	    set LesLignesCompletes {}
	    foreach Ligne $LesLignes {
		lassign $Ligne L A E
		set Entity [lrange [lindex [CifEntity $E _entity ListOfLines] 0] 0 3]
		set LigneComplete "$L\t$A\t$Entity"
		lappend LesLignesCompletes $LigneComplete
	    }
	    return $LesLignesCompletes
	}
	if {[regexp -nocase "^Org" $Qui]} {
	    return [AboutOrganismsInCifFile]
	}
	if {$Qui=="All"} {
	    set LesLignes {}
	    foreach Key $Cif(ListOf,Key) {
		lappend LesLignes "$Key : $Cif($Key,Value)"
	    }
	    return [join $LesLignes "\n"]
	}
	if {$Quoi=="All"} {
	    set Qui [join $Cif($Qui,ListOfKey) ","]
	}
	if {[regexp {,} $Qui]} {
	    set LesQui [split $Qui ","]
	    set First [lindex $LesQui 0]
	    set Loop $Cif($First,Loop)
	    set LesLignes {}
	    foreach I [NombresEntre 1 [llength $Cif($First,Value)]] {
		set LaLigne {}
		foreach Q $LesQui {
		    lappend LaLigne [lindex $Cif($Q,Value) $I-1]
		}
		set Ligne [join $LaLigne " "]
		lappend LesLignes $Ligne
	    }
	    return [join $LesLignes "\n"]
	}
	#rR Qui peut être la LoopKeyClass au lieu de Loop
	set LoopKeyClass $Qui
	if {[info exists Cif($LoopKeyClass,Loop)]} {
	    set Loop $Cif($LoopKeyClass,Loop)
	    if {[info exists Cif($Loop,$Quoi)]} { return $Cif($Loop,$Quoi) }
	}
	if {[info exists Cif($Qui.$Quoi,Value)]} { return $Cif($Qui.$Quoi,Value) }
	if {[regexp {^[0-9]+$} $Qui] && [info exists Cif($Qui,LoopKeyClass)]} {
	    set LoopKeyClass $Cif($Qui,LoopKeyClass) 
	    if {[info exists Cif($LoopKeyClass.$Quoi,Value)]} { return $Cif($LoopKeyClass.$Quoi,Value) }
	}
	return ""
    }
    ##################################################################################
    set Cif("EstCharge") 1
    set Cif(ListOf,Loop) {}
    set Cif(ListOf,LoopKey) {}
    set Cif(ListOf,CifLoopKey) {}
    set Data ""
    CifToken Init $CifFilePath
    set Loop -1
    while 1 {
	set Token [CifToken]
	if {$Token==""} { break }
	if {[regexp "^data_" $Token]} {
	    if {$Data==""} {
		set Data $Token
	    } else {
		FaireLire "I cannot yet manage mutiple data_"
		break
	    }
	}
	if {[regexp "^_" $Token]} {
	    set Key $Token
	    lappend Cif(ListOf,Key)       $Key
	    lappend Cif(ListOf,SimpleKey) $Key
	    regsub {\..+$} $Key "" SimpleKeyClass
	    lappend Cif(ListOf,SimpleKeyClass) $SimpleKeyClass
	    set Value [CifToken]
	    set Cif($Key,Value) $Value
	    continue
	}
	if {$Token=="loop_"} {
	    incr Loop
	    set Key [CifToken]
	    regsub {\..+$} $Key "" LoopKeyClass
	    set Cif($Loop,LoopKeyClass)      $LoopKeyClass
	    set Cif($LoopKeyClass,Loop)      $Loop
	    lappend Cif(ListOf,LoopKeyClass) $LoopKeyClass
	    lappend Cif(ListOf,Loop)         $Loop
	    CifToken -1
	    while 1 {
		set Token [CifToken]
		if {$Token==""} { break }
		if {[regexp "^_" $Token]} {
		    set Key $Token
		    regsub {\..+$} $Key "" LoopKeyClass
		    regsub {^[^\.]+\.} $Key "" SubKey
		    lappend Cif($LoopKeyClass,ListOfKey)    $Key
		    lappend Cif($LoopKeyClass,ListOfSubKey) $SubKey
		    lappend Cif($Loop,ListOfKey)            $Key
		    lappend Cif($Loop,ListOfSubKey)         $SubKey
		    set Cif($Loop,Width) [llength $Cif($Loop,ListOfSubKey)]
		    lappend Cif(ListOf,LoopKey)             $Key
		    lappend Cif(ListOf,CifLoopKey)          "Cif $Key"
		    set     Cif($Key,Loop)                  $Loop
		} else {
		    if {$Token=="loop_"} {
			CifToken -2
			break
		    }
		    set LesColonnes [CifToken "0+$Cif($Loop,Width)"]
		    set Ligne [join $LesColonnes "\t"]
		    lappend Cif($Loop,ListOfLines) $Ligne
		    foreach Key $Cif($Loop,ListOfKey) Value $LesColonnes {
			lappend Cif($Key,Value) $Value
		    }
		    set Next [CifToken]
		    if {$Next=="loop_"} {
			CifToken -2
			break
		    }
		    if {[regexp "^_" $Next] || $Next==""} {
			CifToken -1
			break
		    }
		    CifToken -1
		}
	    }
	}
    }
    set Cif(ListOf,SimpleKeyClass) [lunique $Cif(ListOf,SimpleKeyClass)]
    foreach Loop $Cif(ListOf,Loop) {
	set FirstKey   [lindex $Cif($Loop,ListOfKey) 0]
	set LoopLength [llength $Cif($FirstKey,Value)]
	set Cif($Loop,LoopLength) $LoopLength
	set Cif($Cif($Loop,LoopKeyClass),LoopLength) $LoopLength
	set Cif($Loop,Loop) $Loop
    }
    set Cif(ListOf,CifLoopKey) [join $Cif(ListOf,CifLoopKey) "\n"]
    set Cif(ListOf,AllKey) [concat $Cif(ListOf,Key) $Cif(ListOf,LoopKey)]
    return [Cif $Qui $Quoi $File]

}

proc CifAsym {{Qui {}} {Quoi {}} {File {}}} {

    # on doit pouvoir en lever tous les file sauf le premier ... A faire !
    #rR CifAsym concerns the asymetric units
    #rR CifAsym Qui Quoi File
    #rR         Qui  can be empty ("") or . (dot) 
    #rR         Quoi can be empty ("") or . (dot)
    #rR         third argument can be File or empty or . then same from previous call
    #rR ... it's better to always use the Label and not Auth
    #rR ... if you want to use Auth instead of Label call me with CifAsym Auth_A ... I'll translate
    #rR CifAsym Help                     ; # returns this help
    #rR CifAsym                          ; # returns same as CifAsym ListOf LabelAuth File
    #rR CifAsym ListOf LabelAuth File    ; # returns these correspondances LabelAsym and AuthAsym
    #rR CifASym L Auth                   ; # returns all Auth  of the Label L
    #rR CifASym A Label                  ; # returns all Label of the Auth A (can be a list) !??
    #rR CifAsym L AtomPdbLike            ; # returns the atoms of Label L as Pdb format
    #rR CifAsym Auth_A AtomPdbLike       ; # returns the atoms of Auth A as Pdb format
    #rR CifAsym L _entity.id             ; # returns the entity_id of Label L
    #rR CifAsym Auth_A _entity.id        ; # returns the entity_id of Auth A
    #rR CifAsym L Sequence               ; # returns the Sequence of Label L
    #rR CifAsym L Sequence               ; # returns the Sequence of Label L
    #rR CifAsym L Sequence1Letter        ; # returns the Sequence1Letter  of Label L
    #rR CifAsym L Sequence3Letters       ; # returns the Sequence3Letters of Label L
    #rR CifAsym B _atom_site.Cartn_x,Cartn_y,Cartn_z store/1ASY.cif   ; #rR B must be a valid label_asim_id

    if {$File==""} { set File [Cif File Value] }

    global CifAsym Cif
    if { ! [info exists Cif("EstCharge")]} { Cif bidon bidon $File }

    # Si on demande Auth_X on force la recherche avec le Label correspondant 
    if {[regexp {^Auth_(.+)$} $Qui Match A]} {
	if { ! [info exists CifAsym("EstCharge",$File)]} { CifAsym bidon bidon $File }
	return [CifAsym [CifAsym $A Label $File] $Quoi $File]
    }
    
    if {[string equal -nocase "Help" $Qui]} { return [HelpDeLaProcedure] }

    if {$Qui =="."} { set Qui  "" }
    if {$Quoi=="."} { set Quoi "" }
    if {$File=="."} { set File "" }

    if {$Qui=="" && $Quoi==""} { set Qui "ListOf"; set Quoi "LabelAuth" }
    
    if {$Quoi=="AtomPdbLike"} {
	set LesKeys [list group_PDB id auth_atom_id auth_comp_id auth_asym_id auth_seq_id Cartn_x Cartn_y Cartn_z occupancy B_iso_or_equiv type_symbol]
	set Keys _atom_site.[join $LesKeys ","]
	if { ! [info exists CifAsym("EstCharge",$File)]} { CifAsym . . $File }
	return [CifAsym $Qui $Keys $File]
    }

    if {$Quoi=="Labelauth"} { set Quoi "LabelAuth" }
    
    if {[info exists CifAsym($Qui,$Quoi,$File)]} { return $CifAsym($Qui,$Quoi,$File) }
    if {[info exists CifAsym("EstCharge",$File)]} {
	set Reponse ""
	if {[regexp -nocase "SeqRes" $Quoi]} {
	    if { ! $CifAsym($Qui,Polymer,$File)} { return {} }
	    if {[regexp -nocase "A" $Quoi]} {
		set LaSequence [CifEx _pdbx_poly_seq_scheme auth_mon_id WHERE asym_id EQ $Qui AND File EQ $File]
	    } else {
		set LaSequence [CifEx _pdbx_poly_seq_scheme      mon_id WHERE asym_id EQ $Qui AND File EQ $File]
	    }
	    set IsNucleic 0
	    set RxAminos [join [UT ListOfAmino] "|"]
	    if { ! [regexp -nocase $RxAminos $LaSequence]} { set IsNucleic 1 } 
	    if {[regexp -nocase {[13]} $Quoi]} {
		set LaSequence13 {}
		foreach S $LaSequence {
		    if {[regexp -nocase "1" $Quoi] && [string length $S]==3} { set S [UT $S] }
		    if {[regexp -nocase "3" $Quoi] && [string length $S]==1} { set S [UT $S $IsNucleic] }
		    lappend LaSequence13 $S
		}
		return $LaSequence13
	    }
	    #Espionne LaSequenceSeqRes de $Qui \n $LaSequence
	    return $LaSequence
	}
	if {[regexp -nocase "Sequence" $Quoi]} {
	    if { ! $CifAsym($Qui,Polymer,$File)} { return {} }
	    set LaSequence [CifEx _atom_site label_comp_id WHERE label_asym_id EQ $Qui AND label_seq_id NE Previous AND File EQ $File]
	    if {[regexp -nocase {[13]} $Quoi]} {
		set LaSequence13 {}
		foreach S $LaSequence {
		    if {[regexp -nocase "1" $Quoi] && [string length $S]==3} { set S [UT $S] }
		    if {[regexp -nocase "3" $Quoi] && [string length $S]==1} { set S [UT $S] }
		    lappend LaSequence13 $S
		}
		return $LaSequence13
	    }
	    return $LaSequence
	}
	if {[regexp -nocase "_entity" $Quoi]} {
	    set EntityId [CifEx _atom_site label_entity_id DISTINCT_WHERE label_asym_id EQ $Qui AND File EQ $File]
	    lassign [split $Quoi "."] E Q
	    return [CifEntity $EntityId $E $Q $File]
	}
	# avec une LoopKeyClass et plusieurs Subkeys séparées par ,
	if {[regexp {^([^\.]+)\.(.+)$} $Quoi Match LoopKeyClass SubKey]} {
	    if {$SubKey=="All"} {
		set SubKey [join [Cif $LoopKeyClass ListOfSubKey] ","]
	    }
	    set Reponse [CifEx $LoopKeyClass $SubKey WHERE label_asym_id eq $Qui AND File EQ $File]
	}
	return $Reponse
    }
    set CifAsym("EstCharge",$File) 1
    set AsymAndEntities [Cif AsymAndEntities . $File]
    set CifAsym(ListOf,LabelAuth,$File) {}
    foreach Ligne $AsymAndEntities {
	lassign [split $Ligne "\t"] L A E
	lappend CifAsym(ListOf,LabelAuth,$File) "$L $A"
	#Attention on ne fournit que l'autre ...pas soi-même car on ne sait pas de quoi on part
	set CifAsym($L,Auth,$File) $A
	set CifAsym($L,Polymer,$File) [expr [regexp "polymer" $E] && ! [regexp "non-polymer" $E]]
	if { ! [info exists CifAsym($A,Label,$File)]} {
	    set CifAsym($A,Label,$File) $L
	} else {
	    # on préfère le polymer aux autres !!!
	    if {$CifAsym($L,Polymer,$File)} { set CifAsym($A,Label,$File) $L }
	}	    
	lappend CifAsym(ListOf,Label,$File) $L
	lappend CifAsym(ListOf,Auth,$File)  $A
    }
    return [CifAsym $Qui $Quoi $File]

}

proc CifEntity {{Id {}} {Qui {}} {Quoi {}} {File {}}} {

    #rR ATTENTION il y a 4 arguments !!
    #rR CifEntity Id Qui Quoi File
    #rR CifEntity                            ; # returns all entities
    #rR CifEntity 1 ListOfLines              ; # returns all lines from entity 1
    #rR CifEntity 1 _atom_site auth_comp_id  ; # returns all auth_comp_id from _atom_site concerning entity 1
    #rR CifEntity 2 Sequence (3 lines below) ; # for the sequence please use CifAsym instead 
    #rR CifEntity 2 Sequence                 ; # returns the sequence extracted from _atom_site.auth_comp_id
    #rR CifEntity 2 Sequence1Letter          ; # converts to 1 letter code
    #rR CifEntity 2 Sequence3Letters         ; # converts to 3 letters code
    #rR CifEntity 1 RefSeq                   ; # returns the SEQRES sequence from entity 1
    #rR CifEntity 1 RefSeq1Letter            ; # converts to 1 letter code
    #rR CifEntity 1 RefSeq3Letters           ; # converts to 3 letters code
    #rR CifEntity 2 _struct_asym ListOfLines ; # returns the lines of the _struc_asym concerning entity 2
    #rR CifEntity Help                       ; # returns this Help

    if {[string equal -nocase "Help" $Id]} { return [HelpDeLaProcedure] }

    # pour les étourdis qui oubliraient le Quoi vide
    if {$File=="" && [regexp {\.cif} $Quoi]} {
	set File $Quoi
	set Quoi ""
    }
    
    if {$Qui=="ListOf" && [regexp "Asym" $Quoi]} {
	set LesLabel [CifAsym ListOf Label]
	set MesLabel {}
	foreach Label $LesLabel {
	    if {[CifAsym $Label _entity.id $File]!=$Id} { continue }
	    if {[regexp "Auth" $Quoi]} { set Label [CifAsym $Label Auth] }
	    lappend MesLabel $Label
	}
	return $MesLabel
    }

    if {[regexp -nocase {^Sequence} $Qui]} {
	set LaSequenceAtomique [CifEntity $Id _atom_site auth_comp_id $File]
	set LesSeqIdAtomique   [CifEntity $Id _atom_site auth_seq_id  $File]
	set PreviousSeqId "inconnu"
	foreach S $LaSequenceAtomique SId $LesSeqIdAtomique {
	    if {[regexp "1" $Qui] && [string length $S]==3} { set S [UT $S] }
	    if {[regexp "3" $Qui] && [string length $S]==1} { set S [UT $S] }
	    if {$SId!=$PreviousSeqId} { lappend LaSequence $S }
	    set PreviousSeqId $SId
	}
	return $LaSequence
    }
    if {[regexp -nocase {^RefSeq} $Qui] } {
	set LaSequenceLue [CifEntity $Id _entity_poly_seq mon_id $File]
	set LaSequence {}
	foreach S $LaSequenceLue {
	    if {[regexp "1" $Qui]  && [string length $S]==3} { set S [UT $S] }
	    if {[regexp "3" $Qui]  && [string length $S]==1} { set S [UT $S] }
	    lappend LaSequence $S
	}
	return $LaSequence
    }
    if {$Id=="" && $Qui=="" && $Quoi==""} { return [Cif "_entity" "ListOfLines" $File] }
    
    if {$Qui=="" && $Quoi==""} {
	set Qui "_entity"
	set Quoi "ListOfLines"
    }
    set LesKeys [Cif $Qui "ListOfKey" $File]
    set LoopKeyClass [Cif $Qui LoopKeyClass $File]
    foreach IdKey [list "$LoopKeyClass.entity_id" "$LoopKeyClass.label_entity_id" "_entity.id" "trululu"] {
	if {[lsearch $LesKeys $IdKey]>=0} { break }
    }
    if {$IdKey=="trululu"} { return "" }
    set LeRetour {}
    set LesValeurs [Cif $LoopKeyClass $Quoi $File]
    foreach IdLu [Cif $IdKey] Value $LesValeurs {
	if {$Id!=$IdLu} { continue }
	lappend LeRetour $Value
    }
    return $LeRetour

}

proc CifEx args {

    #rR CifEx Qui Quoi WHERE k1 EQ v1 AND k2 LT V2 AND File EQ fichier.cif
    #rR       Qui est une Loop, Quoi une subkey de la loop et les k1 des subkey
    #rR                         Quoi peut être ListOfLines
    #rR                         Quoi peut contenir des virgules Q1,Q2,Q3
    #rR                              les résultats seront joints par \t pour créer une ligne
    #rR CifEx _atom_site label_asym_id,auth_asym_id DISTINCT_WHERE File eq store/1ASY.cif

    set Qui  [lindex $args 0]
    set Quoi [lindex $args 1]

    if {[string equal -nocase "Help" $Qui]} { return [HelpDeLaProcedure] }

    set File ""
    set LesCle {}
    set LesOpe {}
    set LesVal {}
    set Distinct 0
    foreach {Conjonction C O V} [lrange $args 2 end] {
	if {[regexp -nocase DISTINCT $Conjonction]} { set Distinct 1 }
	if {[regexp -nocase ONCHANGE $Conjonction]} { set OnChange($C) 1 } ; #attention ne sert pas voir "ne previous"
	if {$C=="File"} { set File $V ; continue }
	lappend LesCle $C
	lappend LesOpe $O
	lappend LesVal $V
    }
    foreach C $LesCle {
	set LesValeurs($C) [Cif $Qui $C $File]
	set Previous($C) "-987654321"
    }

    set Longueur 0
    foreach K [split $Quoi ","] {
	set Resultat($K) [Cif $Qui $K $File]
	if {$Longueur==0} { set Longueur [llength $Resultat($K)] }
    }
    set LesLignesResultat {}
    for {set I 0} {$I<$Longueur} {incr I} {
	set LaLigne {}
	foreach K [split $Quoi ","] {
	    set Valeur [lindex $Resultat($K) $I]
	    if {[regexp {^=} $K]} { set Valeur [string trim $K "="] }
	    lappend LaLigne $Valeur
	}
	lappend LesLignesResultat [join $LaLigne "\t"]
    }
    set LeRetour {}
    set I -1
    foreach Line $LesLignesResultat {
	incr I
	set OnGarde  1
	foreach C $LesCle O $LesOpe V $LesVal {
	    set O [OpEx $O]
	    if {$C!="I"} {
		set ValeurLue [lindex $LesValeurs($C) $I]
	    } else {
		set ValeurLue $I
	    }
	    if {[string equal -nocase $V "Previous"]} {
		set V $Previous($C)
	    }
	    set Previous($C) $ValeurLue
	    if {[string is integer $ValeurLue] || [string is double $ValeurLue]} {
		if { ! [expr $ValeurLue $O $V] } { set OnGarde 0; break }
	    } else {
		if { ! [expr \"$ValeurLue\" $O \"$V\"] } { set OnGarde 0; break }
	    }
	    #Espionne \"$ValeurLue\" $O \"$V\"
	}
	if {$OnGarde} { lappend LeRetour $Line }
    }
    if {$Distinct} { set LeRetour [lunique $LeRetour] }
    return $LeRetour

}

proc CifFilePath {{File {}}} {

    global Cif
    global CifToken
    global CifAsym
    if {[regexp -nocase  {^[0-9][a-z0-9]{3}$} $File]} {
	set FILE [string toupper $File]
	set File "https://files.rcsb.org/download/$FILE.cif"
    }
    if { ! [info exists Cif(File,Value)]} { set  Cif(File,Value) "/cif/store/1qru.cif" }
    #if { ! [info exists Cif(File,Value)]} { set  Cif(File,Value) "/cif/store/4w2f-assembly1.cif" }
    set CifFile $Cif(File,Value)

    if {$File!="" && $File!=$CifFile} {
	if {[info exists Cif     ]} { unset Cif      }
	if {[info exists CifToken]} { unset CifToken }
	if {[info exists CifAsym ]} { unset CifAsym  }
	set CifFile $File
	set Cif(File,Value) $CifFile
    }

    set CifFilePath $CifFile
    if {[regexp "^store/"     $CifFilePath]} { set CifFilePath "/home/ripp/cif/$CifFilePath" }
    if {[regexp "^/cif/store" $CifFilePath]} { set CifFilePath "/home/ripp$CifFilePath" }
    return $CifFilePath

}

proc CifToken {{Lequel {}} {CifFilePath {}}} {

    global CifToken
    
    if {$Lequel=="."} { set Lequel "" }
    if {$Lequel=="" } { set Lequel "1" }    
    
    if {[info exists CifToken("EstCharge")]} {
	set Longueur 1
	if {[regexp {^([\-0-9]+)(\+([0-9]+))?} $Lequel Match Increment Plus Longueur]} {
	    if {$Longueur==""} { set Longueur 1 }
	    #Espionne $Match $Increment $Plus $Longueur
	    set D [expr $CifToken(Current) + $Increment]
	    set F [expr $D + $Longueur -1]
	    set LesVoulus [lrange $CifToken(All) $D $F]
	    set CifToken(Current) $F
	    #Espionne "$Lequel LesVoulus $LesVoulus "
	    return $LesVoulus
	}
	if {[info exists CifToken($Lequel)]} { return $CifToken($Lequel) }
	return ""
    }
    
    set CifToken("EstCharge") 1

    set CifFilePathArray "$CifFilePath.tok"

    if {[file exists $CifFilePathArray]} {
	array set CifToken [ContenuDuFichier $CifFilePathArray]
	return [CifToken $Lequel $CifFilePath]
    }
    
    set Texte [ContenuDuFichier $CifFilePath]
    set CifToken(Text) $Texte
    set LesC [split "\n$Texte\n" ""]
    set LesP [lrange $LesC 0 end-2]
    set LesX [lrange $LesC 1 end-1]
    set LesS [lrange $LesC 2 end]
    set InSemiColon   0
    set InSimpleQuote 0
    set InDoubleQuote 0
    set InComments    0
    set Token ""
    foreach P $LesP X $LesX S $LesS {
	if {$P eq "\n" && $X eq "#"} {
	    set InComments 1
	    if {$X eq "#" && $S eq "\n"} { set InComments 0 }
	    continue
	}
	if {$InComments && $S ne "\n"} {
	    continue
	}
	if {$InComments && $S eq "\n"} {
	    set InComments 0
	    continue
	}
	if {$P eq "\n" && $X eq ";"} {
	    if {$InSemiColon} {
		set InSemiColon 0
		lappend LesToken [string trim $Token]
		set Token ""
		continue
	    } else {
		set InSemiColon 1
		set Token ""
		continue
	    }
	}
	if {$InSemiColon} {
	    append Token $X
	    continue
	}
	if { ! $InDoubleQuote } {
	    if {$X eq "'"} {
		if {$InSimpleQuote} {
		    set Tok [string trim $Token]
		    if {[string index $Tok 0] eq "_"} { set Tok "'$Tok'" } ; # si jamais !!!
		    lappend LesToken $Tok
		    set Token ""
		    set InSimpleQuote 0
		    continue
		} else {
		    set InSimpleQuote 1
		    set Token ""
		    continue
		}
	    }
	}
	if { ! $InSimpleQuote } {
	    if {$X eq "\""} {
		if {$InDoubleQuote} {
		    set Tok [string trim $Token]
		    if {[string index $Tok 0] eq "_"} { set Tok "\"$Tok\"" } ; # si jamais !!!
		    lappend LesToken $Tok
		    set Token ""
		    set InDoubleQuote 0
		    continue
		} else {
		    set InDoubleQuote 1
		    set Token ""
		    continue
		}
	    }
	}
	if { ! $InSimpleQuote && ! $InDoubleQuote} {
	    if {$X ne " " && $X ne "\t" && $X ne "\n"} {
		append Token $X
		continue
	    } else {
		if {$Token ne "" } { lappend LesToken [string trim $Token] }
		set Token ""
		continue
	    }
	}
	if {$InSimpleQuote || $InDoubleQuote} {
	    append Token $X
	    continue
	}
    }
    set CifToken(Current) -1
    set CifToken(All)     $LesToken
    set CifToken(Size)    [llength $LesToken]

    if { ! [regexp "^http" $CifFilePathArray] && [FileAbsent $CifFilePathArray]} {
	Sauve [array get CifToken] dans $CifFilePathArray
    }
    return [CifToken $Lequel $CifFilePath]

}

proc CioNarcisse A {

    global CioNarcisse

    if {[info exists CioNarcisse($A)]} { return [set CioNarcisse($A)] }
    if {[info exists CioNarcisse("EstCharge")]} { return $A }

    set CioNarcisse("EstCharge") 1

    foreach Ligne [LesLignesDuFichier "/genomics/link/Ciona/fiches/narcisse"] {
        set X ""
        set Y ""
        scan $Ligne "%s %s" X Y
        set CioNarcisse($X) $Y
        set CioNarcisse($Y) $X
    }
    return [CioNarcisse $A]

}

proc CirCode {{Qui {}} {Quoi {}}} {

    #rR Be carefull : if you don't set DefaultCircode it is 00 except if you are in setgscope MAMAxy (01 ... 30)
    #rR  ... and you have to be in the same runing process when you set DefaultCircode
    #rR
    #rR you can get the list of codon from CirCode or X0 or IsX0 (CirCode is the best manner)
    #rR CirCode xy                   returns the corresponding list of codons
    #rR CirCode DefaultCirCode       returns the DefaultCirCode value (ie 00 or 01 ... or 30)
    #rR CirCode DefaultCirCode xy    sets the DefaultCirCode to xy
    #rR CirCode ListOf Codon         from the DefaultCirCode
    #rR CirCode ListOf AA            from the DefaultCirCode (1 letter amino acid)
    #rR CirCode ListOf AA3           from the DefaultCirCode (3 letters amino acid)
    global DefaultCirCode
    set Qui  [string toupper $Qui]
    set Quoi [string toupper $Quoi]

    set R(00) [list AAC AAT ACC ATC ATT CAG CTC CTG GAA GAC GAG GAT GCC GGC GGT GTA GTC GTT TAC TTC]
    set R(01) [list AAC AAT ACA ACT AGG ATA ATT CAA CAG CTC CTG GCC GCG GCT GGC GTA GTC GTT TGC TGT]
    set R(02) [list ACT AGG AGT ATA ATG CAA CAG CCA CCG CTC GAA GAG GCT GGC TAC TAT TCC TCT TGG TTG]
    set R(03) [list AAT ACC AGA ATT CCT CGA CGG CTA CTC CTG GAA GAC GAT GCC GCG GGT GTG TAC TAT TTA]
    set R(04) [list ACC AGA AGG ATA ATC CCG CCT CGC CTA CTC CTG CTT GAA GAT GCA GGA GTA GTG TGT TTA]
    set R(05) [list AAC AAG ACA AGC CCA CGA CTG CTT GAG GCA GCC GGC GTA GTT TAC TAT TCA TCT TGG TGT]
    set R(06) [list AAC ACG AGA AGG ATA CCT CGC CGG CGT CTA CTG GAA GAC GCT GTA TAT TCC TGC TTA TTG]
    set R(07) [list AAT ACT AGT ATC CAA CCT CGA CTG GAC GAG GAT GCA GCG GCT GTA TAC TAT TCC TCG TGG]
    set R(08) [list AAG ACG AGG ATA ATG CAT CCA CGG CGT CTT GAC GCA GCC GCT GGC TAC TAT TCA TTA TTG]
    set R(09) [list AAG ACG ACT AGG AGT ATC CAA CAG CCT CGA CGC CTG CTT GCA GGT GTG GTT TAC TAT TCA]
    set R(10) [list ACC ACT AGA AGT ATG CAG CAT CCA CGC CTT GAA GAT GCA GCT GGA GGC GTA TCT TGT TTC]
    set R(11) [list AAC AAT ACA ACT AGG AGT ATA CAT CGC CTA CTC GAC GCA GCC GGC GTC GTT TGG TGT TTG]
    set R(12) [list AAG ACG ACT AGG ATA CAA CAC CAG CCT CGT CTA GAG GCA GCC GTG GTT TAT TCG TCT TTG]
    set R(13) [list AAC AAT AGA AGC ATT CAG CCT CGC CGG CTA GAC GAT GCC GGC GGT GTA TAT TCA TTC TTG]
    set R(14) [list ACA ACC ACG AGA AGG ATC ATT CAC CAT CCT CGT GAG GCA GGA GGC GTT TGC TGT TTA TTC]
    set R(15) [list AAC ACA ACC AGC AGG ATA CAT CGC CGG CTT GCA GGA GTA GTG TAC TCG TCT TGG TTA TTC]
