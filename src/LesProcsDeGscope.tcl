    bind $P.names <Double-1> "tc_loadNamedColor \[$P.names get \[$P.names curselection\]\] $P"
    scrollbar $P.scroll -orient vertical  -command "$P.names yview"  -relief sunken -borderwidth 2
    pack $P.names -in $P.middle.left -side left
