	grid      $EntryIdMin            -row 1 -column 1 -rowspan 1 -columnspan 1 -sticky nsew
	grid      $LabelNbSubjectMax     -row 2 -column 0 -rowspan 1 -columnspan 1 -sticky nsew
	grid      $EntryNbSubjectMax     -row 2 -column 1 -rowspan 1 -columnspan 1 -sticky nsew
	grid      $LabelCompression      -row 3 -column 0 -rowspan 1 -columnspan 1 -sticky nsew
	grid      $EntryCompression      -row 3 -column 1 -rowspan 1 -columnspan 1 -sticky nsew
	pack   $BoutonApply              -side left -fill x -expand 1
	pack   $BoutonDefaut             -side left -fill x -expand 1
	pack   $BoutonClose              -side left -fill x -expand 1
	
	$BoutonApply    configure -command "LaunchOrApplyDrawBlast $v"
	$BoutonDefaut   configure -command "DefautOptionsDrawBlast $v"
	$BoutonClose    configure -command "destroy   $w"
    }

}

proc DrawChoixDesBoitesDuProjetGscope FichierGOPourGscope {

    if {![file exists $FichierGOPourGscope]} {return}

    set FichierOCADE "[file dirname $FichierGOPourGscope]/Orf2Cluster2Access2Def2Expression"
    set FichierNomsInteressants "[file dirname $FichierGOPourGscope]/LesNomsInteressants"
    if {[file exists $FichierOCADE]} {
	set AiJeUnFichierAvecLesInfosDeChaqueSequence 1
	set LesNomsDuProjet [InterrogeOrf2Cluster2Access2Def2Expression $FichierOCADE LesNoms]
    } else {
	set AiJeUnFichierAvecLesInfosDeChaqueSequence 0
	set LesNomsDuProjet [InterrogeGeneOntology $FichierGOPourGscope LesNoms]
    }
    if {[file exists $FichierNomsInteressants]} {
	set LesNomsDuProjet [LesLignesDuFichier $FichierNomsInteressants]
    }

    set LesClustersSelectionnes {}
    if {$AiJeUnFichierAvecLesInfosDeChaqueSequence} {
	set LesClusters         {}
	set LesClustersAffiches {}
	foreach Cluster [InterrogeOrf2Cluster2Access2Def2Expression $FichierOCADE LesClusters] {
	    set Taille [llength [InterrogeOrf2Cluster2Access2Def2Expression $FichierOCADE Cluster $Cluster LesNoms]]
	    lappend LesClusters $Cluster
	    lappend LesClustersAffiches [format "Cluster %-4s Length %s" $Cluster $Taille]
	}
        foreach Cluster [DrawEntreDeux $LesClusters $LesClustersAffiches] {set TabClusterSelect($Cluster) 1}
    }

    set LesNoms     {}
    set LesAffiches {}
    foreach Nom $LesNomsDuProjet {
	set Cluster [InterrogeOrf2Cluster2Access2Def2Expression $FichierOCADE $Nom Cluster   ]
	set Texte $Nom
	if {$AiJeUnFichierAvecLesInfosDeChaqueSequence} {
	    if {![info exists TabClusterSelect($Cluster)]} {continue}
	    set Cluster [InterrogeOrf2Cluster2Access2Def2Expression $FichierOCADE $Nom Cluster   ]
	    if {$Cluster != ""} {append Texte [format " Cluster %-4s"  $Cluster]}
	    set Access  [InterrogeOrf2Cluster2Access2Def2Expression $FichierOCADE $Nom Access    ]
	    if {$Access  != ""} {append Texte [format " Acc %-15s"  $Access ]}
	    set Def     [InterrogeOrf2Cluster2Access2Def2Expression $FichierOCADE $Nom Definition]
	    if {$Def     != ""} {append Texte [format " Def %s" $Def    ]}
	}
	lappend LesNoms $Nom 
	lappend LesAffiches [string trim $Texte]
    }
    set     LesNomsSelectionnes {}
    foreach Nom [DrawEntreDeux $LesNoms $LesAffiches] {lappend LesNomsSelectionnes [list $Nom $FichierGOPourGscope]}
    return  $LesNomsSelectionnes

}

proc DrawChoixDesHitsDuBlast FichierBlast {

    global ChoixMultipleRadio
    global validOk
    if {![file exists $FichierBlast]} {return}

    set LesValeurs  {}
    set LesAffiches {}
    foreach LeHit [LesHitsDuBlast $FichierBlast 1e200 1e200] {
	if {$LeHit == ""} {continue}
	set BId [lindex $LeHit 0]
	if {$BId   == "" || [regexp {^[0-9]} $BId]} {continue}
	set Acc [lindex $LeHit 1]
	set Exp [lindex $LeHit 2]
	set Sco [lindex $LeHit 3]

	lappend LesValeurs $BId
	set Texte [string trim [format "%-20s %-15s %-10s %-10s" [string range $BId 0 19] $Acc $Exp $Sco]]
	lappend LesAffiches $Texte

	if {$Exp <= 0.001} {set ChoixMultipleRadio($Texte) p} else {set ChoixMultipleRadio($Texte) a}
	if {$Exp <= 0.001} {set ChoixMultipleRadio($BId) p} else {set ChoixMultipleRadio($BId) a}
    }
    if {$LesValeurs == {}} {return} 
    set validOk 1
    return [DrawEntreDeux $LesValeurs $LesAffiches]

}

proc DrawChoixDesHitsDuClustering FichierDPCouSecator {

    if {![file exists $FichierDPCouSecator]} {return}
    
    set LesAccess   {}
    set LesAffiches {}
    foreach Cluster    [InterrogeLesClustersDesMSF $FichierDPCouSecator LesClusters                ] {
	foreach Access [InterrogeLesClustersDesMSF $FichierDPCouSecator Cluster $Cluster LesAccess] {
	    if {$Access   == "" || [regexp {^[0-9]} $Access]} {continue}
	    lappend LesAccess   $Access
	    lappend LesAffiches [string trim [format "Cluster %-5s Access %-20s" $Cluster $Access]]
	}
    }
    if {$LesAccess == {}} {return}
    return [DrawEntreDeux $LesAccess $LesAffiches]

}

proc DrawChoixDesHitsDuMSF FichierMSF {

    if {![file exists $FichierMSF]} {return}
    set LesAccess  {}
    if {![DecortiqueUnMSF $FichierMSF LesAccess TabSequences]} {return}
