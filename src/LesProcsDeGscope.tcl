    if {$QuestionDejaPoseeEtOui || ! [file exists $FichierPIClustalw]} { 
	CreeLesFichiersPIClustalwEtPSClustalw $Orga $Extension
    }

    CreeLesTables "distancesphylo" $Orga $Extension

}

