    set AvecATV [file exists "[RepertoireDuGenome]/phylos"]

    set AvecAutresBoutons [expr $WithLinkToPipealign || [OnTraiteSpine] || [OnTraiteBalibase] || [OnTraitePeroxisome]  || [MacsimExiste] || [OnTraite "KoAnno"]]
    set LesBoutons {}
    if {$AvecAutresBoutons} {
