    set_balloon $RBTmMethod2 "Thermodynamic method (<70 nts)"
    set_balloon $RBTmMethod3 "Method for DNA-DNA duplex (50<L<100 nts)"
    set_balloon $RBTmMethod4 "Method for DNA-RNA duplex (50<L<100 nts)"
    set_balloon $RBTmMethod5 "Method for RNA-RNA duplex (50<L<100 nts)"

    #2.2.3.1 Advanced Parameters
    set FAdvanced1   "$FParameters3.fadvanced1"
    set  LAdvanced1  "$FAdvanced1.ladvanced1"
    set  BAdvanced1  "$FAdvanced1.badvanced1"
    set FAdvanced2   "$FParameters3.fadvanced2"

    frame $FAdvanced1                       -relief "ridge"  -borderwidth "2"
    label $LAdvanced1 -background "#808FFF" -relief "groove" -text "Advanced Parameters"
