	entry     $EntryIdMin            -borderwidth 1 -textvariable TabOptionsDeDrawBlast($v,IdMin)
	label     $LabelNbSubjectMax     -borderwidth 1 -text "Nb Subject Max"
	entry     $EntryNbSubjectMax     -borderwidth 1 -textvariable TabOptionsDeDrawBlast($v,NbSubjectMax)
	label     $LabelCompression      -borderwidth 1 -text "Compression"
	entry     $EntryCompression      -borderwidth 1 -textvariable TabOptionsDeDrawBlast($v,TailleMaxDUneRegionNonAlignee)
	button $BoutonApply              -borderwidth 1 -text "APPLY"
	button $BoutonDefaut             -borderwidth 1 -text "DEFAULT"
	button $BoutonClose              -borderwidth 1 -text "CLOSE"
	
	pack   $FrameThreshold           -side top -fill both
	grid      $LabelExpectMax        -row 0 -column 0 -rowspan 1 -columnspan 1 -sticky nsew
	grid      $EntryExpectMax        -row 0 -column 1 -rowspan 1 -columnspan 1 -sticky nsew
