proc DefinitionConsensus {Nom FileMSF FileClust {IdDesProtId 0.98} {NorMDMin 0.5} {NbMilliSecMax 30000} {NbIndiv 20}} {

    if {![file exists $FileMSF]} {return}
    AskMSF unset

    if {[AskMSF $FileMSF $Nom] != ""} {
	set Query $Nom
    } elseif {[AskMSF $FileMSF "QUERY_PROTEIN"] != ""} {
	set Query "QUERY_PROTEIN"
    } else {
	return
    }
    set LesAccess [LesProteinesProchesDeLaProteineDeRef $Query $FileMSF $FileClust $IdDesProtId "AvecCluster" $NorMDMin]

    AskLesPagesInfos load $LesAccess protein

    set LesMotsDeRef {}
    set LesDefinitionsDeRef {}
    foreach Access $LesAccess {
	if {$Access == $Query        } {continue}
	if {[regexp {^[0-9]} $Access]} {continue}

	LesPhrasesMemorisees         UNSET
	InterrogeLesEffectifsDesMots UNSET

	set PageInfo [AskLesPagesInfos ask $Access]
	if {$PageInfo == ""} {continue}
	set Def      [join [LaDefinitionDeLaProt_PageInfo $PageInfo] " "]
	if {$Def      == ""} {continue}

	Espionne "$Access $Def"
	lappend LesDefinitionsDeRef $Def
    }
    AskLesPagesInfos unset

    if {$LesDefinitionsDeRef == {}} {return}
    LesPhrasesMemorisees $LesDefinitionsDeRef
    if {[LesPhrasesMemorisees] == {}} {return}
    return [AlgoGenet $NbIndiv $NbMilliSecMax]

}

