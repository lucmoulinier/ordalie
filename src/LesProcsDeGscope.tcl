    pack   $LProjGscope -side left -fill both
    pack   $EProjGscope -side left -fill both
    pack   $BProjGscope -side left -fill both
    pack   $FBoxGscope -side top -fill x
    pack   $LBoxGscope -side left -fill both
    pack   $EBoxGscope -side left -fill both
    pack   $BBoxGscope -side left -fill both
    pack   $FBlastP -side top -fill x
    pack   $LBlastP -side left -fill both
    pack   $EBlastP -side left -fill both
    pack   $BBlastP -side left -fill both
    
