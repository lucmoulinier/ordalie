    radiobutton $RBTmMethod1 -relief "groove" -anchor "w" -variable TmMethod -text "Wallace" -value "Wallace" -command {
	set Text "4*(G+C)+2*(A+T)"
	$LTmMethod2 configure -text $Text
	LesParametresDuDesign TmMethod $TmMethod "Positionne"
	AjouteAuLog "Tm method: Wallace"
    }
    radiobutton $RBTmMethod2 -relief "groove" -anchor "w" -variable TmMethod -text "Nearest Neighbor (Default)" -value "NearestNeighbor" -command {
	set Text "1000*DH/(DS+R*ln(\[ADN\]/4)-273.15)"
	$LTmMethod2 configure -text $Text
	LesParametresDuDesign TmMethod $TmMethod "Positionne"
	AjouteAuLog "Tm method: Nearest Neighbor"
    }
    radiobutton $RBTmMethod3 -relief "groove" -anchor "w" -variable TmMethod -text "DNA-DNA" -value "DNADNA" -command {
	set Text "81.5+16.6*log M+0.41(%GC)-500/L-0.62F"	       
	$LTmMethod2 configure -text $Text			       
	LesParametresDuDesign TmMethod $TmMethod "Positionne"	       
	AjouteAuLog "Tm method: DNA-DNA"			       
    }								       
    radiobutton $RBTmMethod4 -relief "groove" -anchor "w" -variable TmMethod -text "DNA-RNA" -value "DNARNA" -command {
	set Text "79.8+18.5*log M+0.584(%GC)+11.8(%GC)^2-820/L-0.35F"  
	$LTmMethod2 configure -text $Text			       
	LesParametresDuDesign TmMethod $TmMethod "Positionne"	       
	AjouteAuLog "Tm method: DNA-RNA"			       
    }								       
    radiobutton $RBTmMethod5 -relief "groove" -anchor "w" -variable TmMethod -text "RNA-RNA" -value "RNARNA" -command {
	set Text "79.8+18.5*log M+0.584(%GC)+11.8(%GC)^2-820/L-0.50F"
	$LTmMethod2 configure -text $Text
	LesParametresDuDesign TmMethod $TmMethod "Positionne"
	AjouteAuLog "Tm method: RNA-RNA"
    }
    set_balloon $LTmMethod   "Methods to calculate the melting temperature (Tm)"
