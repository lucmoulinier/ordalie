proc CheckLesZones K {

    Wup "Permet de mettre les numeros de zones dans un ordre convenable"
    
    set ListeIdLigne ""
    set         LesIds [$K find withtag {"Zonable" && "Flag"}]
    foreach Id $LesIds {
	lappend ListeIdLigne [list $Id [lindex [$K coords $Id] 0]]
    }
    set nbLigne      [llength $ListeIdLigne]
    set ListeIdLigne [lsort -increasing -real -index 1 $ListeIdLigne]

    set i 0
    foreach Ligne $ListeIdLigne {
	incr i
	if {$i >$nbLigne} {break}
	$K itemconfigure [lindex $Ligne 0] -text "$i"
    }
    return ""

}

proc CheckRestrictionEnzymes {NomOuAlias {ListOfEnzymes {}} {Texte {}} {Quoi {}}} {

    if {[regexp "^Get" $Texte]} { set Quoi $Texte ; set Texte "" } 

    regsub "^for_" $NomOuAlias "" NomOuAlias

    if {$ListOfEnzymes=="" || $ListOfEnzymes=="All"} { set ListOfEnzymes [RestrictionEnzyme ListOf Enzymes] }
    if {$ListOfEnzymes=="Signals"} {
	set ListOfEnzymes {}
	foreach Signal [Signal ListOf Signals] {
	    set EstUnSignal($Signal) 1 
	}
	foreach E [RestrictionEnzyme ListOf Enzymes] {
	    if {[info exists EstUnSignal($E)]} { lappend ListOfEnzymes $E }
	}
    }

    set Nom ""
    set Alias ""
    set DE ""
    while {$Nom==""} {
	if {$NomOuAlias=="FromFile"}      { set Nom "FromFile"  ; set NomOuAlias $Texte }
	if {[regexp "/" $NomOuAlias]}     { set Nom "FromFile"  ; break }
	if {$NomOuAlias=="FromSequence"}  { set Nom $NomOuAlias ; break }
	if {[EstUnPAB $NomOuAlias]}       { set Nom $NomOuAlias ; break }
	if {[NomDuAlias $NomOuAlias]!=""} { set Nom $NomOuAlias ; break }
	if {$Texte==""} { set Texte $NomOuAlias }
	set NomOuAlias "FromSequence"
    }
    if {[EstUnPAB $Nom]} {
	set Alias [Alias $Nom]
	set DE [DefinitionRapide $Nom]
	set Seq [QueLaSequenceDuFichierTFA [GscopeFile $Nom "nuctfa"]]
    }
    if {$Nom=="FromSequence"} {
	if {[regexp ">" $Texte]} {
	    set Seq [QueLaSequenceDuTexteTFA $Texte]
	} else {
	    set Seq $Texte
	}
    }
    if {$Nom=="FromFile"} {
	set Seq [QueLaSequenceDuFichierTFA $NomOuAlias]
	set Nom $NomOuAlias
    }

    set Seq [string toupper $Seq]
    set LesHits [list "CheckRestrictionEnzymes for $Nom $Alias $DE"]
    foreach E $ListOfEnzymes {
	set SE [string toupper [RestrictionEnzyme $E "Sequence"]]
	set SEX [IUPAC $SE]

	set LesDFs [regexp -all -indices -inline $SEX $Seq]
	if {$LesDFs=={}} {
	    lappend LesHits "[format %-8s $E] [format %-20s $SE]         NotFound"
	} else {
	    set LesIs {}
	    foreach DF $LesDFs {
		scan $DF "%d" I
		lappend LesIs "[expr $I+1] [expr ($I+3)/3]"
	    }
	    lappend LesHits "[format %-8s $E] [format %-20s $SE] [join $LesIs " / "]"
	}
    }
    set Hits [join $LesHits "\n"]
    if {$Quoi=="GetHtml"} { return [Html_DuTexteTelQuel $Hits] }
    if {$Quoi=="GetHits"} { return $Hits } 
    return [AfficheVariable $Hits "" "Restriction Enzymes Hits for $Nom"]

}

proc CheckTFAFile Fichier {

    Wup "Permet de tester et de decider pour un fichier fasta multiple"
    Wup "Retourne vide si rien n est fait et le nom des fichiers si des fichiers sont crees"

    if {! [file exists $Fichier]} {return ""}

    set LesNewFiles ""
    if {[EstCeUnTFAOuUnTFAS $Fichier]>1} {
	if {[OuiOuNon "$Fichier seems to be a multiple fasta sequence file.\nI need one file per sequence.\nWould you like to split your sequences ?"]} {
	    set Dir         [tk_chooseDirectory -title "Choose a saving directory." -initialdir "[RepertoireDuGenome]"]
	    set LesNewFiles [SplitLeTFAS $Fichier $Dir]
	}
    }

    return "$LesNewFiles"

}

proc ChefDOrchestreDuCalculDEnrichissement args {

    global TabDuChefDOrchestreDuCalculDEnrichissement
    global LePanelPrincipalDuGOEnrichment

    if {$args == ""} {return}
    set PremierArg [lindex $args 0]

    if {[string equal -nocase $PremierArg "LesTypesDEntry"]} {
	return [list "Access" "Access file" "Blast file" "MSF file" "Clustering file" "Gscope GO file"]
    }
    
    if {[string equal -nocase $PremierArg "unsetgroup"]} {
	set TabDuChefDOrchestreDuCalculDEnrichissement(Groupe,LesAccess)           {}
	set TabDuChefDOrchestreDuCalculDEnrichissement(Groupe,LesBoitesGscope)     {}
	set TabDuChefDOrchestreDuCalculDEnrichissement(Groupe,LesIndividus)        {}
	return
    }
    if {[string equal -nocase $PremierArg "unsetpopulation"]} {
	set TabDuChefDOrchestreDuCalculDEnrichissement(Population,LesAccess)       {}
	set TabDuChefDOrchestreDuCalculDEnrichissement(Population,LesBoitesGscope) {}
	set TabDuChefDOrchestreDuCalculDEnrichissement(Population,Lesindividus)    {}
	return
    }
    if {[string equal -nocase $PremierArg "unset"]} {
	if {[info exists TabDuChefDOrchestreDuCalculDEnrichissement]} {unset TabDuChefDOrchestreDuCalculDEnrichissement}
	ChefDOrchestreDuCalculDEnrichissement Ini
	return
    }
    if {[string equal -nocase $PremierArg "Ini"]} {
	if {[info exists TabDuChefDOrchestreDuCalculDEnrichissement]} {unset TabDuChefDOrchestreDuCalculDEnrichissement}
	set TabDuChefDOrchestreDuCalculDEnrichissement(Groupe,LesAccess)           {}
	set TabDuChefDOrchestreDuCalculDEnrichissement(Groupe,LesBoitesGscope)     {}
	set TabDuChefDOrchestreDuCalculDEnrichissement(Groupe,LesIndividus)        {}
	set TabDuChefDOrchestreDuCalculDEnrichissement(Population,LesAccess)       {}
	set TabDuChefDOrchestreDuCalculDEnrichissement(Population,LesBoitesGscope) {}
	set TabDuChefDOrchestreDuCalculDEnrichissement(Population,Lesindividus)    {}

	set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,rMin)      0
	set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,rMax)      1.e200   
	set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,RMin)      0
	set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,RMax)      1.e200
	set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,nMin)      0
	set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,nMax)      1.e200
	set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,NMin)      0
	set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,NMax)      1.e200
	set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,ZscoreMin) 0
	set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,ZscoreMax) 1.e200
	return
    }
    if {[string equal -nocase $PremierArg "AppendGroup"] || [string equal -nocase $PremierArg "AppendPopulation"]} {
	if {[string equal -nocase $PremierArg "AppendGroup"]} {set Qui "Groupe"} else {set Qui "Population"}

	set Type  [lindex $args 1]
	set Entry [lindex $args 2]
	if {$Type == "" || $Entry == ""} {return}
	if {[regexp -nocase " file" $Type] && ![file exists $Entry]} {return}

	if {[string equal -nocase $Type "Access"]} {lappend TabDuChefDOrchestreDuCalculDEnrichissement($Qui,LesAccess) $Entry}
	if {[string equal -nocase $Type "Access file"]} {
	    foreach Access [LesLignesDuFichier $Entry] {
		set Access [string trim $Access]
		if {$Access == ""} {continue}
		scan $Access "%s" Access
		lappend TabDuChefDOrchestreDuCalculDEnrichissement($Qui,LesAccess) $Access
	    }
	}
	if {[string equal -nocase $Type "Blast file"]} {
	    foreach Access [DrawChoixDesHitsDuBlast  $Entry] {
		lappend TabDuChefDOrchestreDuCalculDEnrichissement($Qui,LesAccess) $Access      
	    }
	}
	if {[string equal -nocase $Type "Clustering file"]} {
	    foreach Access [DrawChoixDesHitsDuClustering  $Entry] {
		lappend TabDuChefDOrchestreDuCalculDEnrichissement($Qui,LesAccess) $Access        
	    }
	}
	if {[string equal -nocase $Type "MSF file"       ]} {
	    foreach Access [DrawChoixDesHitsDuMSF   $Entry] {
		lappend TabDuChefDOrchestreDuCalculDEnrichissement($Qui,LesAccess) $Access        
	    }
	}
	if {[string equal -nocase $Type "Gscope GO file" ]} {
	    foreach LaBoiteGscope [DrawChoixDesBoitesDuProjetGscope  $Entry] {
		lappend TabDuChefDOrchestreDuCalculDEnrichissement($Qui,LesBoitesGscope) $LaBoiteGscope
	    }
	}
	return
    }
    if {[string equal -nocase $PremierArg "set"]} {
	set Quoi [join [lrange $args 1 end] ","]
	if {![info exists TabDuChefDOrchestreDuCalculDEnrichissement($Quoi)]} {return}
	return [set TabDuChefDOrchestreDuCalculDEnrichissement($Quoi)]
    }
    if {[string equal -nocase $PremierArg "append"]} {
	set Quoi [join [lrange $args 1 end-1] ","]
	if {$Quoi == ""} {return}
	set AAjouter [lindex $args end]
	set TabDuChefDOrchestreDuCalculDEnrichissement($Quoi) $AAjouter
	return [set TabDuChefDOrchestreDuCalculDEnrichissement($Quoi)]
    }
    if {[string equal -nocase $PremierArg "Affiche"]} {
	set LesZscore                    [lindex $args 1]

	set rMin      [set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,rMin)     ]
	set rMax      [set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,rMax)     ]
	set RMin      [set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,RMin)     ]
	set RMax      [set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,RMax)     ]
	set nMin      [set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,nMin)     ]
	set nMax      [set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,nMax)     ]
	set NMin      [set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,NMin)     ]
	set NMax      [set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,NMax)     ]
	set ZscoreMin [set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,ZscoreMin)]
	set ZscoreMax [set TabDuChefDOrchestreDuCalculDEnrichissement(Valeur,ZscoreMax)]	

	set ListePourLHisto [list "z score"]

	set NbZscore 0
	foreach LeZscore $LesZscore {
	    set GO     [lindex $LeZscore 0]

	    set r      [lindex $LeZscore 2]
	    if {[EstCeUnNombre $rMin     ] && $r      < $rMin     } {continue}
	    if {[EstCeUnNombre $rMax     ] && $r      > $rMax     } {continue}
	    set R      [lindex $LeZscore 3]
	    if {[EstCeUnNombre $RMin     ] && $R      < $RMin     } {continue}
	    if {[EstCeUnNombre $RMax     ] && $R      > $RMax     } {continue}
	    set n      [lindex $LeZscore 4]
	    if {[EstCeUnNombre $nMin     ] && $n      < $nMin     } {continue}
	    if {[EstCeUnNombre $nMax     ] && $n      > $nMax     } {continue}
	    set N      [lindex $LeZscore 5]
	    if {[EstCeUnNombre $NMin     ] && $N      < $NMin     } {continue}
	    if {[EstCeUnNombre $NMax     ] && $N      > $NMax     } {continue}
	    set Zscore [format "%.3f" [lindex $LeZscore 1]]
	    if {[EstCeUnNombre $ZscoreMin] && $Zscore < $ZscoreMin} {continue}
	    if {[EstCeUnNombre $ZscoreMax] && $Zscore > $ZscoreMax} {continue}
	    
	    incr NbZscore

	    set ET     ""
	    set Color "lightgrey"

	    set     LInfo {}
	    lappend LInfo "GO         : $GO"
	    lappend LInfo "Definition :" 

	    set LesDefinitions {}
	    foreach Type [GODB GO $GO LesTypes] {
		set GO [GODB Type $Type GOSynonyme $GO GODeRef]
		if {[string equal -nocase $Type "component"]} {set Color "green"}
		if {[string equal -nocase $Type "function" ]} {set Color "blue" }
		if {[string equal -nocase $Type "process"  ]} {set Color "red"  }

		foreach Definition [GODB Type $Type GO $GO LesDefinitions] {
		    if {$Definition == ""} {continue}
		    if {![info exists TabTmp($GO,$Definition)]} {
			set TabTmp($GO,$Definition) 1
			lappend LInfo " $Definition"
			lappend LesDefinitions $Definition
		    }
		}
	    }

	    set DefDeRef [lindex $LesDefinitions 0]

	    set LesAccessDuGroupe       [ChefDOrchestreDuCalculDEnrichissement "set" GO $GO LesAccessDuGroupe            ]
	    set LesAccessDeLaPop        [ChefDOrchestreDuCalculDEnrichissement "set" GO $GO LesAccessDeLaPopulation      ]
	    set LesBoitesGscopeDuGroupe [ChefDOrchestreDuCalculDEnrichissement "set" GO $GO LesBoitesGscopeDuGroupe      ]
	    set LesBoitesGscopeDeLaPop  [ChefDOrchestreDuCalculDEnrichissement "set" GO $GO LesBoitesGscopeDeLaPopulation]

	    lappend LInfo "z score    : $Zscore"
	    lappend LInfo "Group      : $r / $R with this GO"
	    lappend LInfo "Population : $n / $N with this GO"
	    lappend LInfo "Group      :"
	    foreach LaBoite $LesBoitesGscopeDuGroupe {
		set Nom       [lindex $LaBoite 0]
		set FichierGO [lindex $LaBoite 1]
		lappend LInfo " $Nom $FichierGO"
	    }
	    lappend LInfo " [join $LesAccessDuGroupe " "]"
	    
	    lappend LInfo "Population :"
	    foreach LaBoite $LesBoitesGscopeDeLaPop {
		set Nom       [lindex $LaBoite 0]
		set FichierGO [lindex $LaBoite 1]
		lappend LInfo " $Nom $FichierGO"
	    }
	    lappend LInfo " [join $LesAccessDeLaPop  " "]" 
	    
	    set LeTexteDefinitif {}
	    foreach Ligne $LInfo {
		while {100 < [string length $Ligne]} {
		    lappend LeTexteDefinitif [string range $Ligne 0  59 ]
		    set     Ligne            [string range $Ligne 60 end]
		}
		if {[string length $Ligne] != 0} {lappend LeTexteDefinitif $Ligne}
	    }
	    set Qui "$GO : $DefDeRef [format "%8s" $Zscore]"

	    set     LesTags         [list "GO" [join $LeTexteDefinitif "\n"]]
	    lappend ListePourLHisto [list $Qui $Color $Zscore $ET $LesTags]
	}
	if {$NbZscore <= 0} {return}
	if {[info exists TabTmp]} {unset TabTmp}

	set FrameDuCanva  ""
	set KCanva         [lindex $LePanelPrincipalDuGOEnrichment 0]
	regsub {\.[^\.]+$} $KCanva "" FrameDuCanva

	if {[winfo exists $FrameDuCanva]} {destroy $FrameDuCanva}
	set FrameCanva [lindex $LePanelPrincipalDuGOEnrichment 5]
	set LMax       [lindex $LePanelPrincipalDuGOEnrichment 1]
	set HMax       [lindex $LePanelPrincipalDuGOEnrichment 2]
	set LWin       [lindex $LePanelPrincipalDuGOEnrichment 3]
	set HWin       [lindex $LePanelPrincipalDuGOEnrichment 4]
	set HauteurMax     [expr $HWin * 1.0 / 15 + $NbZscore * 30]
	if {$HauteurMax < $HWin} {set HauteurMax $HWin}
	set KCanva         [Canva $LMax $HauteurMax $LWin $HWin NoY "" "" $FrameCanva]
	$KCanva configure -background white
	set LePanelPrincipalDuGOEnrichment [list $KCanva $LMax $HMax $LWin $HWin $FrameCanva]
	
	PlaceLHistogramme $ListePourLHisto $KCanva 0 $HauteurMax 0 $LWin "Vertical"
	return $KCanva
    }
    if {[string equal -nocase $PremierArg "Calcul"]} {
	set TousLesGODesIndividusDuGroupe {}
	set TousLesGODesIndividusDeLaPop  {}
	foreach LaBoite [set TabDuChefDOrchestreDuCalculDEnrichissement(Groupe,LesBoitesGscope)] {
	    set Nom       [lindex $LaBoite 0]
	    set FichierGO [lindex $LaBoite 1]

	    set FichierProtJum "[file dirname $FichierGO]/ProteinesJumelles"
	    Espionne "Group $Nom from $FichierGO"

	    if {![info exists TabDuChefDOrchestreDuCalculDEnrichissement(Gscope,$FichierGO,Nom,$Nom,LesGO)]} {
		set LesGODeLaBoite {}
		foreach     GO [InterrogeGeneOntology $FichierGO $Nom LesGO] {
		    foreach Type [GODB GO $GO LesTypes                     ] {
			set GO [GODB Type $Type GOSynonyme $GO GODeRef]
			if {$GO == ""} {continue}
			lappend LesGODeLaBoite $GO
			foreach GOParent [InterrogeGeneOntology $FichierGO GO $GO LesAncetres] {
			    set GOParent [GODB Type $Type GOSynonyme $GOParent GODeRef]
			    if {$GOParent == ""} {continue}
			    lappend LesGODeLaBoite $GOParent
			}
		    }
		}
		set LesGODeLaBoite [lsort -unique $LesGODeLaBoite]
		set TabDuChefDOrchestreDuCalculDEnrichissement(Gscope,$FichierGO,Nom,$Nom,LesGO) $LesGODeLaBoite
	    } else {
		set LesGODeLaBoite [set TabDuChefDOrchestreDuCalculDEnrichissement(Gscope,$FichierGO,Nom,$Nom,LesGO)]
	    }
	    foreach GO $LesGODeLaBoite {
		if {![info exists TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesBoitesGscopeDuGroupe)]} {
		    set TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesBoitesGscopeDuGroupe) {}
		}
		lappend TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesBoitesGscopeDuGroupe) $LaBoite
	    }
	    if {[info exists TabTmp(Groupe,$FichierGO,$Nom)]} {continue}
	    foreach Jum [InterrogeProteinesJumelles $FichierProtJum $Nom LesProteinesJumelles] {set TabTmp(Groupe,$FichierGO,$Jum) 1}

	    lappend TousLesGODesIndividusDuGroupe                                                  $LesGODeLaBoite
	    set TabTmp(Groupe,$FichierGO,$Nom) 1
	}
	foreach LaBoite [set TabDuChefDOrchestreDuCalculDEnrichissement(Population,LesBoitesGscope)] {
	    set Nom       [lindex $LaBoite 0]
	    set FichierGO [lindex $LaBoite 1]
	    
	    set FichierProtJum "[file dirname $FichierGO]/ProteinesJumelles"
	    Espionne "Population $Nom from $FichierGO"

	    if {![info exists TabDuChefDOrchestreDuCalculDEnrichissement(Gscope,$FichierGO,Nom,$Nom,LesGO)]} {
		set LesGODeLaBoite {}
		foreach GO [InterrogeGeneOntology $FichierGO $Nom LesGO] {
		    foreach Type [GODB GO $GO LesTypes                                 ] {
			set GO [GODB Type $Type GOSynonyme $GO GODeRef]
			if {$GO == ""} {continue}
			lappend LesGODeLaBoite $GO
			foreach GOParent [InterrogeGeneOntology $FichierGO GO $GO LesAncetres] {
			    set GOParent [GODB Type $Type GOSynonyme $GOParent GODeRef]
			    if {$GOParent == ""} {continue}
			    lappend LesGODeLaBoite $GOParent
			}
		    }
		}
		set LesGODeLaBoite [lsort -unique $LesGODeLaBoite]
		set TabDuChefDOrchestreDuCalculDEnrichissement(Gscope,$FichierGO,Nom,$Nom,LesGO) $LesGODeLaBoite
	    } else {
		set LesGODeLaBoite [set TabDuChefDOrchestreDuCalculDEnrichissement(Gscope,$FichierGO,Nom,$Nom,LesGO)]
	    }

	    foreach GO $LesGODeLaBoite {
		if {![info exists TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesBoitesGscopeDeLaPopulation)]} {
		    set TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesBoitesGscopeDeLaPopulation) {}
		}
		lappend TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesBoitesGscopeDeLaPopulation) $LaBoite
	    }

	    if {[info exists TabTmp(Population,$FichierGO,$Nom)]} {continue}
	    foreach Jum [InterrogeProteinesJumelles $FichierProtJum $Nom LesProteinesJumelles] {set TabTmp(Population,$FichierGO,$Jum) 1}

	    lappend TousLesGODesIndividusDeLaPop                                                  $LesGODeLaBoite
	    set TabTmp(Population,$FichierGO,$Nom) 1
	}
	if {[info exists TabTmp]} {unset TabTmp}

	########ACCESS###########
	set LesAccessDuGroupe [lsort -unique [set TabDuChefDOrchestreDuCalculDEnrichissement(Groupe,LesAccess)    ]]
	foreach Access $LesAccessDuGroupe {
	    Espionne "Group $Access"
	    if {![info exists TabDuChefDOrchestreDuCalculDEnrichissement(Access,$Access,LesGO)]} {
		lappend TabDuChefDOrchestreDuCalculDEnrichissement(Groupe,LesAccess) $Access

		set LesGODeLAccess {}
		set LesGO          [lsort -unique [Access2GO $Access]]
		set LesGO          [lsort -unique [concat $LesGO [TousLesAncetresGODesGO $LesGO]]]	
		foreach GO $LesGO {
		    foreach Type [GODB GO $GO LesTypes] {
			set GO [GODB Type $Type GOSynonyme $GO GODeRef]
			if {[info exists TabTmp(Groupe,$Access,$GO)]} {continue}
			set TabTmp(Groupe,$Access,$GO) 1
			
			lappend LesGODeLAccess                                                       $GO
		    }
		}
		set     LesGODeLAccess                                                   [lsort -unique $LesGODeLAccess]
		set     TabDuChefDOrchestreDuCalculDEnrichissement(Access,$Access,LesGO) $LesGODeLAccess
	    } else {
		set LesGODeLAccess [set TabDuChefDOrchestreDuCalculDEnrichissement(Access,$Access,LesGO)]
	    }
	    foreach GO $LesGODeLAccess {
		if {![info exists TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesAccessDuGroupe)]} {
		    set TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesAccessDuGroupe) {}
		}
		lappend TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesAccessDuGroupe) $Access
	    }
	    lappend TousLesGODesIndividusDuGroupe                                    $LesGODeLAccess
	}
	set LesAccessDeLaPop  [lsort -unique [set TabDuChefDOrchestreDuCalculDEnrichissement(Population,LesAccess)]]
	set TabDuChefDOrchestreDuCalculDEnrichissement(Population,LesAccess) $LesAccessDeLaPop
	foreach Access $LesAccessDeLaPop {
	    Espionne "Population $Access"
	    if {![info exists TabDuChefDOrchestreDuCalculDEnrichissement(Access,$Access,LesGO)]} {
		lappend TabDuChefDOrchestreDuCalculDEnrichissement(Population,LesAccess) $Access
		
		set LesGODeLAccess {}
		set LesGO          [lsort -unique [Access2GO $Access]]
		set LesGO          [lsort -unique [concat $LesGO [TousLesAncetresGODesGO $LesGO]]]	
		foreach GO $LesGO {
		    foreach Type [GODB GO $GO LesTypes] {
			set GO [GODB Type $Type GOSynonyme $GO GODeRef]
			if {[info exists TabTmp(Population,$Access,$GO)]} {continue}
			set TabTmp(Population,$Access,$GO) 1
			
			lappend LesGODeLAccess                                                             $GO
		    }
		}
		set     LesGODeLAccess                                                   [lsort -unique $LesGODeLAccess]
		set     TabDuChefDOrchestreDuCalculDEnrichissement(Access,$Access,LesGO) $LesGODeLAccess
	    } else {
		set LesGODeLAccess [set TabDuChefDOrchestreDuCalculDEnrichissement(Access,$Access,LesGO)]
	    }
	    foreach GO $LesGODeLAccess {
		if {![info exists TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesAccessDeLaPopulation)]} {
		    set TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesAccessDeLaPopulation) {}
		}
		lappend TabDuChefDOrchestreDuCalculDEnrichissement(GO,$GO,LesAccessDeLaPopulation) $Access
	    }

	    lappend TousLesGODesIndividusDeLaPop                                     $LesGODeLAccess
	}
	################################################
	if {[info exists TabTmp]} {unset TabTmp}

	return [LesZscoreDesRequetesDuGroupe $TousLesGODesIndividusDuGroupe $TousLesGODesIndividusDeLaPop]
    }
    return

}

proc ChefDOrchestreDuGOHisto args {

    global TabDuChefDOrchestreDuGOHisto
    global LePanelPrincipalDuGOHisto

    if {$args == ""} {return}
    set PremierArg [lindex $args 0]

    if {[string equal -nocase $PremierArg "LesTypesDEntry"]} {
	return [list "Access" "Access file" "Blast file" "MSF file" "Clustering file" "Gscope GO file"]
    }
    
    if {[string equal -nocase $PremierArg "unset"]} {
	if {[lindex $args 1] != ""} {
	    set Quoi [join [lrange $args 1 end] ","]
	    if {[info exists TabDuChefDOrchestreDuGOHisto($Quoi)]} {unset TabDuChefDOrchestreDuGOHisto($Quoi)}
	} else {
	    if {[info exists TabDuChefDOrchestreDuGOHisto]} {unset TabDuChefDOrchestreDuGOHisto}
	    ChefDOrchestreDuGOHisto Ini
	}
	return
    }
    if {[string equal -nocase $PremierArg "Ini"]} {
	if {[info exists TabDuChefDOrchestreDuGOHisto]} {unset TabDuChefDOrchestreDuGOHisto}
	set TabDuChefDOrchestreDuGOHisto(LesAccess)           {}
	set TabDuChefDOrchestreDuGOHisto(LesBoitesGscope)     {}
	set TabDuChefDOrchestreDuGOHisto(LesIndividus)        {}

	set TabDuChefDOrchestreDuGOHisto(Valeur,nMin)      0
	set TabDuChefDOrchestreDuGOHisto(Valeur,nMax)      1.e200
	set TabDuChefDOrchestreDuGOHisto(Valeur,NivMin)    0
	set TabDuChefDOrchestreDuGOHisto(Valeur,NivMax)    1.e200
	return
    }
    if {[string equal -nocase $PremierArg "AppendGroup"]} {
	set Type  [lindex $args 1]
	set Entry [lindex $args 2]
	if {$Type == "" || $Entry == ""} {return}
	if {[regexp -nocase " file" $Type] && ![file exists $Entry]} {return}

	if {[string equal -nocase $Type "Access"]} {lappend TabDuChefDOrchestreDuGOHisto(LesAccess) $Entry}
	if {[string equal -nocase $Type "Access file"]} {
	    foreach Access [LesLignesDuFichier $Entry] {
		set Access [string trim $Access]
		if {$Access == ""} {continue}
		scan $Access "%s" Access
		lappend TabDuChefDOrchestreDuGOHisto(LesAccess) $Access
	    }
	}
	if {[string equal -nocase $Type "Blast file"]} {
	    foreach Access [DrawChoixDesHitsDuBlast  $Entry] {
		lappend TabDuChefDOrchestreDuGOHisto(LesAccess) $Access      
	    }
	}
	if {[string equal -nocase $Type "Clustering file"]} {
	    foreach Access [DrawChoixDesHitsDuClustering  $Entry] {
		lappend TabDuChefDOrchestreDuGOHisto(LesAccess) $Access        
	    }
	}
	if {[string equal -nocase $Type "MSF file"       ]} {
	    foreach Access [DrawChoixDesHitsDuMSF   $Entry] {
		lappend TabDuChefDOrchestreDuGOHisto(LesAccess) $Access        
	    }
	}
	if {[string equal -nocase $Type "Gscope GO file" ]} {
	    foreach LaBoiteGscope [DrawChoixDesBoitesDuProjetGscope  $Entry] {
		lappend TabDuChefDOrchestreDuGOHisto(LesBoitesGscope) $LaBoiteGscope
	    }
	}
	return
    }
    if {[string equal -nocase $PremierArg "set"]} {
	set Quoi [join [lrange $args 1 end] ","]
	if {![info exists TabDuChefDOrchestreDuGOHisto($Quoi)]} {return}
	return [set TabDuChefDOrchestreDuGOHisto($Quoi)]
    }
    if {[string equal -nocase $PremierArg "append"]} {
	set Quoi [join [lrange $args 1 end-1] ","]
	if {$Quoi == ""} {return}
	set AAjouter [lindex $args end]
	set TabDuChefDOrchestreDuGOHisto($Quoi) $AAjouter
	return [set TabDuChefDOrchestreDuGOHisto($Quoi)]
    }
    if {[string equal -nocase $PremierArg "Save"]} {
	set TousLesGO  [lindex $args 1]

	set nMin      [set TabDuChefDOrchestreDuGOHisto(Valeur,nMin)     ]
	set nMax      [set TabDuChefDOrchestreDuGOHisto(Valeur,nMax)     ]
	set NivMin    [set TabDuChefDOrchestreDuGOHisto(Valeur,NivMin)   ]
	set NivMax    [set TabDuChefDOrchestreDuGOHisto(Valeur,NivMax)   ]

	if {[info exists TabTmp]} {unset TabTmp}

	set LeTexte {}
	foreach GO [lsort -unique $TousLesGO] {
	    foreach Type [GODB GO $GO LesTypes] {
		set Niv [lindex [GODB Type $Type GO $GO LesNiveaux    ] 0]
		set Def [lindex [GODB Type $Type GO $GO LesDefinitions] 0]

		set n 0
		set LesRefs {}
		foreach LaBoite [ChefDOrchestreDuGOHisto "set" GO $GO LesBoitesGscope ] {
		    set Nom       [lindex $LaBoite 0]
		    set FichierGO [lindex $LaBoite 1]

		    if {[info exists TabTmp($FichierGO,$Nom,$Type,$GO)]} {continue}
		    set TabTmp($FichierGO,$Nom,$Type,$GO) 1

		    lappend LesRefs $Nom
		    incr n
		}
		set LesRefs [join $LesRefs " "]

		set LesAccess {}
		foreach Access [ChefDOrchestreDuGOHisto "set" GO $GO LesAccess] {
		    if {[info exists TabTmp($Access,$Type,$GO)]} {continue}
		    set TabTmp($Access,$Type,$GO) 1
		    lappend LesRefs $Access
		    incr n
		}
		
		if {[EstCeUnNombre $nMin     ] && $n        < $nMin       } {continue}
		if {[EstCeUnNombre $nMax     ] && $n        > $nMax       } {continue}
		if {[EstCeUnNombre $NivMin   ] && $Niv      < $NivMin     } {continue}
		if {[EstCeUnNombre $NivMax   ] && $Niv      > $NivMax     } {continue}

		lappend LeTexte [list $GO $Type $Niv $Def $n $LesRefs] 
	    }
	    ChefDOrchestreDuGOHisto unset GO $GO LesAccess
	    ChefDOrchestreDuGOHisto unset GO $GO LesBoitesGscope
	}
	if {$LeTexte == {}} {return}
	set File [tk_getSaveFile -title "Choose a file name to save results"]
	if {[file exists $File]} {File delete -force $File}

	AppendAuFichier $File "GO\tType\tLevel\tDescription\tn\tLinks"
	foreach Ligne [lsort -index 4 -real -decreasing $LeTexte] {AppendAuFichier $File [join $Ligne "\t"]}
	return $File
    }

    if {[string equal -nocase $PremierArg "Affiche"]} {
	set TousLesGO  [lindex $args 1]

	set nMin      [set TabDuChefDOrchestreDuGOHisto(Valeur,nMin)     ]
	set nMax      [set TabDuChefDOrchestreDuGOHisto(Valeur,nMax)     ]
	set NivMin    [set TabDuChefDOrchestreDuGOHisto(Valeur,NivMin)   ]
	set NivMax    [set TabDuChefDOrchestreDuGOHisto(Valeur,NivMax)   ]

	set NbBarre 0

	if {[info exists TabTmp]} {unset TabTmp}

	set ListePourLHisto {}
	foreach GO [lsort -unique $TousLesGO] {
	    foreach Type [GODB GO $GO LesTypes] {
		set Niv [lindex [GODB Type $Type GO $GO LesNiveaux    ] 0]
		set Def [lindex [GODB Type $Type GO $GO LesDefinitions] 0]
		
		set     LInfo {}
		lappend LInfo "GO         : $GO"
		lappend LInfo "Type       : $Type"
		lappend LInfo "Definition : $Def" 

		set n 0

		foreach LaBoite [ChefDOrchestreDuGOHisto "set" GO $GO LesBoitesGscope ] {
		    set Nom       [lindex $LaBoite 0]
		    set FichierGO [lindex $LaBoite 1]

		    if {[info exists TabTmp($FichierGO,$Nom,$Type,$GO)]} {continue}
		    set TabTmp($FichierGO,$Nom,$Type,$GO) 1
		    lappend LInfo " $Nom $FichierGO"
		    incr n
		}
		set LesAccess {}
		foreach Access [ChefDOrchestreDuGOHisto "set" GO $GO LesAccess] {
		    if {[info exists TabTmp($Access,$Type,$GO)]} {continue}
		    set TabTmp($Access,$Type,$GO) 1
		    lappend LesAccess $Access
		    incr n
		}

		lappend LInfo [join $LesAccess " "]

		if {[EstCeUnNombre $nMin     ] && $n        < $nMin       } {continue}
		if {[EstCeUnNombre $nMax     ] && $n        > $nMax       } {continue}
		if {[EstCeUnNombre $NivMin   ] && $Niv      < $NivMin     } {continue}
		if {[EstCeUnNombre $NivMax   ] && $Niv      > $NivMax     } {continue}

		incr NbBarre
				
		set ET     ""
		set Color "lightgrey"
		if {[string equal -nocase $Type "component"]} {set Color "green";set T "C"}
		if {[string equal -nocase $Type "function" ]} {set Color "blue" ;set T "F"}
		if {[string equal -nocase $Type "process"  ]} {set Color "red"  ;set T "P"}
		
		set Qui "$T $GO : $Def [format "%8s" $n]"
	    
		set LeTexteDefinitif {}
		foreach Ligne $LInfo {
		    while {100 < [string length $Ligne]} {
			lappend LeTexteDefinitif [string range $Ligne 0  59 ]
			set     Ligne            [string range $Ligne 60 end]
		    }
		    if {[string length $Ligne] != 0} {lappend LeTexteDefinitif $Ligne}
		}
		set     LesTags         [list "GO" [join $LeTexteDefinitif "\n"]]
		lappend ListePourLHisto [list $Qui $Color $n $ET $LesTags]
	    }
	    ChefDOrchestreDuGOHisto unset GO $GO LesAccess
	    ChefDOrchestreDuGOHisto unset GO $GO LesBoitesGscope
	}

	if {$ListePourLHisto == {}} {return}

	set ListePourLHisto [lsort -index 2 -real  -decreasing $ListePourLHisto]

	set ListePourLHisto [linsert $ListePourLHisto 0 "n"]

	if {$NbBarre <= 0} {return}
	if {[info exists TabTmp]} {unset TabTmp}

	set FrameDuCanva  ""
	set KCanva         [lindex $LePanelPrincipalDuGOHisto 0]
	regsub {\.[^\.]+$} $KCanva "" FrameDuCanva

	if {[winfo exists $FrameDuCanva]} {destroy $FrameDuCanva}
	set FrameCanva [lindex $LePanelPrincipalDuGOHisto 5]
	set LMax       [lindex $LePanelPrincipalDuGOHisto 1]
	set HMax       [lindex $LePanelPrincipalDuGOHisto 2]
	set LWin       [lindex $LePanelPrincipalDuGOHisto 3]
	set HWin       [lindex $LePanelPrincipalDuGOHisto 4]
	set HauteurMax     [expr $HWin * 1.0 / 15 + $NbBarre * 30]
	if {$HauteurMax < $HWin} {set HauteurMax $HWin}
	set KCanva         [Canva $LMax $HauteurMax $LWin $HWin NoY "" "" $FrameCanva]
	$KCanva configure -background white
	set LePanelPrincipalDuGOHisto [list $KCanva $LMax $HMax $LWin $HWin $FrameCanva]
	
	PlaceLHistogramme $ListePourLHisto $KCanva 0 $HauteurMax 0 $LWin "Vertical"
	return $KCanva
    }
    if {[string equal -nocase $PremierArg "Calcul"]} {
	set TousLesGO {}
	set LesBoitesGscope  [set TabDuChefDOrchestreDuGOHisto(LesBoitesGscope)]
	set LesAccess        [lsort -unique [set TabDuChefDOrchestreDuGOHisto(LesAccess)    ]]
	foreach LaBoite $LesBoitesGscope {
	    Espionne $LaBoite
	    set Nom       [lindex $LaBoite 0]
	    set FichierGO [lindex $LaBoite 1]
	    set LesGODeLaBoite {}
	    if {![info exists TabDuChefDOrchestreDuGOHisto(Gscope,$FichierGO,Nom,$Nom,LesGO)]} {
		foreach     GO [InterrogeGeneOntology $FichierGO $Nom LesGO] {
		    foreach Type [GODB GO $GO LesTypes                     ] {
			set GO [GODB Type $Type GOSynonyme $GO GODeRef]
			if {$GO == ""} {continue}
			lappend LesGODeLaBoite $GO
			foreach GOParent [InterrogeGeneOntology $FichierGO GO $GO LesAncetres] {
			    set GOParent [GODB Type $Type GOSynonyme $GOParent GODeRef]
			    if {$GOParent == ""} {continue}
			    lappend LesGODeLaBoite $GOParent
			}
			
		    }
		}

		set LesGODeLaBoite                                [lsort -unique $LesGODeLaBoite]
		set TabDuChefDOrchestreDuGOHisto(Gscope,$FichierGO,Nom,$Nom,LesGO) $LesGODeLaBoite
	    } else {
		set LesGODeLaBoite [set TabDuChefDOrchestreDuGOHisto(Gscope,$FichierGO,Nom,$Nom,LesGO)]
	    }
	    foreach GO [lsort -unique $LesGODeLaBoite] {
		if {[info exists TabTmp($FichierGO,$Nom,$GO)]} {continue}
		set TabTmp($FichierGO,$Nom,$GO) 1

		if {![info exists TabDuChefDOrchestreDuGOHisto(GO,$GO,LesBoitesGscope)]} {
		    set TabDuChefDOrchestreDuGOHisto(GO,$GO,LesBoitesGscope) {}
		}
		lappend TabDuChefDOrchestreDuGOHisto(GO,$GO,LesBoitesGscope) $LaBoite
		lappend TousLesGO $GO
	    }
	}
	if {[info exists TabTmp]} {unset TabTmp}

	########ACCESS###########
	foreach Access $LesAccess {
	    Espionne "$Access"
	    if {![info exists TabDuChefDOrchestreDuGOHisto(Access,$Access,LesGO)]} {
		lappend TabDuChefDOrchestreDuGOHisto(LesAccess) $Access

		set LesGODeLAccess {}
		set LesGO          [lsort -unique [Access2GO $Access]]
		set LesGO          [lsort -unique [concat $LesGO [TousLesAncetresGODesGO $LesGO]]]	
		foreach GO $LesGO {
		    foreach Type [GODB GO $GO LesTypes] {
			set GO [GODB Type $Type GOSynonyme $GO GODeRef]
			lappend LesGODeLAccess                             $GO
		    }
		}
		set     LesGODeLAccess                                     [lsort -unique $LesGODeLAccess]
		set     TabDuChefDOrchestreDuGOHisto(Access,$Access,LesGO) $LesGODeLAccess
	    } else {
		set LesGODeLAccess [set TabDuChefDOrchestreDuGOHisto(Access,$Access,LesGO)]
	    }
	    foreach GO [lsort -unique $LesGODeLAccess] {
		if {[info exists TabTmp($Access,$GO)]} {continue}
		set TabTmp($Access,$GO) 1

		if {![info exists TabDuChefDOrchestreDuGOHisto(GO,$GO,LesAccess)]} {
		    set TabDuChefDOrchestreDuGOHisto(GO,$GO,LesAccess) {}
		}
		lappend TabDuChefDOrchestreDuGOHisto(GO,$GO,LesAccess) $Access
		lappend TousLesGO                          $GO
	    }
	}
	################################################
	if {[info exists TabTmp]} {unset TabTmp}

	return [lsort -unique $TousLesGO]
    }
    return

}

