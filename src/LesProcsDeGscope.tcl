proc EnleveLesTriples_new {Nb aLt aLd} {

    upvar $aLt Lt $aLd Ld

    # les triples sont tries par ordre croissant
    # le dernier avec ok = 1 est dernier ajoute
    while {$Nb > 0} {
	# cherche index du dernier triple flagge ok=1
	set it -1
	foreach t $Lt {
	    if {[lindex $t 9] != 0} {
		incr it
	    } else {
		break
	    }
	}
	# flag a ok=0
	lset Lt $it 9 0

	# on le cherche dans les doubles
	lassign [lindex $Lt $it] w e1 e2 go no po
	set id [lsearch -exact -index 1 $Ld $e1]
	set dd [lindex $Ld $id]

	# on l'enleve, le met en debut de liste
	# flag ok a 1, change what a Dxx
	set Ld [lreplace $Ld $id $id]
	lset dd 9 1
	set Ld [linsert $Ld 0 $dd]

	incr Nb -1
	update
    }

    return

}

proc EnleveUnDouble {nbd aLdbl aLtrp} {

    upvar $aLdbl Ldbl $aLtrp Ltrp
    
    # la liste des doubles est classee du meilleur
    # double au moins bon.
    # 
    # Pour enlever, parcours la liste de la fin et
    # enleve les doubles les moins bon

    set Ltmp {}
    set id -1
    foreach d [lreverse $Ldbl] {
	if {$nbd == 0} {
	    if {[lindex $d 9]} {
		lset d 9 0
		incr nbd -1
	    }
	}
	lappend Ltmp $d
    }
    set Ldbl [lreverse $Ltmp]

    update

    return

}

