	set Fic ""
    } else {
	set Rep [file dirname $RepertoireEtFichier]
	set Fic [file tail $RepertoireEtFichier]
    }

    set RepertoireInitial [pwd]  
    set FichierInitial "Nouveau" 

    set Fichier  [tk_getSaveFile -title "Enregistrement du fichier"  -initialfile $FichierInitial  -initialdir $RepertoireInitial]
