proc ::Sampling::FilterByExpect {lines expectValue} {

	set filtered {}
	foreach l $lines {
		set e [string reverse [lindex [split [string trim [string reverse $l]] " "] 0]]
		if { [string index $e 0] == "e" } { set e "1.$e" }
	    if { $e >= $expectValue } { break } 
		lappend filtered $l
	}
	return $filtered

}

proc ::Sampling::SelectClass {lines ancestors max} {

	set elus {}

	set taxids [dict create]
	set lookout 0
	set id ""
	foreach l $lines {
		if {[regexp {^>([^ ]+)} $l matches id]} {
			set lookout 1
		}
		if {$lookout} {
			if {[regexp {OX=([0-9]+)} $l matches ox]} {
				dict set taxids $id $ox
				set lookout 0
			}
			if {[regexp {^Query} $l]} {
				set lookout 0
			}
		}
	}
	set begin 0
	foreach l $lines {
		if {[regexp {^>} $l]} break

		if {[regexp {^Sequences producing significant alignments} $l]} {
			set begin 1
		} elseif {$begin && $l != ""} {
			foreach anc $ancestors {
				set id ""
				regexp {^([^ ]+)} $l matches id
				if {[dict exists $taxids $id] && [Taxo::isAncestor $anc [dict get $taxids $id]]} {
					lappend elus $l
				}
			}
		}
		if {[llength $elus] == $max} break
	}
	return $elus

}

proc ::Sampling::SelectFDD lines {

	proc Derivee {l} {
		foreach v [lrange $l 0 end-1] w [lrange $l 1 end] {
			set e [expr {$w-$v}]
			lappend d $e
		}
		return $d
	}

	if { [llength $lines] < 5 } {
		return $lines
	}

	set expects {}
	set logs {}
	foreach line $lines {
		set expect [string range $line [expr [string last " " $line] +1] end]
		if { $expect< 1.e-300 } { set expect "e-300" }
		set log [expr log([regsub "e" $expect "1.e"])]
		lappend lines $line
		lappend logs $log
		lappend expects $expect
	}
	
	set logs1D [Derivee $logs]
	set logs1D  [linsert $logs1D  0 -300.]
	set logs2D [Derivee $logs1D]
	set logs2D  [linsert $logs2D  0 300.]
	set logs3D [Derivee $logs2D]
	set logs3D  [linsert $logs3D  0 300.]

	set elus {}
	lappend elus [lindex $lines 0]
	set i 0
	foreach e $expect l $logs3D {
		if { $i > 1 } {
			if { $e < 0. && [lindex $logs3D [expr $i-1]] > 0. } {
				lappend elus [lindex $lines [expr $i-1]]
			}
		}
		incr i
	}
	return $elus

}

proc ::Sampling::SelectStrips {lines {nStrips 100}} {

	if {[llength $lines] == 0} {
		return {}
	}
	set logs {}
	foreach line $lines {
		set expect [string range $line [expr [string last " " $line] +1] end]
		if { $expect< 1.e-200 } { set expect "e-200" }
		set log [expr log10([regsub "e" $expect "1.e"])]
		lappend lines $line
		lappend logs $log
	}

	set premier [lindex $logs 0]
	set dernier [lindex $logs end]
	set pas [expr (($dernier-$premier))/$nStrips]

	set elus {}
	set borneBas $premier
	set borneHaut [expr $premier+$pas]

	set groupe {}

	foreach line $lines log $logs {
		if { $log >= $borneHaut } {
			set elus  [concat $elus [selectBest $groupe]]
			set groupe {}

			set borneBas $borneHaut
			set borneHaut [expr $borneBas+$pas]
		} elseif { $log >= $borneBas } {
			lappend groupe $line
		}
	}
	return $elus

}

proc ::Sampling::readBlast {path {full 0}} {

	set infile [open $path r]

	set lines {}
	if { !$full } {
		while { ![regexp "Sequences producing significant alignments" [gets $infile]] } {}
		gets $infile
	}

	while { [gets $infile line] >= 0 && ($full || $line != "") } {
		lappend lines $line
	}
	close $infile

	return $lines

}

proc ::Sampling::sampleBlast {infile outfile maxExpect maxNumber method args} {

	switch $method {
		"nature" {
			set lines [readBlast $infile]
			set elus [FilterByExpect $lines $maxExpect]
		}
		"strips" {
			set lines [readBlast $infile]
			set lines [FilterByExpect $lines $maxExpect]
			set nStrips 100
			if { [llength $args] >= 1 } { set nStrips [lindex $args 0] }
			set elus [SelectStrips $lines $nStrips]
		}
		"fdd" {
			set lines [readBlast $infile]
			set lines [FilterByExpect $lines $maxExpect]
			set elus [SelectFDD $lines]
		}
		"class" {
			set lines [readBlast $infile 1]
			set elus [SelectClass $lines [split [lindex $args 0] ","] $maxNumber]
			set elus [FilterByExpect $elus $maxExpect]
		}
		default {
			throw 1 "Unknown method $method"
		}
	}
	set elus [lrange $elus 0 [expr $maxNumber-1]]
	set outfile [open $outfile w]
	foreach elu $elus {
		puts $outfile [lindex [split $elu " "] 0]
	}
	close $outfile

	return

}

proc ::Sampling::selectBest groupe {

	proc splitByChain {str separator} {
		regsub -all $separator $str "\x00" str
		return [split $str "\x00"]
	}

	if {[llength $groupe] == 0} {
		return {}
	}
	if {[llength $groupe] == 1} {
		return $groupe
	} else {
		set post ""
		foreach line $groupe {
			append post [string range $line 0 [expr [string first " " $line] -1]] "\n"
		}
		set rawquery [BirdQuery $post]
		set rawquery [string trim $rawquery "/"]
		set queries [splitByChain $rawquery "\n//"]

		set selected ""
		set maxLength 0
		set isSW 0
		set bestIsSW 0
		set i 0
		foreach line $groupe {
			set id [string range $line 0 [expr [string first " " $line] -1]]
			regsub {^[A-Za-z|]*:} $id "" id

			set query [lindex $queries $i]
			while { ![regexp $id $query] && $i < [llength $queries] } {
				incr i
				set query [lindex $queries $i]
			}
			if { [regexp $id $query] && ![regexp "Flags: Fragment" $query] } {
				set isSW 0
				set length 0
				regexp {SQ   SEQUENCE   ([0-9]+)} $query -> length

				if { [regexp "^SW:" $line] && !$bestIsSW } {
					set isSW 1
					set bestIsSW 1
					set best $line
				}
				if { $length > $maxLength && (($isSW && $bestIsSW) || (!$isSW && !$bestIsSW)) } {
					set maxLength $length
					set selected [list $line]
				}
			}
			incr i
		}
		return $selected
	}

}

