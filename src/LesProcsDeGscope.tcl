proc ChoisisLeMeilleurMsf FichierNormd {

    set NormdRascal 0; set NormdDbclustal 0; set NormdLeon 0
    set ListeNormd {}
    foreach Ligne [LesLignesDuFichier $FichierNormd] {
	if {$Ligne == ""} {continue}
	set Ligne [regsub -all {NorMD de } $Ligne ""]
	set Ligne [regsub -all " :" $Ligne ""]
	set Normd 0
	scan $Ligne "%s %s" NomProcess Normd
	if {[regexp "dbclustal" $NomProcess]} {
	    set NormdDbclustal $Normd
	    set LeNormd($NormdDbclustal) Dbclustal
	}
	if {[regexp "rascal" $NomProcess]} {
	    set NormdRascal $Normd
	    set LeNormd($NormdRascal) Rascal
	}
	if {[regexp "leon" $NomProcess]} {
	    set NormdLeon $Normd
	    set LeNormd($NormdLeon) Leon
	}
    }
    #Espionne "NormdDbclustal $NormdDbclustal"
    #Espionne "NormdRascal $NormdRascal"
    #Espionne "NormdLeon $NormdLeon"
    if {$NormdLeon>0.5} {
	set bestmsf "Leon"
    } else {
	foreach {C V} [array get LeNormd] {
	    lappend ListeNormd $C 
	}
	set Max [DetermineLePlusGrand $ListeNormd]
	#Espionne "Max $Max"
	#Espionne "$LeNormd($Max)"
	set bestmsf $LeNormd($Max)
    }
    return $bestmsf

}

