proc DrawGOTreeBall {{LesGO {}} {LargeurMax {}} {HauteurMax {}} {LargeurFenetre {}} {HauteurFenetre {}} {KCanva {}}} {

    if {$LargeurMax     == ""} {set LargeurMax         [expr [winfo screenwidth  .] * 2.0 / 3]}
    if {$HauteurMax     == ""} {set HauteurMax         [expr [winfo screenheight .] * 2.0 / 3]}
    if {$LargeurFenetre == ""} {set LargeurFenetre     [expr [winfo screenheight .] * 2.0 / 3]}
    if {$HauteurFenetre == ""} {set HauteurFenetre     [expr [winfo screenheight .] * 2.0 / 3]}

    if {$KCanva == ""} {
	if {![GODB EstCharge]} {GODB Load}
	if {![2GO  EstCharge]} {2GO  Load}
	set KCanva [Canva $LargeurMax $HauteurMax $LargeurFenetre $HauteurFenetre "NoY" "Gene Ontology"]
	$KCanva configure -background white
    }

    set BordY              50.0
    set BordX              50.0

    set LesTypes  [GODB LesTypes]
    set TousLesGO [GODB LesGO   ]
    if {$LesGO == ""} {
	set LesGO $TousLesGO
    } else {
	set LesGOSelected {}
	foreach GO      $LesGO {
	    set TabDesGOParticuliers($GO,Ref) 1
	    foreach Type [GODB GO $GO LesTypes] {
		set GODeRef [GODB Type $Type GOSynonyme $GO GODeRef]
		set TabDesGOParticuliers($GODeRef,Ref) 1
		lappend LesGOSelected $GODeRef
	    }
	}
	set LesGOSelected [lsort -unique $LesGOSelected]

	foreach GO       [TousLesAncetresGODesGO $LesGOSelected       ] {lappend LesGOSelected                       $GO}
	foreach GOAbsent [LaDifferenceDeL1AvecL2 $TousLesGO moins $LesGOSelected] {set     TabDesGOParticuliers($GOAbsent,Absent) 0  }
    }

    set NivMax -1e200
    set NivMin  1e200
    foreach Type $LesTypes {
	foreach Niv [GODB Type $Type LesNiveaux] {
	    if {$NivMax < $Niv   } {set NivMax $Niv}
	    if {$Niv    < $NivMin} {set NivMin $Niv}
	}
    }

    set LesGOIni {}
    foreach Type $LesTypes {
	foreach GO [GODB Type $Type Niveau $NivMin LesGO] {
	    if {[info exists TabDesExceptions($GO)]} {continue}
	    lappend LesGOIni $GO
	}
    }
    if {$LesGOIni == ""} {return}
    set LesGOIni [lsort -unique $LesGOIni]

    
    set NbNiv [expr $NivMax - $NivMin + 1]

    set nBulles              [llength $LesGOIni]
    set LargeurMinAffichage                      $BordX
    set LargeurMaxAffichage  [expr $LargeurMax - $BordX]

    set LargeurAffichage     [expr $LargeurMaxAffichage - $LargeurMinAffichage]
    set HauteurAffichage     [expr ($HauteurMax - 2*$BordY)*1.0]
    set EcartDeLargeur       [expr $LargeurAffichage    * 1.0 / $nBulles]

    set TailleDUnNiveau      [expr $HauteurAffichage    * 1.0 / ($NbNiv-1)]
    set YDuPremierNiv        $BordY
    set RayonMaxDUneBalle    [expr $YDuPremierNiv * 1.0 / 4]
    set RayonMinDUneBalle    2
        
    for {set i $NivMin} {$i <= $NivMax} {incr i} {
	set YLine [expr $YDuPremierNiv + $i * $TailleDUnNiveau]
	$KCanva create line $LargeurMinAffichage $YLine $LargeurMaxAffichage $YLine -fill lightgrey
	$KCanva create text $LargeurMinAffichage $YLine -anchor e -text "Level $i" -font "arial 10 bold"
	$KCanva create text $LargeurMaxAffichage $YLine -anchor w -text "Level $i" -font "arial 10 bold"
    }

    FDeX INI $NivMin $RayonMaxDUneBalle $NivMax $RayonMinDUneBalle
    for {set i 0} {$i < $nBulles} {incr i} {
	set GOIni [lindex $LesGOIni $i]
	set XMin  [expr $LargeurMinAffichage + $EcartDeLargeur * $i * 1.0]
	set XMax  [expr $XMin                + $EcartDeLargeur           ]
	DrawOneBall $KCanva $GOIni $NivMin $XMin $XMax $YDuPremierNiv $TailleDUnNiveau TabDesGOParticuliers "" ""
    }

    FDeX unset

    $KCanva bind "Affichable" <Enter>     "AfficheInfoBulle $KCanva %x %y Enter"
    $KCanva bind "Affichable" <Leave>     "AfficheInfoBulle $KCanva %x %y Leave"
    $KCanva bind "GO"         <1>         "SelectionDuGOPourDrawGOTreeBall $KCanva %x %y Seul"
    $KCanva bind "GO"         <Shift-1>   "SelectionDuGOPourDrawGOTreeBall $KCanva %x %y AvecCesDescendants"
    $KCanva bind "GO"         <Control-1> "SelectionDuGOPourDrawTreeOneGO  $KCanva %x %y"
    return $KCanva

}

proc DrawInfo args {

    if {$args == ""} {return}

    set Quoi [lindex $args 0]

    set w ""
    if {[string equal -nocase $Quoi "Access"]} {
	set Qui [lindex $args 1]
	set PageInfo [PageInfoLaTotale $Qui protein]
	set w   [lindex $args 2]
    }
    if {[string equal -nocase $Quoi "Interpro"]} {
	set Qui [lindex $args 1]
	set PageInfo [PageInfoLaTotale $Qui interpro]
	set w   [lindex $args 2]
    }
    if {[string equal -nocase $Quoi "Box"]} {
	set FichierGO [lindex $args 1]
	set Nom       [lindex $args 2]
	set w         [lindex $args 3]
	set FichierHTML "[file dirname $FichierGO]/../BilanHTML/$Nom.html"
	if {![file exists $FichierHTML]} {return}
	set PageInfo [ContenuDuFichier $FichierHTML]
    }
    if {[string equal -nocase $Quoi "Brut"]} {
	set PageInfo [lindex $args 1]
	set w        [lindex $args 2]
    }

    set EstCeQueJeFaisPartiDUneAutreFenetre 1
    if {$w == "" || ![winfo exists $w]} {
	set w [NomDe fenetre]
	toplevel $w
	set EstCeQueJeFaisPartiDUneAutreFenetre 0
    }

    set FrameInfo "$w.frameinfo"
    set ListBox  "$FrameInfo.list"
    if {![winfo exists $FrameInfo]} {
	frame $FrameInfo
	pack  $FrameInfo -side top -expand yes -fill both
	scrollbar $FrameInfo.yscroll -command "$ListBox yview"
	scrollbar $FrameInfo.xscroll -command "$ListBox xview" -orient horizontal 
	set Largeur 82
	set Hauteur 35
	listbox $ListBox -width $Largeur -height $Hauteur -setgrid 1  -yscroll "$FrameInfo.yscroll set"  -xscroll "$FrameInfo.xscroll set"  -selectmode extended  -background "LightGrey"  -foreground "Black"  -selectbackground "LightYellow"  -selectforeground "Black"  -font "courier 10" 
	
	grid $FrameInfo.list    -row 0 -column 0 -rowspan 1 -columnspan 1 -sticky nsew
	grid $FrameInfo.yscroll -row 0 -column 1 -rowspan 1 -columnspan 1 -sticky nsew
	grid $FrameInfo.xscroll -row 1 -column 0 -rowspan 1 -columnspan 1 -sticky nsew
	grid rowconfig    $FrameInfo 0 -weight 1 -minsize 0
	grid columnconfig $FrameInfo 0 -weight 1 -minsize 0
    }
    if {[winfo exists $ListBox]} {$ListBox delete 0 end}

    set nLignes 0
    foreach Ligne [split $PageInfo "\n"] {	
	if {[string equal -nocase $Quoi "Box"] || [string equal -nocase $Quoi "interpro"] } {
	    regsub -all "\t" $Ligne " " Ligne
	    regsub -all "&nbsp|&nbsp;" $Ligne " " Ligne
	    regsub -all {<[^>]+>} $Ligne "" Ligne
	    if {[regexp -nocase "<BR>" $Ligne]} {continue}
	}
	if {![string equal -nocase $Quoi "Brut"] && [string trim $Ligne] == ""} {continue}
	$FrameInfo.list insert end $Ligne
    }

    if {!$EstCeQueJeFaisPartiDUneAutreFenetre} {
	set BoutonExit "$w.buttonexit"
	button       $BoutonExit  -borderwidth 1 -text "CLOSE"
	pack         $BoutonExit   -fill x    -side bottom -expand 0
	$BoutonExit configure -command "destroy $w"
    }
    return $ListBox

}

proc DrawInfoDeDrawBlast {w {Kcanva {}} {PageInfoOuAliouToutLAliouToutLeBlast Ali}} {

    if {![AskOptionsDeDrawBlast exists LesBIdStockeAvecLeurPageInfo]} {
	AskOptionsDeDrawBlast set LesBIdStockeAvecLeurPageInfo {}
    }

    if {[string equal -nocase $w "unset"]} {
	foreach BId [AskOptionsDeDrawBlast ask LesBIdStockeAvecLeurPageInfo] {
	    AskOptionsDeDrawBlast unset $BId PageInfo
	}
	AskOptionsDeDrawBlast set LesBIdStockeAvecLeurPageInfo {}
	return
    }

    set Id           [$Kcanva  find withtag current]
    set MesTags      [$Kcanva  gettags  $Id]
    set FichierBlast [lindex   $MesTags 1  ]
    set BId          [lindex   $MesTags 2  ]
    set Segment      [lindex   $MesTags 3  ]

    if {$PageInfoOuAliouToutLAliouToutLeBlast == "ToutLeBlast"} {
	set Info [ContenuDuFichier $FichierBlast]
    }
    if {$PageInfoOuAliouToutLAliouToutLeBlast == "Ali"     } {
	if {$Segment == "All"} {
	    set Info [AskBlast $FichierBlast BanqueId $BId SubjectBrut]
	} else {
	    set Info [AskBlast $FichierBlast BanqueId $BId Segment $Segment AlignBrut]
	}
    }
    if {$PageInfoOuAliouToutLAliouToutLeBlast == "ToutLAli"} {
	set Info [AskBlast $FichierBlast BanqueId $BId SubjectBrut]
    }
    if {$PageInfoOuAliouToutLAliouToutLeBlast == "PageInfo"} {
	if {![info exists TabOptionsDeDrawBlast($BId,PageInfo)]} {
	    AskOptionsDeDrawBlast append LesBIdStockeAvecLeurPageInfo $BId
	    AskOptionsDeDrawBlast set    $BId PageInfo                [PageInfoLaTotale $BId "unknown"]
	}
	set Info [AskOptionsDeDrawBlast ask    $BId PageInfo]
    }
    if {$Info == ""} {return}
    
    DrawInfo Brut $Info

    return
    if {![AskOptionsDeDrawBlast exists $w ListBox]} {
	AskOptionsDeDrawBlast set $w ListBox [DrawInfo Brut ""]
    }
    set ListBox [AskOptionsDeDrawBlast ask $w ListBox]
    if {![winfo exists $ListBox]} {
	AskOptionsDeDrawBlast set $w ListBox [DrawInfo Brut ""]
    }
    set ListBox [AskOptionsDeDrawBlast ask $w ListBox]

    $ListBox delete 0 end
    foreach Ligne [split $Info "\n"] {$ListBox insert end $Ligne}

}

proc DrawMapping {FichierBlast {BanqueId {}} {ExpectMax 1e200} {IdMin 0.0} {TailleMaxDUneRegionNonAlignee 500} {LargeurFenetre {}} {HauteurFenetre {}} {KCanva {}} {w {}}} {

    if {![file exists $FichierBlast]} {return}
    set TypeDeBlast [AskBlast $FichierBlast TypeDeBlast]
    set Query       [AskBlast $FichierBlast Query      ]
    set TailleQ     [AskBlast $FichierBlast Taille     ]
    if {$TailleQ == ""} {return}

    if {$BanqueId != ""} {
	set NbSegment [AskBlast $FichierBlast BanqueId $BanqueId NbSegment]
	set AiJeRecontreUnSegment 0
	for {set j 1} {$j <= $NbSegment} {incr j} {
	    set Expect     [AskBlast $FichierBlast BanqueId $BanqueId Segment $j Expect    ]
	    set Identities [AskBlast $FichierBlast BanqueId $BanqueId Segment $j Identities]
	    if {$Expect == "" || $Identities == ""} {continue}
	    scan $Identities "%d/%d" n nTot
	    set Id [expr $n*1.0/$nTot]
	    if {$ExpectMax < $Expect} {continue}
	    if {$Id < $IdMin} {continue}
	    set AiJeRecontreUnSegment 1
	    break
	}
	if {!$AiJeRecontreUnSegment} {set BanqueId ""}
    }
    if {$BanqueId == ""} {
	set NbSubject [AskBlast $FichierBlast NbSubject]
	for {set i 1} {$i <= $NbSubject} {incr i} {
	    set BId       [AskBlast $FichierBlast Subject $i]
	    set NbSegment [AskBlast $FichierBlast BanqueId $BId NbSegment]
	    set AiJeRecontreUnSegment 0
	    for {set j 1} {$j <= $NbSegment} {incr j} {
		set Expect     [AskBlast $FichierBlast BanqueId $BId Segment $j Expect    ]
		set Identities [AskBlast $FichierBlast BanqueId $BId Segment $j Identities]
		if {$Expect == "" || $Identities == ""} {continue}
		scan $Identities "%d/%d" n nTot
		set Id [expr $n*1.0/$nTot]
		if {$ExpectMax < $Expect} {continue}
		if {$Id < $IdMin} {continue}
		
		set AiJeRecontreUnSegment 1
		break
	    }
	    if {!$AiJeRecontreUnSegment} {continue}
	    set BanqueId $BId
	    break
	}
    }
    if {$BanqueId == ""} {
	Canva $LargeurFenetre $HauteurFenetre $LargeurFenetre $HauteurFenetre "NoY" "" "" $KCanva
	$KCanva configure -background white
	return
    }

    set TailleS     [AskBlast $FichierBlast BanqueId $BanqueId Taille   ]
    set NbSegment   [AskBlast $FichierBlast BanqueId $BanqueId NbSegment]
    if {$NbSegment == "" || $TailleS == ""} {return}

    if {$LargeurFenetre == ""} {set LargeurFenetre     [expr [winfo screenheight .] * 2.0 / 3]}
    if {$HauteurFenetre == ""} {set HauteurFenetre     [expr [winfo screenheight .] * 2.0 / 3]}
    set LargeurMax       $LargeurFenetre
    set HauteurMax       $HauteurFenetre
    set BordX            [expr $LargeurFenetre * 1.0 / 4 ]
    set BordY            [expr $HauteurFenetre * 1.0 / 10]
    if {$BordY < 30} {set BordY 40}
    set EcartY           10.0
    set HBox             25.0
    set HSmallBox        15.0
    set LargeurAffichage [expr $LargeurFenetre - 2 * $BordX]
    set FacteurXDeQ      [expr $LargeurAffichage * 1.0 / $TailleQ]
    set FacteurXDeS      [expr $LargeurAffichage * 1.0 / $TailleS]

    set TailleDansLeSensPlus  0
    set TailleDansLeSensMoins 0
    
    set LesRegionsDuSubject        {}
    set LesRegionsUniquesDuSubject {}
    set LesRegionsDeLaQuery        {}
    set LesRegionsUniquesDeLaQuery {}
    for {set Seg 1} {$Seg <= $NbSegment} {incr Seg} {
	set Expect     [AskBlast $FichierBlast BanqueId $BanqueId Segment $Seg Expect    ]
	if {$ExpectMax < $Expect} {continue}
	set Identities [AskBlast $FichierBlast BanqueId $BanqueId Segment $Seg Identities]
	scan $Identities "%d/%d" n nTot
	set Id [expr $n*1.0/$nTot]
	if {$Id < $IdMin} {continue}

	set Orientation  [AskBlast $FichierBlast BanqueId $BanqueId Segment $Seg Orientation]
	if {$Orientation == ""} {set Orientation "Prot / Prot"}

	set Sens [SensDeLaRegion $Orientation]
	set DQ [Mini [AskBlast $FichierBlast BanqueId $BanqueId Segment $Seg DQ] [AskBlast $FichierBlast BanqueId $BanqueId Segment $Seg FQ]]
	set FQ [Maxi [AskBlast $FichierBlast BanqueId $BanqueId Segment $Seg DQ] [AskBlast $FichierBlast BanqueId $BanqueId Segment $Seg FQ]]
	set DS [Mini [AskBlast $FichierBlast BanqueId $BanqueId Segment $Seg DS] [AskBlast $FichierBlast BanqueId $BanqueId Segment $Seg FS]]
	set FS [Maxi [AskBlast $FichierBlast BanqueId $BanqueId Segment $Seg DS] [AskBlast $FichierBlast BanqueId $BanqueId Segment $Seg FS]]

	if {$Sens == "+"} {incr TailleDansLeSensPlus [expr $FQ - $DQ + 1]} else {incr TailleDansLeSensMoins [expr $FQ - $DQ + 1]}

	if {![info exists Tab(Query,$DQ,$FQ,RegionOccupee)]} {
	    set     Tab(Query,$DQ,$FQ,RegionOccupee)   1
	    lappend LesRegionsUniquesDeLaQuery [list $DQ $FQ]
	}
	lappend LesRegionsDeLaQuery [list $DQ $FQ $DS $FS $Orientation $Id $Seg]
	if {![info exists Tab(Subject,$DS,$FS,RegionOccupee)]} {
	    set     Tab(Subject,$DS,$FS,RegionOccupee) 1
	    lappend LesRegionsUniquesDuSubject [list $DS $FS]
	}
	lappend LesRegionsDuSubject [list $DS $FS $DQ $FQ $Orientation $Id $Seg]
    }
    if {$LesRegionsDuSubject == {} || $LesRegionsDeLaQuery == {}} {return}
    set SensGeneral "+"
    if {$TailleDansLeSensMoins > $TailleDansLeSensPlus} {set SensGeneral "-"}

    set LesPetitesRegionsUniquesDeLaQuery  [LesPetitesRegionsDesGrandesRegions  $LesRegionsUniquesDeLaQuery]
    foreach LaRegion [LesRegionsAbsentesDesPetitesRegions $LesPetitesRegionsUniquesDeLaQuery 1 $TailleQ] {
	lappend LaRegion "Absente"
	lappend LesPetitesRegionsUniquesDeLaQuery $LaRegion
    }

    set TailleDeLaSeqReduiteQ       0
    set TailleDeLaReduction         0
    foreach LaRegion [lsort -index 0 -real $LesPetitesRegionsUniquesDeLaQuery] {
	set DQ     [lindex $LaRegion 0]
	set FQ     [lindex $LaRegion 1]
	set Type   [lindex $LaRegion 2]

	set Taille [expr   $FQ-$DQ + 1]

	set  DRed                      [expr $DQ - $TailleDeLaReduction]
	set  FRed                      [expr $FQ - $TailleDeLaReduction]
	if {$Type == "Absente" && $TailleMaxDUneRegionNonAlignee < $Taille} {
	    set  FRed                  [expr $DRed + $TailleMaxDUneRegionNonAlignee - 1]
	    incr TailleDeLaReduction   [expr $Taille - $TailleMaxDUneRegionNonAlignee]
	    incr TailleDeLaSeqReduiteQ $TailleMaxDUneRegionNonAlignee
	} else {
	    incr TailleDeLaSeqReduiteQ $Taille
	}
	set TabRed(Query,$DQ) $DRed
	set TabRed(Query,$FQ) $FRed
    }
    
    set FacteurQX [expr $LargeurAffichage * 1.0 / $TailleDeLaSeqReduiteQ]

    set LesFormesAPlacer {}
    lappend LesFormesAPlacer [list text  [expr $LargeurFenetre*1.0/2] [expr $BordY*1.0/3] "center" "QUERY : [string range $Query end-30 end]"]
    lappend LesFormesAPlacer [list text  [expr $LargeurFenetre*1.0/2] [expr $BordY*2.0/3] "center" "BLAST : $TypeDeBlast"                    ]

    set     XMin             $BordX
    set     YMin             $BordY
    set     XMax             [expr $XMin + $LargeurAffichage]
    set     YMax             [expr $YMin + $HBox]
    set     YText            [expr $YMin + ($YMax - $YMin)/2]
    lappend LesFormesAPlacer [list rectangle $XMin           $YMin $XMax $YMax "lightgrey" "black" 3]
    lappend LesFormesAPlacer [list text      [expr $XMin-1]  $YText "e"  1                          ]
    lappend LesFormesAPlacer [list text      [expr $XMax+1]  $YText "w"  $TailleQ                   ]

    set HauteurAffichage [expr $HauteurMax - 2 * ($BordY + $HBox + $EcartY)]
    set YMinDeRef [expr $BordY + $HBox + $EcartY]

    set NiveauMaxDeRef [expr int($HauteurAffichage * 1.0 / ($HSmallBox + $EcartY)/2)]
    set NiveauMin 0
    set NiveauMax 0

    foreach LaRegion $LesRegionsDeLaQuery {
	set DQ  [lindex $LaRegion 0]
	set FQ  [lindex $LaRegion 1]

	if {![info exists Tab(Query,$DQ,$FQ,RegionOccupee)]} {continue}
	if {![info exists TabRed(Query,$DQ)               ]} {continue}
	if {![info exists TabRed(Query,$FQ)               ]} {continue}

	set DQR [set TabRed(Query,$DQ)]
	set FQR [set TabRed(Query,$FQ)]

	set DS     [lindex $LaRegion 2]
	set FS     [lindex $LaRegion 3]
	set Orient [lindex $LaRegion 4]
	set Id     [lindex $LaRegion 5]
	set Seg    [lindex $LaRegion 6]

	set ColorFill    [ColoriageDeLIdDeDrawBlast     $Id    ]
	set ColorOutLine [ColoriageDuMappingDeDrawBlast $Orient]

	set AiJeRencontreUnNiveauAvecDeLaPlace 0
	for {set Niv $NiveauMin} {$Niv <= $NiveauMax} {incr Niv} {
	    if {![info exists TabNiveau($Niv,LesRegions)]} {set TabNiveau($Niv,LesRegions) {}}
	    set AiJeRencontreUnePlaceACeNiveau 1
	    foreach LaRegionDuNiveau [set TabNiveau($Niv,LesRegions)] {
		set DNiv [lindex $LaRegionDuNiveau 0]
		set FNiv [lindex $LaRegionDuNiveau 1]
		if {[CesRegionsSontEllesOverlappantes $DQ $FQ $DNiv $FNiv]} {
		    set AiJeRencontreUnePlaceACeNiveau 0
		    break
		}
	    }
	    if {$AiJeRencontreUnePlaceACeNiveau} {
		set     NiveauVide                         $Niv
		lappend TabNiveau($NiveauVide,LesRegions)  [list $DQ $FQ]
		set     AiJeRencontreUnNiveauAvecDeLaPlace 1
		break
	    }
	}
	if {!$AiJeRencontreUnNiveauAvecDeLaPlace} {
	    incr    NiveauMax
	    set     NiveauVide                        $NiveauMax
	    set     TabNiveau($NiveauVide,LesRegions) {}
	    lappend TabNiveau($NiveauVide,LesRegions) [list $DQ $FQ]
	}

	if {$NiveauMaxDeRef < $NiveauVide} {set NiveauVide $NiveauMaxDeRef}

	set XMin    [expr ($DQR-1)   * $FacteurQX + $BordX]
	set YMin    [expr $YMinDeRef + $NiveauVide * ($HSmallBox + $EcartY)]
	set XMax    [expr $FQR       * $FacteurQX + $BordX]
	set YMax    [expr $YMin      + $HSmallBox                          ]

	set LesTags [list "Box" $FichierBlast $BanqueId $Seg]

	set Tab(DQ,$DQ,FQ,$FQ,LesCoordonnees) [list $XMin $YMax $XMax $YMax]

	lappend LesFormesAPlacer [list rectangle $XMin $YMin $XMax $YMax $ColorFill $ColorOutLine 2 $LesTags]
    }

    set LesPetitesRegionsUniquesDuSubject  [LesPetitesRegionsDesGrandesRegions  $LesRegionsUniquesDuSubject]
    foreach LaRegion [LesRegionsAbsentesDesPetitesRegions $LesPetitesRegionsUniquesDuSubject 1 $TailleS] {
	lappend LaRegion "Absente"
	lappend LesPetitesRegionsUniquesDuSubject $LaRegion
    }

    set TailleDeLaSeqReduiteS       0
    set TailleDeLaReduction         0
    foreach LaRegion [lsort -index 0 -real $LesPetitesRegionsUniquesDuSubject] {
	set DS     [lindex $LaRegion 0]
	set FS     [lindex $LaRegion 1]
	set Type   [lindex $LaRegion 2]

	set Taille [expr   $FS-$DS + 1]

	set  DRed                      [expr $DS - $TailleDeLaReduction]
	set  FRed                      [expr $FS - $TailleDeLaReduction]
	if {$Type == "Absente" && $TailleMaxDUneRegionNonAlignee < $Taille} {
	    set  FRed                  [expr $DRed + $TailleMaxDUneRegionNonAlignee - 1]
	    incr TailleDeLaReduction   [expr $Taille - $TailleMaxDUneRegionNonAlignee]
	    incr TailleDeLaSeqReduiteS $TailleMaxDUneRegionNonAlignee
	} else {
	    incr TailleDeLaSeqReduiteS $Taille
	}
	set TabRed(Subject,$DS) $DRed
	set TabRed(Subject,$FS) $FRed
    }
    set FacteurSX [expr $LargeurAffichage * 1.0 / $TailleDeLaSeqReduiteS]

    set     XMin             $BordX
    set     YMin             [expr $HauteurMax - $BordY - $HBox]
    set     XMax             [expr $XMin + $LargeurAffichage]
    set     YMax             [expr $YMin + $HBox]
    set     YText            [expr $YMin + ($YMax - $YMin)/2]
    lappend LesFormesAPlacer [list rectangle $XMin           $YMin $XMax $YMax "lightgrey" "black" 3]
    lappend LesFormesAPlacer [list text  [expr $LargeurFenetre*1.0/2] [expr $HauteurMax - $BordY*1.0/3] "center" "SBJCT : $BanqueId"]

    if {$SensGeneral == "+"} {
	lappend LesFormesAPlacer [list text      [expr $XMin-1]  $YText "e"  1                          ]
	lappend LesFormesAPlacer [list text      [expr $XMax+1]  $YText "w"  $TailleS                   ]
    } else {
	lappend LesFormesAPlacer [list text      [expr $XMin-1]  $YText "e"  $TailleS                   ]
	lappend LesFormesAPlacer [list text      [expr $XMax+1]  $YText "w"  1                          ]
    }
    foreach LaRegion $LesRegionsDuSubject {
	set DS    [lindex $LaRegion 0]
	set FS    [lindex $LaRegion 1]

	if {![info exists Tab(Subject,$DS,$FS,RegionOccupee)]} {continue}
	if {![info exists TabRed(Subject,$DS)               ]} {continue}
	if {![info exists TabRed(Subject,$FS)               ]} {continue}

	set DSR    [set TabRed(Subject,$DS)]
	set FSR    [set TabRed(Subject,$FS)]
	set DQ     [lindex $LaRegion 2]
	set FQ     [lindex $LaRegion 3]
	set Orient [lindex $LaRegion 4]
	set Id     [lindex $LaRegion 5]
	set Seg    [lindex $LaRegion 6]

	set ColorFill    [ColoriageDeLIdDeDrawBlast    $Id    ]
	set ColorOutLine [ColoriageDuMappingDeDrawBlast $Orient]

	if {$SensGeneral == "-"} {
	    set XMax  [expr $LargeurMax - (($DSR-1) * $FacteurSX + $BordX)]
	    set XMin  [expr $LargeurMax - ($FSR     * $FacteurSX + $BordX)]
	} else {
	    set XMin  [expr ($DSR-1) * $FacteurSX + $BordX]
	    set XMax  [expr $FSR     * $FacteurSX + $BordX]
	}

	set LesTags [list "Box" $FichierBlast $BanqueId $Seg]

	if {![info exists Tab(Subject,Box,$DS,$FS)]} {
	    set     Tab(Subject,Box,$DS,$FS) 1
	    lappend LesFormesAPlacer [list rectangle $XMin $YMin $XMax $YMax $ColorFill $ColorOutLine 2 $LesTags]
	}
	set XLineS1 $XMin
	set YLineS1 $YMin
	set XLineS2 $XMax
	set YLineS2 $YMin

	set LesCoordonnees [set Tab(DQ,$DQ,FQ,$FQ,LesCoordonnees)]
	set XLineQ1 [lindex $LesCoordonnees 0]
	set YLineQ1 [lindex $LesCoordonnees 1]
	set XLineQ2 [lindex $LesCoordonnees 2]
	set YLineQ2 [lindex $LesCoordonnees 3]
	
	lappend LesFormesAPlacer [list line $XLineQ1 $YLineQ1 $XLineS1 $YLineS1 $ColorOutLine]
	lappend LesFormesAPlacer [list line $XLineQ2 $YLineQ2 $XLineS2 $YLineS2 $ColorOutLine]
    }

    #######CREATION DES FORMES##################

    set KCanva [Canva $LargeurMax $HauteurMax $LargeurFenetre $HauteurFenetre "NoY" "BlastTools" "" $KCanva]
    $KCanva configure -background white

    set i 0
    foreach LaForme $LesFormesAPlacer {

	set Forme    [lindex $LaForme 0]
	set XMin     [lindex $LaForme 1]
	set YMin     [lindex $LaForme 2]

	if {$Forme == "text"} {
	    set Anch    [lindex $LaForme 3]
	    set Text    [lindex $LaForme 4]
	    set LesTags [lindex $LaForme 5]

	    $KCanva create text $XMin $YMin -text $Text -anchor $Anch -font "courier 10" -tags $LesTags
	    continue
	}
	set XMax     [lindex $LaForme 3]
	set YMax     [lindex $LaForme 4]
	set Color    [lindex $LaForme 5]
	if {$Forme == "rectangle"} {
	    set COutLine [lindex $LaForme 6]
	    set Width    [lindex $LaForme 7]
	    set LesTags  [lindex $LaForme 8]

	    $KCanva create rectangle $XMin $YMin $XMax $YMax -fill $Color -outline $COutLine -width $Width -tags $LesTags
	    continue
	}
	if {$Forme == "line"} {
	    if {[lindex $LaForme 6] == "dash"} {
		$KCanva create line      $XMin $YMin $XMax $YMax -fill $Color -dash {4 2}
	    } else {
		$KCanva create line      $XMin $YMin $XMax $YMax -fill $Color
	    }
	    continue
	}
    }

    $KCanva bind "Box" <1>     "DrawInfoDeDrawBlast $w $KCanva Ali     "
    $KCanva bind "Box" <2>     "DrawInfoDeDrawBlast $w $KCanva ToutLAli"
    $KCanva bind "Box" <3>     "DrawInfoDeDrawBlast $w $KCanva PageInfo"

}

proc DrawMappingPourDrawBlast {w K} {

    set Id           [$K find withtag current]
    set MesTags      [$K gettags $Id]
    set BId          [lindex $MesTags 2]

    set FichierBlast                  [AskOptionsDeDrawBlast ask $w FichierBlast                 ]
    set ExpectMax                     [AskOptionsDeDrawBlast ask $w ExpectMax                    ]
    set IdMin                         [AskOptionsDeDrawBlast ask $w IdMin                        ]
    set TailleMaxDUneRegionNonAlignee [AskOptionsDeDrawBlast ask $w TailleMaxDUneRegionNonAlignee]
    set LargeurFenetre                [AskOptionsDeDrawBlast ask $w LargeurFenetre               ]
    set FrameCanvaMapping             [AskOptionsDeDrawBlast ask $w FrameCanvaMapping            ]
    set HauteurFenetreMapping         [AskOptionsDeDrawBlast ask $w HauteurFenetreMapping        ]

    AskOptionsDeDrawBlast set $w BanqueId $BId

    if {$FichierBlast == ""} {return}

    DrawMapping $FichierBlast $BId $ExpectMax $IdMin $TailleMaxDUneRegionNonAlignee $LargeurFenetre $HauteurFenetreMapping $FrameCanvaMapping $w

}

proc DrawMosaic {FichierBlast {ExpectMax 1e200} {NbSubjectMax 1e200} {IdMin 0.0} {LesBanqueId {}} {LargeurFenetre {}} {HauteurFenetre {}} {KCanva {}} {w {}}} {

    if {![file exists $FichierBlast]} {return}
    set TailleQ     [AskBlast $FichierBlast Taille]
    set TypeDeBlast [AskBlast $FichierBlast TypeDeBlast]
    set Query       [AskBlast $FichierBlast Query]
    
    if {$TailleQ == ""} {return}

    if {$LargeurFenetre == ""} {set LargeurFenetre     [expr [winfo screenheight .] * 2.0 / 3]}
    if {$HauteurFenetre == ""} {set HauteurFenetre     [expr [winfo screenheight .] * 2.0 / 3]}
    set LargeurMax       $LargeurFenetre
    set HauteurMax       $HauteurFenetre
    set BordX            [expr $LargeurFenetre * 1.0 / 4 ]
    set BordY            [expr $HauteurFenetre * 1.0 / 10]
    if {$BordY < 30} {set BordY 40}

    set EcartY           10.0
    set HBox             25.0
    set HSmallBox        15.0
    set LargeurAffichage [expr $LargeurFenetre - 2 * $BordX]
    set FacteurX         [expr $LargeurAffichage * 1.0 / $TailleQ]

    set LaFrequenceDesPetitesRegionsDuBlast [LaFrequenceDesPetitesRegionsDeLaQueryDuBlast $FichierBlast $ExpectMax $NbSubjectMax $IdMin "No" $LesBanqueId]
    if {$LaFrequenceDesPetitesRegionsDuBlast == {}} {
	Canva $LargeurFenetre $HauteurFenetre $LargeurFenetre $HauteurFenetre "NoY" "" "" $KCanva
	$KCanva configure -background white
	return
    }
    set LesFormesAPlacer {}

    lappend LesFormesAPlacer [list text  [expr $LargeurFenetre*1.0/2] [expr $BordY*1.0/3] "center" "QUERY : [string range $Query end-30 end]"]
    lappend LesFormesAPlacer [list text  [expr $LargeurFenetre*1.0/2] [expr $BordY*2.0/3] "center" "BLAST : $TypeDeBlast"                    ]

    set     YMin             $BordY
    set     XMin             $BordX
    set     YMax             [expr $YMin + $HBox]
    set     XMax             [expr $XMin + $LargeurAffichage]
    set     YText            [expr $YMin + ($YMax - $YMin)/2]

    lappend LesFormesAPlacer [list rectangle $XMin           $YMin $XMax $YMax "lightgrey" "black" 3]
    lappend LesFormesAPlacer [list text      [expr $XMin-1]  $YText "e"  1                                     ]
    lappend LesFormesAPlacer [list text      [expr $XMax+1]  $YText "w"  $TailleQ                              ]
    lappend LesFormesAPlacer [list text      $LargeurFenetre $YMax  "ne" [format "%10s %10s" "Length" "Expect"]]
    
    foreach LaFrequenceDeLaRegion $LaFrequenceDesPetitesRegionsDuBlast {
	set Deb     [lindex $LaFrequenceDeLaRegion 0]
	set Fin     [lindex $LaFrequenceDeLaRegion 1]
	set XMin    [expr ($Deb-1) * $FacteurX + $BordX]
	set XMax    [expr $Fin     * $FacteurX + $BordX]

	set Freq    [lindex $LaFrequenceDeLaRegion 2    ]
	set Couleur [ColoriageDeLaFrequenceDeDrawBlast        $Freq]
	lappend LesFormesAPlacer [list rectangle $XMin $YMin $XMax $YMax $Couleur $Couleur 1]
    }
    set YMinDeRef [expr $YMax + $EcartY]

    foreach BId $LesBanqueId {set TabSelect($BId) 1}

    set k 0
    set NbSubject [AskBlast $FichierBlast NbSubject]
    for {set i 1;set NiveauMinDeRef 1} {$i <= $NbSubject} {incr i;incr NiveauMinDeRef} {
	set BId         [AskBlast $FichierBlast Subject  $i              ]
	set NbSegment   [AskBlast $FichierBlast BanqueId $BId NbSegment  ]
	set TailleS     [AskBlast $FichierBlast BanqueId $BId Taille     ]

	if {$LesBanqueId != "" && ![info exists TabSelect($BId)]} {incr NiveauMinDeRef -1;continue}

	set YLigne [expr $YMinDeRef + ($NiveauMinDeRef-1) * ($HSmallBox + $EcartY) + $EcartY * 1.0 / 2]

	if {[info exists TabNiveau]} {unset TabNiveau}

	set LesFormesAPlacerDuSubject {}
	set NiveauMaxDuSubject $NiveauMinDeRef
	for {set j 1} {$j <= $NbSegment} {incr j} {
	    set Expect [AskBlast $FichierBlast BanqueId $BId Segment $j Expect]
	    if {$ExpectMax  < $Expect} {continue}

	    set Identities [AskBlast $FichierBlast BanqueId $BId Segment $j Identities]
	    scan $Identities "%d/%d" n nTot
	    set Id [expr $n*1.0/$nTot]
	    if {$Id < $IdMin} {continue}

	    set ColorFill  [ColoriageDeLIdDeDrawBlast $Id]
	    
	    set TypeRegion [AskBlast $FichierBlast BanqueId $BId Segment $j Orientation]
	    if {$TypeRegion == "" && [regexp "BLASTP" $TypeDeBlast]} {set TypeRegion "Prot / Prot"}
	    set ColorOutLine [ColoriageDuMappingDeDrawBlast $TypeRegion]

	    set DQ [Mini [AskBlast $FichierBlast BanqueId $BId Segment $j DQ] [AskBlast $FichierBlast BanqueId $BId Segment $j FQ]]
	    set FQ [Maxi [AskBlast $FichierBlast BanqueId $BId Segment $j DQ] [AskBlast $FichierBlast BanqueId $BId Segment $j FQ]]

	    set AiJeRencontreUnNiveauAvecDeLaPlace 0
	    for {set Niv $NiveauMinDeRef} {$Niv <= $NiveauMaxDuSubject} {incr Niv} {
		if {![info exists TabNiveau($Niv,LesRegions)]} {set TabNiveau($Niv,LesRegions) {}}
		set AiJeRencontreUnePlaceACeNiveau 1
		foreach LaRegion [set TabNiveau($Niv,LesRegions)] {
		    set DR [lindex $LaRegion 0]
		    set FR [lindex $LaRegion 1]
		    if {[CesRegionsSontEllesOverlappantes $DQ $FQ $DR $FR]} {
			set AiJeRencontreUnePlaceACeNiveau 0
			break
		    }
		}
		if {$AiJeRencontreUnePlaceACeNiveau} {
		    set     AiJeRencontreUnNiveauAvecDeLaPlace 1
		    lappend TabNiveau($Niv,LesRegions) [list $DQ $FQ]
		    set     NiveauVide                         $Niv
		    break
		}
	    }
	    if {!$AiJeRencontreUnNiveauAvecDeLaPlace} {
		incr    NiveauMaxDuSubject
		set     NiveauVide                        $NiveauMaxDuSubject
		set     TabNiveau($NiveauVide,LesRegions) {}
		lappend TabNiveau($NiveauVide,LesRegions) [list $DQ $FQ]
	    }

	    set XMin [expr ($DQ-1) * $FacteurX + $BordX]
	    set YMin [expr $YMinDeRef + $NiveauVide * ($HSmallBox + $EcartY) - $HSmallBox]
	    set XMax [expr  $FQ    * $FacteurX + $BordX]
	    set YMax [expr $YMin      + $HSmallBox                                      ]

	    if {$HauteurMax < $YMax} {set HauteurMax $YMax}

	    set LesTags   [list "Box" $FichierBlast $BId $j]
	    lappend LesFormesAPlacerDuSubject [list rectangle $XMin $YMin $XMax $YMax $ColorFill $ColorOutLine 2 $LesTags]
	}
	if {$LesFormesAPlacerDuSubject == {}} {incr NiveauMinDeRef -1;continue}

	incr k
	if {$NbSubjectMax < $k} {break}

	set NiveauMinDeRef $NiveauMaxDuSubject

	set Expect [AskBlast $FichierBlast BanqueId $BId Segment 1 Expect]
	
	set LesTags   [list "Box" $FichierBlast $BId All]

	set XMin 0
	set XMax $LargeurFenetre
	lappend LesFormesAPlacer [list line $XMin $YLigne $XMax $YLigne "black" "dash"]
	lappend LesFormesAPlacer [list text $XMin [expr $YLigne+1] "nw" $BId                                  $LesTags]
	lappend LesFormesAPlacer [list text $XMax [expr $YLigne+1] "ne" [format "%10s %10s" $TailleS $Expect] $LesTags]

	foreach LaForme $LesFormesAPlacerDuSubject {
	    lappend LesFormesAPlacer $LaForme
	}
    }
    #######CREATION DES FORMES##################
    set HauteurMax [expr $HauteurMax + $EcartY]
    set KCanva [Canva $LargeurMax $HauteurMax $LargeurFenetre $HauteurFenetre "NoY" "BlastTools" "" $KCanva]
    $KCanva configure -background white

    set i 0
    foreach LaForme $LesFormesAPlacer {
	set Forme    [lindex $LaForme 0]
	set XMin     [lindex $LaForme 1]
	set YMin     [lindex $LaForme 2]

	if {$Forme == "text"} {
	    set Anch    [lindex $LaForme 3]
	    set Text    [lindex $LaForme 4]
	    set LesTags [lindex $LaForme 5]

	    $KCanva create text $XMin $YMin -text $Text -anchor $Anch -font "courier 12" -tags $LesTags
	    continue
	}
	set XMax     [lindex $LaForme 3]
	set YMax     [lindex $LaForme 4]
	set Color    [lindex $LaForme 5]
	if {$Forme == "rectangle"} {
	    set COutLine [lindex $LaForme 6]
	    set Width    [lindex $LaForme 7]
	    set LesTags  [lindex $LaForme 8]

	    $KCanva create rectangle $XMin $YMin $XMax $YMax -fill $Color -outline $COutLine -width $Width -tags $LesTags
	    continue
	}
	if {$Forme == "line"} {
	    if {[lindex $LaForme 6] == "dash"} {
		$KCanva create line      $XMin $YMin $XMax $YMax -fill $Color -dash {4 2}
	    } else {
		$KCanva create line      $XMin $YMin $XMax $YMax -fill $Color
	    }
	    continue
	}
    }

    $KCanva bind "Box" <1>          "DrawInfoDeDrawBlast      $w $KCanva Ali     "
    $KCanva bind "Box" <2>          "DrawInfoDeDrawBlast      $w $KCanva ToutLAli"
    $KCanva bind "Box" <3>          "DrawInfoDeDrawBlast      $w $KCanva PageInfo"
    $KCanva bind "Box" <Shift-1>    "DrawMappingPourDrawBlast $w $KCanva" 

}

proc DrawOneBall {K GO Niveau XMin XMax Y TailleDUnNiveau aTabDesGOParticuliers {XPere {}} {PartOfouSubclassOf {}}} {

    upvar $aTabDesGOParticuliers TabDesGOParticuliers

    ##########################################################
    #####INFORMATION SPECIFIQUE DE CHAQUE GO SUR L'ARBRE######
    #####TAGS#################################################
    set LeTexte        {}
    set LesTypes       [GODB GO $GO LesTypes]
    set LesDefinitions {}
    set LesGO          {}
    set LesGOChild     {}
    foreach Type $LesTypes {
	set GO [GODB Type $Type GOSynonyme $GO GODeRef]
	if {[info exists TabTmp($GO)]} {continue}
	set     TabTmp($GO) 1
	lappend LesGO $GO
	foreach GOSynonyme [GODB Type $Type GO $GO LesSynonymes] {
	    if {[info exists TabTmp($GOSynonyme)]} {continue}
	    set     TabTmp($GOSynonyme) 1
	    lappend LesGO $GOSynonyme
	}
    }
    foreach GO [lsort -unique $LesGO] {
	foreach Type [GODB GO $GO LesTypes] {
	    foreach Definition [GODB Type $Type GO $GO LesDefinitions] {
		if {[info exists TabTmp($Definition)]} {continue}
		set     TabTmp($Definition) 1
		lappend LesDefinitions      $Definition
	    }
	    foreach GOSynonyme [GODB Type $Type GO $GO LesSynonymes] {
		if {[info exists TabTmp($GOSynonyme)]} {continue}
		set     TabTmp($GOSynonyme) 1
		lappend LesGO $GOSynonyme
	    }
	    foreach GOChild [GODB Type $Type GO $GO LesContributions] {
		if {[info exists TabDesGOParticuliers($GOChild,Absent)]} {continue}
		if {[info exists TabTmp($GOChild)]} {continue}
		set TabTmp($GOChild) 1
		lappend LesGOChild [list $GOChild "PartOf"     $Type]
	    }
	    foreach GOChild [GODB Type $Type GO $GO LesEnfants      ] {
		if {[info exists TabDesGOParticuliers($GOChild,Absent)]} {continue}
		if {[info exists TabTmp($GOChild)]} {continue}
		set TabTmp($GOChild) 1
		lappend LesGOChild [list $GOChild "SubclassOf" $Type]
	    }
	}
    }
    if {![info exists TabTmp]} {unset TabTmp}
    
    lappend LeTexte         "Type       : [join $LesTypes " "]"
    lappend LeTexte         "Name       : [join $LesGO    " "]"
    lappend LeTexte         "Definition :"
    foreach Definition $LesDefinitions {lappend LeTexte "$Definition"}
    
    if {[GOUsersDB ask LesGO] != ""} {
	set LesAccess       {}
	set LesRequetes     {}
	set LesBoites       {}
	foreach GO $LesGO {
	    foreach Access  [lsort -unique [GOUsersDB ask GO $GO LesAccess      ]] {lappend LesAccess   $Access } 
	    foreach Requete [lsort -unique [GOUsersDB ask GO $GO LesRequetes    ]] {lappend LesRequetes $Requete}
	    foreach LaBoite [lsort -unique [GOUsersDB ask GO $GO LesBoitesGscope]] {lappend LesBoites   $LaBoite}
	}
	lappend     LeTexte "UsersSelection"
	if {$LesAccess   != ""} {
	    lappend LeTexte "Access     : [join $LesAccess   " "]"
	}
	if {$LesRequetes != ""} {
	    lappend LeTexte "Links      : [join $LesRequetes " "]"
	}
	if {$LesBoites   != ""} {
	    lappend LeTexte "GscopeBox  :"
	    foreach LaBoite $LesBoites {
		set Nom  [lindex $LaBoite 0]
		set File [lindex $LaBoite 1]
		lappend LeTexte "   $Nom $File"
	    }
	}
    }
    set LeTexteDefinitif {}
    foreach Ligne $LeTexte {
	while {100 < [string length $Ligne]} {
	    lappend LeTexteDefinitif [string range $Ligne 0  59 ]
	    set     Ligne            [string range $Ligne 60 end]
	}
	if {[string length $Ligne] != 0} {lappend LeTexteDefinitif $Ligne}
    }
    set ListeDesTags [list "Affichable" [join $LeTexteDefinitif "\n"] "GO" $LesGO]
    ##########################################################
    set Definition [lindex $LesDefinitions 0]

    set DiffX      [expr ($XMax          -  $XMin )]
    set X          [expr $DiffX * 1.0 /2 +  $XMin  ]

    set Rayon1     [FDeX Calc               $Niveau]
    set Rayon2     [expr $DiffX / 6                ] 
    if {$Rayon2 < $Rayon1} {set Rayon $Rayon2} else {set Rayon $Rayon1}

    set XMinCercle [expr $X              -  $Rayon ]
    set YMinCercle [expr $Y              -  $Rayon ]
    set XMaxCercle [expr $X              +  $Rayon ]
    set YMaxCercle [expr $Y              +  $Rayon ]
 
    set  Color      "Green"
    if {[string equal -nocase $PartOfouSubclassOf "PartOf"    ]} {set Color "blue"}
    if {[string equal -nocase $PartOfouSubclassOf "SubclassOf"]} {set Color "red" }
    foreach GO $LesGO {if {[info exists TabDesGOParticuliers($GO,Ref)]} {set Color "Orange";break}}

    if {300 < [expr $XMax - $XMin]} {
	set Definition [string range $Definition 0 50]
	set Police     "arial 12"
    } elseif {200 < [expr $XMax - $XMin]} {
	set Definition [string range $Definition 0 30]
	set Police     "arial 10"
    } elseif {100 < [expr $XMax - $XMin]} {
	set Definition [string range $Definition 0 20]
	set Police     "arial 9"
    } elseif {70 < [expr $XMax - $XMin]} {
	set Definition [string range $Definition 0 10]
	set Police     "arial 8"
    } elseif {40 < [expr $XMax - $XMin]} {
	set Definition [string range $Definition 0 10]
	set Police     "arial 7"
    } else {
	set  Definition ""
    }
	
    $K create oval $XMinCercle $YMinCercle $XMaxCercle $YMaxCercle -fill $Color -tags $ListeDesTags
    if {$XPere != ""} {
	$K lower [$K create line $XPere [expr $Y-$TailleDUnNiveau] $X $Y -fill $Color -tags $ListeDesTags]
    }
    if {$Definition != ""} {
	$K raise [$K create text $X [expr $Y - $Rayon] -anchor s -text $Definition -fill $Color -font $Police -tags $ListeDesTags]
    }
 
    ###################################################################
    if {$LesGOChild == {}} {return}

    set YChild          [expr $Y  +  $TailleDUnNiveau]
    set nBulles         [llength          $LesGOChild]
    set EcartDeX        [expr $DiffX * 1.0 / $nBulles]
    incr Niveau
    for {set i 0} {$i < $nBulles} {incr i} {
	set LeGOChild          [lindex $LesGOChild $i]
	set GOChild            [lindex $LeGOChild 0]
	set PartOfouSubclassOf [lindex $LeGOChild 1]
	set Type               [lindex $LeGOChild 2]
	set XMinChild          [expr $XMin      + $EcartDeX * $i]
	set XMaxChild          [expr $XMinChild + $EcartDeX     ]

	DrawOneBall $K $GOChild $Niveau $XMinChild $XMaxChild $YChild $TailleDUnNiveau TabDesGOParticuliers $X $PartOfouSubclassOf
    }
    return

}

proc DrawOpenCloseArrow {w x y Etat} {

    set xm [expr {$x-10}]
    set ym [expr {$y-10}]
    set xx [expr {$x+10}]
    set yx [expr {$y+10}]

    if {$Etat} {
	# open ; arrow head bottom
	set Lc [list $xm $ym $xx $ym $x $yx]
	set col green1
    } else {
	# clsoe ; arrow head horizontal
	set Lc [list $xm $ym $xx $y $xm $yx]
	set col orange
    }
    
    set Id [$w create polygon $Lc  -fill $col  -outline black  -width 2  -tags {Arrow}
	   ]
    
    return $Id

}

proc DrawTaxo {{toSee {}}} {

    global TaxRoot Tx HExstModel HExstUser  HExstSel LModelId LUserId LTaxSelected

    set w $Tx(PAD)
    $w delete all

    array set HExstModel [HashExiste $LModelId]
    array set HExstUser  [HashExiste $LUserId]
    array set HExstSel   [HashExiste $LTaxSelected]

    DrawTaxoNode $TaxRoot 20 20
    
    $w raise Arrow
    $w lower Rleaf
    $w lower RectInt
    $w lower Line

    lassign [$w bbox all] x1 y1 x2 y2
    set dx [expr {$x2-$x1+50}]
    set dy [expr {$y2-$y1+50}]
    if {$dx < $Tx(PADWdt)} {set dx $Tx(PADWdt)}
    if {$dy < $Tx(PADHgt)} {set dy $Tx(PADHgt)}
    $w configure -scrollregion [list 0 0 $dx $dy]
    
    if {$toSee ne ""} {
	CanvasSee $w $toSee
    }

    return

}

proc DrawTaxoNode {n xCsg yCsg} {
 
    global Tx

    if {! $Tx(hasSel,$n)} {
	return [list $xCsg $yCsg]
    }

    if {$Tx(Etat,$n)} {
	set Lchild [set Tx(ChildD,$n)]
    } else {
	set Lchild {}
    }

    set OffsetX $Tx(OffsetX)
    set OffsetY $Tx(OffsetY)

    set xDeb $xCsg
    set yDeb $yCsg
    set xFin $xCsg
    if {$Tx(isInt,$n) && ! $Tx(ShowInt,$n)} {
	set yFin $yCsg
    } else {
	set yFin [expr {$yCsg + $OffsetY}]
	set nom [set Tx(Name,$n)]
	WriteTaxName $n $nom $xFin $yFin
    }
    
    set LAnchors [list]
    foreach f $Lchild {
	if {$Tx(isInt,$f) && ! $Tx(ShowInt,$f)} {
	    set xDrw $xDeb
	} else {
	    set xDrw [expr {$xDeb + $OffsetX}]
	}
	lappend LAnchors [list $xDrw $yFin]
	set yFin [lindex [DrawTaxoNode $f $xDrw $yFin] 1]
    }

    # line linking brothers
    if {[llength [lunique $LAnchors]] > 1} {
	lassign [lindex $LAnchors 0]   x0 y0
	lassign [lindex $LAnchors end] x1 y1
	incr y0 [expr {$OffsetY}]
	incr y1 [expr {$OffsetY}]
	$Tx(PAD) create line [list $x0 $y0 $x1 $y1]  -fill $Tx(fgCan)  -width 1  -tags {Line}
    }

    return [list $xFin $yFin]

}

proc DrawTreeAllGO {KTree {LesGO {}} {OpenOuClose Close} {CheminIni {}}} {

    global TabAiJeVuCetteBranche

    set TousLesGO [GODB LesGO]
    if {$LesGO == ""} {
	set LesGO $TousLesGO
	set LesTypes [GODB LesTypes]
    } else {
	foreach GO [TousLesAncetresGODesGO $LesGO] {lappend LesGO $GO}
	set LesTypes [LesTypesDesGO $LesGO]
	foreach GOAbsent [LaDifferenceDeL1AvecL2 $TousLesGO moins $LesGO] {set TabDesExceptions($GOAbsent) 0}
    }
    
    foreach Type [GODB LesTypes] {
	set Chemin "$CheminIni/$Type"
	if {[info exists TabAiJeVuCetteBranche($KTree,$Chemin)]} {Tree:delitem  $KTree $Chemin}
    }

    ImageDirectory   idir
    ImageFile        ifile

    set NiveauPremierGO 0
    foreach Type $LesTypes {
	set Chemin "$CheminIni/$Type"

	set TabAiJeVuCetteBranche($KTree,$Chemin) 1

	Tree:newitem    $KTree $Chemin -image idir
	TreeOpenOuClose $KTree $Chemin $OpenOuClose

	foreach GO [GODB Type $Type Niveau $NiveauPremierGO LesGO] {
	    if {[info exists TabDesExceptions($GO)]} {continue}
	    PlaceNoeudDansTreeAllGO $KTree $Type $GO $Chemin "" TabDesExceptions $OpenOuClose
	}
    }
    if {[info exists TabTmp]} {unset TabTmp}   
    update

}

proc DrawTreeOneGO {KTree {GO {}}} {

    global TabAiJeVuCetteBranche

    if {$GO == ""} {set GO [lindex [GODB Type [lindex [GODB LesTypes] 0] Niveau 0 LesGO] 0]} 

    set LesTypes [GODB GO $GO LesTypes]

    set LesGO {}
    foreach Type $LesTypes {
	set GO [GODB Type $Type GOSynonyme $GO GODeRef]
	if {[info exists TabTmp($GO)]} {continue}
	set TabTmp($GO) 1
	lappend LesGO $GO

	foreach GOSynonyme [GODB Type $Type GO $GO LesSynonymes] {
	    if {[info exists TabTmp($GOSynonyme)]} {continue}
	    set TabTmp($GOSynonyme) 1
	    lappend LesGO $GOSynonyme
	}
    }
    if {![info exists TabTmp]} {unset TabTmp}

    set LesDefinitions {}
    set LesRequetes    {}
    foreach GO $LesGO {
	lappend LesDescendantsEtAncetres $GO
	foreach Type [GODB GO $GO LesTypes] {
	    foreach Definition [GODB Type $Type GO $GO LesDefinitions] {
		regsub -all " |\/" $Definition "_" Definition
		if {[info exists TabTmp($Definition)]} {continue}
		set TabTmp($Definition) 1
		lappend LesDefinitions $Definition
	    }
	}
	foreach Requete [2GO $GO LesLiens] {
	    if {[info exists TabTmp($Requete)]} {continue}
	    set WhatIsIt [2GO $Requete WhatIsIt]

	    lappend LesRequetes [list $WhatIsIt $Requete]

	    set TabTmp($Requete) 1
	}
    }

    if {![info exists TabTmp]} {unset TabTmp}
    set LesRequetes [lsort -index 0 $LesRequetes]

    set LesParents     [concat [TousLesAncetresGODesGO    $LesGO] $LesGO]
    ###############################################################################
    
    ImageDirectory   idir
    ImageFile        ifile

    set Chemin "/GO"
    if {[info exists TabAiJeVuCetteBranche($KTree,$Chemin)]} {Tree:delitem  $KTree $Chemin}
    set TabAiJeVuCetteBranche($KTree,$Chemin) 1
    foreach GO $LesGO {
	Tree:createallchildren $KTree [list [list "GO" "Open" idir] [list $GO "Open" ifile]]
    }
  
    set Chemin "/GO_Definitions"
    if {[info exists TabAiJeVuCetteBranche($KTree,$Chemin)]} {Tree:delitem  $KTree $Chemin}
    set TabAiJeVuCetteBranche($KTree,$Chemin) 1
    foreach Definition $LesDefinitions {
	Tree:createallchildren $KTree [list [list "GO_Definitions" "Open" idir] [list $Definition "Open" ifile]]
    }
    
    set Chemin "/GO_Links"
    if {[info exists TabAiJeVuCetteBranche($KTree,$Chemin)]} {Tree:delitem  $KTree $Chemin}
    set TabAiJeVuCetteBranche($KTree,$Chemin) 1
    foreach LaRequete $LesRequetes {
	set Banque  [lindex $LaRequete 0]
	set Requete [lindex $LaRequete 1]
	Tree:createallchildren $KTree [list [list "GO_Links" "Open" idir] [list $Banque "Close" idir] [list $Requete "Open" ifile]]
    }

    set Chemin "/GO_ParentTerms"
    if {[info exists TabAiJeVuCetteBranche($KTree,$Chemin)]} {Tree:delitem  $KTree $Chemin}
    if {$LesParents != ""} {
	set TabAiJeVuCetteBranche($KTree,$Chemin) 1
	Tree:newitem    $KTree $Chemin -image idir
	TreeOpenOuClose $KTree $Chemin   Open
	DrawTreeAllGO $KTree $LesParents Open $Chemin
    }

    if {[GOUsersDB ask LesGO] != ""} {
	set Chemin "/GO_UsersSelection"
	if {[info exists TabAiJeVuCetteBranche($KTree,$Chemin)]} {Tree:delitem  $KTree $Chemin}
	set TabAiJeVuCetteBranche($KTree,$Chemin) 1
	foreach GO $LesGO {
	    set LesAccess       [lsort -unique [GOUsersDB ask GO $GO LesAccess      ]]
	    set LesRequetes     [lsort -unique [GOUsersDB ask GO $GO LesRequetes    ]]
	    set LesBoitesGscope [lsort -unique [GOUsersDB ask GO $GO LesBoitesGscope]]
	    if {$LesAccess != ""} {
		foreach Access $LesAccess {
		    Tree:createallchildren $KTree [list [list "GO_UsersSelection" "Open" idir] [list "Access" "Open" idir] [list $Access "Close" ifile]]
		    foreach Requete [GOUsersDB ask Access $Access LesRequetes] {
			regsub -all  " |\/" $Requete "_" Requete

			Tree:createallchildren $KTree [list [list "GO_UsersSelection" "Open" idir] [list "Access" "Open" idir] [list $Access "Close" ifile] [list $Requete "Close" ifile]]
		    }
		}
	    }
	    if {$LesRequetes != ""} {
		foreach Requete $LesRequetes {
		    regsub -all  " |\/" $Requete "_" Requete
		    Tree:createallchildren $KTree [list [list "GO_UsersSelection" "Open" idir] [list "DomainsKeywords" "Open" idir] [list $Requete "Open" ifile]]
		}
	    }
	    if {$LesBoitesGscope != ""} {
		set CheminBox "$Chemin/GscopeBox"
		foreach LaBoite $LesBoitesGscope {
		    set Nom       [lindex $LaBoite 0]
		    set FichierGO [lindex $LaBoite 1]
		    regsub -all "\/" $FichierGO "|" TexteFichierGO

		    Tree:createallchildren $KTree [list [list "GO_UsersSelection" "Open" idir] [list "GscopeBox" "Open" idir] [list $TexteFichierGO "Open" idir] [list $Nom "Close" ifile]]
		    foreach Access [GOUsersDB ask Gscope $FichierGO Nom $Nom LesAccess] {
			Tree:createallchildren $KTree [list [list "GO_UsersSelection" "Open" idir] [list "GscopeBox" "Open" idir] [list $TexteFichierGO "Open" idir] [list $Nom "Close" ifile] [list $Access "Close" ifile]]
		    }
		}

	    }
	}
    }
    if {[info exists TabTmp]} {unset TabTmp}
    update

}

proc EMBLdeGscope {Access {ACFirst {}}} {

    if {$ACFirst=="ACFirst"} { set ACFirst 1 } else { set ACFirst 0 }

    if {[regexp {[\:_]} $Access Car]} {
	set Nom [StringApres $Car dans $Access]
    } else {
	set Nom $Access
    }
    set G [GenomeDu $Nom]
    if {$G==""} {return ""}
    set FicEmbl "$G/protembl/$Nom"
    if { ! [file exists $FicEmbl]} { return "" }

    if { ! $ACFirst} { return [ContenuDuFichier $FicEmbl] }

    set LigneAC ""
    set LesLignesEmblSansAC {}
    foreach Ligne [LesLignesDuFichier $FicEmbl] {
	if {[regexp "^AC   " $Ligne]} {
	    set LigneAC $Ligne
	    continue
	}
	lappend LesLignesEmblSansAC $Ligne
    }
    if {$LigneAC==""} {
	FaireLire "I can't find a line 'AC   something' in $FicEmbl"
    }
    return "$LigneAC\n[join $LesLignesEmblSansAC "\n"]"

}

proc EMBLduPDB {aPDB {ACFirst {}}} {

    Wup "Calls TFADuPDB which calls fastacmd"
    Wup "if no answer searches in /catalog/blast/pdb"

    if {$ACFirst=="ACFirst"} { set ACFirst 1 } else { set ACFirst 0 }

    set OS [OrganismeDuPDB $aPDB]
    set OC [OCduOS $OS]
    set GN [MoleculeDuPDB $aPDB]

    if {$ACFirst} {
	lappend LeEMBL "AC   $aPDB"
	lappend LeEMBL "ID   $aPDB created by Gscope with pdb entry $aPDB"
    } else {
	lappend LeEMBL "ID   $aPDB created by Gscope with pdb entry $aPDB"
	lappend LeEMBL "AC   $aPDB"
    }
    lappend LeEMBL "OS   $OS"
    lappend LeEMBL "OC   $OC"

    set TFA [string trim [TFADuPDB $aPDB] " \n"]
    regsub {[^ ]* } [lindex [split $TFA "\n"] 0] "" DE
    if {$TFA==""} {
#	return ""
	set TFA [TfaDeLaBanqueBlast "/catalog/blast/pdb" $aPDB]
    }
    if {$TFA==""} { return "" }

    if {$DE==""} {
	set DE [TextePDB $aPDB "KEYWDS"]
    }
    if {[regexp {\.{2,} *$} $DE]} { regsub {\.{2,} *$} $DE "" DE } 
    if {$DE!=""} { lappend LeEMBL "DE   $DE" }
    if {$GN!=""} { lappend LeEMBL "GN   $GN" }

    set Seq [join [lrange [split $TFA "\n"] 1 end] "\n"]
    regsub -all -nocase {[^A-Z]} $Seq "" Seq 

    lappend LeEMBL [QueSequenceFormatEMBL $Seq "AvecSQ"]

    return [join $LeEMBL "\n"]

}

