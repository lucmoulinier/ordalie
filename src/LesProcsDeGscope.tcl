    Wup "numerotation commence a 0"

    regsub -all " " $Seq "" Seq
    set DernierBon $Depart
    foreach I [NombresEntre $Depart 1 -3] {
	set Codon [string range $Seq $I [expr $I+2]]
#	if {[CodonStartPossible $Codon]} { set DernierBon $I }
