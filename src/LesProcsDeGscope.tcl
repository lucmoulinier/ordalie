proc InfoSurMasking {SequenceDuCDNAMasquee NombreDeBasesMasquees LesNomsDesRepeats} {

    ####################################################
    global RepertoireDuGenome

    set TailleDeLaSequence [string length $SequenceDuCDNAMasquee]
    set PourcentMasque [PourcentageArrondiSup $NombreDeBasesMasquees $TailleDeLaSequence]

    if {$PourcentMasque==0} {
	set Annotation "NoRepeatToMask EndMask"
    } else {
	if {$PourcentMasque==-1} {
	    set Annotation "NoSequenceToMask EndMask"
	} else {
	    set SeuilPourcentage 90.0
	    if {[expr $PourcentMasque > $SeuilPourcentage]} {
		set Annotation "TotallyMasked"
	    } else {
		set Annotation "PartiallyMasked"
	    }
	}
    }
    
    if {$PourcentMasque==0} {
	set Annotation "$Annotation"
    } else {
	set NomsDesRepeats [join $LesNomsDesRepeats " "]
	set Annotation "$Annotation ${PourcentMasque}% $NomsDesRepeats EndMask"    
    }
    return $Annotation

}

