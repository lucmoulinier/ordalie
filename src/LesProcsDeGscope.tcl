	set RosaceCourante $K
	lappend ParametresDuBoard(RosacesEnCours) $K
	lappend LesKanvasOuverts $K
	
	JeMeSignale "FinPatience"
	if {0 && [PourWscope] } {
	    return $w
	} else {
	    return $K
	}
    }

}

