	if {[EstUnAccessPDB $Access]} {
	    set OS [OrganismeDuPDB $Access]
	    set DE [TextePDB $Access "KEYWDS"]
	} else {
	    set OS [OrgaDuAccess $Access]
	    set DE [DefinitionDuAccess $Access]
	}
