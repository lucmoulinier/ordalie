    if {[info exists FamiliarTaxId("TaxIdEstCharge")]} { return 0 }
    set FamiliarTaxId("TaxIdEstCharge") 1
    set FichierFOWTI "[RepertoireDuGenome]/fiches/familiar_organism_with_taxid"
    while { ! [file exists $FichierFOWTI]} {
