proc DefDeAcc {AccessOuId Banques {Option EntreeComplete} {Link NoLink}} {

    Wup "Pour pouvoir recuperer la definition la taille par getz ..."

    if {$Option == "EntreeComplete"} {
	set option "-e"
    } elseif {$Option == "IdDef"} {
	set option "-f \"id des\""
    } elseif {$Option == "AccDef"} {
	set option "-vf \"acc des\""
    } elseif {$Option == "Def"} {
	set option "-vf \"des\""
    } elseif {$Option == "Id"} {
	set option "-vf \"id\""
    } elseif {$Option == "Taille"} {
	set option "-vf \"sl\""
    } elseif {$Option == "Acc"} {
	set option "-f \"acc\""
    }
    
    set LeType [list "acc" "id" "prd" "gid"] 
    foreach Type $LeType {
	if {$Link   == "NoLink"} {
	    set Commande "getz $option \"\\\[$Banques-$Type: $AccessOuId\\\]\""
	} else {
	    set Commande "getz $option \"\\\[$Banques-$Type: $AccessOuId\\\] \\\> $Link \""
	}
	catch {set GetzOut [eval exec $Commande]} Message
	if {![info exists GetzOut] || $GetzOut == ""} {continue}
	return $GetzOut
    }
    return ""

}

