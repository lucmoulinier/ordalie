proc GroupDunName {FileMacsims NameVoulu} {

    set FileMacsims [TheTrueMacsimsFile $FileMacsims]
    set fh [open $FileMacsims "r"]
    dom parse -channel $fh doc
    close $fh
    $doc documentElement root
    
    foreach seq [$root selectNodes "//sequence"] {
	set Name  [$seq selectNodes "string(./seq-name)"]
	set Group [$seq selectNodes "string(./seq-info/group)"]
	if {$Name == $NameVoulu} {
	    $doc delete
	    return $Group
	}
    }
    $doc delete

}

