    set FichierAnchors "$RepertoireDuGenome/ballast/$Nom.anchors"
    if {[file exists $FichierAnchors]} { return $FichierAnchors }

    Wup "Il faut le creer"

    set FichierBlastP "$RepertoireDuGenome/blastp/$Nom"

