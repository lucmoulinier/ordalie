    upvar $aBin Bin
    set i 1
    set Protru 0
    set LesColProtru [list]
    set LesColRate [list]
    while {$i<$ColDuMet} {
	if {[set Bin($Query,$i)]} {
	    incr Protru
	    lappend LesColProtru $i
	}
	incr i
    }
    set Rate 0
    set PourcentageProtru 0
    if {!$Protru} {
	while {$i<=$TailleSeq} { 
	    if {[set Bin($Query,$i)]} break
	    incr Rate
	    lappend LesColRate $i
	    incr i
	}
	if {$Rate} {
	    set TotalRes [expr [llength $LesColRate]*[llength $LesNoms]]
	    set TotalGap $TotalRes
	    foreach Col $LesColRate {
		foreach Nom $LesNoms {
		    set TotalGap [expr $TotalGap-[set Bin($Nom,$Col)]]
		}
	    }
	    set PourcentageGap [expr ($TotalGap*100) / $TotalRes]
	}
    } else {
	set TotalRes [expr $Protru*[llength $LesNoms]]
	set TotalProtru 0
	foreach Col $LesColProtru {
	    foreach Nom $LesNoms {
		set TotalProtru [expr $TotalProtru+[set Bin($Nom,$Col)]]
	    }
	}
	set PourcentageProtru [expr ($TotalProtru*100) / $TotalRes]
    }
    
    if {!$Rate} {
	return "$Query [format "%3s" +$Protru] [format "%2s" $PourcentageProtru] %"
    } else {
	return "$Query [format "%3s" -$Rate] [format "%2s" $PourcentageGap] %"
    }
    

}

proc Dialog {HostPort args} {

    #rR on va discuter en client avec un serveur Gscope ou Ordali
    DecortiqueIpCafe $HostPort Host Port
    if {[catch {set Sockette [socket $Host $Port]} Message]} {
	return $Message
    }
    set  Question [join $args " "]
    if {$Question=="" || $Question=="GetSocket"} { return $Sockette }  

    append Question "\nFinDeMessage"
    puts  $Sockette $Question
    flush $Sockette
    set LaReponse {}
    while {[gets $Sockette R]>=0} {
	lappend LaReponse $R
    }
    set Reponse [join $LaReponse "\n"]
    return $Reponse

}

proc DialogPort {{Action {}}} {

    #rR Crée un ou plusieurs serveur de socket
    #rR si Action est vide ou GetFirst (on en crée un si nécessaire et) on le rend
    #rR si Action est New on en crée un nouveau
    #rR si Action est un numéro de port on le crée (voir ci-dessous pour les détail s'il existe déjà)

    global DialogPort

    if {$Action==""} { set Action "GetFirst" }

    if {$Action=="GetFirst"} {
	if {[info exists DialogPort(ListOf,Port)]} { return [lindex $DialogPort(ListOf,Port) 0] }
    }
    if {[regexp "GetAll" $Action]} {
	if {[info exists DialogPort(ListOf,Port)]} {
	    return $DialogPort(ListOf,Port)
	} else {
	    if { ! [regexp "Create" $Action] } { return "" }
	    DialogPort
	    return [DialogPort "GetAll"]
	}
    }
    #rR Can be CreateAndDisplayAll
    if {[regexp "DisplayAll" $Action]} {
	if {[info exists DialogPort(ListOf,Port)]} {
	    set ExistingPorts $DialogPort(ListOf,Port)
	    FaireLire "Ports available on [Hostname]\n$ExistingPorts"
	    set BoutonDialog "[Vitrine GetVitrine].dialog"
	    if {[regexp "^\." $BoutonDialog]} {
		$BoutonDialog configure -text "Dialog sur [Hostname] $ExistingPorts /+"
	    }
	    return $DialogPort(ListOf,Port)
	} else {
	    if { ! [regexp "Create" $Action] && ! [OuiOuNon "There is no port available on [Hostname].\nDo I create it ?"]} { return "" }
	    DialogPort
	    return [DialogPort "DisplayAll"]
	}
    }
    set NbTentatives 2
    set StartingPort 21100
    set Port $StartingPort
    if {$Action=="New"} {
	set  ExistingPorts [DialogPort "GetAll"]
	while {[lsearch $Port $ExistingPorts]>=0} { incr Port }
    }
    set ForcePort 0
    if {[regexp {^[0-9]+$} $Action]} {
	set ForcePort 1
	set Port $Action
	set NbTentatives 1
    }
    while {1} {
	if {$NbTentatives < 1 } { return "Error : Trop de tentatives infructueuses de création de socket serveur port $Port" }   
	incr NbTentatives
	if {[catch {set Socket [socket -server CreeOreilleGeneraliste $Port]} Message]} {
	    if {[regexp -nocase "Already in use" $Message]} {
		if {$ForcePort} { return $Message } ;#rR le port existe déjà mais on rend quand même le message d'erreur
		incr Port
		continue
	    }
	}
	lappend DialogPort(ListOf,Port) $Port
	return $Port
    }    

}

proc DiffBlaAli Nom {

    global RepertoireDuGenome
    global DiffBlaAli

    if {[info exists DiffBlaAli($Nom)]} { return [set DiffBlaAli($Nom)] }
    if {[info exists DiffBlaAli]} { return "" }

    set DiffBlaAli("EstCharge") 1

    set FichierDiffBlaAli "$RepertoireDuGenome/fiches/diffblaali"
    if { ! [file exists $FichierDiffBlaAli]} { return "" }
	
    foreach DBA [LesLignesDuFichier $FichierDiffBlaAli] {
	scan $DBA "%s %s" NomLu Rapport 
	if {[regexp "No(More|Bla|Ali)" $Rapport]} {
	    set DiffBlaAli($NomLu) $Rapport
	    continue
	}

	scan $DBA "%s %s %s %s %s %s %s %s" NomLu BestBla BestAli DisBla DisAli Ecart Rapport Fragments

	set DiffBlaAli($NomLu) "$Rapport $BestBla $BestAli"
    }
    if {[info exists DiffBlaAli($Nom)]} { return [set DiffBlaAli($Nom)] }
    return ""

}

proc DifferentColor {{GetWhat {}}} {

    global DifferentColor

    if {$GetWhat==""} { set GetWhat "RGB" }

    set GetWhat [string toupper $GetWhat]

    if {$GetWhat=="RESET"} {
	if {[info exists DifferentColor]} { unset DifferentColor }
	return ""
    }
    #rR on utilise un angle pour Hue 
    if { ! [info exists DifferentColor(Ang)]} { set DifferentColor(Ang) -137.5 }
    if { ! [info exists DifferentColor(Sat)]} { set DifferentColor(Sat) 1.0 }
    if { ! [info exists DifferentColor(Bri)]} { set DifferentColor(Bri) 1.0 }
    set Angle $DifferentColor(Ang)
    set Angle [expr round($Angle+137.5)%360]
    set Hue   [expr  $Angle/360.]
    set DifferentColor(Ang) $Angle
    set DifferentColor(Hue) $Hue

    set Sat $DifferentColor(Sat)
    set Sat [expr $Sat*0.98]
    set DifferentColor(Sat) $Sat
    
    return [ColorFromHSB $DifferentColor(Hue) $DifferentColor(Sat) $DifferentColor(Bri)]

}

proc DifferentielBlastAlignement Nom {

    global RepertoireDuGenome
    global NotreOS
    global NotreOrga

    set AvecShow 0

    set FichierAli "$RepertoireDuGenome/disphy/$Nom"
    if { ! [file exists $FichierAli]} { return "$Nom NoAli" }
    set FichierBla "$RepertoireDuGenome/apns/$Nom"
    if { ! [file exists $FichierBla]} { set FichierBla "$RepertoireDuGenome/blastp/$Nom" }
    if { ! [file exists $FichierAli]} { return "$Nom NoBla" }
    set DescriAli [AfficheLesDescriptifs $FichierAli "MemeOrdre" "LaListe"]
    set LesBonsAli {}
    foreach Ligne $DescriAli {
	if {[regexp [ExpressionReguliereDesPABs] [lindex [split $Ligne " "] 0]]} { continue }
	if {[regexp -nocase "OS:$NotreOS" $Ligne]} { continue }
	lappend LesBonsAli $Ligne
    }
    if {$LesBonsAli=={}} { return "$Nom NoMoreAli" }
    set DescriBla [AfficheLesDescriptifs $FichierBla "MemeOrdre" "LaListe"]
    set LesBonsBla {}
    foreach Ligne $DescriBla {
	if {[regexp [ExpressionReguliereDesPABs] [lindex [split $Ligne " "] 0]]} { continue }
	if {[regexp -nocase "OS:$NotreOS" $Ligne]} { continue }
	lappend LesBonsBla $Ligne
    }
    if {$LesBonsBla=={}} { return "$Nom NoMoreBla" }

    set Rapport "NotYetValued"

    scan [lindex $LesBonsBla 0] "%s" BestBla
    scan [lindex $LesBonsAli 0] "%s" BestAli
    if {[string equal -nocase $BestBla $BestAli]} {
	set Rapport "Same"
	set Ecart   000
	set DisBla  000
	set DisAli  000
    }

    if {$Rapport!="Same"} {
	FromDisphy $Nom
	set DisBla [FromDisphy $BestBla]
	set DisAli [FromDisphy $BestAli]
	if { ! [regexp {^[0-9]+$} $DisBla] || ! [regexp {^[0-9]+$} $DisAli]} {
	    set DisBla 0
	    set DisAli 0
	    set Ecart  0
	    set Rapport "Problem"
	} else {
	    scan [RapportDuDifferentiel $DisBla $DisAli] "%s %d" Rapport Ecart
	}
    }
    set Fragments ".."
    if {$Rapport!="Same"} {
	set DEBla [ChampDuDescriptif [LeDescriptif $BestBla $Nom] DE]
	set DEAli [ChampDuDescriptif [LeDescriptif $BestAli $Nom] DE]
	set FraBla [regexp -nocase "FRAGMENT" $DEBla]
	set FraAli [regexp -nocase "FRAGMENT" $DEAli]
	if {$FraBla} { set FraBla "F" } else { set FraBla "-" }
	if {$FraAli} { set FraAli "F" } else { set FraAli "-" }
	set Fragments "$FraBla$FraAli"
    }
    set Beau [format "%s %-9s %-9s %3d %3d %3d %-10s %s"  $Nom $BestBla $BestAli $DisBla $DisAli $Ecart $Rapport $Fragments]

    return $Beau

}

proc DifferentielBlastAlignementPourTous {} {

    global RepertoireDuGenome

    set FichierDiffBlaAli "$RepertoireDuGenome/fiches/diffblaali"

    while {[file exists $FichierDiffBlaAli]} {
	if {[OuiOuNon "The file differential blastp alignment already exists. \n Do I replace it ?"]} {
	    File delete $FichierDiffBlaAli
	    continue
	}
	if {[OuiOuNon "Do I append to it ?"]} {
	    foreach Ligne [LesLignesDuFichier $FichierDiffBlaAli] {
		scan $Ligne "%s" Nom
		set BlaAli($Nom) $Ligne
	    }
	    break
	}
    }

    foreach Nom [ListeDesPABs] {
	if {[info exists BlaAli($Nom)]} { continue }
	set Differentiel [DifferentielBlastAlignement $Nom]
	AppendAuFichier $FichierDiffBlaAli "$Differentiel"
	if { [regexp " Same " $Differentiel]} { continue }
	Espionne "$Differentiel"
    }
    
    return $FichierDiffBlaAli

}

proc Dismiss w {

    global PagePropre
    if {[info exists PagePropre($w)]} { unset PagePropre($w) }
    if {[PourWscope]} { return "<script language='javascript'>window.close()</script>'" }
    catch {after 10 destroy $w}
    return $w    

}

proc DismissToutCePAB {Nom {Force {}}} {

    global LesFenetresDePAB
    global PagePropre

    if {$Nom=="" || ! [info exists LesFenetresDePAB($Nom)]} { return }

    if {$Force == "Force"} { set Force 1 } else { set Force 0 }
    if {$Force || [OuiOuNon "Je DISMISS tout $Nom ? "]} {
	foreach Fenetre [set LesFenetresDePAB($Nom)] {
	    if { ! [winfo exists $Fenetre]} { continue }
	    if {[info exists PagePropre($Fenetre)]} { unset PagePropre($Fenetre) }
	    after 10 destroy $Fenetre
	}
	unset LesFenetresDePAB($Nom)
    }

}

proc DismissToutesLesFenetres {} {

    global LesFenetresDePAB
    
    set Force ""
    if {[OuiOuNon "DO I destroy all windows without confirmation ?"]} { set Force "Force" }
    foreach Nom [array names LesFenetresDePAB] {
	DismissToutCePAB $Nom $Force
    }     

}

proc DisplayBilanHDACroises {K Index} {

    global IndexDisplayBilanHDACroises
    
    if { ! [info exists IndexDisplayBilanHDACroises($K)]} { set IndexDisplayBilanHDACroises($K) 2 }

    if {$Index == $IndexDisplayBilanHDACroises($K) } {
	set Efface 1
	set IndexDisplayBilanHDACroises($K) 9999
    } else {
	set Efface 0
	set IndexDisplayBilanHDACroises($K) $Index
    }

    foreach Id [$K find withtag "TexteRang"] {
	if {$Efface} {
	    set Texte " "
	} else {
	    set MesTags [$K gettags $Id]
	    set TexteDevoile [lindex $MesTags 1]
	    set A "coucou"
	    set P "voila"
	    scan $TexteDevoile "%s %s %s %s %s %s" G E F N P A
	    if {$P=="voila"} {
		set A $N
		set P $F
		set N $E
		set F $G
		set E "unknown"
		set G "Unknown"
	    }
	    if {$A=="coucou"} {
		set A $P
		set P $N
		set N $F
		set F $E
		set E "unknown"
		set G "Unknown"
	    }
	    
	    set Texte [lindex [list bidon $N $P $A] $Index]
	}
	$K itemconfigure $Id -text $Texte
    }

}

proc DissimilaritesPositions {LesNoms aBin aDissim aColPleines aColAutres TailleSeq} {

    upvar  $aDissim Dissim 
    upvar  $aBin Bin
    upvar  $aColPleines ColPleines
    upvar  $aColAutres  ColAutres
    global PremiereColPleine
    
    set ColPleines [list]
    set ColAutres  [list]
    set NbSeq [llength $LesNoms]
    #determination des colonnes pleines
    for {set i 1} {$i<=$TailleSeq} {incr i} {
	set Somme 0
	foreach Nom $LesNoms {
	    if {![set Bin($Nom,$i)]} break
	    incr Somme [set Bin($Nom,$i)]
	}
	if {$Somme==$NbSeq} {
	    lappend ColPleines $i
	    set PleinOuNon($i) 1
	} else {
	    lappend ColAutres $i
	    set PleinOuNon($i) 0
	}
    }
    #calcul des dissimilarites entre une colonne pleine et toutes les autres
    if {[llength $ColPleines]>0} {
	set PremiereColPleine [lindex $ColPleines 0]
	set i $PremiereColPleine
	for {set j 1} {$j<=$TailleSeq} {incr j} {
	    if {[set PleinOuNon($j)]} {
		set Dissim($i,$j) 0
		set Dissim($j,$i) 0
	    } else {
		set SommeDiff 0
		foreach Nom $LesNoms {
#		    set SommeDiff [expr $SommeDiff + abs( [set Bin($Nom,$i)] - [set Bin($Nom,$j)] )]
		    set SommeDiff [expr {$SommeDiff +([set Bin($Nom,$i)]^[set Bin($Nom,$j)])}]
		}
		set Dissim($i,$j) $SommeDiff
		set Dissim($j,$i) $SommeDiff
	    }
	}
    } else {
	set PremiereColPleine -1
    }
    #calcul des dissimilarites dans le cas general
    for {set i 1} {$i<=$TailleSeq} {incr i} {
	for {set j [expr $i+1]} {$j<=$TailleSeq} {incr j} {
	    if {[set PleinOuNon($i)]} {
		set Dissim($i,$j) [set Dissim($PremiereColPleine,$j)] 
		set Dissim($j,$i) [set Dissim($j,$PremiereColPleine)]
		continue
	    }
	    if {[set PleinOuNon($j)]} {
		set Dissim($i,$j) [set Dissim($i,$PremiereColPleine)] 
		set Dissim($j,$i) [set Dissim($PremiereColPleine,$i)] 
		continue
	    }
	    set SommeDiff 0
	    foreach Nom $LesNoms {
		#set SommeDiff [expr {$SommeDiff + abs( [set Bin($Nom,$i)] - [set Bin($Nom,$j)] )}]
		set SommeDiff [expr {$SommeDiff +([set Bin($Nom,$i)]^[set Bin($Nom,$j)])}]
	    }
	    set Dissim($i,$j) $SommeDiff
	    set Dissim($j,$i) $SommeDiff
	}
    }

}

proc DissimilaritesSequences {LesNoms aBin aDissim TailleSeq} {

    upvar  $aDissim Dissim
    upvar  $aBin Bin
    
    set LesAutres $LesNoms
    foreach NomA $LesNoms {
	set LesAutres [lrange $LesAutres 1 end]
	foreach NomB $LesAutres {
	    set SommeDiss 0
	    for {set i 1} {$i<=$TailleSeq} {incr i} {
		set SommeDiss [expr $SommeDiss + abs([set Bin($NomA,$i)]- [set Bin($NomB,$i)])]
	    } 
	    set Dissim($NomA,$NomB) $SommeDiss
	    set Dissim($NomB,$NomA) $SommeDiss
	}
    }

}

proc DistanceEntreDeuxPhrases {PhraseA PhraseB} {

    set LaPhraseA     [split   [join $PhraseA " "]  " "]
    set LaPhraseB     [split   [join $PhraseB " "]  " "]
    set TaillePhraseA [llength $LaPhraseA        ]
    set TaillePhraseB [llength $LaPhraseB        ]

    set Score 0
    set PosA  -1
    foreach MotA $LaPhraseA {
	incr PosA
	
	set LAiJeTrouve 0
	set PosB -1
	foreach MotB $LaPhraseB {
	    incr PosB
	    if {$MotA != $MotB} {continue}
	    set LAiJeTrouve 1
	    set Score      [expr $Score + abs($PosA-$PosB)]
	    set LaPhraseB [lreplace $LaPhraseB $PosB $PosB ""]
	    break
	}
	if {!$LAiJeTrouve} {set Score [expr $Score + $TaillePhraseA]}
    }
    return $Score

}

proc Distribution {Liste Intervalle {MinLength {}}} {

    #intervalle ]0-1] nomme 1
 #   set Debut 0.05

    set ListeReels [list]
    set LaDistribution [list]
    foreach el $Liste {
        if {$el==""} continue
        lappend ListeReels [expr 1.0*$el]
    }
    set ListeTriee [lsort -real $ListeReels]
    if {$MinLength==""} {
	set Debut [lindex $ListeTriee 0]
    } else {
	set Debut $MinLength
    }
    set Max [lindex $ListeTriee end]
    set i [expr $Intervalle+$Debut]
    while {$i<$Max} {
        set LesIntervalles($i) 0
        set i [expr $i+$Intervalle]
    }
    set LesIntervalles($i) 0
    set i [expr $Intervalle+$Debut]
    
    foreach el $ListeTriee {
        while {$el>$i && [expr $el-$i]>1e-10 } {set i [expr $i+$Intervalle]}
        incr LesIntervalles($i)
    }
    set i [expr $Intervalle+$Debut]
    while {$i<$Max} {
        lappend LaDistribution "$i [set LesIntervalles($i)]"
        set i [expr $i+$Intervalle]
    } 
    lappend LaDistribution "$i [set LesIntervalles($i)]"
    array unset LesIntervalles
    return $LaDistribution

}

proc DistributionDesGenesSurLesBandesCytologiques {{Save {}}} {

    global RepertoireDuGenome

    set RepLocalisation      "[HumanGenomeDir]/Localisation"
    set Fichier "$RepLocalisation/Gene_cyto_Distribution"
    set FichierBandesCytos   "$RepLocalisation/CytologicMap"
    if {![file exists $FichierBandesCytos]} {Espionne "$FichierBandesCytos does not exist";return ""}

    set FichierContigs      "$RepLocalisation/seq_contig.md"
    if {![file exists $FichierContigs]} {Espionne "$FichierContigs does not exist";return ""}

    set FichierGenes      "$RepLocalisation/seq_locus_tr.md"
    set NameFichierGenes  [file tail $FichierGenes]
    if {![file exists $FichierGenes]} {Espionne "$FichierGenes does not exist";return ""}

    ChargeContigsDesChromosomes Contigs $FichierContigs
    ChargeBandesCytologiques LesBandesCytos $FichierBandesCytos

    #############Initialisation des bandes ################
    foreach Chromosome [set LesBandesCytos(LesChromosomes)] {
	set nChromosome [NumeroDuChromosome $Chromosome]
	if {![info exists Contigs($nChromosome,Taille)]} {continue}
	set TailleChromosome [set Contigs($nChromosome,Taille)]

	set LesBandesP             [lsort -decreasing [set LesBandesCytos($Chromosome,LesBandesP)]]
	set LesBandesQ             [lsort [set LesBandesCytos($Chromosome,LesBandesQ)]]
	set LesBandesCytologiques  $LesBandesP
	foreach BandeQ $LesBandesQ {lappend LesBandesCytologiques $BandeQ}

	set PosIni 0
	foreach Bande $LesBandesCytologiques {
	    set LesInfos    [set LesBandesCytos($Chromosome,$Bande)]
	    set Position    [lindex $LesInfos 0]
	    set Position    [expr round($Position * 1E6)]
	    set TailleBande [expr round($Position-$PosIni)]
	    set PosIni $Position

	    set Tableau($Bande,NbGenes) 0
	    set Tableau($Bande,Taille)  $TailleBande
	}
    }

    ###########Les genes########################
    foreach Chromosome [set Contigs(LesChromosomes)] { 
	set Tableau($Chromosome,NbGenesInCtgNP) 0
	set Tableau($Chromosome,NbGenesInCtgP)  0
	Espionne $Chromosome
	if {[info exists TabMV]} {unset TabMV}
	ChargeFichierMapViewer TabMV $FichierGenes $Chromosome
	if {![info exists TabMV($NameFichierGenes,Chromosome,$Chromosome,LesElements)]} {continue}
	foreach Gene [set TabMV($NameFichierGenes,Chromosome,$Chromosome,LesElements)] {
	    set LeGene [set TabMV($NameFichierGenes,Chromosome,$Chromosome,Element,$Gene,LesLocalisations)]
	    set LesInfos [lindex [lsort -integer -decreasing -index 5 $LeGene] 0]
	    set Sens     [lindex $LesInfos 6]
	    if {$Sens == 0 || $Sens == ""} {continue}
	    set Debut    [lindex $LesInfos 3]
	    set Fin      [lindex $LesInfos 4]
	    set LesBandesOccupees [LesBandesCytologiquesDeLaRegion $Chromosome $Debut $Fin]
	    foreach LaBande $LesBandesOccupees {
		set Bande  [lindex $LaBande 0]
		incr Tableau($Bande,NbGenes)
	    }
	}
    }

    #############Texte ################
    set Texte ""
    foreach Chromosome [set LesBandesCytos(LesChromosomes)] {
	set NbGenesTot 0
	set nChromosome [NumeroDuChromosome $Chromosome]
	if {![info exists Contigs($nChromosome,Taille)]} {continue}
	set TailleChromosome [set Contigs($nChromosome,Taille)]

	set LesBandesP             [lsort -decreasing [set LesBandesCytos($Chromosome,LesBandesP)]]
	set LesBandesQ             [lsort [set LesBandesCytos($Chromosome,LesBandesQ)]]
	set LesBandesCytologiques  $LesBandesP
	foreach BandeQ $LesBandesQ {lappend LesBandesCytologiques $BandeQ}

	set LaLegende           [list "Chromosome"  "Length"            "Type"      "Var"            ]
	set LesNbGenes          [list "$nChromosome" "$TailleChromosome" "Cytologic" "NbGenes" ]
	set LesTaillesDesBandes [list "$nChromosome" "$TailleChromosome" "Cytologic" "Length"        ]

	foreach Bande $LesBandesCytologiques {
	    lappend LaLegende            $Bande
	    lappend LesNbGenes           [set Tableau($Bande,NbGenes) ]
	    lappend LesTaillesDesBandes  [set Tableau($Bande,Taille)  ]
	}
	append Texte [join "$LaLegende"            "\t"];append Texte "\n"
	append Texte [join "$LesNbGenes"     "\t"]      ;append Texte "\n"
	append Texte [join "$LesTaillesDesBandes" "\t"] ;append Texte "\n"    
    }
    Espionne $Texte
    if {$Save == "Save"} {
	Sauve $Texte dans "$Fichier"
    } else {
	if {[OuiOuNon "Would you want to save these Results?\n$Fichier"]} {
	    Sauve $Texte dans "$Fichier"
	}
    }
    return "$Texte\n\nsave in $Fichier"

}

proc DistributionDesGenesSurLesChromosomes {{Save {}}} {

    global RepertoireDuGenome

    set RepLocalisation "[HumanGenomeDir]/Localisation"
    set Fichier "$RepLocalisation/Gene_chr_Distribution"
    set FichierContigs      "$RepLocalisation/seq_contig.md"
    if {![file exists $FichierContigs]} {Espionne "$FichierContigs does not exist";return ""}

    set FichierGenes      "$RepLocalisation/seq_locus_tr.md"
    set NameFichierGenes  [file tail $FichierGenes]
    if {![file exists $FichierGenes]} {Espionne "$FichierGenes does not exist";return ""}

    ChargeContigsDesChromosomes Contigs $FichierContigs
    #############Initialisation des chromosomes###########
    foreach Chromosome [set Contigs(LesChromosomes)] { 
	set Tableau($Chromosome,NbGenesInCtgNP) 0
	set Tableau($Chromosome,NbGenesInCtgP)  0
	Espionne $Chromosome
	if {[info exists TabMV]} {unset TabMV}
	ChargeFichierMapViewer TabMV $NameFichierGenes $Chromosome
	if {![info exists TabMV($NameFichierGenes,Chromosome,$Chromosome,LesElements)]} {continue}
	foreach Gene [set TabMV($NameFichierGenes,Chromosome,$Chromosome,LesElements)] {
	    set LeGene [set TabMV($NameFichierGenes,Chromosome,$Chromosome,Element,$Gene,LesLocalisations)]
	    set Sens   [lindex [lindex $LeGene 0] 6]
	    if {$Sens == ""} {continue}
	    if {$Sens == "0"} {
		incr Tableau($Chromosome,NbGenesInCtgNP)
	    } else {
		incr Tableau($Chromosome,NbGenesInCtgP)
	    }
	}
    }
    #######Tableau#################
    set GenesInCtgPTot  0
    set GenesInCtgNPTot 0
    set TailleTot       0

    set Texte "Chromosome\tLength\tGenesInCtgP\tGenesInCtgNP\tGenesInWCtg"
    foreach Chromosome   [lsort -command CompareSeulementLesNombres [set Contigs(LesChromosomes)]] {
	if {![info exists Contigs($Chromosome,Taille)]} {continue}
	set Taille       [set Contigs($Chromosome,Taille)        ]
	set GenesInCtgP  [set Tableau($Chromosome,NbGenesInCtgP) ]
	set GenesInCtgNP [set Tableau($Chromosome,NbGenesInCtgNP)]
	append Texte "\n$Chromosome\t$Taille\t$GenesInCtgP\t$GenesInCtgNP\t0"
	incr GenesInCtgPTot  $GenesInCtgP
	incr GenesInCtgNPTot $GenesInCtgNP
	incr TailleTot       $Taille
    }
    append Texte "\nRemaining\t0\t0\t0\t0"
    append Texte "\nTotal\t$TailleTot\t$GenesInCtgPTot\t$GenesInCtgNPTot\t0"

    Espionne $Texte

    if {$Save == "Save"} {
	Sauve $Texte dans "$Fichier"
    } else {
	if {[OuiOuNon "Would you want to save these Results?\n$Fichier"]} {
	    Sauve $Texte dans "$Fichier"
	}
    }
    return "$Texte\n\nsave in $Fichier"

}

proc DistributionDesGenesSurLesContigs {{Save {}}} {

    global RepertoireDuGenome

    set RepLocalisation "[HumanGenomeDir]/Localisation"
    set Fichier "$RepLocalisation/Gene_ctg_Distribution"
    set FichierContigs      "$RepLocalisation/seq_contig.md"
    if {![file exists $FichierContigs]} {Espionne "$FichierContigs does not exist";return ""}

    set FichierGenes      "$RepLocalisation/seq_locus_tr.md"
    set NameFichierGenes  [file tail $FichierGenes]
    if {![file exists $FichierGenes]} {Espionne "$FichierGenes does not exist";return ""}

    ChargeContigsDesChromosomes Contigs $FichierContigs

    ##########Initialisation des contigs###########
    foreach Contig [set Contigs(LesContigs)] {
	set Tableau($Contig,NbGenesInCtgNP) 0
	set Tableau($Contig,NbGenesInCtgP)  0
    }
    ###########Les genes########################

    foreach Chromosome [set Contigs(LesChromosomes)] { 
	set Tableau($Chromosome,NbGenesInCtgNP) 0
	set Tableau($Chromosome,NbGenesInCtgP)  0
	Espionne $Chromosome
	if {[info exists TabMV]} {unset TabMV}
	ChargeFichierMapViewer TabMV $FichierGenes $Chromosome
	if {![info exists TabMV($NameFichierGenes,Chromosome,$Chromosome,LesElements)]} {continue}
	foreach Gene [set TabMV($NameFichierGenes,Chromosome,$Chromosome,LesElements)] {
	    set LeGene [set TabMV($NameFichierGenes,Chromosome,$Chromosome,Element,$Gene,LesLocalisations)]
	    set LesInfos [lindex [lsort -integer -decreasing -index 5 $LeGene] 0]
	    set Sens     [lindex $LesInfos 6]
	    if {$Sens == ""} {continue}
	    set Debut    [lindex $LesInfos 3]
	    set Fin      [lindex $LesInfos 4]

	    foreach Contig [set Contigs($Chromosome,LesContigs)] {
		set LeContig [set Contigs($Contig)] 
		set DContig  [lindex $LeContig 1]
		set FContig  [lindex $LeContig 2]

		if {![CesRegionsSontEllesOverlappantes $Debut $Fin $DContig $FContig]} {continue}
		if {$Sens == 0} {
		    incr Tableau($Contig,NbGenesInCtgNP)
		} else {
		    incr Tableau($Contig,NbGenesInCtgP)
		}
	    }
	}
    }
    ###########Texte#######################
    set Texte ""
    set LesChromosomes [lsort -command CompareSeulementLesNombres [set Contigs(LesChromosomes)]]
    foreach Chromosome $LesChromosomes {
	set NbGenesTot 0
	if {![info exists Contigs($Chromosome,Taille)]} {continue}
	set TailleChromosome [set Contigs($Chromosome,Taille)]

	set LesContigs [set Contigs($Chromosome,LesContigs)]
	set LaLegende            [list "Chromosome"  "Length"            "Type"   "Var"         ]
	set LesNbGenesInCtgP     [list "$Chromosome" "$TailleChromosome" "Contig" "GenesInCtgP" ]
	set LesNbGenesInCtgNP    [list "$Chromosome" "$TailleChromosome" "Contig" "GenesInCtgNP"]
	set LesSensDesContigs    [list "$Chromosome" "$TailleChromosome" "Contig" "Sens"        ]
	set LesTaillesDesContigs [list "$Chromosome" "$TailleChromosome" "Contig" "Length"      ]
	foreach Contig $LesContigs {
	    set LesInfosDuContig        [set Contigs($Chromosome,$Contig)    ]
	    set Debut                   [lindex $LesInfosDuContig 0          ]
	    set Fin                     [lindex $LesInfosDuContig 1          ]
	    set TailleContig            [expr $Fin - $Debut  + 1             ] 
	    set Sens                    [lindex $LesInfosDuContig 2          ]

	    lappend LaLegende            $Contig
	    lappend LesNbGenesInCtgP     [set Tableau($Contig,NbGenesInCtgP) ]
	    lappend LesNbGenesInCtgNP    [set Tableau($Contig,NbGenesInCtgNP)]
	    lappend LesSensDesContigs    $Sens
	    lappend LesTaillesDesContigs $TailleContig
	}
	append Texte [join "$LaLegende"            "\t"];append Texte "\n"
	append Texte [join "$LesNbGenesInCtgP"     "\t"];append Texte "\n"
	append Texte [join "$LesNbGenesInCtgNP"    "\t"];append Texte "\n"
	append Texte [join "$LesSensDesContigs"    "\t"];append Texte "\n"
	append Texte [join "$LesTaillesDesContigs" "\t"];append Texte "\n"
    }
    Espionne $Texte
    if {$Save == "Save"} {
	Sauve $Texte dans "$Fichier"
    } else {
	if {[OuiOuNon "Would you want to save these Results?\n$Fichier"]} {
	    Sauve $Texte dans "$Fichier"
	}
    }
    return "$Texte\n\nsave in $Fichier"

}

proc DistributionDesGenesSurLesRegions {{TailleRegion 1e6} {Save {}}} {

    global RepertoireDuGenome

    set RepLocalisation      "[HumanGenomeDir]/Localisation"
    set Fichier "$RepLocalisation/Gene_area${TailleRegion}bp_Distribution"
    set FichierBandesCytos   "$RepLocalisation/CytologicMap"
    if {![file exists $FichierBandesCytos]} {Espionne "$FichierBandesCytos does not exist";return ""}

    set FichierContigs      "$RepLocalisation/seq_contig.md"
    if {![file exists $FichierContigs]} {Espionne "$FichierContigs does not exist";return ""}

    set FichierGenes      "$RepLocalisation/seq_locus_tr.md"
    set NameFichierGenes [file tail $FichierGenes]
    if {![file exists $FichierGenes]} {Espionne "$FichierGenes does not exist";return ""}

    ChargeContigsDesChromosomes Contigs $FichierContigs
    ChargeBandesCytologiques LesBandesCytos $FichierBandesCytos

    #############Initialisation des regions ################
    set TousLesChromosomes [lsort -command CompareSeulementLesNombres [set Contigs(LesChromosomes)]]
    foreach Chromosome $TousLesChromosomes {
	if {![info exists Contigs($Chromosome,Taille)]} {continue}
	set TailleChromosome [set Contigs($Chromosome,Taille)]
	set Reste            [expr round($TailleChromosome) % round($TailleRegion)]
	set NbRegions        [expr round (($TailleChromosome/$TailleRegion)-0.5)]

	set Tab($Chromosome,DerniereRegion) $Reste

	set DebutRegion 1
	for {set i 1} {$i <= $NbRegions} {incr i} {
	    set FinRegion [expr round($DebutRegion + $TailleRegion - 1)]
	    set Tab($Chromosome,$i,NbGenes) 0
	    
	    set Tab($Chromosome,$i,Debut)   $DebutRegion
	    set Tab($Chromosome,$i,Fin)     $FinRegion

	    set DebutRegion [expr $FinRegion + 1]
	}
	if {$Reste != 0} {
	    set Tab($Chromosome,NbRegions)  [expr $NbRegions + 1]
	    set FinRegion                   [expr $DebutRegion + $Reste]
	    set Tab($Chromosome,$i,Debut)   $DebutRegion
	    set Tab($Chromosome,$i,Fin)     $FinRegion
	    set Tab($Chromosome,$i,NbGenes) 0
	} else {
	    set Tab($Chromosome,NbRegions)  $NbRegions
	}
    }
    #########Les Genes#####################

    foreach Chromosome [set Contigs(LesChromosomes)] { 
	set Tableau($Chromosome,NbGenesInCtgNP) 0
	set Tableau($Chromosome,NbGenesInCtgP)  0
	Espionne $Chromosome
	if {[info exists TabMV]} {unset TabMV}
	ChargeFichierMapViewer TabMV $FichierGenes $Chromosome
	if {![info exists TabMV($NameFichierGenes,Chromosome,$Chromosome,LesElements)]} {continue}
	foreach Gene [set TabMV($NameFichierGenes,Chromosome,$Chromosome,LesElements)] {
	    set LeGene [set TabMV($NameFichierGenes,Chromosome,$Chromosome,Element,$Gene,LesLocalisations)]
	    set LesInfos [lindex [lsort -integer -decreasing -index 5 $LeGene ] 0]
	    set Sens     [lindex $LesInfos 6]
	    if {$Sens == 0 || $Sens == ""} {continue}
	    set Debut    [lindex $LesInfos 3]
	    set Fin      [lindex $LesInfos 4]

	    for {set i 1} {$i <= [set Tab($Chromosome,NbRegions)]} {incr i} {
		set DebutRegion  [set Tab($Chromosome,$i,Debut)]
		set FinRegion    [set Tab($Chromosome,$i,Fin)  ]
		if {![CesRegionsSontEllesOverlappantes $Debut $Fin $DebutRegion $FinRegion]} {continue}
		incr Tab($Chromosome,$i,NbGenes)
	    }
	}
    }
    #############Texte ################
    set Texte ""
    foreach Chromosome $TousLesChromosomes {
	if {![info exists Contigs($Chromosome,Taille)]} {continue}
	if {![info exists Tab($Chromosome,NbRegions) ]} {continue}
	set NbRegions           [set Tab($Chromosome,NbRegions)]
	set TailleChromosome    [set Contigs($Chromosome,Taille)]
	if {$TailleChromosome == 0} {continue}

	set LaLegende            [list "Chromosome"  "Length"            "Type"  "Var"         ]
	set LesNbGenes           [list "$Chromosome" "$TailleChromosome" "Area${TailleRegion}bp" "NbGenes" ]
	set LesTaillesDesRegions [list "$Chromosome" "$TailleChromosome" "Area${TailleRegion}bp" "Length"      ]
	for {set i 1} {$i <= $NbRegions} {incr i} {
	    set DebutRegion  [set Tab($Chromosome,$i,Debut)  ] 
	    set FinRegion    [set Tab($Chromosome,$i,Fin)    ] 
	    set NbGenes      [set Tab($Chromosome,$i,NbGenes)]
	    
	    if {$i == $NbRegions} {
		set TailleArea [set Tab($Chromosome,DerniereRegion)] 
	    } else {
		set TailleArea $TailleRegion
	    }
	    lappend LaLegende            $i
	    lappend LesNbGenes           $NbGenes
	    lappend LesTaillesDesRegions $TailleArea
	}
	append Texte [join "$LaLegende"            "\t"];append Texte "\n"
	append Texte [join "$LesNbGenes"           "\t"];append Texte "\n"
	append Texte [join "$LesTaillesDesRegions" "\t"];append Texte "\n" 
    }
    Espionne $Texte

    if {$Save == "Save"} {
	Sauve $Texte dans "$Fichier"
    } else {
	if {[OuiOuNon "Would you want to save these Results?\n$Fichier"]} {
	    Sauve $Texte dans "$Fichier"
	}
    }
    return "$Texte\n\nsave in $Fichier"

}

proc DistributionDesSequencesSurLesBandesCytologiques {{Save {}}} {

    global RepertoireDuGenome

    set FichierLocalisation  "$RepertoireDuGenome/Localisation/BoxLocalisation_Human"
    if {![file exists $FichierLocalisation]} {return ""}

    set RepLocalisation      "[HumanGenomeDir]/Localisation"
    set FichierBandesCytos   "$RepLocalisation/CytologicMap"
    if {![file exists $FichierBandesCytos]} {
	Espionne "$FichierBandesCytos does not exist"
	return ""
    }
    set RepLocalisation "[HumanGenomeDir]/Localisation"
    set FichierContigs      "$RepLocalisation/seq_contig.md"
    if {![file exists $FichierContigs]} {
	Espionne "$FichierContigs does not exist"
	return ""
    }
    set FichierFold "$RepertoireDuGenome/fiches/FoldExpression"
    if {![file exists $FichierFold]} {
	set Fold 0
    } else {
	set Fold 1
	ChargeFoldDesSequences Expression
    }

    ChargeFichierLocalisation   MesSequences $FichierLocalisation
    ChargeContigsDesChromosomes Contigs $FichierContigs
    ChargeBandesCytologiques LesBandesCytos $FichierBandesCytos

    #############Initialisation des bandes ################
    foreach Chromosome [set LesBandesCytos(LesChromosomes)] {
	set nChromosome [NumeroDuChromosome $Chromosome]
	if {![info exists Contigs($nChromosome,Taille)]} {continue}
	set TailleChromosome [set Contigs($nChromosome,Taille)]

	set LesBandesP             [lsort -decreasing [set LesBandesCytos($Chromosome,LesBandesP)]]
	set LesBandesQ             [lsort [set LesBandesCytos($Chromosome,LesBandesQ)]]
	set LesBandesCytologiques  $LesBandesP
	foreach BandeQ $LesBandesQ {lappend LesBandesCytologiques $BandeQ}

	set PosIni 0
	foreach Bande $LesBandesCytologiques {
	    set LesInfos    [set LesBandesCytos($Chromosome,$Bande)]
	    set Position    [lindex $LesInfos 0]
	    set Position    [expr round($Position * 1E6)]
	    set TailleBande [expr round($Position-$PosIni)]
	    set PosIni $Position

	    set Tableau($Bande,NbSeq)   0

	    if {$Fold} {
		set Tableau($Bande,NbSeqPlus)   0
		set Tableau($Bande,NbSeqMinus)  0
		set Tableau($Bande,NbSeqNoInf)  0
	    }
	    set Tableau($Bande,Taille)  $TailleBande
	}
    }
    #########Mes sequences#####################
    Espionne "Seq research in cytologic bandes ... please wait"

    foreach Nom      [set MesSequences($FichierLocalisation,LesNoms)] {
	foreach LInfo [set MesSequences($FichierLocalisation,Nom,$Nom)] {

	    set InfoLoc  [lindex $LInfo 1 ]
	    if {$InfoLoc != "MonoLoc" && $InfoLoc != "MayBePolyLoc"} {continue}
	    set BestLoc  [lindex $LInfo 20]
	    if {$BestLoc != "BestLoc"                              } {continue}

	    set Contig   [lindex $LInfo 13]
	    if {![info exists Contigs($Contig)]                    } {continue}
	    set Sens    [lindex $LInfo 12]
	    if {$Sens == 0                                         } {continue}
	    set Nom      [lindex $LInfo 0 ]
	    if {[info exists TabTmp($Nom)]                         } {continue}
	    set TabTmp($Nom) 1

	    set nChromosome [NumeroDuChromosome [lindex [set Contigs($Contig)] 0]]
	    set Debut   [lindex $LInfo 10]
	    set Fin     [lindex $LInfo 11]

	    set LesBandesOccupees [LesBandesCytologiquesDeLaRegion $nChromosome $Debut $Fin]
	    foreach LaBande $LesBandesOccupees {
		set Bande  [lindex $LaBande 0]
		incr Tableau($Bande,NbSeq)
		
		if {$Fold} {
		    if {[set Expression($Nom)] == "+"} {
			incr Tableau($Bande,NbSeqPlus)
		    } elseif {[set Expression($Nom)] == "-"} {
			incr Tableau($Bande,NbSeqMinus)
		    } else {
			incr Tableau($Bande,NbSeqNoInf)
		    }
		}
		
	    }
	}
    }
    #############Texte ################
    set Texte ""
    foreach Chromosome [set LesBandesCytos(LesChromosomes)] {
	set NbSeqTot 0
	set nChromosome [NumeroDuChromosome $Chromosome]
	if {![info exists Contigs($nChromosome,Taille)]} {continue}
	set TailleChromosome [set Contigs($nChromosome,Taille)]

	set LesBandesP             [lsort -decreasing [set LesBandesCytos($Chromosome,LesBandesP)]]
	set LesBandesQ             [lsort [set LesBandesCytos($Chromosome,LesBandesQ)]]
	set LesBandesCytologiques  $LesBandesP
	foreach BandeQ $LesBandesQ {lappend LesBandesCytologiques $BandeQ}

	set LaLegende                    [list "Chromosome"  "Length"            "Type"      "Var"            ]
	set LesNbSeq                     [list "$nChromosome" "$TailleChromosome" "Cytologic" "NbSeq"   ]
	if {$Fold} {
	    set LesNbSeqPlus             [list "$nChromosome" "$TailleChromosome" "Cytologic" "NbSeqPlus"]
	    set LesNbSeqMinus            [list "$nChromosome" "$TailleChromosome" "Cytologic" "NbSeqMinus"]
	    set LesNbSeqNoInf            [list "$nChromosome" "$TailleChromosome" "Cytologic" "NbSeqNoInf"]
	}
	set LesTaillesDesBandes [list "$nChromosome" "$TailleChromosome" "Cytologic" "Length"        ]

	foreach Bande $LesBandesCytologiques {
	    lappend LaLegende            $Bande
	    lappend LesNbSeq             [set Tableau($Bande,NbSeq)   ]

	    if {$Fold} {
		lappend LesNbSeqPlus             [set Tableau($Bande,NbSeqPlus)    ]
		lappend LesNbSeqMinus            [set Tableau($Bande,NbSeqMinus)   ]
		lappend LesNbSeqNoInf            [set Tableau($Bande,NbSeqNoInf)   ]
	    }
	    lappend LesTaillesDesBandes  [set Tableau($Bande,Taille)  ]
	}
	append Texte [join "$LaLegende"               "\t"]      ;append Texte "\n"
	append Texte [join "$LesNbSeq"                "\t"]      ;append Texte "\n"

	if {$Fold} {
	    append Texte [join "$LesNbSeqPlus"        "\t"]      ;append Texte "\n"
	    append Texte [join "$LesNbSeqMinus"       "\t"]      ;append Texte "\n"
	    append Texte [join "$LesNbSeqNoInf"       "\t"]      ;append Texte "\n"
	}
	append Texte [join "$LesTaillesDesBandes" "\t"] ;append Texte "\n"    
    }
    Espionne $Texte
    set Rep "$RepertoireDuGenome/Localisation"
    set Fichier "$Rep/cyto_Distribution"
    if {$Save == "Save"} {
	if {![file exists $Rep]} {File mkdir $Rep}
	Sauve $Texte dans "$Fichier"
    } else {
	if {![file exists $Rep]} {File mkdir $Rep}
	if {[OuiOuNon "Would you want to save these Results?\n$Fichier"]} {
	    Sauve $Texte dans "$Fichier"
	}
    }
    return "$Texte\n\nsave in $Fichier"

}

proc DistributionDesSequencesSurLesChromosomes {{Save {}}} {

    global RepertoireDuGenome

    set FichierLocalisation "$RepertoireDuGenome/Localisation/BoxLocalisation_Human"
    if {![file exists $FichierLocalisation]} {
	FaireLire "$FichierLocalisation doesn't exist.\nI am going to create it." 
	return ""
    }
    set RepLocalisation "[HumanGenomeDir]/Localisation"
    set FichierContigs      "$RepLocalisation/seq_contig.md"
    if {![file exists $FichierContigs]} {
	Espionne "$FichierContigs does not exist"
	return ""
    }
    set FichierFold "$RepertoireDuGenome/fiches/FoldExpression"
    if {![file exists $FichierFold]} {
	set Fold 0
    } else {
	set Fold 1
	ChargeFoldDesSequences Expression
    }

    ChargeContigsDesChromosomes Contigs      $FichierContigs
    ChargeFichierLocalisation   MesSequences $FichierLocalisation

    #############Initialisation des chromosomes###########
    foreach Chromosome [set Contigs(LesChromosomes)] { 
	set Tableau($Chromosome,NbSeqInCtgNP)   0
	set Tableau($Chromosome,NbSeqInCtgP)    0

	if {$Fold} {
	    set Tableau($Chromosome,NbSeqPlusInCtgNP)    0
	    set Tableau($Chromosome,NbSeqPlusInCtgP)     0
	    set Tableau($Chromosome,NbSeqMinusInCtgNP)   0
	    set Tableau($Chromosome,NbSeqMinusInCtgP)    0
	    set Tableau($Chromosome,NbSeqNoInfInCtgNP)   0
	    set Tableau($Chromosome,NbSeqNoInfInCtgP)    0
	}
    }
    if {$Fold} {
	set Tableau(NbSeqPlusInWCtg)    0
	set Tableau(NbSeqPlusExcl)      0
	set Tableau(NbSeqMinusInWCtg)   0
	set Tableau(NbSeqMinusExcl)     0
	set Tableau(NbSeqNoInfInWCtg)   0
	set Tableau(NbSeqNoInfExcl)     0
    }
    set Tableau(NbSeqInWCtg)        0
    set Tableau(NbSeqExcl)          0
    
    ###########Nb sequences dans chaque chromosome#############
    foreach Nom      [set MesSequences($FichierLocalisation,LesNoms)] {
	foreach LInfo [set MesSequences($FichierLocalisation,Nom,$Nom)] {
	    set Nom      [lindex $LInfo 0 ]
	    set InfoLoc  [lindex $LInfo 1 ]
	    set BestLoc  [lindex $LInfo 20]
	    if {($InfoLoc == "NoLoc" || $InfoLoc == "MayBePolyLoc") && $BestLoc != "BestLoc"} {continue}

	    if {[info exists TabTmp($Nom)]} {continue}
	    set TabTmp($Nom) 1

	    if {    $InfoLoc != "MonoLoc" && $InfoLoc != "MayBePolyLoc"} {
		if {$Fold} {
		    set Expr [set Expression($Nom)]
		    if {      $Expr == "+"} {
			incr Tableau(NbSeqPlusExcl)
		    } elseif {$Expr == "-"} {
			incr Tableau(NbSeqMinusExcl)
		    } else {
			incr Tableau(NbSeqNoInfExcl)
		    }
		}
		incr Tableau(NbSeqExcl)
		continue
	    }
	    set Contig   [lindex $LInfo 13]
	    if {![info exists Contigs($Contig)]} {
		if {$Fold} {
		    set Expr [set Expression($Nom)]
		    if {      $Expr == "+"} {
			incr Tableau(NbSeqPlusInWCtg)
		    } elseif {$Expr == "-"} {
			incr Tableau(NbSeqMinusInWCtg)
		    } else {
			incr Tableau(NbSeqNoInfInWCtg)
		    }
		}
		incr Tableau(NbSeqInWCtg)
		continue
	    } else {
		set LesInfosDuContig [set Contigs($Contig)      ]
		set Sens             [lindex $LesInfosDuContig 3]
		set Chromosome       [lindex $LesInfosDuContig 0]
		if {$Sens == "0"} {
		    if {$Fold} {
			set Expr [set Expression($Nom)]
			if {      $Expr == "+"} {
			    incr Tableau($Chromosome,NbSeqPlusInCtgNP)
			} elseif {$Expr == "-"} {
			    incr Tableau($Chromosome,NbSeqMinusInCtgNP)
			} else {
			    incr Tableau($Chromosome,NbSeqNoInfInCtgNP)
			}
		    }
		    incr Tableau($Chromosome,NbSeqInCtgNP)
		} else {
		    if {$Fold} {
			set Expr [set Expression($Nom)]
			if {      $Expr == "+"} {
			    incr Tableau($Chromosome,NbSeqPlusInCtgP)
			} elseif {$Expr == "-"} {
			    incr Tableau($Chromosome,NbSeqMinusInCtgP)
			} else {
			    incr Tableau($Chromosome,NbSeqNoInfInCtgP)
			}
		    }
		    incr Tableau($Chromosome,NbSeqInCtgP)
		}
	    }
	}
    }
    #######Tableau#################
    set SeqInCtgPTot    0
    set SeqInCtgNPTot   0
    if {$Fold} {
	set SeqPlusInCtgPTot     0
	set SeqPlusInCtgNPTot    0
	set SeqMinusInCtgPTot    0
	set SeqMinusInCtgNPTot   0
	set SeqNoInfInCtgPTot    0
	set SeqNoInfInCtgNPTot   0
    }
    set TailleTot       0

    if {$Fold} {
	set Texte "Chromosome\tLength\tSeqInCtgP\tSeqInCtgNP\tSeqExcl\tSeqInWCtg\tSeqPlusInCtgP\tSeqPlusInCtgNP\tSeqPlusExcl\tSeqPlusInWCtg\tSeqMinusInCtgP\tSeqMinusInCtgNP\tSeqMinusExcl\tSeqMinusInWCtg\tSeqNoInfInCtgP\tSeqNoInfInCtgNP\tSeqNoInfExcl\tSeqNoInfInWCtg"
    } else {
	set Texte "Chromosome\tLength\tSeqInCtgP\tSeqInCtgNP\tSeqExcl\tSeqInWCtg"
    }

    foreach Chromosome   [lsort -command CompareSeulementLesNombres [set Contigs(LesChromosomes)]] {
	if {![info exists Contigs($Chromosome,Taille)]} {continue}
	set Taille       [set Contigs($Chromosome,Taille)        ]
	set SeqInCtgP    [set Tableau($Chromosome,NbSeqInCtgP)   ]
	set SeqInCtgNP   [set Tableau($Chromosome,NbSeqInCtgNP)  ]

	if {$Fold} {
	    set SeqPlusInCtgP    [set Tableau($Chromosome,NbSeqPlusInCtgP)   ]
	    set SeqPlusInCtgNP   [set Tableau($Chromosome,NbSeqPlusInCtgNP)  ]
	    set SeqMinusInCtgP    [set Tableau($Chromosome,NbSeqMinusInCtgP)   ]
	    set SeqMinusInCtgNP   [set Tableau($Chromosome,NbSeqMinusInCtgNP)  ]
	    set SeqNoInfInCtgP    [set Tableau($Chromosome,NbSeqNoInfInCtgP)   ]
	    set SeqNoInfInCtgNP   [set Tableau($Chromosome,NbSeqNoInfInCtgNP)  ]

	    append Texte "\n$Chromosome\t$Taille\t$SeqInCtgP\t$SeqInCtgNP\t0\t0\t$SeqPlusInCtgP\t$SeqPlusInCtgNP\t0\t0\t$SeqMinusInCtgP\t$SeqMinusInCtgNP\t0\t0\t$SeqNoInfInCtgP\t$SeqNoInfInCtgNP\t0\t0"

	    incr SeqPlusInCtgPTot     $SeqPlusInCtgP
	    incr SeqPlusInCtgNPTot    $SeqPlusInCtgNP
	    incr SeqMinusInCtgPTot    $SeqMinusInCtgP
	    incr SeqMinusInCtgNPTot   $SeqMinusInCtgNP
	    incr SeqNoInfInCtgPTot    $SeqNoInfInCtgP
	    incr SeqNoInfInCtgNPTot   $SeqNoInfInCtgNP
	} else {
	    append Texte "\n$Chromosome\t$Taille\t$SeqInCtgP\t$SeqInCtgNP\t0\t0"
	}
	incr SeqInCtgPTot    $SeqInCtgP
	incr SeqInCtgNPTot   $SeqInCtgNP
	incr TailleTot       $Taille
    }
    set SeqInWCtg        [set Tableau(NbSeqInWCtg)               ]
    set SeqExcl          [set Tableau(NbSeqExcl)                 ]
    
    if {$Fold} {
	set SeqPlusInWCtg        [set Tableau(NbSeqPlusInWCtg)               ]
	set SeqPlusExcl          [set Tableau(NbSeqPlusExcl)                 ]
	set SeqMinusInWCtg        [set Tableau(NbSeqMinusInWCtg)               ]
	set SeqMinusExcl          [set Tableau(NbSeqMinusExcl)                 ]
	set SeqNoInfInWCtg        [set Tableau(NbSeqNoInfInWCtg)               ]
	set SeqNoInfExcl          [set Tableau(NbSeqNoInfExcl)                 ]
	append Texte "\nRemaining\t0\t0\t0\t$SeqExcl\t$SeqInWCtg\t0\t0\t$SeqPlusExcl\t$SeqPlusInWCtg\t0\t0\t$SeqMinusExcl\t$SeqMinusInWCtg\t0\t0\t$SeqNoInfExcl\t$SeqNoInfInWCtg"

	append Texte "\nTotal\t$TailleTot\t$SeqInCtgPTot\t$SeqInCtgNPTot\t$SeqExcl\t$SeqInWCtg\t$SeqPlusInCtgPTot\t$SeqPlusInCtgNPTot\t$SeqPlusExcl\t$SeqPlusInWCtg\t$SeqMinusInCtgPTot\t$SeqMinusInCtgNPTot\t$SeqMinusExcl\t$SeqMinusInWCtg\t$SeqNoInfInCtgPTot\t$SeqNoInfInCtgNPTot\t$SeqNoInfExcl\t$SeqNoInfInWCtg"
    } else {
	append Texte "\nRemaining\t0\t0\t0\t$SeqExcl\t$SeqInWCtg"
	append Texte "\nTotal\t$TailleTot\t$SeqInCtgPTot\t$SeqInCtgNPTot\t$SeqExcl\t$SeqInWCtg"
    }

    Espionne $Texte
    set Rep "$RepertoireDuGenome/Localisation"
    set Fichier "$Rep/chr_Distribution"
    if {$Save == "Save"} {
	if {![file exists $Rep]} {File mkdir $Rep}
	Sauve $Texte dans "$Fichier"
    } else {
	if {![file exists $Rep]} {File mkdir $Rep}
	if {[OuiOuNon "Would you want to save these Results?\n$Fichier"]} {
	    Sauve $Texte dans "$Fichier"
	}
    }
    return "$Texte\n\nsave in $Fichier"

}

proc DistributionDesSequencesSurLesContigs {{Save {}}} {

    global RepertoireDuGenome

    set FichierLocalisation "$RepertoireDuGenome/Localisation/BoxLocalisation_Human"
    if {![file exists $FichierLocalisation]} {return ""}

    set RepLocalisation "[HumanGenomeDir]/Localisation"
    set FichierContigs      "$RepLocalisation/seq_contig.md"
    if {![file exists $FichierContigs]} {
	Espionne "$FichierContigs does not exist"
	return ""
    }

    set FichierFold "$RepertoireDuGenome/fiches/FoldExpression"
    if {![file exists $FichierFold]} {
	set Fold 0
    } else {
	set Fold 1
	ChargeFoldDesSequences Expression
    }

    ChargeContigsDesChromosomes Contigs $FichierContigs
    ChargeFichierLocalisation   MesSequences $FichierLocalisation
    ##########Initialisation des contigs###########
    set Tableau(NbSeqExcl)     0
    set Tableau(NbSeqInWCtg)   0

    if {$Fold} {
	set Tableau(NbSeqPlusExcl)      0
	set Tableau(NbSeqPlusInWCtg)    0
	set Tableau(NbSeqMinusExcl)     0
	set Tableau(NbSeqMinusInWCtg)   0
	set Tableau(NbSeqNoInfExcl)     0
	set Tableau(NbSeqNoInfInWCtg)   0
    }

    foreach Contig [set Contigs(LesContigs)] {
	set Tableau($Contig,NbSeqInCtgNP)   0
	set Tableau($Contig,NbSeqInCtgP)    0

	if {$Fold} {
	    set Tableau($Contig,NbSeqPlusInCtgNP)   0
	    set Tableau($Contig,NbSeqPlusInCtgP)    0
	    set Tableau($Contig,NbSeqMinusInCtgNP)   0
	    set Tableau($Contig,NbSeqMinusInCtgP)    0
	    set Tableau($Contig,NbSeqNoInfInCtgNP)   0
	    set Tableau($Contig,NbSeqNoInfInCtgP)    0
	}
    }
    #########Mes sequences#####################
    foreach Nom      [set MesSequences($FichierLocalisation,LesNoms)] {
	foreach LInfo [set MesSequences($FichierLocalisation,Nom,$Nom)] {
	    set Nom      [lindex $LInfo 0 ]
	    if {[info exists TabTmp($Nom)]                         } {continue}
	    set TabTmp($Nom) 1

	    set InfoLoc  [lindex $LInfo 1 ]
	    if {$InfoLoc != "MonoLoc" && $InfoLoc != "MayBePolyLoc"} {
		incr Tableau(NbSeqExcl)
		if {$Fold} {
		    if {[set Expression($Nom)] == "+"} {
			incr Tableau(NbSeqPlusExcl)
		    } elseif {[set Expression($Nom)] == "-"} {
			incr Tableau(NbSeqMinusExcl)
		    } else {
			incr Tableau(NbSeqNoInfExcl)
		    }
		}
		continue
		continue
	    }
	    set BestLoc  [lindex $LInfo 20]
	    if {$BestLoc != "BestLoc"                              } {continue}

	    set Contig   [lindex $LInfo 13]
	    set Sens    [lindex $LInfo 12]
	    if {![info exists Contigs($Contig)]} {
		incr Tableau(NbSeqInWCtg)
		if {$Fold} {
		    if {[set Expression($Nom)] == "+"} {
			incr Tableau(NbSeqPlusInWCtg)
		    } elseif {[set Expression($Nom)] == "-"} {
			incr Tableau(NbSeqMinusInWCtg)
		    } else {
			incr Tableau(NbSeqNoInfInWCtg)
		    }
		}
		continue
	    } else {
		set LesInfosDuContig [set Contigs($Contig)      ]
		set Sens             [lindex $LesInfosDuContig 3]
		if {$Sens == 0} {
		    incr Tableau($Contig,NbSeqInCtgNP)
		    
		    if {$Fold} {
			if {[set Expression($Nom)] == "+"} {
			    incr Tableau($Contig,NbSeqPlusInCtgNP)
			} elseif {[set Expression($Nom)] == "-"} {
			    incr Tableau($Contig,NbSeqMinusInCtgNP)
			} else {
			    incr Tableau($Contig,NbSeqNoInfInCtgNP)
			}
		    }
		} else {
		    incr Tableau($Contig,NbSeqInCtgP)
		    if {$Fold} {
			if {[set Expression($Nom)] == "+"} {
			    incr Tableau($Contig,NbSeqPlusInCtgP)
			} elseif {[set Expression($Nom)] == "-"} {
			    incr Tableau($Contig,NbSeqMinusInCtgP)
			} else {
			    incr Tableau($Contig,NbSeqNoInfInCtgP)
			}
		    }
		}
	    }
	}
    }
    ###########Texte#######################
    set Texte ""
    set LesChromosomes [lsort -command CompareSeulementLesNombres [set Contigs(LesChromosomes)]]
    foreach Chromosome $LesChromosomes {
	set NbSeqTot 0
	if {![info exists Contigs($Chromosome,Taille)]} {continue}
	set TailleChromosome [set Contigs($Chromosome,Taille)]

	set LesContigs [set Contigs($Chromosome,LesContigs)]
	set LaLegende            [list "Chromosome"  "Length"            "Type"   "Var"         ]
	set LesNbSeqInCtgP       [list "$Chromosome" "$TailleChromosome" "Contig" "SeqInCtgP"   ]
	set LesNbSeqInCtgNP      [list "$Chromosome" "$TailleChromosome" "Contig" "SeqInCtgNP"  ]

	if {$Fold} {
	    set LesNbSeqPlusInCtgP       [list "$Chromosome" "$TailleChromosome" "Contig" "SeqPlusInCtgP"   ]
	    set LesNbSeqPlusInCtgNP      [list "$Chromosome" "$TailleChromosome" "Contig" "SeqPlusInCtgNP"  ]
	    set LesNbSeqMinusInCtgP     [list "$Chromosome" "$TailleChromosome" "Contig" "SeqMinusInCtgP"   ]
	    set LesNbSeqMinusInCtgNP    [list "$Chromosome" "$TailleChromosome" "Contig" "SeqMinusInCtgNP"  ]
	    set LesNbSeqNoInfInCtgP     [list "$Chromosome" "$TailleChromosome" "Contig" "SeqNoInfInCtgP"   ]
	    set LesNbSeqNoInfInCtgNP    [list "$Chromosome" "$TailleChromosome" "Contig" "SeqNoInfInCtgNP"  ]
	}

	set LesSensDesContigs    [list "$Chromosome" "$TailleChromosome" "Contig" "Sens"        ]
	set LesTaillesDesContigs [list "$Chromosome" "$TailleChromosome" "Contig" "Length"      ]
	foreach Contig $LesContigs {
	    set LesInfosDuContig        [set Contigs($Chromosome,$Contig)    ]
	    set Debut                   [lindex $LesInfosDuContig 0          ]
	    set Fin                     [lindex $LesInfosDuContig 1          ]
	    set TailleContig            [expr $Fin - $Debut  + 1             ] 
	    set Sens                    [lindex $LesInfosDuContig 2          ]

	    lappend LaLegende            $Contig
	    lappend LesNbSeqInCtgP       [set Tableau($Contig,NbSeqInCtgP)   ]
	    lappend LesNbSeqInCtgNP      [set Tableau($Contig,NbSeqInCtgNP)  ]

	    if {$Fold} {
		lappend LesNbSeqPlusInCtgP       [set Tableau($Contig,NbSeqPlusInCtgP)   ]
		lappend LesNbSeqPlusInCtgNP      [set Tableau($Contig,NbSeqPlusInCtgNP)  ]
		lappend LesNbSeqMinusInCtgP       [set Tableau($Contig,NbSeqMinusInCtgP)   ]
		lappend LesNbSeqMinusInCtgNP      [set Tableau($Contig,NbSeqMinusInCtgNP)  ]
		lappend LesNbSeqNoInfInCtgP       [set Tableau($Contig,NbSeqNoInfInCtgP)   ]
		lappend LesNbSeqNoInfInCtgNP      [set Tableau($Contig,NbSeqNoInfInCtgNP)  ]
	    }

	    lappend LesSensDesContigs    $Sens
	    lappend LesTaillesDesContigs $TailleContig
	}
	append Texte [join "$LaLegende"            "\t"];append Texte "\n"
	append Texte [join "$LesNbSeqInCtgP"       "\t"];append Texte "\n"
	append Texte [join "$LesNbSeqInCtgNP"      "\t"];append Texte "\n"

	if {$Fold} {
	    append Texte [join "$LesNbSeqPlusInCtgP"       "\t"];append Texte "\n"
	    append Texte [join "$LesNbSeqPlusInCtgNP"      "\t"];append Texte "\n"
	    append Texte [join "$LesNbSeqMinusInCtgP"       "\t"];append Texte "\n"
	    append Texte [join "$LesNbSeqMinusInCtgNP"      "\t"];append Texte "\n"
	    append Texte [join "$LesNbSeqNoInfInCtgP"       "\t"];append Texte "\n"
	    append Texte [join "$LesNbSeqNoInfInCtgNP"      "\t"];append Texte "\n"
	}

	append Texte [join "$LesSensDesContigs"    "\t"];append Texte "\n"
	append Texte [join "$LesTaillesDesContigs" "\t"];append Texte "\n"
    }

    Espionne $Texte
    set Rep "$RepertoireDuGenome/Localisation"
    set Fichier "$Rep/ctg_Distribution"
    if {$Save == "Save"} {
	if {![file exists $Rep]} {File mkdir $Rep}
	Sauve $Texte dans "$Fichier"
    } else {
	if {![file exists $Rep]} {File mkdir $Rep}
	if {[OuiOuNon "Would you want to save these Results?\n$Fichier"]} {
	    Sauve $Texte dans "$Fichier"
	}
    }
    return "$Texte\n\nsave in $Fichier"

}

proc DistributionDesSequencesSurLesRegions {{TailleRegion 1e6} {Save {}}} {

    global RepertoireDuGenome

    set FichierLocalisation  "$RepertoireDuGenome/Localisation/BoxLocalisation_Human"
    if {![file exists $FichierLocalisation]} {return ""}
    set RepLocalisation      "[HumanGenomeDir]/Localisation"
    set FichierBandesCytos   "$RepLocalisation/CytologicMap"
    if {![file exists $FichierBandesCytos]} {
	Espionne "$FichierBandesCytos does not exist"
	return ""
    }
    set RepLocalisation "[HumanGenomeDir]/Localisation"
    set FichierContigs      "$RepLocalisation/seq_contig.md"
    if {![file exists $FichierContigs]} {
	Espionne "$FichierContigs does not exist"
	return ""
    }
    set FichierFold "$RepertoireDuGenome/fiches/FoldExpression"
    if {![file exists $FichierFold]} {
	set Fold 0
    } else {
	set Fold 1
	ChargeFoldDesSequences Expression
    }

    ChargeFichierLocalisation   MesSequences $FichierLocalisation
    ChargeContigsDesChromosomes Contigs $FichierContigs
    ChargeBandesCytologiques LesBandesCytos $FichierBandesCytos

    #############Initialisation des regions ################
    set TousLesChromosomes [lsort -command CompareSeulementLesNombres [set Contigs(LesChromosomes)]]
    foreach Chromosome $TousLesChromosomes {
	if {![info exists Contigs($Chromosome,Taille)]} {continue}
	set TailleChromosome [set Contigs($Chromosome,Taille)]
	set Reste            [expr round($TailleChromosome) % round($TailleRegion)]
	set NbRegions        [expr round (($TailleChromosome/$TailleRegion)-0.5)]

	set Tab($Chromosome,DerniereRegion) $Reste

	set DebutRegion 1
	for {set i 1} {$i <= $NbRegions} {incr i} {
	    set FinRegion [expr round($DebutRegion + $TailleRegion - 1)]
	    set Tab($Chromosome,$i,NbSeq)   0
	    
	    if {$Fold} {
		set Tab($Chromosome,$i,NbSeqPlus)    0
		set Tab($Chromosome,$i,NbSeqMinus)   0
		set Tab($Chromosome,$i,NbSeqNoInf)   0
	    }

	    set Tab($Chromosome,$i,Debut)   $DebutRegion
	    set Tab($Chromosome,$i,Fin)     $FinRegion

	    set DebutRegion [expr $FinRegion + 1]
	}
	if {$Reste != 0} {
	    set Tab($Chromosome,NbRegions)  [expr $NbRegions + 1]
	    set FinRegion                   [expr $DebutRegion + $Reste]
	    set Tab($Chromosome,$i,Debut)   $DebutRegion
	    set Tab($Chromosome,$i,Fin)     $FinRegion
	    set Tab($Chromosome,$i,NbSeq)   0

	    if {$Fold} {
		set Tab($Chromosome,$i,NbSeqPlus)    0
		set Tab($Chromosome,$i,NbSeqMinus)   0
		set Tab($Chromosome,$i,NbSeqNoInf)   0
	    }
	} else {
	    set Tab($Chromosome,NbRegions)  $NbRegions
	}
    }
    #########Mes sequences#####################
    
    foreach Nom      [set MesSequences($FichierLocalisation,LesNoms)] {
	foreach LInfo [set MesSequences($FichierLocalisation,Nom,$Nom)] {
	    set InfoLoc  [lindex $LInfo 1 ]
	    if {$InfoLoc != "MonoLoc" && $InfoLoc != "MayBePolyLoc"} {continue}
	    set BestLoc  [lindex $LInfo 20]
	    if {$BestLoc != "BestLoc"                              } {continue}
	    set Contig   [lindex $LInfo 13]
	    if {![info exists Contigs($Contig)]                    } {continue}
	    set Sens    [lindex $LInfo 12]
	    if {$Sens == 0                                         } {continue}
	    set Chromosome [lindex [set Contigs($Contig)] 0]
	    if {![info exists Contigs($Chromosome,Taille)]         } {continue}
	    set TailleChromosome [set Contigs($Chromosome,Taille)]
	    set Nom      [lindex $LInfo 0 ]
	    if {[info exists TabTmp($Nom)]                         } {continue}
	    set TabTmp($Nom) 1

	    set Debut   [lindex $LInfo 10]
	    set Fin     [lindex $LInfo 11]
	    for {set i 1} {$i <= [set Tab($Chromosome,NbRegions)]} {incr i} {
		set DebutRegion  [set Tab($Chromosome,$i,Debut)]
		set FinRegion    [set Tab($Chromosome,$i,Fin)  ]
		
		if {    ($DebutRegion < $Debut       && $Fin       <= $FinRegion) || ($DebutRegion < $Fin         && $Fin       <= $FinRegion) || ($DebutRegion < $Debut       && $Debut     <= $FinRegion) || ($Debut       < $DebutRegion && $FinRegion <= $Fin      ) } {
		    incr Tab($Chromosome,$i,NbSeq)
		    
		    if {$Fold} {
			if {[set Expression($Nom)] == "+"} {
			    incr Tab($Chromosome,$i,NbSeqPlus)
			} elseif {[set Expression($Nom)] == "-"} {
			    incr Tab($Chromosome,$i,NbSeqMinus)
			} else {
			    incr Tab($Chromosome,$i,NbSeqNoInf)
			}
		    }
		}
	    }
	}
    }
    #############Texte ################
    set Texte ""
    foreach Chromosome $TousLesChromosomes {
	if {![info exists Tab($Chromosome,NbRegions)]} {continue}
	set NbRegions           [set Tab($Chromosome,NbRegions)]
	if {![info exists Contigs($Chromosome,Taille)]} {continue}
	set TailleChromosome    [set Contigs($Chromosome,Taille)]
	if {$TailleChromosome == 0} {continue}

	set LaLegende            [list "Chromosome"  "Length"            "Type"  "Var"         ]
	set LesNbSeq             [list "$Chromosome" "$TailleChromosome" "area${TailleRegion}bp" "NbSeq"   ]
	if {$Fold} {
	    set LesNbSeqPlus     [list "$Chromosome" "$TailleChromosome" "area${TailleRegion}bp" "NbSeqPlus"]
	    set LesNbSeqMinus    [list "$Chromosome" "$TailleChromosome" "area${TailleRegion}bp" "NbSeqMinus"]
	    set LesNbSeqNoInf    [list "$Chromosome" "$TailleChromosome" "area${TailleRegion}bp" "NbSeqNoInf"]
	}
	set LesTaillesDesRegions [list "$Chromosome" "$TailleChromosome" "area${TailleRegion}bp" "Length"      ]

	for {set i 1} {$i <= $NbRegions} {incr i} {
	    set DebutRegion  [set Tab($Chromosome,$i,Debut)  ] 
	    set FinRegion    [set Tab($Chromosome,$i,Fin)    ] 
	    set NbSeq        [set Tab($Chromosome,$i,NbSeq)  ]

	    if {$Fold} {
		set NbSeqPlus        [set Tab($Chromosome,$i,NbSeqPlus)  ]
		set NbSeqMinus       [set Tab($Chromosome,$i,NbSeqMinus)  ]
		set NbSeqNoInf       [set Tab($Chromosome,$i,NbSeqNoInf)  ]
	    }
	    
	    if {$i == $NbRegions} {
		set TailleArea [set Tab($Chromosome,DerniereRegion)] 
	    } else {
		set TailleArea $TailleRegion
	    }
	    lappend LaLegende            $i
	    lappend LesNbSeq             $NbSeq
	    if {$Fold} {
		lappend LesNbSeqPlus             $NbSeqPlus
		lappend LesNbSeqMinus            $NbSeqMinus
		lappend LesNbSeqNoInf            $NbSeqNoInf
	    }

	    lappend LesTaillesDesRegions $TailleArea
	}
	append Texte [join "$LaLegende"            "\t"];append Texte "\n"
	append Texte [join "$LesNbSeq"             "\t"];append Texte "\n"
	if {$Fold} {
	    append Texte [join "$LesNbSeqPlus"             "\t"];append Texte "\n"
	    append Texte [join "$LesNbSeqMinus"             "\t"];append Texte "\n"
	    append Texte [join "$LesNbSeqNoInf"             "\t"];append Texte "\n"
	}
	append Texte [join "$LesTaillesDesRegions" "\t"];append Texte "\n" 
    }
    Espionne $Texte
    set Rep "$RepertoireDuGenome/Localisation"
    set Fichier "$Rep/area${TailleRegion}bp_Distribution"
    if {$Save == "Save"} {
	if {![file exists $Rep]} {File mkdir $Rep}
	Sauve $Texte dans "$Fichier"
    } else {
	if {![file exists $Rep]} {File mkdir $Rep}
	if {[OuiOuNon "Would you want to save these Results?\n$Fichier"]} {
	    Sauve $Texte dans "$Fichier"
	}
    }
    return "$Texte\n\nsave in $Fichier"

}

proc DiviseLeGO {K Type LesGO} {

    set Id      [$K find withtag current]
    set MesTags [$K gettags $Id]

    set Definition           [lindex $MesTags 1]
    scan $Definition "%s %s" GOSelected Definition

    set LesNewGO {}
    foreach GO $LesGO {
	if {$GO != $GOSelected} {lappend LesNewGO $GO;continue}

	set LesDescendants [concat [Onto $Type $GO LesEnfants] [Onto $Type $GO LesContributions]]

	if {$LesDescendants == {}} {return $LesGO}
	foreach GO $LesDescendants {
	    lappend LesNewGO $GO
	}
    }
    set LesGO [ElimineLesRedondancesDansUneListe $LesNewGO]
    IllustreLeCamembertOntologique $Type $LesGO
    return $LesGO

}

proc DonneGenealogieMem fils {

    global TaxRoot Tx

    if {$fils <= 0} {
	return [list]
    }

    set pere ""
    set Lgen [list $fils]
    while {$pere != $TaxRoot || $pere != -1} {
	#rR a essayé mais marche pas 	if { ! [info exists ::Tx(Parent,$fils)]} { break }
	set pere $Tx(Parent,$fils)
	if {$pere <= 0 || ! [string is integer -strict $pere]} {
	    return $Lgen
	} 
	lappend Lgen $pere
	set fils $pere
    }

    return $Lgen

}

