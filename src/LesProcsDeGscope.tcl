proc ::Grillade::listerBanquesBlast {NomDB DBdir} {

		set res {}
		if {[file exists "$DBdir/$NomDB.pal"]} {
			set f [open "$DBdir/$NomDB.pal" r]
			set content [read $f]
			close $f
			regexp -line {^DBLIST (.*)$} $content marches dblist
			
			foreach db $dblist {
				lappend res {*}[listerBanquesBlast $db $DBdir]
			}
		} elseif {[file exists "$DBdir/$NomDB.phr"]} {
			lappend res $NomDB
		} else {
			puts stderr "Unknown database $NomDB"
		}
		return $res
	
}

proc ::Grillade::resumePoeleBlast NomPoele {

		Brasseur::executer "Recette::resumePoeleBlast $NomPoele"
	
}

