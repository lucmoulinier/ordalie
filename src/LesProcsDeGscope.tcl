	    set name [ChoixParmi $canalList]
	}
	set canalName $name
    
}

proc ::NSCap3ParametersGui::buildParametersArray {} {

	variable parameters

	# databaseField description cmdLineParam defaultValue {minValue or ""} {maxValue or ""}
	lappend lParams "band_expansion_size" "Band expansion size" "-a" 20 11 ""
	lappend lParams "base_quality_differences_cutoff" "Base quality differences cutoff" "-b" 20 16 ""
	lappend lParams "base_quality_clipping_cutoff" "Base quality clipping cutoff" "-c" 12 6 ""
	lappend lParams "max_differences_qscore_sum" "Maximum sum of quality score at differences" "-d" 250 101 ""
	lappend lParams "extra_differences_number" "Extra number of differences" "-e" 20 11 ""
	lappend lParams "max_overlap_gap_length" "Maximum gap length in overlap" "-f" 300 11 ""
	lappend lParams "gap_penalty_factor" "Gap penalty factor" "-g" 6 1 ""
	lappend lParams "match_score_factor" "Match score factor" "-m" 2 1 ""
	lappend lParams "mismatch_score_factor" "Mismatch score factor" "-n" -5 "" -1
	lappend lParams "overlap_length_cutoff" "Overlap length cutoff" "-o" 30 21 ""
	lappend lParams "overlap_percent_identity_cutoff" "Overlap percent identity cutoff" "-p" 75 66 ""
	lappend lParams "reverse_orientation" "Allow reverse orientation" "-r" 1 0 1
	lappend lParams "overlap_similarity_score_cutoff" "Overlap similarity score cutoff" "-s" 500 101 ""
	lappend lParams "max_word_occurrences" "Maximum number of word occurrences" "-t" 500 31 ""
	lappend lParams "min_correction_constraints" "Minimum number of constraints for correction" "-u" 4 1 ""
	lappend lParams "min_linking_constraints" "Minimum number of constraints for linking" "-v" 2 1 ""
	lappend lParams "clipping_range" "Clipping range" "-y" 250 6 ""
	lappend lParams "clip_pos_min_good_reads" "Minimum number of good reads at clip positions" "-z" 2 1 ""
	
	array set parameters {index {}}
	foreach {param descr cmdLine def min max} $lParams {
	    set parameters($param,description) $descr
	    set parameters($param,commandLine) $cmdLine
	    set parameters($param,defaultValue) $def
	    set parameters($param,minValue) $min
	    set parameters($param,maxValue) $max
	    lappend parameters(index) $param
	    
	    set parameters($param,isDefault) 1
	    set parameters($param,currentValue) $parameters($param,defaultValue)

	    trace add variable parameters($param,currentValue) write [namespace code validateParameters]
	}
    
}

proc ::NSCap3ParametersGui::checkParameter param {

	variable parameters
	
	if {[lsearch -exact $parameters(index) $param] != -1} {
	    if {$parameters($param,currentValue) eq "" || ![string is integer $parameters($param,currentValue)]} {
		# not an integer
		return 0
	    }
	    if {$parameters($param,minValue) ne "" && $parameters($param,currentValue) < $parameters($param,minValue)} {
		# value too low
		return 0
	    }
	    if {$parameters($param,maxValue) ne "" && $parameters($param,currentValue) > $parameters($param,maxValue)} {
		# value too high
		return 0
	    }
	    # that's great
	    return 1
	}
	# param doesn't exists
	return 0
    
}

proc ::NSCap3ParametersGui::getStringParameterRange param {

	variable parameters

	if {[lsearch -exact $parameters(index) $param] != -1} {
	    if {$parameters($param,minValue) ne "" && $parameters($param,maxValue) ne ""} {
		return "\[$parameters($param,minValue);$parameters($param,maxValue)\]"
	    } elseif {$parameters($param,minValue) ne ""} {
		return ">= $parameters($param,minValue)"
	    } elseif {$parameters($param,maxValue) ne ""} {
		return "<= $parameters($param,maxValue)"
	    }
	}

	return ""
    
}

proc ::NSCap3ParametersGui::initNS {} {

	if {![info exists [namespace current]::parameters]} {
	    buildParametersArray
	}
    
}

proc ::NSCap3ParametersGui::setDefaultValue param {

	variable parameters

	if {[lsearch -exact $parameters(index) $param] != -1} {
	    if {$parameters($param,isDefault) == 1} {
		set parameters($param,currentValue) $parameters($param,defaultValue)
		$parameters($param,entry) configure -state disabled
	    } else {
		$parameters($param,entry) configure -state normal
	    }
	}
    
}

proc ::NSCap3ParametersGui::showGui {} {

	variable parameters
	variable okButton
	variable returnValue

	# create a new window
	set win [toplevel [NomDe fenetre]]
	wm title $win "cap3 assembler parameters"

	# create parameters array
	set pFrame [frame $win[NomDe frame]]
	pack $pFrame

	set title1 [label $pFrame[NomDe label] -text "Parameter" -background "LightYellow"]
	set title2 [label $pFrame[NomDe label] -text "Set default" -background "LightYellow"]
	set title3 [label $pFrame[NomDe label] -text "Current value" -background "LightYellow"]
	set title4 [label $pFrame[NomDe label] -text "Range" -background "LightYellow"]
	grid $title1 $title2 $title3 $title4 -sticky we

	foreach param $parameters(index) {
	    set lbl1 [label $pFrame[NomDe label] -text "$parameters($param,description) ($parameters($param,commandLine))"]
	    set cb [checkbutton $pFrame[NomDe checkbutton] -variable [namespace current]::parameters($param,isDefault) -command [namespace code "setDefaultValue $param"]]
	    set parameters($param,entry) [entry $pFrame[NomDe entry] -textvariable [namespace current]::parameters($param,currentValue)]
	    if {$parameters($param,isDefault)} {
		$parameters($param,entry) configure -state disabled
	    } else {
		$parameters($param,entry) configure -state normal
	    }
	    set lbl2 [label $pFrame[NomDe label] -text "[getStringParameterRange $param]"]
	    grid $lbl1 $cb $parameters($param,entry) $lbl2 -sticky w
	}

	# create the OK button
	set okButton [button $win[NomDe button] -text OK -command [namespace code {validateDialog 1}]]
	pack $okButton

	tkwait variable [namespace current]::returnValue
	catch "destroy $win"
	return $returnValue
    
}

proc ::NSCap3ParametersGui::validateDialog {{nonDefaultsOnly 0}} {

	variable parameters
	variable returnValue

	set retValue {}

	foreach param $parameters(index) {
	    if {$nonDefaultsOnly} {
		if {$parameters($param,currentValue) != $parameters($param,defaultValue)} {
		    lappend retValue $param $parameters($param,currentValue)
		}
	    } else {
		lappend retValue $param $parameters($param,currentValue)
	    }
	}

	set returnValue $retValue
    
}

proc ::NSCap3ParametersGui::validateParameters args {

	variable parameters
	variable okButton

	set allParamsOk 1
	foreach param $parameters(index) {
	    if {[checkParameter $param]} {
		$parameters($param,entry) configure -background "LightGrey"
	    } else {
		$parameters($param,entry) configure -background "red"
		set allParamsOk 0
	    }
	}

	if {$allParamsOk} {
	    $okButton configure -state normal -background "LightGrey"
	} else {
	    $okButton configure -state disabled -background "red"
	}
    
}

proc ::NSLibraryEditorGui::addUpdateLibrary {} {

	variable pk
	variable name
	variable organism
	variable tissue
	variable normalized
	variable construction
	variable vector
	variable adapter
	variable growingStage
	variable samplesCount
	variable strain
	variable samplingDate
	variable samplingPlace
	variable comments

	if {$normalized} {set sqlNormalized true} else {set sqlNormalized false}

	if {$pk eq ""} {
	    # add a new library
	    set sql "INSERT INTO library(name, organism, tissue, normalized, construction_method, vector, adapter, growing_stage, samples_count, strain, sampling_date, sampling_place, comments) VALUES('$name', '$organism', '$tissue', $sqlNormalized, '$construction', '$vector', '$adapter', '$growingStage', '$samplesCount', '$strain', '$samplingDate', '$samplingPlace', '$comments')"
	} else {
	    # update the current library
	    set sql "UPDATE library SET name='$name', organism='$organism', tissue='$tissue', normalized=$sqlNormalized, construction_method='$construction', vector='$vector', adapter='$adapter', growing_stage='$growingStage', samples_count='$samplesCount', strain='$strain', sampling_date='$samplingDate', sampling_place='$samplingPlace', comments='$comments' WHERE pk_library = $pk"
	}

	#canalSqlAssemblyDb
	NSAssemblyDb::getCanal
	SqlExec $sql
	CanalSqlDisconnect

	fetchLibraries
	newLibrary
    
}

proc ::NSLibraryEditorGui::deleteLibrary {} {

	variable pk

	if {$pk ne ""} {
	    #canalSqlAssemblyDb
	    NSAssemblyDb::getCanal
 	    SqlExec "DELETE FROM library WHERE pk_library = $pk"
	    CanalSqlDisconnect
 	}

	fetchLibraries
	newLibrary
    
}

