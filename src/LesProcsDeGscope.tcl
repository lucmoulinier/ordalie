proc Entropy LesNbDesClusters {

    set NbTot 0
    foreach Nb $LesNbDesClusters {set NbTot [expr $NbTot + $Nb]}

    set Entropy 0
    foreach NbDuCluster $LesNbDesClusters {
	if {$NbDuCluster == 0} {continue}
	set Pi     [expr $NbDuCluster * 1.0 / $NbTot]
	set PiLnPi [expr -1 * $Pi * log($Pi)/log(2)]
	set Entropy [expr $Entropy + $PiLnPi]
    }
    return $Entropy

}

