	set LaLigne [split $Ligne "\t"]

	set Nom  [lindex $LaLigne 0]

	set WhatContig [lindex $LaLigne 1]
	if {$WhatContig == "NoContigFound"} {continue}
	set BIdContig     [lindex $LaLigne 2]
	set AccessContig  [lindex $LaLigne 3]
	set TailleContig  [lindex $LaLigne 4]
	set OrgaContig    [lindex $LaLigne 5]
	set ExpectContig  [lindex $LaLigne 6]
	set IdContig      [lindex $LaLigne 7]
	set NbAliContig   [lindex $LaLigne 8]

	set Tab($Nom,Contig,BanqueId)  $BIdContig
	set Tab($Nom,Contig,Access)    $AccessContig
	set Tab($Nom,Contig,Taille)    $TailleContig
	set Tab($Nom,Contig,Organisme) $OrgaContig
	set Tab($Nom,Contig,Expect)    $ExpectContig
	set Tab($Nom,Contig,Identity)  $IdContig
	set Tab($Nom,Contig,NbAli)     $NbAliContig

	set WhatProt      [lindex $LaLigne 9]
	if {$WhatProt == "NoProteinFound"} {continue}
	set BIdProt       [lindex $LaLigne 10]
	set AccessProt    [lindex $LaLigne 11]
	set TailleProt    [lindex $LaLigne 12]
	set OrgaProt      [lindex $LaLigne 13]
	set Distance      [lindex $LaLigne 14]
	set ExpectProt    [lindex $LaLigne 15]
	set ScoreProt     [lindex $LaLigne 16]
	set IdProt        [lindex $LaLigne 17]
	set NbAliProt     [lindex $LaLigne 18]

	set Tab($Nom,Protein,BanqueId)  $BIdProt
	set Tab($Nom,Protein,Access)    $AccessProt
	set Tab($Nom,Protein,Taille)    $TailleProt
	set Tab($Nom,Protein,Organisme) $OrgaProt
	set Tab($Nom,Protein,Expect)    $ExpectProt
	set Tab($Nom,Protein,Score)     $ScoreProt
	set Tab($Nom,Protein,Identity)  $IdProt
	set Tab($Nom,Protein,NbAli)     $NbAliProt
	set Tab($Nom,Protein,Distance)  $Distance
    }
    close $F
    return $aTab

}

proc ChargeContigsDesChromosomes {aTab FichierContig {Chromo {}}} {

    upvar $aTab Tab
    if {![file exists $FichierContig]} {return}
    set F [open $FichierContig]
    if {![info exists Tab(LesChromosomes)]} {set Tab(LesChromosomes) {}}
    if {![info exists Tab(LesContigs)    ]} {set Tab(LesContigs)     {}}
    while {[gets $F Ligne]>=0} {
	set Ligne [string trim $Ligne]
	if {$Ligne == ""} {continue}
	set LesInfos [split $Ligne "\t"]

	set Chromosome [string toupper [string trim [lindex $LesInfos 1]]]
	set Pos  [string first "|" $Chromosome]
	if {-1 < $Pos} {
	    set Sens 0
	    set Chromosome [string range $Chromosome 0 [expr $Pos-1]]
	} else {
	    set Sens       [string trim [lindex $LesInfos 4]]
	    if {$Sens == 0} {set Sens "?"}
	}
	if {$Chromo != "" && ![string equal -nocase $Chromo $Chromosome]} {continue}

	if {![info exists Tab($Chromosome,LesContigs)]} {
	    lappend Tab(LesChromosomes) $Chromosome
	    set Tab($Chromosome,LesContigs) {}
	}
	set Debut      [string trim [lindex $LesInfos 2]]
	set Fin        [string trim [lindex $LesInfos 3]]
	set Contig     [string trim [lindex $LesInfos 5]]

	if {$Contig == "start"} {continue}
	if {$Contig == "end"} {
	    set Tab($Chromosome,Taille) $Fin
	    continue
	}

	regsub "_" $Contig "" Contig
	if {0} {
	    set Pos [string first "_" $Contig]
	    if {-1 < $Pos} { 
		set Contig "[string range $Contig 0 [expr $Pos-1]][string range $Contig [expr $Pos+1] end]" 
	    }
	}

	set Pos [string first "." $Contig]
	if {-1 < $Pos} { 
	    set Version [string range $Contig [expr $Pos+1] end]
	    set Contig  [string range $Contig 0 [expr $Pos-1]]
	} else {
	    set Version ""
	}
	if {![info exists TabTmp($Contig,DebutMin)]} {
	    set TabTmp($Contig,DebutMin) 1e200
	    set TabTmp($Contig,FinMax)   0
	    lappend Tab($Chromosome,LesContigs) $Contig    
	    lappend Tab(LesContigs)             $Contig
	    set     Tab($Chromosome,$Contig)    [list "" "" "$Sens" "$Version"]
	    set     Tab($Contig)                [list "$Chromosome" "" "" "$Sens" "$Version"]
	}
	if {$Debut < [set TabTmp($Contig,DebutMin)]} {
	    set Tab($Chromosome,$Contig) [lreplace [set Tab($Chromosome,$Contig)] 0 0 $Debut]
	    set Tab($Contig)             [lreplace [set Tab($Contig)]             1 1 $Debut]
	    set TabTmp($Contig,DebutMin) $Debut
	}
	if {[set TabTmp($Contig,FinMax)] < $Fin} {
	    set Tab($Chromosome,$Contig) [lreplace [set Tab($Chromosome,$Contig)] 1 1 $Fin]
	    set Tab($Contig)             [lreplace [set Tab($Contig)            ] 2 2 $Fin]
	    set TabTmp($Contig,FinMax) $Fin
	}
    }
    if {[info exists TabTmp]} {unset TabTmp}

    close $F
    return $aTab

}

proc ChargeDefinitionsConsensus {aTab Fichier} {

    upvar $aTab Tab
    if {![file exists $Fichier]} {return}    

    set Tab(LesNoms) {}

    set F [open $Fichier]
    while {[gets $F Ligne]>=0} {
	set Ligne [string trim $Ligne]
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne "\t"]
	set Nom     [lindex $LaLigne 0]
	set Def     [string trim [lindex $LaLigne 1]]
	if {$Def == "" || $Def == "Nothing"} {continue}

	if {![info exists Tab($Nom,Definition)]} {lappend Tab(LesNoms) $Nom}
	set Tab($Nom,Definition) $Def
    }
    return $aTab

}

proc ChargeDevStage {aTab FichierDevStage} {

    upvar $aTab Tab
    set Tab(LesDevStages) {}

    if {![file exists $FichierDevStage]} {return}

    set Tab(LesNoms) {}
    set F [open $FichierDevStage]
    while {[gets $F Ligne]>=0} { 
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne "\t"]
	set Nom     [lindex $LaLigne 0]
	set Acc     [lindex $LaLigne 1]

	if {$Acc == "NoESTFound"} {continue}

	set DevStage  [string tolower [lindex $LaLigne 3]]

	if {![info exists Tab($Nom,LesDevStages)]} {
	    lappend Tab(LesNoms)                  $Nom
	    set Tab($Nom,LesDevStages)              {}
	    set Tab($Nom,LesEST)                  {}
	}
	if {![info exists Tab(EST,$Acc,LesDevStages)]} {
	    set Tab(EST,$Acc,LesDevStages)          {}
	    set Tab(EST,$Acc,LesNoms)             {}
	}
	if {![info exists Tab(DevStage,$DevStage,LesNoms)]} {
	    set     Tab(DevStage,$DevStage,LesNoms)   {}
	    set     Tab(DevStage,$DevStage,LesEST)    {}
	    set     Tab(DevStage,$DevStage,n)         0
	    lappend Tab(LesDevStages)               $DevStage
	}
	incr Tab(DevStage,$DevStage,n)

	if {![info exists Tab($Nom,DevStage,$DevStage,n)]} {
	    set Tab($Nom,DevStage,$DevStage,n)      0
	    set Tab($Nom,DevStage,$DevStage,LesEST) {}
	    lappend Tab($Nom,LesDevStages)        $DevStage
	    lappend Tab(DevStage,$DevStage,LesNoms) $Nom
	}
	incr Tab($Nom,DevStage,$DevStage,n)

	if {![info exists Tab($Nom,DevStage,$DevStage,EST,$Acc,n)]} {
	    set     Tab($Nom,DevStage,$DevStage,EST,$Acc,n) 0
	    lappend Tab($Nom,DevStage,$DevStage,LesEST)     $Acc
	}
	incr Tab($Nom,DevStage,$DevStage,EST,$Acc,n)

	if {![info exists Tab(EST,$Acc,DevStage,$DevStage,n)]} {
	    set Tab(EST,$Acc,DevStage,$DevStage,n)  0
	    lappend Tab(EST,$Acc,LesDevStages)    $DevStage
	    lappend Tab(DevStage,$DevStage,LesEST)  $Acc
	}
	incr Tab(EST,$Acc,DevStage,$DevStage,n)
    }
    close $F
    return $aTab

}

proc ChargeDistancesClusters {aTab {Fichier {}}} {

    upvar $aTab Tab
    if {$Fichier == ""} {
	global RepertoireDuGenome
	set Fichier "$RepertoireDuGenome/xhda/TousLesBilans_PourNuca.dst"
    }
    if {![file exists $Fichier]} {return "File does not exists, please create it"}

    set F [open $Fichier]
    set Cluster1 0
    while {[gets $F Ligne] >=0} {
	if {$Ligne == ""} {continue}
	set Cluster2 0
	foreach Dist [split $Ligne " "] {
	    set Tab(Cluster1,$Cluster1,Cluster2,$Cluster2,Distance) $Dist
	    incr Cluster2
	}
	incr Cluster1
    }
    close $F
    return $aTab

}

proc ChargeDistributionsSurChromosomes {aTab TypeDistribution} {

    global RepertoireDuGenome
    upvar $aTab Tab
    set RepLocalisation         "[HumanGenomeDir]/Localisation"
    set FichierGeneDistribution "$RepLocalisation/Gene_${TypeDistribution}_Distribution"
    set Rep                     "$RepertoireDuGenome/Localisation"
    set FichierSeqDistribution  "$Rep/${TypeDistribution}_Distribution"

    if {![file exists $FichierGeneDistribution]} {
	if {[OuiOuNon "$FichierGeneDistribution doesn't exist.\nDo you want I create it?"]} {
	    QuelquesChiffresSurLesGenes Save 0
	} else { 
	    return ""
	}
    } 
    if {![file exists $FichierSeqDistribution]} {
	if {[OuiOuNon "$FichierSeqDistribution doesn't exist.\nDo you want I create it?"]} {
	    QuelquesChiffresSurLesSequences Save 0
	} else { 
	    return ""
	}
    } 
    set FichierFold "$RepertoireDuGenome/fiches/FoldExpression"
    if {![file exists $FichierFold]} {
	set Fold 0
    } else {
	set Fold 1
    }

    set LesLignes [LesLignesDuFichier $FichierSeqDistribution]
    set LesChromosomes {}
    foreach Ligne $LesLignes {
	if {![regexp -nocase {[0-9a-z]} $Ligne]} {continue}
	if {[regexp -nocase {^Chrom}     $Ligne]} {continue}
	if {[regexp -nocase {^Remaining} $Ligne]} {continue}

	set LaLigne [split $Ligne "\t"]
	set Chrom                        [lindex $LaLigne 0 ]

	set Tab($Chrom,Taille)           [lindex $LaLigne 1 ]
	set Tab($Chrom,NbSeqInCtgP)      [lindex $LaLigne 2 ]
	set Tab($Chrom,NbSeqInCtgNP)     [lindex $LaLigne 3 ]
	set Tab($Chrom,NbSeqExl)         [lindex $LaLigne 4 ]
	set Tab($Chrom,NbSeqInWCtg)      [lindex $LaLigne 5 ]
	set Tab($Chrom,NbSeq)            [expr [set Tab($Chrom,NbSeqInCtgP)] + [set Tab($Chrom,NbSeqInCtgNP)]]

	if {$Fold} {
	    set Tab($Chrom,NbSeqPlusInCtgP)      [lindex $LaLigne 6 ]
	    set Tab($Chrom,NbSeqPlusInCtgNP)     [lindex $LaLigne 7 ]
	    set Tab($Chrom,NbSeqPlusExl)         [lindex $LaLigne 8 ]
	    set Tab($Chrom,NbSeqPlusInWCtg)      [lindex $LaLigne 9 ]
	    set Tab($Chrom,NbSeqPlus)            [expr [set Tab($Chrom,NbSeqPlusInCtgP)] + [set Tab($Chrom,NbSeqPlusInCtgNP)]]
	    set Tab($Chrom,NbSeqMinusInCtgP)      [lindex $LaLigne 10 ]
	    set Tab($Chrom,NbSeqMinusInCtgNP)     [lindex $LaLigne 11 ]
	    set Tab($Chrom,NbSeqMinusExl)         [lindex $LaLigne 12 ]
	    set Tab($Chrom,NbSeqMinusInWCtg)      [lindex $LaLigne 13 ]
	    set Tab($Chrom,NbSeqMinus)            [expr [set Tab($Chrom,NbSeqMinusInCtgP)] + [set Tab($Chrom,NbSeqMinusInCtgNP)]]
	    set Tab($Chrom,NbSeqNoInfInCtgP)      [lindex $LaLigne 14 ]
	    set Tab($Chrom,NbSeqNoInfInCtgNP)     [lindex $LaLigne 15 ]
	    set Tab($Chrom,NbSeqNoInfExl)         [lindex $LaLigne 16 ]
	    set Tab($Chrom,NbSeqNoInfInWCtg)      [lindex $LaLigne 17 ]
	    set Tab($Chrom,NbSeqNoInf)            [expr [set Tab($Chrom,NbSeqNoInfInCtgP)] + [set Tab($Chrom,NbSeqNoInfInCtgNP)]]
	}
	lappend LesChromosomes                 $Chrom
    }
    set LesLignes [LesLignesDuFichier $FichierGeneDistribution]
    foreach Ligne $LesLignes {
	if {![regexp -nocase {[0-9a-z]} $Ligne]} {continue}
	if {[regexp -nocase {^Chrom}     $Ligne]} {continue}
	if {[regexp -nocase {^Remaining} $Ligne]} {continue}

	set LaLigne [split $Ligne "\t"]
	set Chrom                        [lindex $LaLigne 0 ]

	set Tab($Chrom,Taille)           [lindex $LaLigne 1 ]
	set Tab($Chrom,NbGenesInCtgP)    [lindex $LaLigne 2 ]
	set Tab($Chrom,NbGenesInCtgNP)   [lindex $LaLigne 3 ]
	set Tab($Chrom,NbGenesInWCtg)    [lindex $LaLigne 4 ]
	set Tab($Chrom,NbGenes)          [expr [set Tab($Chrom,NbGenesInCtgP)] + [set Tab($Chrom,NbGenesInCtgNP)]]
	if {[set Tab($Chrom,NbGenes)] == 0} {
	    set Tab($Chrom,EspaceDisponible) 0
	} else {
	    set Tab($Chrom,EspaceDisponible) [expr round([set Tab($Chrom,Taille)]*1.0/[set Tab($Chrom,NbGenes)])]
	}
    }
    
    set LesChromosomesAffiches {}
    foreach Chromosome $LesChromosomes {
	if {$Chromosome == "Total"    } {continue}
	if {$Chromosome == "Remaining"} {continue}
	lappend LesChromosomesAffiches $Chromosome
	
	set TailleChrom [set Tab($Chromosome,Taille)]
	if {$TailleChrom == 0} {
	    set Tab($Chromosome,GenesPerBP) 0
	    set Tab($Chromosome,SeqPerBP)   0

	    if {$Fold} {
		set Tab($Chromosome,SeqPlusPerBP)   0
		set Tab($Chromosome,SeqMinusPerBP)   0
		set Tab($Chromosome,SeqNoInfPerBP)   0
	    }
	} else {
	    if {[set Tab($Chromosome,NbGenes)] == 0} {
		set Tab($Chromosome,GenesPerBP) 0
	    } else {
		set Tab($Chromosome,GenesPerBP)  [expr [set Tab($Chromosome,NbGenes)]*1.0/$TailleChrom]
	    }

	    if {[set Tab($Chromosome,NbSeq)] == 0} {
		set Tab($Chromosome,SeqPerBP) 0
	    } else {
		set Tab($Chromosome,SeqPerBP)   [expr [set Tab($Chromosome,NbSeq)  ]*1.0/$TailleChrom]
	    }
	    if {$Fold} {
		if {[set Tab($Chromosome,NbSeqPlus)  ] == 0} {
		    set Tab($Chromosome,SeqPlusPerBP) 0
		} else {
		    set Tab($Chromosome,SeqPlusPerBP)  [expr [set Tab($Chromosome,NbSeqPlus)  ]*1.0/$TailleChrom]
		}
		if { [set Tab($Chromosome,NbSeqMinus)  ] == 0} {
		    set Tab($Chromosome,SeqMinusPerBP) 0
		} else {
		    set Tab($Chromosome,SeqMinusPerBP) [expr [set Tab($Chromosome,NbSeqMinus)  ]*1.0/$TailleChrom]
		}

		if {[set Tab($Chromosome,NbSeqNoInf)  ] == 0} {
		    set Tab($Chromosome,SeqNoInfPerBP) 0
		} else {
		    set Tab($Chromosome,SeqNoInfPerBP) [expr [set Tab($Chromosome,NbSeqNoInf)  ]*1.0/$TailleChrom]
		}
	    }
	}
	set Tab($Chromosome,PourcentageGenique)  [expr round(1000.0*[set Tab($Chromosome,NbGenes)]/[set Tab(Total,NbGenes)])/10.0]

	if {[set Tab($Chromosome,NbSeq)] == 0 || [set Tab(Total,NbSeq)] == 0} {
	    set Tab($Chromosome,PourcentageSequence) 0
	} else {
	    set Tab($Chromosome,PourcentageSequence) [expr round(1000.0*[set Tab($Chromosome,NbSeq)]/[set Tab(Total,NbSeq)])/10.0]
	}

	if {[set Tab($Chromosome,NbGenes)] != 0} {
	    set Tab($Chromosome,BiaisEnSequences)    [expr round(100*[set Tab($Chromosome,NbSeq)]*[set Tab(Total,NbGenes)]*1.0/([set Tab(Total,NbSeq)]*[set Tab($Chromosome,NbGenes)]))]
	} else {
	    set Tab($Chromosome,BiaisEnSequences) 0
	}
	
	set Tab($Chromosome,PourcentageBase)     [expr round(1000.0*$TailleChrom/[set Tab(Total,Taille)]*1.0)/10.0]

	if {$Fold} {
	    if {[set Tab(Total,NbSeqPlus)] == 0 || [set Tab($Chromosome,NbSeqPlus)] == 0} {
		set Tab($Chromosome,PourcentageSequencePlus) 0
	    } else {
		set Tab($Chromosome,PourcentageSequencePlus) [expr round(1000.0*[set Tab($Chromosome,NbSeqPlus)]/[set Tab(Total,NbSeqPlus)])/10.0]
	    }
	    if {[set Tab(Total,NbSeqMinus)] == 0 || [set Tab($Chromosome,NbSeqMinus)] == 0} {
		set Tab($Chromosome,PourcentageSequenceMinus) 0
	    } else {
	    set Tab($Chromosome,PourcentageSequenceMinus) [expr round(1000.0*[set Tab($Chromosome,NbSeqMinus)]/[set Tab(Total,NbSeqMinus)])/10.0]
	    }
	    if {[set Tab(Total,NbSeqNoInf)] == 0 || [set Tab($Chromosome,NbSeqNoInf)] == 0} {
		set Tab($Chromosome,PourcentageSequenceNoInf) 0
	    } else {
	    set Tab($Chromosome,PourcentageSequenceNoInf) [expr round(1000.0*[set Tab($Chromosome,NbSeqNoInf)]/[set Tab(Total,NbSeqNoInf)])/10.0]
	    }

	    if {[set Tab($Chromosome,NbGenes)] != 0 && [set Tab(Total,NbSeqPlus)] != 0 && [set Tab(Total,NbSeqPlus)] != 0} {
		set Tab($Chromosome,BiaisEnSequencesPlus)    [expr round(100*[set Tab($Chromosome,NbSeqPlus)]*[set Tab(Total,NbGenes)]*1.0/([set Tab(Total,NbSeqPlus)]*[set Tab($Chromosome,NbGenes)]))]
	    } else {
		set Tab($Chromosome,BiaisEnSequencesPlus) 0
	    }

	    if {[set Tab($Chromosome,NbGenes)] != 0 && [set Tab(Total,NbSeqMinus)] != 0 && [set Tab(Total,NbSeqMinus)] != 0} {
		set Tab($Chromosome,BiaisEnSequencesMinus)    [expr round(100*[set Tab($Chromosome,NbSeqMinus)]*[set Tab(Total,NbGenes)]*1.0/([set Tab(Total,NbSeqMinus)]*[set Tab($Chromosome,NbGenes)]))]
	    } else {
		set Tab($Chromosome,BiaisEnSequencesMinus) 0
	    }

	    if {[set Tab($Chromosome,NbGenes)] != 0 && [set Tab(Total,NbSeqNoInf)] != 0 && [set Tab(Total,NbSeqNoInf)] !=0 } {
		set Tab($Chromosome,BiaisEnSequencesNoInf)    [expr round(100*[set Tab($Chromosome,NbSeqNoInf)]*[set Tab(Total,NbGenes)]*1.0/([set Tab(Total,NbSeqNoInf)]*[set Tab($Chromosome,NbGenes)]))]
	    } else {
		set Tab($Chromosome,BiaisEnSequencesNoInf) 0
	    }
	}
    }
    set Tab(LesChromosomesAffiches) $LesChromosomesAffiches    
    return $aTab

}

proc ChargeDistributionsSurRegions {aTab ChromosomeDeRef TypeDistribution} {

    global RepertoireDuGenome
    upvar $aTab Tab

    if {$TypeDistribution == "chr"} {
	ChargeDistributionsSurChromosomes Tab $TypeDistribution
	return $aTab
    }

    set RepLocalisation         "[HumanGenomeDir]/Localisation"
    set FichierGeneDistribution "$RepLocalisation/Gene_${TypeDistribution}_Distribution"
    set Rep                     "$RepertoireDuGenome/Localisation"
    set FichierSeqDistribution  "$Rep/${TypeDistribution}_Distribution"

    if {![file exists $FichierGeneDistribution]} {
	if {[OuiOuNon "$FichierGeneDistribution doesn't exist.\nDo you want I create it?"]} {
	    QuelquesChiffresSurLesGenes Save 0
	} else { 
	    return ""
	}
    } 
    if {![file exists $FichierSeqDistribution]} {
	if {[OuiOuNon "$FichierSeqDistribution doesn't exist.\nDo you want I create it?"]} {
	    QuelquesChiffresSurLesSequences Save 0
	} else { 
	    return ""
	}
    } 
    set FichierBandesCytos   "$RepLocalisation/CytologicMap"
    if {![file exists $FichierBandesCytos]} {
	Espionne "$FichierBandesCytos does not exist"
	return ""
    }
    set FichierContigs      "$RepLocalisation/seq_contig.md"
    if {![file exists $FichierContigs]} {
	Espionne "$FichierContigs does not exist"
	return ""
    }

    set FichierFold "$RepertoireDuGenome/fiches/FoldExpression"
    if {![file exists $FichierFold]} {
	set Fold 0
    } else {
	set Fold 1
    }

    set ChromDeRef [NumeroDuChromosome $ChromosomeDeRef]
    set LesLignes  [concat [LesLignesDuFichier $FichierGeneDistribution] [LesLignesDuFichier $FichierSeqDistribution]]

    if {![info exists Tab($ChromosomeDeRef,LesVariables)]} {set Tab($ChromosomeDeRef,LesVariables) {}}
    foreach Ligne $LesLignes {
	set Ligne [string trim $Ligne]
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne "\t"]

	if {[regexp -nocase {^Chrom}     $Ligne]} {
	    set LesRegions [lrange $LaLigne 4 end]
	    continue
	}
	set Chromosome   [lindex $LaLigne 0 ]	
	if {$Chromosome != $ChromDeRef} {continue}

	set Tab($ChromosomeDeRef,LesRegions)    $LesRegions

	set Tab($ChromosomeDeRef,Taille) [lindex $LaLigne 1    ]
	set Var         [lindex $LaLigne 3    ]

	if {![info exists Tab($ChromosomeDeRef,$Var)]} {lappend Tab($ChromosomeDeRef,LesVariables) $Var}
	set Tab($ChromosomeDeRef,$Var)   [lrange $LaLigne 4 end]

    }
    set LesRegions [set Tab($ChromosomeDeRef,LesRegions)]
    
    set GenesTot 0
    set SeqTot   0
    if {$Fold} {
	set SeqPlusTot   0
	set SeqMinusTot   0
	set SeqNoInfTot   0
    }

    for {set i 0} {$i < [llength $LesRegions]} {incr i} {
	set Region         [lindex $LesRegions               $i]
	set TailleRegion [lindex [set Tab($ChromosomeDeRef,Length)  ] $i]

	if {$TypeDistribution == "ctg"} {
	    set Sens         [lindex [set Tab($ChromosomeDeRef,Sens)        ] $i]
	    set SeqInCtgP    [lindex [set Tab($ChromosomeDeRef,SeqInCtgP)   ] $i]
	    set SeqInCtgNP   [lindex [set Tab($ChromosomeDeRef,SeqInCtgNP)  ] $i]
	    set GenesInCtgP  [lindex [set Tab($ChromosomeDeRef,GenesInCtgP) ] $i]
	    set GenesInCtgNP [lindex [set Tab($ChromosomeDeRef,GenesInCtgNP)] $i]

	    set Genes      [expr $GenesInCtgP + $GenesInCtgNP]
	    set Seq        [expr $SeqInCtgP   + $SeqInCtgNP  ]

	    if {$Fold} {
		set SeqPlusInCtgP    [lindex [set Tab($ChromosomeDeRef,SeqPlusInCtgP)   ] $i]
		set SeqPlusInCtgNP   [lindex [set Tab($ChromosomeDeRef,SeqPlusInCtgNP)  ] $i]
		set SeqPlus        [expr $SeqPlusInCtgP   + $SeqPlusInCtgNP  ]
		set SeqMinusInCtgP    [lindex [set Tab($ChromosomeDeRef,SeqMinusInCtgP)   ] $i]
		set SeqMinusInCtgNP   [lindex [set Tab($ChromosomeDeRef,SeqMinusInCtgNP)  ] $i]
		set SeqMinus        [expr $SeqMinusInCtgP   + $SeqMinusInCtgNP  ]
		set SeqNoInfInCtgP    [lindex [set Tab($ChromosomeDeRef,SeqNoInfInCtgP)   ] $i]
		set SeqNoInfInCtgNP   [lindex [set Tab($ChromosomeDeRef,SeqNoInfInCtgNP)  ] $i]
		set SeqNoInf        [expr $SeqNoInfInCtgP   + $SeqNoInfInCtgNP  ]
	    }
	} else {
	    if {[lindex [set Tab($ChromosomeDeRef,NbGenes) ] $i] == ""} {continue}
	    set Genes        [lindex [set Tab($ChromosomeDeRef,NbGenes) ] $i]

	    set Seq          [lindex [set Tab($ChromosomeDeRef,NbSeq)   ] $i]
	    if {$Fold} {
		set SeqPlus          [lindex [set Tab($ChromosomeDeRef,NbSeqPlus)    ] $i]
		set SeqMinus         [lindex [set Tab($ChromosomeDeRef,NbSeqMinus)   ] $i]
		set SeqNoInf         [lindex [set Tab($ChromosomeDeRef,NbSeqNoInf)   ] $i]
	    }
	}
	set GenesTot   [expr $GenesTot + $Genes]
	set SeqTot     [expr $SeqTot   + $Seq  ]
	if {$Fold} {
	    set SeqPlusTot      [expr $SeqPlusTot    + $SeqPlus  ]
	    set SeqMinusTot     [expr $SeqMinusTot   + $SeqMinus  ]
	    set SeqNoInfTot     [expr $SeqNoInfTot   + $SeqNoInf  ]
	}
	if {$Genes == 0} {
	    set EspaceDisponible 0
	} else {
	    set EspaceDisponible [expr round($TailleRegion*1.0/$Genes)]
	}

	set Tab($ChromosomeDeRef,$Region,Taille)           $TailleRegion
	set Tab($ChromosomeDeRef,$Region,NbGenes)            $Genes
	set Tab($ChromosomeDeRef,$Region,NbSeq)              $Seq

	if {$Fold} {
	    set Tab($ChromosomeDeRef,$Region,NbSeqPlus)              $SeqPlus
	    set Tab($ChromosomeDeRef,$Region,NbSeqMinus)             $SeqMinus
	    set Tab($ChromosomeDeRef,$Region,NbSeqNoInf)             $SeqNoInf
	}

	set Tab($ChromosomeDeRef,$Region,EspaceDisponible) $EspaceDisponible
    }
    set Tab($ChromosomeDeRef,GenesTot) $GenesTot
    set Tab($ChromosomeDeRef,SeqTot)   $SeqTot
    
    if {$Fold} {
	set Tab($ChromosomeDeRef,SeqPlusTot)    $SeqPlusTot
	set Tab($ChromosomeDeRef,SeqMinusTot)   $SeqMinusTot
	set Tab($ChromosomeDeRef,SeqNoInfTot)   $SeqNoInfTot
    }
    foreach Region $LesRegions {
	if {![info exists Tab($ChromosomeDeRef,$Region,NbGenes)] ||  ![info exists Tab($ChromosomeDeRef,$Region,NbSeq)]} {continue}
	set Tab($ChromosomeDeRef,$Region,PourcentageGenique)  [expr round(1000.0*[set Tab($ChromosomeDeRef,$Region,NbGenes)]/$GenesTot)/10.0]

	if {[set Tab($ChromosomeDeRef,$Region,NbGenes)] != 0} {
	    set Tab($ChromosomeDeRef,$Region,GenesPerBP)          [expr [set Tab($ChromosomeDeRef,$Region,NbGenes)]*1.0/[set Tab($ChromosomeDeRef,$Region,Taille)]]
	} else {
	    set Tab($ChromosomeDeRef,$Region,GenesPerBP) 0
	}

	if {$SeqTot == 0 || [set Tab($ChromosomeDeRef,$Region,NbSeq)] == 0} {
	    set Tab($ChromosomeDeRef,$Region,PourcentageSequence) 0
	} else {
	    set Tab($ChromosomeDeRef,$Region,PourcentageSequence) [expr round(1000.0*[set Tab($ChromosomeDeRef,$Region,NbSeq)  ]/$SeqTot  )/10.0]
	}
	if {[set Tab($ChromosomeDeRef,$Region,NbSeq)] == 0} {
	    set Tab($ChromosomeDeRef,$Region,SeqPerBP) 0
	} else {
	    set Tab($ChromosomeDeRef,$Region,SeqPerBP)    [expr [set Tab($ChromosomeDeRef,$Region,NbSeq)  ]*1.0/[set Tab($ChromosomeDeRef,$Region,Taille)]]
	}

	if {[set Tab($ChromosomeDeRef,$Region,NbGenes)] == 0 || $SeqTot == 0} {
	    set Tab($ChromosomeDeRef,$Region,BiaisEnSequences) 0
	} else {
	    set Tab($ChromosomeDeRef,$Region,BiaisEnSequences)    [expr round(100*[set Tab($ChromosomeDeRef,$Region,NbSeq)]*$GenesTot*1.0/($SeqTot*[set Tab($ChromosomeDeRef,$Region,NbGenes)]))]
	}
	
	set Tab($ChromosomeDeRef,$Region,PourcentageBase)     [expr round(1000.0*[set Tab($ChromosomeDeRef,$Region,Taille)]/[set Tab($ChromosomeDeRef,Taille)]*1.0)/10.0]
	
	if {$Fold} {
	    if {$SeqPlusTot == 0 || [set Tab($ChromosomeDeRef,$Region,NbSeqPlus)  ] == 0} {
		set Tab($ChromosomeDeRef,$Region,PourcentageSequencePlus) 0
	    } else {
		set Tab($ChromosomeDeRef,$Region,PourcentageSequencePlus) [expr round(1000.0*[set Tab($ChromosomeDeRef,$Region,NbSeqPlus)  ]/$SeqPlusTot  )/10.0]
	    }
	    if {$SeqMinusTot == 0 || [set Tab($ChromosomeDeRef,$Region,NbSeqMinus)  ] == 0} {
		set Tab($ChromosomeDeRef,$Region,PourcentageSequenceMinus) 0
	    } else {
		set Tab($ChromosomeDeRef,$Region,PourcentageSequenceMinus) [expr round(1000.0*[set Tab($ChromosomeDeRef,$Region,NbSeqMinus)  ]/$SeqMinusTot  )/10.0]
	    }
	    if {$SeqNoInfTot == 0 || [set Tab($ChromosomeDeRef,$Region,NbSeqNoInf)  ] == 0} {
		set Tab($ChromosomeDeRef,$Region,PourcentageSequenceNoInf) 0
	    } else {
		set Tab($ChromosomeDeRef,$Region,PourcentageSequenceNoInf) [expr round(1000.0*[set Tab($ChromosomeDeRef,$Region,NbSeqNoInf)  ]/$SeqNoInfTot  )/10.0]
	    }

	    if {[set Tab($ChromosomeDeRef,$Region,NbSeqPlus)  ] == 0} {
		set Tab($ChromosomeDeRef,$Region,SeqPlusPerBP) 0
	    } else {
		set Tab($ChromosomeDeRef,$Region,SeqPlusPerBP)  [expr [set Tab($ChromosomeDeRef,$Region,NbSeqPlus)  ]*1.0/[set Tab($ChromosomeDeRef,$Region,Taille)]]
	    }

	    if {[set Tab($ChromosomeDeRef,$Region,NbSeqMinus)] == 0} {
		set Tab($ChromosomeDeRef,$Region,SeqMinusPerBP) 0
	    } else {
		set Tab($ChromosomeDeRef,$Region,SeqMinusPerBP) [expr [set Tab($ChromosomeDeRef,$Region,NbSeqMinus)  ]*1.0/[set Tab($ChromosomeDeRef,$Region,Taille)]]
	    }
	    if {[set Tab($ChromosomeDeRef,$Region,NbSeqNoInf)] == 0} {
		set Tab($ChromosomeDeRef,$Region,SeqNoInfPerBP) 0
	    } else {
		set Tab($ChromosomeDeRef,$Region,SeqNoInfPerBP) [expr [set Tab($ChromosomeDeRef,$Region,NbSeqNoInf)  ]*1.0/[set Tab($ChromosomeDeRef,$Region,Taille)]]
	    }

	    if {[set Tab($ChromosomeDeRef,$Region,NbGenes)] == 0 || $SeqPlusTot == 0 || [set Tab($ChromosomeDeRef,$Region,NbSeqPlus)] == 0} {
		set Tab($ChromosomeDeRef,$Region,BiaisEnSequencesPlus) 0
	    } else {
		    set Tab($ChromosomeDeRef,$Region,BiaisEnSequencesPlus)    [expr round(100*[set Tab($ChromosomeDeRef,$Region,NbSeqPlus)]*$GenesTot*1.0/($SeqPlusTot*[set Tab($ChromosomeDeRef,$Region,NbGenes)]))]
	    }
	    
	    if {[set Tab($ChromosomeDeRef,$Region,NbGenes)] == 0 || $SeqMinusTot == 0 || [set Tab($ChromosomeDeRef,$Region,NbSeqMinus)] == 0} {
		set Tab($ChromosomeDeRef,$Region,BiaisEnSequencesMinus) 0
	    } else {
		    set Tab($ChromosomeDeRef,$Region,BiaisEnSequencesMinus)    [expr round(100*[set Tab($ChromosomeDeRef,$Region,NbSeqMinus)]*$GenesTot*1.0/($SeqMinusTot*[set Tab($ChromosomeDeRef,$Region,NbGenes)]))]
	    }
	    if {[set Tab($ChromosomeDeRef,$Region,NbGenes)] == 0 || $SeqNoInfTot == 0 || [set Tab($ChromosomeDeRef,$Region,NbSeqNoInf)] == 0} {
		set Tab($ChromosomeDeRef,$Region,BiaisEnSequencesNoInf) 0
	    } else {
		set Tab($ChromosomeDeRef,$Region,BiaisEnSequencesNoInf)    [expr round(100*[set Tab($ChromosomeDeRef,$Region,NbSeqNoInf)]*$GenesTot*1.0/($SeqNoInfTot*[set Tab($ChromosomeDeRef,$Region,NbGenes)]))]
	    }
	}
    }
    return $aTab

}

proc ChargeDomaines aTab {

    upvar $aTab Tab
    
    set Fichier "[RepertoireDuGenome]/fiches/Domaines"
    if {![file exists $Fichier]} {return}
    
    set Tab(LesNoms)     {}
    
    set F [open $Fichier]
    while {[gets $F Ligne]>=0} {
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne "\t"]
	if {[lindex $LaLigne 1] == "Nothing"} {continue}
	set Nom     [lindex $LaLigne 0]
	if {![info exists Tab($Nom,LesDomaines)]} {
	    lappend Tab(LesNoms)                          $Nom
	    set     Tab($Nom,LesDomaines)                 {}
	}
	lappend     Tab($Nom,LesDomaines)                 [lrange $LaLigne 1 end]
    }
    close $F
    return $aTab

}

proc ChargeECCpdRn aTab {

    upvar $aTab Tab
    set Tab(LesElements) {}
    foreach File [glob -nocomplain "[KEGGDir map]/*_map.tab"] {
	set F [open $File]
	while {[gets $F Ligne]>=0} {
	    set Ligne [string trim $Ligne]
	    if {$Ligne == ""} {continue}
	    set LaLigne [split $Ligne "\t"]

	    set Qui [lindex $LaLigne 0]
	    if {![info exists Tab(Element,$Qui,LesPathway)]} {
		set     Tab(Element,$Qui,LesPathway) {}
		lappend Tab(LesElements)             $Qui
	    }
	    foreach Pathway [split [lindex $LaLigne 1] " "] {
		regsub {[a-z]{3}$} $Pathway "" Pathway
		if {[info exists TabTmp($Qui,$Pathway)]} {continue}
		set TabTmp($Qui,$Pathway) 1
		lappend Tab(Element,$Qui,LesPathway) $Pathway
	    }
	}
	close $F
    }

    if {[info exists TabTmp]} {unset TabTmp}

    return $aTab

}

proc ChargeECDuPathway {aTab Pathway} {

    upvar $aTab Tab
    set File [FichierPathway $Pathway "" enz]
    if {![file exists $File]} {return}

    set Tab(Pathway,$Pathway,LesEC) {}
    set F [open $File]
    while {[gets $F Ligne]>=0} {
	set Ligne [string trim $Ligne]
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne "\t"]
	set EC  [lindex $LaLigne 0]
	regsub "^EC " $EC "" EC
	set EC  [CorrigeLEC $EC]

	lappend Tab(Pathway,$Pathway,LesEC) $EC

	set Definitions [string trim [lindex $LaLigne 1]]
	regsub -all "; " $Definitions ";" Definitions

	set Tab(Pathway,$Pathway,EC,$EC,LesDefinitions) {}
	foreach Definition [split $Definitions ";"] {
	    set Definition [string trim $Definition]
	    if {$Definition == ""} {continue}
	    lappend Tab(Pathway,$Pathway,EC,$EC,LesDefinitions) $Definition
	    set Tab(Pathway,$Pathway,Definition,$Definition,EC) $EC
	}
    }
    close $F
    return $aTab

}

proc ChargeEffectifDesDevStage {aTab FichierEffectif} {

    upvar $aTab Tab
    if {![file exists $FichierEffectif]} {return}

    set Tab(NTotDansLaBanque) 0
    set F [open $FichierEffectif]
    while {[gets $F Ligne]>=0} {
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne "\t"]
	set DevStage  [lindex $LaLigne 0]
	set n       [lindex $LaLigne 1]
	incr Tab(NTotDansLaBanque) $n
	set Tab(DevStage,$DevStage,NTotDansLaBanque) $n
    }
    close $F
    return $aTab

}

proc ChargeEffectifDesTissueType {aTab FichierEffectif} {

    upvar $aTab Tab
    if {![file exists $FichierEffectif]} {return}

    set Tab(NTotDansLaBanque) 0
    set F [open $FichierEffectif]
    while {[gets $F Ligne]>=0} {
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne "\t"]
	set Tissue  [lindex $LaLigne 0]
	set n       [lindex $LaLigne 1]
	incr Tab(NTotDansLaBanque) $n
	set Tab(Tissue,$Tissue,NTotDansLaBanque) $n
    }
    close $F
    return $aTab

}

proc ChargeExonicMap {aTab FichierEM} {

    upvar $aTab Tab
    
    if {![file exists $FichierEM]} {return}

    set Tab($FichierEM,Query,Masking) 0
    set Tab($FichierEM,LesWarning)    {}
    set Tab($FichierEM,LesRangs)      {}

    set F [open $FichierEM]
    while {[gets $F Ligne]>=0} {
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne ":"]
	set Entete  [lindex $LaLigne 0]
	set Reste   [join [lrange $LaLigne 1 end] ":"]

	if {[string equal -nocase $Entete "BOX"        ]} {
	    set Tab($FichierEM,Nom)          [string trim $Reste]
	    continue
	}
	if {[string equal -nocase $Entete "File"       ]} {
	    set Reste [string trim $Reste]
	    if {![regexp [RepertoireDuGenome] $Reste]} {set Reste "[RepertoireDuGenome]/$Reste"}
	    
	    set Tab($FichierEM,Query,FichierTFA) $Reste
	    if {![file exists $Reste]} {
		set Tab($FichierEM,Query,SeqTFA) ""
	    } else {
		set Tab($FichierEM,Query,SeqTFA) [ContenuDuFichier $Reste]
	    }
	    continue
	}
	if {[string equal -nocase $Entete "TYPE"       ]} {
	    set Tab($FichierEM,Query,Type)   [string trim $Reste]
	    continue
	}
	if {[string equal -nocase $Entete "LengthBox"  ]} {
	    set Tab($FichierEM,Query,Taille) [string trim $Reste]
	    continue
	}
	if {[string equal -nocase $Entete "NbCycles"   ]} {
	    set Tab($FichierEM,NbCycles)     [string trim $Reste]
	    continue
	}
	if {[string equal -nocase $Entete "WARNING"    ]} {
	    if {[set Tab($FichierEM,LesRangs)] != {}} {
		set     Tab($FichierEM,Query,Warning)    [string trim $Reste]
		lappend Tab($FichierEM,LesWarning)       [string trim $Reste]
		continue
	    } else {
		set     Rang [lindex [set Tab($FichierEM,LesRangs)] end]
		if {![info exists Tab($FichierEM,Rang,$Rang,LesWarning)]} {
		    set Tab($FichierEM,Rang,$Rang,LesWarning) {}
		}
		lappend Tab($FichierEM,Rang,$Rang,LesWarning) [string trim $Reste]
		continue
	    }
	}
	if {[string equal -nocase $Entete "RANK_SCORE"    ]} {
	    set LeReste [split [string trim [string trim $Reste]]    " "]
	    set Rang    [lindex $LeReste   0]
	    lappend Tab($FichierEM,LesRangs)            $Rang
	    set     Tab($FichierEM,Rang,$Rang,NbAliTot) [lindex $LeReste 1]
	    set     Tab($FichierEM,Rang,$Rang,NbAreas)  0
	    continue
	}
	if {[string equal -nocase $Entete "Chromosome"]} {
	    set     Rang [lindex [set Tab($FichierEM,LesRangs)] end]
	    set     Tab($FichierEM,Rang,$Rang,Chromosome) [string trim $Reste]
	    continue
	}
	if {[string equal -nocase $Entete "Contig"]} {
	    set     Rang [lindex [set Tab($FichierEM,LesRangs)] end]
	    set     Tab($FichierEM,Rang,$Rang,Contig)           [string trim $Reste]
	    set     Tab($FichierEM,Rang,$Rang,ContigFragments)  {}
	    continue
	}
	if {[string equal -nocase $Entete "ContigFragments"]} {
	    set     Rang [lindex [set Tab($FichierEM,LesRangs)] end]
	    scan [string trim $Reste] "%s %s %s %s" From Fragment1 To Fragment2
	    lappend Tab($FichierEM,Rang,$Rang,ContigFragments)  $Fragment1
	    if {$Fragment1 != $Fragment2} {lappend Tab($FichierEM,Rang,$Rang,ContigFragments)  $Fragment2}
	    continue
	}
	if {[string equal -nocase $Entete "ContigLocalisation"]} {
	    set     Rang [lindex [set Tab($FichierEM,LesRangs)] end]
	    scan    [string trim $Reste] "%s %d %s %d" From DebutGene To FinGene
	    lappend Tab($FichierEM,Rang,$Rang,ContigLocalisation,Debut) $DebutGene
	    lappend Tab($FichierEM,Rang,$Rang,ContigLocalisation,Fin)   $FinGene
	    continue
	}
	if {[string equal -nocase $Entete "Sense"]} {
	    set     Rang [lindex [set Tab($FichierEM,LesRangs)] end]
	    set     Tab($FichierEM,Rang,$Rang,Sens)            [string trim $Reste]
	    set     Tab($FichierEM,Rang,$Rang,LesOrientations) {}
	    continue
	}
	if {[string equal -nocase $Entete "NbExonicAreas"]} {
	    set     Rang [lindex [set Tab($FichierEM,LesRangs)] end]
	    set     Tab($FichierEM,Rang,$Rang,NbExonicAreas)    [string trim $Reste]
	    continue
	}
	if {[string equal -nocase $Entete "NbAbsentAreas"]} {
	    set     Rang [lindex [set Tab($FichierEM,LesRangs)] end]
	    set     Tab($FichierEM,Rang,$Rang,NbAbsentAreas)    [string trim $Reste]
	    continue
	}
	if {[string equal -nocase $Entete "NbPolyLocAreas"]} {
	    set     Rang [lindex [set Tab($FichierEM,LesRangs)] end]
	    set     Tab($FichierEM,Rang,$Rang,NbPolyLocAreas)    [string trim $Reste]
	    continue
	}
	if {[regexp {^[0-9]} $Ligne]} {
	    set     Rang [lindex [set Tab($FichierEM,LesRangs)] end]
	    regsub -all " / " $Ligne "/" Ligne
	    while {[regexp "  " $Ligne]} {regsub -all "  " $Ligne " " Ligne}
	    set LaLigne [split [string trim $Ligne] " "]

	    incr Tab($FichierEM,Rang,$Rang,NbAreas)
	    set  nArea [set Tab($FichierEM,Rang,$Rang,NbAreas)]

	    set Type     [lindex $LaLigne 3]
	    set nType    [lindex $LaLigne 4]

	    set Tab($FichierEM,Rang,$Rang,Area,$nArea,Type)    $Type
	    set Tab($FichierEM,Rang,$Rang,Area,$nArea,$Type,n) $nType

	    set Tab($FichierEM,Rang,$Rang,$Type,$nType,DQ) [Mini [lindex $LaLigne 0] [lindex $LaLigne 1]]
	    set Tab($FichierEM,Rang,$Rang,$Type,$nType,FQ) [Maxi [lindex $LaLigne 0] [lindex $LaLigne 1]]
	    set Tab($FichierEM,Rang,$Rang,$Type,$nType,Taille)   [lindex $LaLigne 2]
	   
	    if {[string equal -nocase $Type "AbsentArea"]} {continue}

	    set Sens [lindex $LaLigne 8]

	    if {$Sens == "+"} {
		set DS [Mini [lindex $LaLigne 5] [lindex $LaLigne 6]]
		set FS [Maxi [lindex $LaLigne 5] [lindex $LaLigne 6]]
	    } else {
		set DS [Mini [lindex $LaLigne 5] [lindex $LaLigne 6]]
		set FS [Maxi [lindex $LaLigne 5] [lindex $LaLigne 6]]
	    }
	    set Orient       [lindex $LaLigne 7]
	    set nAli         [lindex $LaLigne 9]
	    set nAliTot      [lindex $LaLigne 10]
	    set Id           [lindex $LaLigne 11]
	    set nContigu     [lindex $LaLigne 12]

	    set Tab($FichierEM,Rang,$Rang,$Type,$nType,DS)          $DS
	    set Tab($FichierEM,Rang,$Rang,$Type,$nType,FS)          $FS
	    set Tab($FichierEM,Rang,$Rang,$Type,$nType,Orientation) $Orient
	    if {![info exists TabTmp($FichierEM,Rang,$Rang,$Orient)]} {
		lappend Tab($FichierEM,Rang,$Rang,LesOrientations)  $Orient
		set     TabTmp($FichierEM,Rang,$Rang,$Orient)       1
	    }

	    set Tab($FichierEM,Rang,$Rang,$Type,$nType,Sens)        $Sens
	    set Tab($FichierEM,Rang,$Rang,$Type,$nType,nAli)        $nAli
	    set Tab($FichierEM,Rang,$Rang,$Type,$nType,nAliTot)     $nAliTot
	    set Tab($FichierEM,Rang,$Rang,$Type,$nType,Identity)    $Id
	    set Tab($FichierEM,Rang,$Rang,$Type,$nType,nContigu)    $nContigu
	}
    }
    if {[info exists TabTmp]} {unset TabTmp}
    close $F

    return $aTab

}

proc ChargeFichierClusteringDesMSF {aTab FichierClustering} {

    upvar $aTab Tab

    set Tab($FichierClustering,LesClusters) {}
    set Tab($FichierClustering,LesAccess)   {}
    set Tab($FichierClustering,NbClusters)  0

    set F [open $FichierClustering]
    while {[gets $F Ligne]>=0} {    
	if {$Ligne == ""} {continue}
	set LaLigne [split [string trim $Ligne] " "]

	set Entete [lindex $LaLigne 0]

	if {[string equal -nocase $Entete "Number"]} {continue}
	if {[string equal -nocase $Entete "Cluster"]} {
	    set Cluster [lindex $LaLigne 1]
	    lappend Tab($FichierClustering,LesClusters)                $Cluster
	    set     Tab($FichierClustering,Cluster,$Cluster,Size)      0
	    set     Tab($FichierClustering,Cluster,$Cluster,LesAccess) {}
	    incr    Tab($FichierClustering,NbClusters)
	    continue
	}
	if {[string equal -nocase $Entete "unclustered"]} {
	    set Cluster "None"
	    lappend Tab($FichierClustering,LesClusters)                $Cluster
	    set     Tab($FichierClustering,Cluster,$Cluster,Size)      0
	    set     Tab($FichierClustering,Cluster,$Cluster,LesAccess) {}
	    incr    Tab($FichierClustering,NbClusters)
	    continue
	}
	lappend Tab($FichierClustering,Access,$Entete,Cluster)     $Cluster
	lappend Tab($FichierClustering,Cluster,$Cluster,LesAccess) $Entete
	lappend Tab($FichierClustering,LesAccess)                  $Entete
	incr    Tab($FichierClustering,Cluster,$Cluster,Size)
    }
    close $F
    return $aTab

}

