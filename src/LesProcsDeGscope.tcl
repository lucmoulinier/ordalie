    Wup "La suite est obsolete"
    foreach Ligne [LesLignesDuFichier "[RepXbgs]/ListeComplementaire.txt"] {
	if { ! [regexp -nocase {[a-z]} $Ligne]} { continue }
	scan $Ligne "%s" Alias
