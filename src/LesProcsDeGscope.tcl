proc ::Mistic::query {dbversion chrom pos ref alt} {

		package require sqlite3
		sqlite3 mdb [getDBPath $dbversion] 
		return [mdb eval "SELECT chrom, pos, ref, alt, mistic_score, mistic_pred
						FROM MISTIC
