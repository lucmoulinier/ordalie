proc HelpDeLaProcedure {{P {}}} {

    if {$P==""} { set P [scan [info level -1] "%s"] }
    #rR HelpDeLaProcedure rend toutes les lignes commençant par #rR ou #lM ou #aK
    if {[info proc $P]==""} { return "$P is not a procedure" }
    set LeHelp {} 
    foreach Ligne [split [info body $P] "\n"] {
		if { ! [regexp {^ +#[a-z][A-Z] } $Ligne]} { continue }
		regsub {^ +#[a-z][A-Z] } $Ligne "" Ligne
		lappend LeHelp $Ligne
    }
    return [join $LeHelp "\n"]

}

