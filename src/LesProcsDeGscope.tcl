	AjouteAuLog [format "%-20s  %-12s" " -t  (Tm)" "Tm threshold."]  
	AjouteAuLog [format "%-20s  %-12s" " -r  (TmRange)" "Tm range."]
	AjouteAuLog [format "%-20s  %-12s" " -b  (Database)" "Database in which specificity will be tested."]
	AjouteAuLog [format "%-20s  %-12s" " -st (Step)" "Step between each attempt to analyse an oligo."]
	AjouteAuLog [format "%-20s  %-12s" " -sp (Specificity)" "Specificity threshold to keep X-Hybridisation."]
	AjouteAuLog [format "%-20s  %-12s" "" "Please enter value as 70.0% (default value)"] 
	AjouteAuLog [format "%-20s  %-12s" " -nc (Contiguous)" "Specificity threshold for max contiguous bases allowed."]
	AjouteAuLog [format "%-20s  %-12s" "" "Default is 15 contiguous bases rejected."] 
	AjouteAuLog [format "%-20s  %-12s" " -m  (TmMethod)" "Method for Tm calculation."]
	AjouteAuLog [format "%-20s  %-12s" " -gl (GCLower)" "The minimum %GC accepted."]
	AjouteAuLog [format "%-20s  %-12s" " -gu (GCUpper)" "The maximum %GC accepted."]
	AjouteAuLog [format "%-20s  %-12s" "" "Please enter values as 35.0%"] 
	AjouteAuLog [format "%-20s  %-12s" "" "Default is NearestNeighbor."] 
	AjouteAuLog [format "%-20s  %-12s" "" "Taille < 20 nt"]
	AjouteAuLog [format "%-20s  %-12s" "" "    Wallace Tm= 4*(G+C)+2*(A+T)]"]
	AjouteAuLog [format "%-20s  %-12s" "" "Taille >20 nt"]
	AjouteAuLog [format "%-20s  %-12s" "" "    NearestNeighbor Tm=1e3DH/DS+Rln(ADN/4)-273.15)"]
	AjouteAuLog [format "%-20s  %-12s" "" "    ADNADN Tm=81.5+16.6log M+0.410(%GC)-500/L-0.62F"]
	AjouteAuLog [format "%-20s  %-12s" "" "    ADNARN Tm=79.8+18.5log M+0.584(%GC)-820/L-0.35F+11.8(%GC)^2"]
	AjouteAuLog [format "%-20s  %-12s" "" "    ARNARN Tm=79.8+18.5log M+0.584(%GC)-820/L-0.50F+11.8(%GC)^2"]
	AjouteAuLog [format "%-20s  %-12s" " -p  (Prohib)" "Prohibited Sequence, must be a list of sequence"]
	AjouteAuLog [format "%-20s  %-12s" " -w  (WorkingDir)" "Choose the directory where to save your files"]
	AjouteAuLog [format "%-20s  %-12s" " -ev (BlastExpect)" "The Blast E-value limit."]
	AjouteAuLog [format "%-20s  %-12s" "" "Default is 100."] 
	AjouteAuLog [format "%-20s  %-12s" " -bw (BlastWord)" "The word length for Blast searches."]
	AjouteAuLog [format "%-20s  %-12s" "" "Default is 15 nt."] 
	AjouteAuLog [format "%-20s  %-12s" " -ba (BlastNbAligned)" "The Blast sequence limit to align."]
	AjouteAuLog [format "%-20s  %-12s" "" "Default is 2000."] 
	AjouteAuLog [format "%-20s  %-12s" " -bs (BlastStrand)" "The Blast option to search on forward (1), reverse (2) or both (3) strands."]
	AjouteAuLog [format "%-20s  %-12s" "" "Default is 1."] 
	AjouteAuLog [format "%-20s  %-12s" " -qc (QueryCheck)" "Your query is checked in database with % Id and %Cover."] 
	AjouteAuLog [format "%-20s  %-12s" "" "Default is 1 (for yes)."] 
	AjouteAuLog "\nYou need to define Length, Tm, Tm range, Database, number of oligo and your working directory."
	AjouteAuLog "The sequence are stored in many different files according to the name of your sequence:"
	AjouteAuLog "\tex:\tACT0001.masked    for the masked sequence (basically for poly A over 15 nts)"
	AjouteAuLog "\t\tACT0001.blastn    for the homology search result with BlastN program"
	AjouteAuLog "\t\tACT0001.log       for the log of all the steps during BlastN analysis"   
	AjouteAuLog "\t\tACT0001.oligo     for the results obtained in multiple fasta file format"
	AjouteAuLog "\t\t                  rejected sequence has <<No oligo available>> label"
	AjouteAuLog "\t\tACT0001.selection for the best oligo available"
	AjouteAuLog "\t\tACT0001.croisee   for the best oligo available between two design."

	exit
	return ""
    } else {
	LogoCADO4MI
	foreach {Option Valeur} $args {
	    #AjouteAuLog "O $Option V $Valeur"
	    switch -regexp -- $Option {
		"-q$"  {LesParametresDuDesign Query          $Valeur "Positionne"}
		"-l$"  {LesParametresDuDesign LengthOligo    $Valeur "Positionne"}
		"-ar$" {
		    set NbZones  [llength $Valeur]
		    if {[expr $NbZones%2]} {
			AjouteAuLog "! Warning ! for option -ar you need pairs of begin-end points"
			return ""
		    } else {
			foreach {b e} $Valeur {
			    LesParametresDuDesign LesZones [list $b $e] "Ajoute"
			}
		    }
		}
		"-nb$" {LesParametresDuDesign NbOligo        $Valeur "Positionne"}
		"-t$"  {LesParametresDuDesign TmLimit        $Valeur "Positionne"}
		"-r$"  {LesParametresDuDesign TmRange        $Valeur "Positionne"}
		"-gl$" {LesParametresDuDesign GCContentMinus $Valeur "Positionne"}
		"-gu$" {LesParametresDuDesign GCContentPlus  $Valeur "Positionne"}
		"-b$"  {LesParametresDuDesign DataBase       $Valeur "Positionne"}
		"-st$" {LesParametresDuDesign Step           $Valeur "Positionne"}
		"-sp$" {LesParametresDuDesign IdLimit        $Valeur "Positionne"}
		"-nc$" {LesParametresDuDesign NbContiguous   $Valeur "Positionne"}
		"-m$"  {LesParametresDuDesign TmMethod       $Valeur "Positionne"}
		"-p$"  {LesParametresDuDesign LesProhibes    $Valeur "Positionne"}
		"-w$"  {LesParametresDuDesign WorkingDir     $Valeur "Positionne"}
		"-ev$" {LesParametresDuDesign BlastExpect    $Valeur "Positionne"}
		"-bw$" {LesParametresDuDesign BlastWord      $Valeur "Positionne"}
		"-ba$" {LesParametresDuDesign BlastNbAligned $Valeur "Positionne"}
		"-bs$" {LesParametresDuDesign BlastStrand    $Valeur "Positionne"}
		"-qc$" {LesParametresDuDesign QueryCheck     $Valeur "Positionne"}
	    }
	}
    }
    LesParametresParDefaut
    if {[BonNombreDeParametres "AvecVerif"]} {
	MontreLesParametresDuDesign

	OligoLauncher 
    } else {
	AjouteAuLog "Missing parameters."
	CADO4MI "-check"
	return ""
    }
    
    #On detruit toutes les infos
    #AskBLAST aussi ??
    #AskBlast unset
    LesParametresDuDesign UnsetAll

    return ""

}

proc CADO4MI_Panel {{w {}}} {

    
    Wup "Interface graphique de CADO4MI 1.0"
    Wup "Permet de lancer un design avec des criteres restrictifs"
    Wup "Permet de visualiser les resultats du design"
    Wup "Permet de visualiser certains des criteres de choix"

    Wup "Ajout de l interface vers IllustreOligo"
    Wup "Ajout des bulles infos, restriction pour les entrees"
    Wup "Ajout File management (delete files et save to excel file)"
    Wup "Ajout advanced parameters (step and blastn parameters, Batch mode)"
    Wup "Ajout Best GC et Tm calculation"

    #On gere la premiere fenetre en . si il y deja autre chose d utiliser dans .
    #ATTENTION on doit modifier . en "" pour pouvoir conserver la hierarchie des fenetres
    if {[winfo children .] != ""} {
	set       w ".startCADO4MI"
	if {[winfo exists $w]} {return ""}
	toplevel $w
    } else {
	set w "."
	#$w config -bd 3 -relief flat
    }
    wm geometry  $w +300+100
    wm title     $w "Microarray: Oligonucleotide Design"
    wm resizable $w false false
    #wm resizable $w true true
    wm protocol  $w WM_DELETE_WINDOW "exit"
    if {$w == "."} {set w ""}

    #0 Le titre
    set    FTitre "$w.ftitre"
    set    LTitre "$FTitre.ltitre"
    frame $FTitre -borderwidth "3" -relief "groove"
    set Titre "CADO4MI 1.0"
    label $LTitre -borderwidth "2" -relief "ridge"  -background "orange" -text "$Titre" -width "45" -pady "3"
    
    bind  $LTitre <Enter> "$LTitre configure -relief sunken -background red    -text \"----------- EXIT -----------\""
    bind  $LTitre <Leave> "$LTitre configure -relief ridge  -background orange -text \"CADO4MI 1.0\""
    if {$w == ""} {set w "."}
    bind  $LTitre <1>     "eval \[wm protocol $w WM_DELETE_WINDOW\]"

    if {$w == "."} {set w ""}
    #Les 2 frames majeures
    #1 Predesigned IllustreOligo Panel
    #2 Design      Tous les parametres du design
    set    FPreDesigned "$w.fpredesigned"
    set    FDesign      "$w.fdesign"
    frame $FPreDesigned -borderwidth "3" -relief "groove"
    frame $FDesign      -borderwidth "3" -relief "groove"

    #1.1 IllustreOligo panel
    global E1Illustre2
    global E2Illustre2
    set FIllustre1   "$FPreDesigned.fillustre1"
    set  LIllustre1  "$FIllustre1.lillustre1"
    set  BIllustre1  "$FIllustre1.billustre1"
    set FIllustre2   "$FPreDesigned.illustre2"
    set  L1Illustre2 "$FIllustre2.l1illustre2"
    set  E1Illustre2 "$FIllustre2.e1illustre2"
    set  B1Illustre2 "$FIllustre2.b1illustre2"
    set  B2Illustre2 "$FIllustre2.b2illustre2"
    set  L2Illustre2 "$FIllustre2.l2illustre2"
    set  E2Illustre2 "$FIllustre2.e2illustre2"
    set  B3Illustre2 "$FIllustre2.b3illustre2"
    set  B4Illustre2 "$FIllustre2.b4illustre2"

    frame  $FIllustre1  -borderwidth "2"          -relief "ridge" 
    label  $LIllustre1  -background  "#808FFF"    -relief "groove" -text "Show Designed Oligo Menu"
    button $BIllustre1  -background  "OliveDrab1" -relief "ridge"  -text "Show / Hide" -padx "2" -command "HideGridedFrame $FIllustre2"
    frame  $FIllustre2  -background "#808080"     -relief "groove" -borderwidth "0"
    label  $L1Illustre2 -background "#808FFF"     -relief "groove" -text "Acc:"   -width "10" -anchor "w"
    entry  $E1Illustre2 -textvariable PAB		      
    button $B2Illustre2 -background "yellow"      -padx "2"        -text "Browse" -command {
	set BrowsedPAB [tk_getOpenFile -multiple "y" -title "Choose 1 or more sequence(s)." -initialdir "[RepertoireDuGenome]"]
	$E1Illustre2 delete 0 end
	$E1Illustre2 insert   end $BrowsedPAB
    }
    button $B1Illustre2 -background "yellow"      -padx "2"        -text "OK"     -command {
	if {$PAB!=""} {
	    if {$ProbesDir==""} {
		if {[regexp {\\} $PAB] || [regexp {/} $PAB]} {
		    set LesDirs [file dirname $PAB]
		} else {
				    set RepOligo "[RepertoireDuGenome]/Probes"   
		    if {[file exists $RepOligo]} {
			set LesDirs ""
			set LaListe ""
			foreach File [glob -nocomplain -directory $RepOligo -types d "*"] {
			    lappend LaListe [file tail $File]
			}
			set  LaListe [EntreDeux [lsort $LaListe]]
			if {$LaListe==""} {AjouteAuLog "No Directories found";return ""}
			foreach Dir $LaListe {
			    lappend LesDirs "$RepOligo/$Dir"
			}
		    } else {AjouteAuLog "No Directories specified";return ""}
		}
	    } else {
		set LesDirs $ProbesDir
	    } 

	    foreach Seq $PAB {
		#IllustreOligo $Seq $ProbesDir
		IllustreOligo $Seq $LesDirs
	    }
	} else {
	    set Warning "Acc must be a regular GScope DataBase Name with previously designed oligo(s)."
	    AjouteAuLog $Warning
	}
    }
    label  $L2Illustre2 -background "#808FFF"     -relief "groove" -text "Directory:" -width "10" -anchor "w"
    entry  $E2Illustre2 -textvariable ProbesDir
    button $B4Illustre2 -background "yellow"      -padx   "2"      -text "Browse" -command {
	set BrowsedDir [tk_chooseDirectory -title "Choose one directory." -initialdir "[RepertoireDuGenome]"]
	$E2Illustre2 delete 0 end
	$E2Illustre2 insert   end $BrowsedDir
    }
    button $B3Illustre2 -background "yellow"      -padx   "2"      -text "OK"     -command {
	if {$ProbesDir!=""} {
	    set ExistingDir 1
	    foreach Dir $ProbesDir {
		if {![file exists $Dir]} {
		    set ExistingDir 0
		    set Warning "Directory must be a regular directory containing previously designed oligo(s)."
		    AjouteAuLog $Warning
		} 
	    }
	    if {$ExistingDir} {
		if {$PAB!=""} {
		    foreach Seq $PAB {
			IllustreOligo $Seq $ProbesDir
		    }
		} else {
		    set LesDirs ""
		    set LaListe ""
		    set RepOligo [lindex $ProbesDir 0]
		    foreach File [glob -nocomplain -directory $RepOligo "*.masked"] {
			regsub {.masked$} $File "" File
			lappend LaListe [file tail $File]
		    }
		    set  LaListe [EntreDeux [lsort $LaListe]]
		    if {$LaListe==""} {AjouteAuLog "No sequence selected.";return ""}
		    foreach Acc $LaListe {
			lappend PAB "$RepOligo/${Acc}.masked"
		    }
		    foreach Seq $PAB {
			IllustreOligo $Seq $ProbesDir
		    }
		    #set Warning "Acc must be choosen."
		    #AjouteAuLog $Warning
		}
	    }
	} else {
	    set Warning "Directory should contain oligo, it is an option."
	    AjouteAuLog $Warning
	}
    }
    set_balloon $LIllustre1  "Where you can display the design of Oligonucleotides"
    set_balloon $L1Illustre2 "Accession or file name for query with designed oligos"
    set_balloon $L2Illustre2 "Directory containing your design"

    #Les 2 frames des parametres
    #2.1 Menu du design
    #2.2 Frame de tous les parametres
    set     FParamMenu         "$FDesign.fparammenu"
    set     LParamMenu         "$FParamMenu.lparammenu"
    set     BParamMenu         "$FParamMenu.bparammenu"
    set     FTousLesParameters "$FDesign.fparameters"
    frame  $FParamMenu -borderwidth "2"          -relief "ridge"  
    label  $LParamMenu -background  "#808FFF"    -relief "groove" -text "Oligo Design Menu"
    button $BParamMenu -background  "OliveDrab1" -relief "ridge"  -text "Show / Hide" -padx "2" -command "HideGridedFrame $FTousLesParameters"
    frame  $FTousLesParameters -borderwidth "0"  -relief "groove" 
    set_balloon $LParamMenu "Where you can do the design of Oligonucleotides"

    #Les petites frames, parametres, Tm methode, menu, log
    #2.2.1 Frame des parametres query, edge, GC ...
    #2.2.2 Frame de la methode de Tm
    #2.2.3 Frame Advanced Parameters step, specificity et BLAST
    #2.2.4 Frame des boutons File, Reset, Run ...
    #2.2.5 Frame du Log
    set    FParameters1 "$FTousLesParameters.fparameters1"
    set    FParameters2 "$FTousLesParameters.fparameters2"
    set    FParameters3 "$FTousLesParameters.fparameters3"
    set    FMenuOut     "$FTousLesParameters.fmenuout"
    set    FVisible     "$FTousLesParameters.fvisible"
    frame $FParameters1 -borderwidth "0" -relief "groove"
    frame $FParameters2 -borderwidth "0" -relief "groove"
    frame $FParameters3 -borderwidth "0" -relief "groove"
    frame $FMenuOut     -borderwidth "3" -relief "ridge"
    frame $FVisible     -borderwidth "0" -relief "groove"

    #2.2.1.1 Query panel
    global EQuery
    set FQuery   "$FParameters1.fquery"
    set  LQuery  "$FQuery.lquery"
    set  EQuery  "$FQuery.equery"
    set  BQuery  "$FQuery.bquery"
    set  B2Query "$FQuery.b2query"
    set  B3Query "$FQuery.b3query"

    frame  $FQuery  -background "#808080" -relief "groove"
    label  $LQuery  -background "#808FFF" -relief "groove" -text "Query" -width "10" -anchor "w"
    entry  $EQuery  -textvariable QueryVar
    button $B3Query -background  "orange" -relief "groove" -text "Info"  -padx   "3" -borderwidth "2" -command {
	if {[LesParametresDuDesign Query "LaValeurMerci"]!=""} {
	    set LesQuerys [LesParametresDuDesign Query "LaValeurMerci"]
	    foreach Qy $LesQuerys {
		AfficheLesInfosDeMaSequence $Qy
	    }
	} else {
	    AjouteAuLog "Query must exist and also being validated"
	}
    }
    button $B2Query -background "yellow"  -padx "2"        -text "Browse" -command {
	set BrowsedQuery [tk_getOpenFile -multiple "y" -title "Choose one sequence file." -initialdir "[RepertoireDuGenome]"]
	$EQuery delete 0 end
	$EQuery insert   end $BrowsedQuery
    }
    button $BQuery  -background "yellow"  -padx "2"        -text "OK"     -command {
	if {$QueryVar!=""} {
	    if {$QueryVar=="LaTotale"}           {set QueryVar [ListeDesPABs]}
	    if {$QueryVar=="ListeTest"}          {set QueryVar [ListeTest]}
	    if {$QueryVar=="ListeControle"}      {set QueryVar [ListeControles]}
	    if {$QueryVar=="ListeDesNews"}       {set QueryVar [ListeDesNews]}
	    if {$QueryVar=="ListeDesRhos"}       {set QueryVar [ListeDesRhos]}
	    if {$QueryVar=="RepertoireDuGenome"} {set QueryVar [RepertoireDuGenome]}
	
	    if {[llength $QueryVar]=="1"} {
		#On a un seul fichier
		#Test si on un single ou multiple fasta file
		set  NbTFA  "0"
		set  NbTFA  [EstCeUnTFAOuUnTFAS $QueryVar]
		if {$NbTFA=="0"} {
		    AjouteAuLog "Query: $QueryVar is not a sequence in fasta format."
		} elseif {$NbTFA=="1"} {
		    LesParametresDuDesign Query $QueryVar "Positionne"
		} else {
		    set  Return [CheckTFAFile $QueryVar]
		    if {$Return != ""} {
			#On a un multi fasta
			LesParametresDuDesign Query           "Reset"
			LesParametresDuDesign Query "$Return" "Positionne"
			set QueryVar [LesParametresDuDesign Query "LaValeurMerci"]
		    }
		}
	    } else {
		#On a plusieurs fichiers
		set LesMauvais ""
		foreach Q $QueryVar {
		    set  NbTFA  "0"
		    set  NbTFA  [EstCeUnTFAOuUnTFAS $Q]
		    if {$NbTFA=="0"} {
			lappend LesMauvais $Q
		    }
		}
		if {$LesMauvais != ""} {
		    AjouteAuLog "Query: Be careful $LesMauvais seems not to be in single fasta format."
		}
		LesParametresDuDesign Query $QueryVar "Positionne"
	    }
	    AjouteAuLog "Query: $QueryVar"
	} else {
	    LesParametresDuDesign Query "Reset"
	    set Warning "Query must be a regular sequence file."
	    AjouteAuLog $Warning
	}
    }
    set_balloon $LQuery  "One or more single fasta sequence file"
    set_balloon $B3Query "Display sequence analysis (Tm and GC profile)\nand allows direct selection of designing areas"

    #2.2.1.2 Edge panel
    set FEdge   "$FParameters1.fedge"
    set  LEdge  "$FEdge.ledge"
    set  L2Edge "$FEdge.l2edge"
    set  L3Edge "$FEdge.l3edge"
    set  EEdge  "$FEdge.eedge"
    set  E2Edge "$FEdge.e2edge"
    set  BEdge  "$FEdge.bedge"
    set  B2Edge "$FEdge.b2edge"
    set  B3Edge "$FEdge.b3edge"

    frame  $FEdge  -background "#808080"             -relief "groove"
    label  $LEdge  -background "#808FFF" -width "10" -relief "groove" -text "Begin" -anchor "w"
    label  $L2Edge -background "#808FFF" -width  "5" -relief "groove" -text "End"   -anchor "center"
    label  $L3Edge -background "#808FFF"             -relief "groove" -text ""      -anchor "w"
    entry  $EEdge  -justify    "center"  -width  "5" -textvariable EdgeBegin
    entry  $E2Edge -justify    "center"  -width  "5" -textvariable EdgeEnd 
    button $B2Edge -background "yellow"  -padx   "2"                  -text "Add"   -command {
	if {$EdgeBegin!="" && $EdgeEnd!=""} {
	    if {$EdgeBegin=="" || $EdgeBegin<="0"} {set EdgeBegin 1}
	    if {$EdgeEnd  =="" || $EdgeEnd  <="0"} {set EdgeEnd 1000000}

	    set LesZonesExistantes [join [LesParametresDuDesign LesZones "LaValeurMerci"] " "]
	    LesParametresDuDesign LesZones [list $EdgeBegin $EdgeEnd] "Ajoute"
	    AjouteAuLog "New designing area $EdgeBegin $EdgeEnd added to previous: $LesZonesExistantes"
	} else {
	    set Warning "Begin and End of design are options."
	    AjouteAuLog $Warning
	}
    }
    button $B3Edge -background "yellow"  -padx "2"                    -text "Reset" -command {
	LesParametresDuDesign LesZones "Reset"
	set Warning "Own specific designing areas reset to null."
	AjouteAuLog $Warning
    }
    button $BEdge  -background "yellow"  -padx "2"                    -text "OK"    -command {
	if {$EdgeBegin!="" && $EdgeEnd!=""} {
	    if {$EdgeBegin=="" || $EdgeBegin<="0"} {set EdgeBegin 1}
	    if {$EdgeEnd  =="" || $EdgeEnd  <="0"} {set EdgeEnd 1000000}

	    if {$EdgeBegin>$EdgeEnd || $EdgeBegin==$EdgeEnd} { 
		set Warning "Please enter a regular value for Begin and End:\n\t0<Begin<End and 0<End>Begin"
		AjouteAuLog $Warning
		set EdgeEnd   ""
		set EdgeBegin ""
	    } else {
		LesParametresDuDesign LesZones                            "Reset"
		LesParametresDuDesign LesZones [list $EdgeBegin $EdgeEnd] "Ajoute"
		AjouteAuLog "Design from $EdgeBegin to $EdgeEnd"
	    }
	} else {
	    set Warning "Begin and End of design are options."
	    AjouteAuLog $Warning
	}
    } 
    set_balloon $LEdge  "Starting Point of a restricted design area\nWill be used if no specific area for query is set."
    set_balloon $L2Edge "Ending Point of a restricted the design area\nWill be used if no specific area for query is set."

    #2.2.1.3 Taille panel
    set FTaille   "$FParameters1.ftaille"
    set  LTaille  "$FTaille.ltaille"
    set  L2Taille "$FTaille.l2taille"
    set  ETaille  "$FTaille.etaille"
    set  BTaille  "$FTaille.btaille"

    frame  $FTaille  -background "#808080"  -relief "groove"
    label  $LTaille  -background "#808FFF"  -relief "groove" -text "Length" -width "10" -anchor "w"
    label  $L2Taille -background "#808FFF"  -relief "groove" -text "nucleotide(s)"      -anchor "w"
    entry  $ETaille  -justify    "center"   -width  "5"      -textvariable LengthVar
    button $BTaille  -background "yellow"   -padx "2"        -text   "OK"   -command {
	if {$LengthVar!=""} {
	    if {$LengthVar>100 | $LengthVar<=0} {
		set Warning "Please enter a regular value for Length\nLength: 0<Length<=100"
		AjouteAuLog $Warning
	    } else {
		    LesParametresDuDesign LengthOligo $LengthVar "Positionne"
		AjouteAuLog "Length: $LengthVar nt(s)"	
	    }
	} else { 
	    LesParametresDuDesign LengthOligo "Reset"
	    set Warning "Choose one value for Length."
	    AjouteAuLog $Warning
	}
    }
    set_balloon $LTaille "Length of Oligo (between 1 and 100 nt)"

    #2.2.1.4 NombreOligo panel
    set FNbOligo   "$FParameters1.fnboligo"
    set  LNbOligo  "$FNbOligo.lnboligo"
    set  L2NbOligo "$FNbOligo.l2nboligo"
    set  ENbOligo  "$FNbOligo.enboligo"
    set  BNbOligo  "$FNbOligo.bnboligo"

    frame  $FNbOligo  -background "#808080" -relief "groove"
    label  $LNbOligo  -background "#808FFF" -relief "groove" -text "Number" -width "10" -anchor "w"
    label  $L2NbOligo -background "#808FFF" -relief "groove" -text "oligonucleotide(s)" -anchor "w"
    entry  $ENbOligo  -justify    "center"  -width  "5"      -textvariable NbOligoVar
    button $BNbOligo  -background "yellow"  -padx   "2"      -text "OK"     -command {
	if {$NbOligoVar!=""} {
	    if {$NbOligoVar>1000000 | $NbOligoVar<=0} {
		set Warning "Please enter a regular value for the Number of Oligo to design \nNbOligo: 0<NbOligo<=1000000"
		AjouteAuLog $Warning
	    } else {
		LesParametresDuDesign NbOligo $NbOligoVar "Positionne"
		AjouteAuLog "NbOligo: $NbOligoVar oligo(s)"	
	    }
	} else {
	    LesParametresDuDesign NbOligo "Reset"
	    set Warning "Choose one value for NbOligo."
	    AjouteAuLog $Warning
	}
    }
    set_balloon $LNbOligo "Number of desired Oligo to keep (between 1 and 1000000, default set to 100)"

