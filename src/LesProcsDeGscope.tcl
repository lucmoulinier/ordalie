proc ::Taxo::getLineage {input {name id} {reverse {}}} {

	set order "ASC"
	if {$reverse ne ""} {
		set order "DESC"
	}
	set field [identifyInput $input]
	set JOIN ""
	if {[regexp -nocase -- {name} $field]} { set JOIN "INNER JOIN name AS n ON n.taxon_id = t.id" }
	set sql	"SELECT parent.id, nparent.name, r.name
			FROM taxon AS t
			  INNER JOIN taxon AS parent ON t.l BETWEEN parent.l AND parent.r
			  $JOIN
			  INNER JOIN name AS nparent ON (nparent.taxon_id = parent.id AND nparent.current)
			  LEFT OUTER JOIN rank AS r ON r.id = parent.rank_id
			WHERE $field = \$1
			ORDER BY parent.l $order"
	set rows [DB::queryPg [getConn] $sql [list [string tolower $input]]]
	return [formatData $rows $name]

}

