proc JeuDeJrn {id j} {

    set type [set ::Defs(TypeJeu)]
    set ddeb [set ::Defs(iDateDeb)]
    set dfin [set ::Defs(iDateFin)]
    set sais [set ::Defs(Saison)]

    set pkjrn [PKDeJrn $id $j]
    set Lmtch [$::Brt eval {select eq1,eq2 from match where pk_journee = $pkjrn}]
    set Lpkjeu {}
    puts "\npkjrn >$pkjrn< pkjeu"
    foreach {e1 e2} $Lmtch {
	set pk [$::Brt eval {select j.pk_jeu from jeu as j, grille as g where  g.eqDom = $e1 and  g.eqExt = $e2 and  g.ligue = $id and  g.idate > $ddeb and  g.idate < $dfin and  g.pk_jeu = j.pk_jeu and  j.type = $type}]
	
	set pk [$::Brt eval {select pk_jeu from grille where  eqDom = $e1 and  eqExt = $e2 and  jrn = $j}]
	
	puts "$pk | $e1 $e2 $id $type"
	if {$pk == {}} {
	    set pk -1
	}
	lappend Lpkjeu {*}$pk
    }
    set Lpkjeu [DenombreLaListe $Lpkjeu]
    set pkjeu [lindex [lindex $Lpkjeu 0] 0]
    
    return $pkjeu

}

