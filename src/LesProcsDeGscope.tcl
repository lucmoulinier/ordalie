proc VerifieSiTousLes1954blast {RepBlast FichierDesPABs FichierSortie} {

    foreach Fichier [glob -nocomplain -directory $RepBlast "DD*"] {
	if {[regexp "old" $Fichier]} {continue}
	set DD [file tail $Fichier]
	Espionne $DD
	set Vu($DD) 1
    }
    set L [CreeListePourFichierAUneColonne $FichierDesPABs]
    Espionne [llength $L]
    set Liste ""
    foreach Nom $L {
	if {![info exists Vu($Nom)]} {lappend Liste $Nom}
    }
    Espionne "nb pabs des 1954 absents dans $RepBlast: [llength $Liste]"
    SauveLesLignes $Liste dans $FichierSortie

}

