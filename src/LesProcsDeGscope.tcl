proc ::Taxo::_getGeneric {input what} {

	set field [identifyInput $input t q]
	set JOIN ""
	if {[regexp -nocase -- {name} $field]} { set JOIN "INNER JOIN name AS q ON q.taxon_id = t.id" }
	set sql "SELECT t.id, n.name, r.name
			FROM taxon AS t
			  INNER JOIN name AS n ON (n.taxon_id = t.id AND n.current)
			  $JOIN
			  LEFT OUTER JOIN rank AS r ON r.id = t.rank_id
			WHERE $field = \$1"
	set rows [DB::queryPg [getConn] $sql [list [string tolower $input]]]
	return [lindex [formatData $rows $what] 0]

}

proc ::Taxo::buildMinimalTree {taxids {field id}} {

	set lineages {}
	foreach t $taxids {
		set l [Taxo::getLineage $t $field]
		if {$l ne ""} {
			lappend lineages [Taxo::getLineage $t $field]
		}
	}
	if {[llength $lineages] == 0} {
		return ""
	}
	return [buildMinimalTreeFromLineages $taxids $lineages $field]

}

proc ::Taxo::buildMinimalTreeFromLineages {required_nodes lineages {field id}} {

	set ROOT 1
	if {$field eq "name"} {
		set ROOT root
	}

	package require struct::tree
	set t mytree
	::struct::tree $t
	if {$ROOT ne "root"} {
		$t rename root $ROOT
	}

	foreach l $lineages {
		set parent $ROOT

		foreach node $l {
			if {$node == $ROOT} continue

			$t insert $parent end $node
			set parent $node
		}
	}
	# Remove superfluous branch nodes (with only one child)
	foreach node [$t nodes] {
		if {$node == $ROOT} continue
		if {$node in $required_nodes} continue

		if {[$t numchildren $node] == 1}  {
			# remove node
			set children [$t children $node]
			set parent [$t parent $node]
			$t move $parent end {*}$children
			$t delete $node
		}
	}
	set res [treeToNewick $t $ROOT]
	$t destroy
	return $res

}

proc ::Taxo::createIndexes {} {

	puts "Creating indexes"
		set sql "
ALTER TABLE update.taxon ADD CONSTRAINT pk_taxon PRIMARY KEY (id);
ALTER TABLE update.name ADD CONSTRAINT pk_name PRIMARY KEY (id);
ALTER TABLE update.rank ADD CONSTRAINT pk_rank PRIMARY KEY (id);

CREATE INDEX IF NOT EXISTS taxon_ix_rank ON update.taxon USING btree (rank_id);
CREATE INDEX IF NOT EXISTS taxon_ix_left ON update.taxon USING btree (l);
CREATE INDEX IF NOT EXISTS taxon_ix_right ON update.taxon USING btree (r);
CREATE INDEX IF NOT EXISTS taxon_ix_parent ON update.taxon USING btree (parent);
CREATE INDEX IF NOT EXISTS name_ix_taxon_id ON update.name USING btree (taxon_id);
CREATE INDEX IF NOT EXISTS name_ix_text_name ON update.name USING gin (to_tsvector('simple'::regconfig, name::text));
CREATE INDEX IF NOT EXISTS name_ix_lower_name ON update.name USING hash (LOWER(name));
CREATE INDEX IF NOT EXISTS rank_ix_lower_name ON update.rank USING hash (LOWER(name));
"
	DB::queryPg [getConn] $sql

}

proc ::Taxo::createSchema {} {

	lappend sqls "DROP SCHEMA IF EXISTS update CASCADE;"
	lappend sqls "CREATE SCHEMA IF NOT EXISTS update;"
	lappend sqls "
CREATE TABLE update.taxon
(
  id integer NOT NULL,
  rank_id smallint,
  l integer,
  r integer,
  parent integer
);
CREATE TABLE update.name
(
  id integer NOT NULL,
  taxon_id integer NOT NULL,
  name character varying(255),
  current boolean
);
CREATE TABLE update.rank
(
  id smallint NOT NULL,
  name character varying(32)
);
CREATE TABLE update.info
(
  id integer NOT NULL,
  key character varying(63) NOT NULL,
  value character varying(63)
);"
	foreach sql $sqls {
		DB::queryPg [getConn] $sql
	}

}

proc ::Taxo::formatData {data fields} {

	set fields [string tolower $fields]
	switch -- $fields {
		"" {
			set fields {id}
		}
		"both" {
			set fields {id name}
		}
		"all" {
			set fields {id name rank}
		}
	}
	set res {}
	foreach {id name rank} $data {
		set row {}
		if {"id" in $fields} {
			lappend row $id
		}
		if {"name" in $fields} {
			lappend row $name
		}
		if {"rank" in $fields} {
			lappend row $rank
		}
		lappend res $row
	}
	if {[llength $fields] == 1} {
		set res [join $res " "]
	}
	return $res

}

proc ::Taxo::get {input {quoi {}} {format {}} {reverse {}}} {

	set quoi [string tolower $quoi]
	if {[regexp -nocase {name|id} $quoi]} {
		set format $quoi
		set quoi ""
	}
	switch -nocase $quoi {
		"parent" {
			return [getParent $input $format]
		}
		"children" {
			return [getChildren $input $format]
		}
		"lineage" {
			return [getLineage $input $format $reverse]
		}
		"descendants" {
			return [getAllDescendants $input $format]
		}
		default {
			if {[string is int $input]} {
				if {[regexp -nocase {id$} $format]} {
					return $input
				}
				return [getName $input]
			} else {
				if {[string equal -nocase "name" $format]} {
					return [getName $input]
				}
				return [getId "$input"]
			}
		}
	}

}

proc ::Taxo::getAll input {

	return [_getGeneric $input "all"]

}

proc ::Taxo::getAllDescendantsExcept {id args} {

	set field [identifyInput $id]
	set output "id"
	if {[string equal -nocase "name" [lindex $args end]]} {
		set output "name"
		set args [lreplace $args end end]
	}

	set sql1 "SELECT node.$output
	FROM taxon AS node, taxon AS parent"
	set sql2 "WHERE node.l > parent.r
		AND node.l < parent.l
		AND parent.$field = \$1"

	set i 1
	foreach e $args {
		append sql1 ", taxon AS parent[incr i]"
		set field [identifyInput $e]
		append sql2 " AND parent$i.$field = \$$i AND (node.l < parent$i.l OR node.r > parent$i.r)"
	}
	set sql "$sql1 $sql2"

	set rows [DB::queryPg [getConn] $sql $id [string tolower $args]]
	return $rows

}

proc ::Taxo::getChildren {input {name id}} {

	set field [identifyInput $input]
	set sql "SELECT tchild.id, nchild.name, r.name
			FROM taxon AS t
			  INNER JOIN taxon AS tchild ON tchild.parent = t.id
			  INNER JOIN name AS n ON n.taxon_id = t.id
			  INNER JOIN name AS nchild ON (nchild.taxon_id = tchild.id AND nchild.current)
			  LEFT OUTER JOIN rank AS r ON r.id = tchild.rank_id
			WHERE $field = \$1"
	set rows [DB::queryPg [getConn] $sql [list [string tolower $input]]]
	return [formatData $rows $name]

}

proc ::Taxo::getConn {} {

	package require Pgtcl

	if {$Taxo::conn == "" || ![regexp $::Taxo::conn [pg_dbinfo connections $::Taxo::conn]]} {
		set Taxo::conn [pg_connect -conninfo "host=ena dbname=taxonomy user=kress password="]
	}
	return $::Taxo::conn

}

proc ::Taxo::getDataVersion {} {

