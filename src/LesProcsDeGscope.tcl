proc ChargeFichierLocalisation {aTabLoc Fichier {ChromosomeOuContigDeRef {}} {LesNoms {}}} {

    if {![file exists $Fichier]} {return}
    upvar $aTabLoc TabLoc
    foreach NomDeRef $LesNoms {set TabNom($NomDeRef) 1}
    set F [open $Fichier]
    while {[gets $F Ligne]>=0} {
	set LaLigne   [split $Ligne "\t"]
	set n         [llength LaLigne]

	###########Charge################
	set Nom              [lindex $LaLigne 0 ]
	if {$Nom == ""}                                    {continue}
	if {$LesNoms != {} && ![info exists TabNom($Nom)]} {continue}

	set Chrom            [lindex $LaLigne 9 ]
	set Cont             [lindex $LaLigne 13]
	if {$ChromosomeOuContigDeRef != ""} {
	    if {$Chrom != $ChromosomeOuContigDeRef && $Cont != $ChromosomeOuContigDeRef} {continue}
	}

	set InfoLoc           [lindex $LaLigne 1 ]
	set TabLoc($Fichier,$Nom,InfoLoc) $InfoLoc
	if {    $InfoLoc != "MonoLoc"      &&  $InfoLoc != "MayBePolyLoc" &&  $InfoLoc != "PolyLoc"      } {
	    continue
	}

	set     LesInfos  [lrange $LaLigne 0 18]
	lappend LesInfos  [split [lindex $LaLigne 19] " "]
	lappend LesInfos  [lindex $LaLigne 20]
	lappend LesInfos  [lindex $LaLigne 21]

	if {![info exists TabLoc($Fichier,Chromosome,$Chrom,LesNoms)]} {set TabLoc($Fichier,Chromosome,$Chrom,LesNoms) {}}
	if {![info exists TabLoc($Fichier,Contig,$Cont,LesNoms)     ]} {set TabLoc($Fichier,Contig,$Cont,LesNoms)      {}}
	if {![info exists TabLoc($Fichier,Chromosome,$Chrom,$Nom)]} {
	    lappend TabLoc($Fichier,Chromosome,$Chrom,LesNoms) $Nom
	    set TabLoc($Fichier,Chromosome,$Chrom,$Nom)    {}
	}
	if {![info exists TabLoc($Fichier,LesNoms)]}  {set     TabLoc($Fichier,LesNoms) {}  }
	if {![info exists TabLoc($Fichier,Nom,$Nom)]} {lappend TabLoc($Fichier,LesNoms) $Nom}

	if {![info exists TabLoc($Fichier,Contig,$Cont,$Nom)     ]} {
	    lappend TabLoc($Fichier,Contig,$Cont,LesNoms)      $Nom
	    set     TabLoc($Fichier,Contig,$Cont,$Nom)         {}
	}
	lappend TabLoc($Fichier,Chromosome,$Chrom,$Nom) $LesInfos	
	lappend TabLoc($Fichier,Contig,$Cont,$Nom)      $LesInfos
	lappend TabLoc($Fichier,Nom,$Nom)               $LesInfos	
    }

    close $F
    return $aTabLoc

}

proc ChargeFichierMapViewer {aTab FichierMV nChromo} {

    upvar $aTab Tab
    if {![file exists $FichierMV]} {return}
    set NameFichierMV [file tail $FichierMV]
    if {![info exists Tab($NameFichierMV,LesChromosomes)]} {set Tab($NameFichierMV,LesChromosomes) {}}
    set F [open $FichierMV]
    while {[gets $F Ligne]>=0} {
	set Ligne [string trim $Ligne]
	if {$Ligne == ""} {continue}
	if {[string index $Ligne 0] == "#"} {continue}

	set LesInfos [split $Ligne "\t"]

	set TaxonId [lindex $LesInfos 0]
	if {$TaxonId != 9606} {
	    set LesInfos [linsert $LesInfos 0 "9606"]
	}
	set Chromosome [string toupper [string trim [lindex $LesInfos 1]]]
	set Pos  [string first "|" $Chromosome]
	if {-1 < $Pos} {
	    set Sens 0
	    set Chromosome [string range $Chromosome 0 [expr $Pos-1]]
	} else {
	    set Sens       [string trim [lindex $LesInfos 4]]
	    if {$Sens == 0} {set Sens "?"}
	}
	if {![string equal -nocase $nChromo $Chromosome]} {continue}
	set Info [string trim [lindex $LesInfos 5]]
	if {[string equal -nocase $Info "start"] || [string equal -nocase $Info "end"]} {continue}

	if {[string trim [lindex $LesInfos 4]] == "-" || [string trim [lindex $LesInfos 4]] == "+"} {set Pos 5 } 
	if {[string trim [lindex $LesInfos 8]] == "-" || [string trim [lindex $LesInfos 8]] == "+"} {set Pos 9 } 
	if {[string trim [lindex $LesInfos 9]] == "-" || [string trim [lindex $LesInfos 9]] == "+"} {set Pos 10}

	set Debut      [string trim [lindex $LesInfos 2]]
	set Fin        [string trim [lindex $LesInfos 3]]
	set Taille     [expr abs($Fin - $Debut) + 1]

	set WhoIsIt  [string trim [lindex $LesInfos $Pos]]
	set LesInfos [lrange $LesInfos $Pos end]

	if {![info exists Tab($NameFichierMV,Chromosome,$Chromosome,LesElements)]} {
	    set Tab($NameFichierMV,Chromosome,$Chromosome,LesElements) {}
	    lappend Tab($NameFichierMV,LesChromosomes) $Chromosome
	}
	if {![info exists Tab($NameFichierMV,Chromosome,$Chromosome,Element,$WhoIsIt,LesLocalisations) ]} {
	    lappend Tab($NameFichierMV,Chromosome,$Chromosome,LesElements) $WhoIsIt
	    set Tab($NameFichierMV,Chromosome,$Chromosome,Element,$WhoIsIt,LesLocalisations) {}
	}
	lappend Tab($NameFichierMV,Chromosome,$Chromosome,Element,$WhoIsIt,LesLocalisations) [list $WhoIsIt $LesInfos $Chromosome $Debut $Fin $Taille $Sens]
    }

    close $F
    return $aTab

}

proc ChargeFichierOutRepeatMasker {aTab FichierOUT} {

    upvar $aTab Tab

    set Tab($FichierOUT,LesRepeats)         {}
    set Tab($FichierOUT,LesRegionsMasquees) {}

    set F [open $FichierOUT]
    while {[gets $F Ligne]>=0} {
	set Ligne [string trim $Ligne]
	if {![regexp {^[0-9]} $Ligne]} {continue}
	regsub -all {[ ]+} $Ligne " " Ligne
	set LaLigne [split $Ligne " "]
	
	set Debut          [lindex $LaLigne 5]
	set Fin            [lindex $LaLigne 6]
	set Repeat         [lindex $LaLigne 9]

	lappend Tab($FichierOUT,LesRepeats)         $Repeat
	lappend Tab($FichierOUT,LesRegionsMasquees) [list $Debut $Fin]
	set     Tab($FichierOUT,Debut,$Debut,Fin,$Fin,Repeat) $Repeat
	
	if {![info exists Tab($FichierOUT,Repeat,$Repeat,LesRegions)]} {set Tab($FichierOUT,Repeat,$Repeat,LesRegions) {}}
	lappend Tab($FichierOUT,Repeat,$Repeat,LesRegions) [list $Debut $Fin]
    }
    close $F
    return $aTab

}

proc ChargeFoldDesSequences aTableau {

    upvar $aTableau Tableau
    global RepertoireDuGenome
    set FichierFold "$RepertoireDuGenome/fiches/FoldExpression"
    if {![file exists $FichierFold]} {
	Espionne "$FichierFold does not exist."
	foreach Nom [ListeDesPABs] {set Tableau($Nom) 0}
	return $aTableau
    }
    foreach Ligne [LesLignesDuFichier $FichierFold] {
	if {![regexp -nocase {[0-9a-z]} $Ligne]} {continue}
	scan $Ligne "%s %s" Nom Fold 
	set Tableau($Nom) $Fold
    }
    return $aTableau

}

proc ChargeGCCount {{PAB {}}} {

    
    Wup "Calcul le GC pour les regions de la query"
    
    global TabDesGCs
    
    if {$PAB==""} {return ""}
      
    #Attention il faut une query, sinon pas de taille ....
    set RepmRNA   "[RepertoireDuGenome]/mrnatfa_Homo_sapiens"
    set Repnuctfa "[RepertoireDuGenome]/nuctfa"

    set FichierQuery $PAB
    if {[regexp {/} $PAB]} {set PAB [file tail $PAB]}
    if {[file exists $FichierQuery]} {
	set FichierQuery $FichierQuery
    } elseif { [file exists "$RepmRNA/$PAB"]} {
	set FichierQuery    "$RepmRNA/$PAB"
    } elseif  {[file exists "$Repnuctfa/$PAB"]} {
	set FichierQuery    "$Repnuctfa/$PAB"
    } else {
	set  LaSeq      $PAB
	if {         $LaSeq ==""}   {Espionne "$FichierQuery no sequence available";return ""}
	if {[IsItDNA $LaSeq]=="-1"} {Espionne "$LaSeq is not a valid DNA sequence";return ""}
	set TailleQuery [string length $LaSeq]
    }
    
    if {! [info exists LaSeq]} {
	set  LaSeq      [QueLaSequenceDuFichierTFA $FichierQuery]
	if {$LaSeq==""} {Espionne "$FichierQuery no sequence available";return ""}
	set TailleQuery [string length $LaSeq]
    }
    set  LaSeq [split $LaSeq ""]

    if {! [info exists TabDesGCs(GCMin)]}     {set TabDesGCs(GCMin)  99999.9}
    if {! [info exists TabDesGCs(GCMax)]}     {set TabDesGCs(GCMax)      0.0}
    if {! [info exists TabDesGCs(GCMoyenne)]} {set TabDesGCs(GCMoyenne)  0.0} 
    if {! [info exists TabDesGCs(GCTotal)]}   {set TabDesGCs(GCTotal)    0.0} 
    if {! [info exists TabDesGCs(NbGC)]}      {set TabDesGCs(NbGC)         0} 
    if {! [info exists TabDesGCs(NbSeq)]}     {set TabDesGCs(NbSeq)        0} 
    
    incr TabDesGCs(NbSeq)

    set nbGC         0
    set GCTotal    0.0
    set DebutSeq     1

    set  LengthOligo [LesParametresDuDesign LengthOligo "LaValeurMerci"]
    if {$LengthOligo==""} {set LengthOligo 60}

    set  Pas         [LesParametresDuDesign Step "LaValeurMerci"]
    if {$Pas        ==""} {set Pas 10}

    set Fin         $LengthOligo
    #Calcul de la moyenne sur une sliding window de taille Facteur et de pas j
    for {set Debut $DebutSeq} {$Fin <= $TailleQuery} {incr Debut $Pas} {
	set Fin [expr $Debut + $LengthOligo - 1] 
	if {![expr $Fin <= $TailleQuery]}          {break}
		
	set Seq [join [lrange $LaSeq [expr $Debut - 1] [expr $Fin - 1]] ""]
	set  TailleSeq [string length $Seq]
	if {$TailleSeq<$LengthOligo}     {continue}

	set GC [format "%.1f" [expr ([NombreDeBaseDe $Seq "G|C"]*100.0)/$TailleSeq]]
	if {$GC=="-1"} {continue} elseif {$GC==""} {return ""}	

	if {! [info exists TabDesGCs($GC)]} {
	    set  TabDesGCs($GC) 1
	} else {
	    incr TabDesGCs($GC)
	}
	incr nbGC
	set GCTotal [expr $GCTotal + $GC]
	
	if {$GC > [set TabDesGCs(GCMax)]} {set TabDesGCs(GCMax) $GC}
	if {$GC < [set TabDesGCs(GCMin)]} {set TabDesGCs(GCMin) $GC}
    }

    #Pour la Moyenne des GCs
    if {[set TabDesGCs(GCTotal)]!="0.0"} {
	set  TabDesGCs(GCTotal) [expr [set TabDesGCs(GCTotal)] + $GCTotal]
    } else {
	set  TabDesGCs(GCTotal) $GCTotal
    } 
    if {[set TabDesGCs(NbGC)]!="0"} {
	set  TabDesGCs(NbGC) [expr [set TabDesGCs(NbGC)] + $nbGC]
    } else {
	set  TabDesGCs(NbGC) $nbGC
    } 

    if {0} {
	#Moyenne des GCs
	set Moyennetmp [format "%.1f" [expr ($GCTotal*1.0)/$nbGC]]
	if {[set TabDesGCs(GCMoyenne)]!="0.0"} {
	    set TabDesGCs(GCMoyenne) [format "%.1f" [expr (([set TabDesGCs(GCMoyenne)] + $Moyennetmp)*1.0)/2.0] ]
	} else {
	    set TabDesGCs(GCMoyenne) $Moyennetmp
	}
    }

    return ""

}

proc ChargeGeneName {aTab FichierGeneName} {

    upvar $aTab Tab
    set Tab(LesGeneNames) {}

    if {![file exists $FichierGeneName]} {return}

    set Tab(LesNoms) {}
    set F [open $FichierGeneName]
    while {[gets $F Ligne]>=0} { 
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne "\t"]
	set Nom     [lindex $LaLigne 0]
	set Acc     [lindex $LaLigne 1]
	if {$Acc == "Nothing"} {continue}
	set GeneName  [string tolower [lindex $LaLigne 3]]

	if {![info exists Tab($Nom,LesGeneNames)]} {
	    lappend Tab(LesNoms)                             $Nom
	    set Tab($Nom,LesGeneNames)                       {}
	    set Tab($Nom,LesProteines)                       {}
	}
	if {![info exists Tab(Protein,$Acc,LesGeneNames)]} {
	    set Tab(Protein,$Acc,LesGeneNames)               {}
	    set Tab(Protein,$Acc,LesNoms)                    {}
	}
	if {![info exists Tab(GeneName,$GeneName,LesNoms)]} {
	    set     Tab(GeneName,$GeneName,LesNoms)          {}
	    set     Tab(GeneName,$GeneName,LesProteines)     {}
	    set     Tab(GeneName,$GeneName,n)                0
	    lappend Tab(LesGeneNames)                        $GeneName
	}
	incr Tab(GeneName,$GeneName,n)

	if {![info exists Tab($Nom,GeneName,$GeneName,n)]} {
	    set Tab($Nom,GeneName,$GeneName,n)               0
	    set Tab($Nom,GeneName,$GeneName,LesProteines)    {}
	    lappend Tab($Nom,LesGeneNames)                   $GeneName
	    lappend Tab(GeneName,$GeneName,LesNoms)          $Nom
	}
	incr Tab($Nom,GeneName,$GeneName,n)

	if {![info exists Tab($Nom,GeneName,$GeneName,Protein,$Acc,n)]} {
	    set     Tab($Nom,GeneName,$GeneName,Protein,$Acc,n) 0
	    lappend Tab($Nom,GeneName,$GeneName,LesProteines)   $Acc
	}
	incr Tab($Nom,GeneName,$GeneName,Protein,$Acc,n)

	if {![info exists Tab(Protein,$Acc,GeneName,$GeneName,n)]} {
	    set Tab(Protein,$Acc,GeneName,$GeneName,n)      0
	    lappend Tab(Protein,$Acc,LesGeneNames)          $GeneName
	    lappend Tab(GeneName,$GeneName,LesProteines)    $Acc
	}
	incr Tab(Protein,$Acc,GeneName,$GeneName,n)
    }
    close $F
    return $aTab

}

proc ChargeGeneOntology {aTab FichierGeneOntology} {

    upvar $aTab Tab
    Wup "toujours faire un lsort -unique avec les sorties de cette procedure"

    if {![info exists Tab($FichierGeneOntology,LesOntologies)]} {
	set Tab($FichierGeneOntology,LesOntologies) {}
    }
    if {![info exists Tab($FichierGeneOntology,LesAccess)]} {
	set Tab($FichierGeneOntology,LesAccess) {}
    }
    set Tab($FichierGeneOntology,LesGroupes) {}
    set Tab($FichierGeneOntology,LesAccess)  {}
    set Tab($FichierGeneOntology,LesNoms)    {}
    set Tab($FichierGeneOntology,LesGO)      {}
    set Tab($FichierGeneOntology,LesTypes)   {}

    set F [open $FichierGeneOntology]
    while {[gets $F Ligne]>=0} { 
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne "\t"]
	
	set Nom         [lindex $LaLigne 0]
	set Groupe      [lindex $LaLigne 1]
	if {[string equal -nocase $Groupe "NoClusterFound"]} {continue}
	set Access      [lindex $LaLigne 2]
	if {[string equal -nocase $Access "NoProteinFound"]} {continue}

	if {![info exists Tab($FichierGeneOntology,Groupe,$Groupe,LesGO)]} {
	    lappend Tab($FichierGeneOntology,LesGroupes)                     $Groupe
	    set Tab($FichierGeneOntology,Groupe,$Groupe,LesGO)               {}
	    set Tab($FichierGeneOntology,Groupe,$Groupe,LesTypes)            {}
	    set Tab($FichierGeneOntology,Groupe,$Groupe,LesAccess)           {}
	    set Tab($FichierGeneOntology,Groupe,$Groupe,LesNoms)             {}
	}
	if {![info exists Tab($FichierGeneOntology,Access,$Access,LesGO)]} {
	    lappend Tab($FichierGeneOntology,LesAccess)                      $Access
	    set Tab($FichierGeneOntology,Access,$Access,LesGO)               {}
	    set Tab($FichierGeneOntology,Access,$Access,LesTypes)            {}
	    set Tab($FichierGeneOntology,Access,$Access,LesGroupes)          {}
	    set Tab($FichierGeneOntology,Access,$Access,LesNoms)             {}
	}
	if {![info exists Tab($FichierGeneOntology,$Nom,LesGO)]} {
	    lappend Tab($FichierGeneOntology,LesNoms)                        $Nom
	    set Tab($FichierGeneOntology,$Nom,LesAccess)                     {}
	    set Tab($FichierGeneOntology,$Nom,LesTypes)                      {}
	    set Tab($FichierGeneOntology,$Nom,LesGroupes)                    {}
	    set Tab($FichierGeneOntology,$Nom,LesGO)                         {}
	}
	if {![info exists TabTmp(Groupe,$Groupe,Access,$Access)]} {
	    set TabTmp(Groupe,$Groupe,Access,$Access) 1
	    lappend Tab($FichierGeneOntology,Groupe,$Groupe,LesAccess)       $Access
	    lappend Tab($FichierGeneOntology,Access,$Access,LesGroupes)      $Groupe
	}
	if {![info exists Tab($FichierGeneOntology,$Nom,Access,$Access,LesGO)]} {
	    lappend Tab($FichierGeneOntology,Access,$Access,LesNoms)         $Nom
	    lappend Tab($FichierGeneOntology,$Nom,LesAccess)                 $Access
	    set     Tab($FichierGeneOntology,$Nom,Access,$Access,Groupe)     $Groupe
	    set     Tab($FichierGeneOntology,$Nom,Access,$Access,LesGO)      {}
	}
	if {![info exists  Tab($FichierGeneOntology,$Nom,Groupe,$Groupe,LesGO)]} {
	    lappend Tab($FichierGeneOntology,Groupe,$Groupe,LesNoms)         $Nom
	    lappend Tab($FichierGeneOntology,$Nom,LesGroupes)                $Groupe
	    set     Tab($FichierGeneOntology,$Nom,Groupe,$Groupe,LesGO)      {}
	    set     Tab($FichierGeneOntology,$Nom,Groupe,$Groupe,LesAccess)  {}
	}

	###Ceux qui ont une ontologie##############
	set Type        [lindex $LaLigne 3]
	if {[string equal -nocase $Type   "NoOntologyFound"] || $Type == ""} {continue}
	set GO          [lindex $LaLigne 4] 
	
	if {![info exists TabTmp(Type,$Type)]} {
	    set     TabTmp(Type,$Type)                                            1
	    lappend Tab($FichierGeneOntology,LesTypes)                            $Type
	}
	if {![info exists  TabTmp(Groupe,$Groupe,Type,$Type)]} {
	    set     TabTmp(Groupe,$Groupe,Type,$Type)                             1
	    lappend Tab($FichierGeneOntology,Groupe,$Groupe,LesTypes)             $Type
	}
	if {![info exists  TabTmp($Nom,Type,$Type)]} {
	    set     TabTmp($Nom,Type,$Type)                                       1
	    lappend Tab($FichierGeneOntology,$Nom,LesTypes)                       $Type
	}
	if {![info exists  TabTmp(Access,$Access,Type,$Type)]} {
	    set     TabTmp(Access,$Access,Type,$Type)                             1
	    lappend Tab($FichierGeneOntology,Access,$Access,LesTypes)             $Type
	}

	if {![info exists Tab($FichierGeneOntology,GO,$GO,LaDefinition)]} {
	    set Def [list [lindex $LaLigne 5]]
	    set Tab($FichierGeneOntology,GO,$GO,LaDefinition)                     $Def
	    set Tab($FichierGeneOntology,LaDefinition,$Def,GO)                    $GO
	    set Tab($FichierGeneOntology,GO,$GO,LesAncetres)                      [lrange $LaLigne 6 end]
	    set Tab($FichierGeneOntology,GO,$GO,Type)                             $Type
	    set Tab($FichierGeneOntology,GO,$GO,n)                                0
	    set Tab($FichierGeneOntology,GO,$GO,LesAccess)                        {}
	    set Tab($FichierGeneOntology,GO,$GO,LesNoms)                          {}
	    set Tab($FichierGeneOntology,GO,$GO,LesGroupes)                       {}
	    lappend Tab($FichierGeneOntology,LesGO)                               $GO
	}

	if {![info exists  Tab($FichierGeneOntology,Groupe,$Groupe,GO,$GO,n)]} {
	    set Tab($FichierGeneOntology,Groupe,$Groupe,GO,$GO,n)                 0
	    lappend Tab($FichierGeneOntology,Groupe,$Groupe,LesGO)                $GO
	    lappend Tab($FichierGeneOntology,GO,$GO,LesGroupes)                   $Groupe
	}
	if {![info exists  Tab($FichierGeneOntology,$Nom,GO,$GO,n)]} {
	    set Tab($FichierGeneOntology,$Nom,GO,$GO,n)                           0
	    set Tab($FichierGeneOntology,$Nom,GO,$GO,LesAccess)                   {}
	    set Tab($FichierGeneOntology,$Nom,GO,$GO,LesGroupes)                  {}
	    lappend Tab($FichierGeneOntology,$Nom,LesGO)                          $GO
	    lappend Tab($FichierGeneOntology,GO,$GO,LesNoms)                      $Nom
	}
	if {![info exists  TabTmp(Access,$Access,GO,$GO)]} {
	    set TabTmp(Access,$Access,GO,$GO)                                     1
	    lappend Tab($FichierGeneOntology,Access,$Access,LesGO)                $GO
	    lappend Tab($FichierGeneOntology,GO,$GO,LesAccess)                    $Access
	}

	if {![info exists TabTmp($Nom,Groupe,$Groupe,Access,$Access)]} {
	    set     TabTmp($Nom,Groupe,$Groupe,Access,$Access)                        1
	    lappend Tab($FichierGeneOntology,$Nom,Groupe,$Groupe,LesAccess)           $Access
	}
	if {![info exists Tab($FichierGeneOntology,$Nom,Groupe,$Groupe,GO,$GO,n)]} {
	    set     Tab($FichierGeneOntology,$Nom,Groupe,$Groupe,GO,$GO,n)            0
	    lappend Tab($FichierGeneOntology,$Nom,Groupe,$Groupe,LesGO)               $GO
	    lappend Tab($FichierGeneOntology,$Nom,GO,$GO,LesGroupes)                  $Groupe
	}

	incr Tab($FichierGeneOntology,$Nom,Groupe,$Groupe,GO,$GO,n)
	incr Tab($FichierGeneOntology,GO,$GO,n)
	incr Tab($FichierGeneOntology,Groupe,$Groupe,GO,$GO,n)
	incr Tab($FichierGeneOntology,$Nom,GO,$GO,n)
	lappend Tab($FichierGeneOntology,$Nom,Access,$Access,LesGO)               $GO
	lappend Tab($FichierGeneOntology,$Nom,GO,$GO,LesAccess)                   $Access
    }
    close $F
    if {[info exists TabTmp]} {unset TabTmp}

    return $aTab

}

proc ChargeGenomeKEGG {aTab Fichier} {

    upvar $aTab Tab
    set F [open $Fichier]

    set Tab(LesOrgaCourts) {}
    set Tab(LesOrganismes) {}
    set Tab(LesTaxonId)    {}
    while {[gets $F Ligne]>=0} {
	if {$Ligne == ""} {continue}
	if {[regexp "^ENTRY   " $Ligne]} {
	    set OrgaC [StringApres ENTRY dans $Ligne]
	    lappend Tab(LesOrgaCourts) $OrgaC
	    continue
	}
	if {[regexp "^DEFINITION  " $Ligne tmp def]} {
	    set Orga [string trim [StringSuivant "DEFINITION" dans $Ligne]]
	    lappend  Tab(LesOrganismes)         $Orga
	    set Tab(OrgaCourt,$OrgaC,Organisme) $Orga
	    set Tab(Organisme,$Orga,OrgaCourt)  $OrgaC
	    continue
	}
	if {[regexp "^TAXONOMY   " $Ligne]} {
	    set Tax [IntegerApres "TAX:" dans $Ligne]
	    lappend Tab(LesTaxonId)           $Tax
	    set Tab(Organisme,$Orga,TaxonId)  $Tax
	    set Tab(TaxonId,$Tax,Organisme)   $Orga
	    set Tab(OrgaCourt,$OrgaC,TaxonId) $Tax
	    set Tab(TaxonId,$Tax,OrgaCourt)   $OrgaC
	    continue
	}
    }
    close $F
    return $aTab

}

proc ChargeKEGG {aTab Fichier} {

    upvar $aTab Tab

    set SuisJeSurLaDef      0
    set SuisJeSurLePathway  0
    set SuisJeSurLesGenes   0
    set SuisJeSurLesLiens   0
    set Tab(LesKegg) {}
    set F [open $Fichier]
    Espionne $Fichier
    while {[gets $F Ligne]>=0} {
	if {$Ligne == ""} {continue}
	if {[regexp "^ENTRY   " $Ligne]} {
	    set KeggNumber [StringApres ENTRY dans $Ligne]
	    lappend Tab(LesKegg) $KeggNumber
	    continue
	}
	if {[regexp "^NAME   " $Ligne]} {
	    if {[regexp {E([0-9\.\-]+)} $Ligne tmp EC]} {
		if {![info exists Tab(Kegg,$KeggNumber,LiensTmp)]} {
		    set    Tab(Kegg,$KeggNumber,LiensTmp) "EC: $EC"
		} else {
		    append Tab(Kegg,$KeggNumber,LiensTmp) " EC: $EC"
		}
	    }
	    continue
	}
	if {$SuisJeSurLaDef} {
	    if {[regexp "^     " $Ligne]} {
		append Tab(Kegg,$KeggNumber,Definition) " [string trim $Ligne]"
		continue
	    } else {
		set SuisJeSurLaDef      0
	    }
	}
	if {[regexp "^DEFINITION  " $Ligne]} {
	    set SuisJeSurLaDef 1
	    set Tab(Kegg,$KeggNumber,Definition) [string trim [StringSuivant "DEFINITION  " dans $Ligne]]
	    
	    continue
	}
	if {$SuisJeSurLePathway} {
	    if {[regexp "^     " $Ligne]} {
		append Tab(Kegg,$KeggNumber,PathwayTmp) " [string trim $Ligne]"
		continue
	    } else {
		set SuisJeSurLePathway 0	
	    }

	}
	if {[regexp "^CLASS  " $Ligne]} {
	    set SuisJeSurLePathway 1
	    set Tab(Kegg,$KeggNumber,PathwayTmp) [string trim [StringSuivant "CLASS  " dans $Ligne]]
	    continue
	}
	if {$SuisJeSurLesLiens} {
	    if {[regexp "^     " $Ligne]} {
		append Tab(Kegg,$KeggNumber,LiensTmp) " [string trim $Ligne]"
		continue
	    } else {
		set SuisJeSurLesLiens 0
	    }
	}
	if {[regexp "^DBLINKS  " $Ligne]} {
	    set SuisJeSurLesLiens 1
	    if {![info exists Tab(Kegg,$KeggNumber,LiensTmp)]} {
		set Tab(Kegg,$KeggNumber,LiensTmp) [string trim [StringSuivant "DBLINKS  " dans $Ligne]]
	    } else {
		append Tab(Kegg,$KeggNumber,LiensTmp) " [string trim [StringSuivant "DBLINKS  " dans $Ligne]]"
	    }
	    continue
	}

	if {$SuisJeSurLesGenes} {
	    if {[regexp "^     " $Ligne]} {
		append Tab(Kegg,$KeggNumber,GenesTmp) " [string trim $Ligne]"
		continue
	    } else {
		set SuisJeSurLesGenes 0
	    }
	}
	if {[regexp "^GENES  " $Ligne]} {
	    set SuisJeSurLesGenes 1
	    set Tab(Kegg,$KeggNumber,GenesTmp) [string trim [StringSuivant "GENES  " dans $Ligne]]
	    continue
	}
    }
    close $F
    set Tab(LesPathway)    {}
    set Tab(LesLiens)      {}
    set Tab(LesOrganismes) {}
    foreach KeggNumber [lsort -unique [set Tab(LesKegg)]] {
	if {![info exists Tab(Kegg,$KeggNumber,PathwayTmp)]} {continue}
	if {![info exists Tab(Kegg,$KeggNumber,GenesTmp)  ]} {continue}

	if {[info exists Tab(Kegg,$KeggNumber,Definition)]} {
	    set Definition                       [set Tab(Kegg,$KeggNumber,Definition)]
	    set Tab(Definition,$Definition,Kegg) $KeggNumber
	}

	set Tab(Kegg,$KeggNumber,LesPathway) {}
	if {[info exists Tab(Kegg,$KeggNumber,PathwayTmp)]} {
	    foreach Pathway [split [string trim [set Tab(Kegg,$KeggNumber,PathwayTmp)]] "\]"] {
		### Modif par Nicolas Gagniere le 05/07/2007
		#set Pos                     [string last "\[" $Pathway]

		#set DefPathway [string trim [string range $Pathway 0 [expr $Pos-1]]]
		#set Pathway    [string trim [string range $Pathway [expr $Pos+8] end]]
		#if {$DefPathway == ""} {continue}
		if {![regexp {(.*)\[PATH:ko(\d+)} $Pathway regMatch DefPathway Pathway]} {continue}
		set DefPathway [string trim $DefPathway] 
		if {![info exists Tab(Pathway,$Pathway,LesKegg)]} {
		    set     Tab(Pathway,$Pathway,LesKegg)       {}
		    set     Tab(Pathway,$Pathway,LesOrganismes) {}
		    set     Tab(Pathway,$Pathway,Definition)    $DefPathway
		    set     Tab(Definition,$Definition,Pathway) $Pathway
		    lappend Tab(LesPathway)                     $Pathway 
		}
		lappend Tab(Kegg,$KeggNumber,LesPathway) $Pathway
	    }
	    unset Tab(Kegg,$KeggNumber,PathwayTmp)
	}
	set Tab(Kegg,$KeggNumber,LesOrganismes) {}
	if {[info exists Tab(Kegg,$KeggNumber,GenesTmp)]} {
	    foreach Elet [split [string trim [set Tab(Kegg,$KeggNumber,GenesTmp)]] " "] {
		if {$Elet == ""} {continue}
		if {[regexp -nocase {^([a-z]{3}):$} $Elet tmp OrgaC]} {
		    set     OrgaC [string tolower $OrgaC]
		    set     Organisme                           [InterrogeGenomeKEGG OrgaCourt $OrgaC Organisme]
		    lappend Tab(Kegg,$KeggNumber,LesOrganismes) $Organisme

		    if {![info exists TabTmp($Organisme)]} {
			set     TabTmp($Organisme) 1
			lappend Tab(LesOrganismes) $Organisme
		    }
		    if {![info exists Tab(Organisme,$Organisme,LesKegg)]} {
			set Tab(Organisme,$Organisme,LesKegg)    {}
			set Tab(Organisme,$Organisme,LesPathway) {}
		    }
		    lappend Tab(Organisme,$Organisme,LesKegg) $KeggNumber

		    foreach Pathway [set Tab(Kegg,$KeggNumber,LesPathway)] {
			if {[info exists TabTmp($Organisme,$Pathway)]} {continue}
			set TabTmp($Organisme,$Pathway) 1
			lappend Tab(Organisme,$Organisme,LesPathway) $Pathway
			lappend Tab(Pathway,$Pathway,LesOrganismes)  $Organisme
		    }
		    set Tab(Kegg,$KeggNumber,Organisme,$Organisme,LesEnzymes) {}
		} else {
		    set Pos [string first "(" $Elet]
		    if {$Pos < 0} {set Pos "end"} else {set Pos [expr $Pos - 1]}
		    set     Enzyme [string range $Elet 0 $Pos]

		    if {![info exists Tab(Organisme,$Organisme,Enzyme,$Enzyme,LesKegg)]} {
			set Tab(Organisme,$Organisme,Enzyme,$Enzyme,LesKegg) {}
		    }

		    if {![info exists TabTmp(Organisme,$Organisme,Enzyme,$Enzyme,Kegg,$KeggNumber)]} {
			set     TabTmp(Organisme,$Organisme,Enzyme,$Enzyme,Kegg,$KeggNumber) 1
			lappend Tab(Organisme,$Organisme,Enzyme,$Enzyme,LesKegg)             $KeggNumber
		    }
		    lappend Tab(Kegg,$KeggNumber,Organisme,$Organisme,LesEnzymes) $Enzyme
		}
	    }
	    unset Tab(Kegg,$KeggNumber,GenesTmp)
	}
	set Tab(Kegg,$KeggNumber,LesLiens) {}
	if {[info exists Tab(Kegg,$KeggNumber,LiensTmp)  ]} {
	    foreach Elet [split [string trim [set Tab(Kegg,$KeggNumber,LiensTmp)]] " "] {
		if {$Elet == ""} {continue}
		if {[info exists TabTmp($KeggNumber,$Elet)]} {continue}
		if {[regexp -nocase ":" $Elet]} {continue}
		set TabTmp($KeggNumber,$Elet) 1

		lappend Tab(Kegg,$KeggNumber,LesLiens) $Elet
		if {![info exists Tab(Lien,$Elet,LesKegg)]} {
		    set     Tab(Lien,$Elet,LesKegg) {}
		    lappend Tab(LesLiens)           $Elet
		}
		lappend     Tab(Lien,$Elet,LesKegg) $KeggNumber
	    }
	    unset Tab(Kegg,$KeggNumber,LiensTmp)
	}
    }
    if {[info exists TabTmp]} {unset TabTmp}
    return $aTab

}

proc ChargeLaClassificationTaxonomique aTabTaxon {

    upvar $aTabTaxon TabTaxon

    global RepertoireDuGenome
    set FichierTaxon "[RepTaxonomie]/ClassificationTaxonomique"
    set F [open $FichierTaxon]
    set NMax 0

    set LesTaxons {}
    while {[gets $F Ligne]>=0} {
	set LaLigne [split [string trim $Ligne] "\t"]

	set Niveau  [lindex $LaLigne 0]
	if {$NMax < $Niveau} {set NMax $Niveau}
	if {$Niveau < 2} {set LesTaxonsDeRef {}} else {set LesTaxonsDeRef [lrange $LesTaxonsDeRef 0 [expr $Niveau - 2]]}

	set     Taxon     [lindex $LaLigne 1]
	lappend LesTaxons $Taxon

	set IndexTaxons [join [linsert $LesTaxonsDeRef end $Taxon] "," ]

	if {[info exists TabTmp($IndexTaxons)]} {continue} else {set TabTmp($IndexTaxons) 1}

	set TabTaxon($Taxon,Niveau) $Niveau

	set IndexTaxonsDeRef [join $LesTaxonsDeRef ","]
	if {![info exist TabTaxon($IndexTaxonsDeRef,LesDescendants)]} {set TabTaxon($IndexTaxonsDeRef,LesDescendants) {}}
	lappend TabTaxon($IndexTaxonsDeRef,LesDescendants) $Taxon

	lappend LesTaxonsDeRef $Taxon

	if {![info exist TabTaxon($Taxon,LesPhylums)]} {set TabTaxon($Taxon,LesPhylums) {}}
	set TabTaxon($Taxon,LesPhylums) [concat [set TabTaxon($Taxon,LesPhylums)] $LesTaxonsDeRef]
    }
    if {[info exists TabTmp]} {unset TabTmp}
    close $F

    set TabTaxon(LesTaxons) $LesTaxons
    set TabTaxon(NbNiveaux) $NMax

    return $aTabTaxon

}

proc ChargeLesARNs {} {

    global RepertoireDuGenome
    global ListeDeBoites
    global ListeDesARNs

    set ListeDesARNs {}

    if {[file exists "$RepertoireDuGenome/fiches/bornesdesarns"]} {
	set LesBornes [LesLignesDuFichier "$RepertoireDuGenome/fiches/bornesdesarns"]
	set LireDansBornes 1
    } else {
	if { ! [OnTraiteUnGenome]} { return {}}
	if { ! [file isdirectory "$RepertoireDuGenome/arndir"] &&  [glob -nocomplain "$RepertoireDuGenome/fiches/*arn*"]=={}} { return {}}
 	if { ! [OuiOuNon "Y a t-il un fichier ARN quelque part ?" 0]} { return {} }
	set FichierARN [ButineArborescence All]
	if {$FichierARN == ""} { return {} }
	set LesBornes [LesLignesDuFichier "$FichierARN"]
	set LireDansBornes 0
    }

    foreach Ligne $LesBornes {
	if {$LireDansBornes} {
	    ExtraireDe $Ligne Nom Debut Fin Orient
	} else {
	    if { ! [regexp {\:} $Ligne]} { continue }
	    scan $Ligne "%s %s %d %s %d" Nom dp Debut Moins Fin
	    set Nom "ARN$Nom"

	    set Orient "F"
	    if { [expr $Fin < $Debut] } {
		set Temp  $Debut
		set Debut $Fin
		set Fin   $Temp
		set Orient "R"
	    }
	}

	if {[regexp {\-([0-9]+)$} $Debut Match D] && [regexp {\-([0-9]+)$} $Fin Match F]} {
	    #rR on traite le cas Chr01-12345 Chr01-12389
	    set Long  [expr $F-$D+1]
	} else {
	    set Long  [expr $Fin-$Debut+1]
	}
	set Frame [NomDeLaFrame ARN $Orient]
	
	set  Boite        $Nom
	Box $Boite nom    $Nom
	Box $Boite orient $Orient
	Box $Boite frame  $Frame
	Box $Boite debut  $Debut
	Box $Boite fin    $Fin
	Box $Boite long   $Long
	
	lappend ListeDeBoites $Boite
	lappend ListeDesARNs $Nom
    }

}

proc ChargeLesBestHitInDatabase {aInfoDatabase FichierBlast} {

    Wup "Permet de verifier si la query a un access dans le blast et de le rendre"
    Wup "Retourne l access et le BId si c un peu juste"

    upvar $aInfoDatabase InfoDatabase

    if {! [file exists $FichierBlast]} {set InfoDatabase($FichierBlast,NotDone) 1;return "-2"}

    set BId          ""
    set AccessDeRef  ""

    #Charge les resultats du Blast
    ##############################
    set SeuilId      "None"
    set TailleQuery  [AskBlast $FichierBlast Taille]
    set NbSubject    [AskBlast $FichierBlast NbSubject]

    set InfoDatabase($FichierBlast,LesBIdsBases) ""
    #Test de la presence de la Query dans le blast
    ##############################################
    if {$NbSubject>0} {
	set LesBIdsBases ""

	#Faut il mettre une limite au nombre de hit utilises pour la recherche du meilleur hit ?
	set  NbSubjectLimit 150
	if {$NbSubject>$NbSubjectLimit} {set NbSubject $NbSubjectLimit}

	for {set i 1} {$i <=$NbSubject} {incr i} {
	    set BId [AskBlast $FichierBlast Subject $i]
	    #On se debarrasse des NG car pas bon dans NombreDeBasesEnCommun et PourcentageDIdentiteGlobal 
	    #il reconstruit le contig en entier
	    if {[regexp {NG[0-9]+} $BId]} {continue}

	    set NbBasesCommuns   [NombreDeBasesEnCommun $FichierBlast $BId "Query"]
	    
	    lappend LesBIdsBases [list $BId $NbBasesCommuns]
	}
	set InfoDatabase($FichierBlast,LesBIdsBases) $LesBIdsBases
	if {$LesBIdsBases ==""} {
	    set BId         ""
	    set AccessDeRef ""
	} else {
 	    set LesBIdsBases  [lsort -integer -index 1 -decreasing $LesBIdsBases]
	    set BId           [lindex [lindex $LesBIdsBases 0] 0]
	    set PIdentity     0.95
	    set PRecouvrement 0.70
	
	    set InfoDatabase($FichierBlast,InitialBId)   $BId
	    set InfoDatabase($FichierBlast,$BId,Aligned) [lindex [lindex $LesBIdsBases 0] 1]
	
	    #Pourcentage d identite global: Aligne sur Total dans les alignements 
	    set IdGlobal      [PourcentageDIdentiteGlobal $FichierBlast $BId]
	    #Recouvrement de Q sur S ou inversement
	    #PCoverQuery   Query   par rapport au Subject
	    #PCoverSubject Subject par rapport au Query
	    set PCoverQuery   [PourcentageDeRecouvrement $FichierBlast $BId   "Query"]
	    set PCoverSubject [PourcentageDeRecouvrement $FichierBlast $BId "Subject"]

	    set InfoDatabase($FichierBlast,IdGlobal)      $IdGlobal
	    set InfoDatabase($FichierBlast,PCoverQuery)   $PCoverQuery
	    set InfoDatabase($FichierBlast,PCoverSubject) $PCoverSubject
	    
	    if {$IdGlobal <= $PIdentity || $PCoverQuery<$PRecouvrement || $PCoverSubject<$PRecouvrement} {
		set AccessDeRef ""
		if {($PCoverQuery <= 0.20 || $PCoverSubject <= 0.20) || $IdGlobal <= 0.90} {
		    #On met tout de meme a zero car trop limite
		    set BId     ""
		}
		#On conserve BId pour les cas litigieux
	    } else {
		set AccessDeRef $BId
	    }
	}
    } else {
	set AccessDeRef ""
    }

    set InfoDatabase($FichierBlast,AccessDeRef) $AccessDeRef
    set InfoDatabase($FichierBlast,BId)         $BId        
    return ""

}

proc ChargeLesCodonsStart {} {

    global LesCodonsStart
    global LesAAsStart

    foreach Boite [ListeDesPABs] {
	set Nom    [Box $Boite nom]
	set Debut  [Box $Boite debut]
	set Fin    [Box $Boite fin]
	set Orient [Box $Boite orient]

	if { $Orient == "F" } {
	    set Codon [BoutADN $Debut [expr $Debut+2] $Orient]
	} else {
	    set Codon [BoutADN [expr $Fin-2] $Fin $Orient]
	}
	set Codon [string toupper $Codon]                       ; #rR 2017/11/06
	set LesCodonsStart($Nom) $Codon
	set LesAAsStart($Nom) [AAduCodon $Codon]
    }

}

proc ChargeLesGLIMMERs {} {

    global ListeDeBoites
    global ListeDesGLIMMERs
    set ListeDesGLIMMERs {}

    set FichierBornesDesGlimmers "[RepertoireDuGenome]/fiches/bornesdesglimmers"
    if { ! [file exists $FichierBornesDesGlimmers]} { return $ListeDesGLIMMERs }

    set LesBornes [LesLignesDuFichier $FichierBornesDesGlimmers]
    foreach Ligne $LesBornes {
	if { ! [regexp "GLIMMER" $Ligne] } { continue }
	
	ExtraireDe $Ligne Nom Debut Fin Orient
	
	set Long  [expr $Fin-$Debut+1]
	set Frame [NomDeLaFrame [expr $Debut%3] $Orient]
	
	set  Boite        $Nom
	Box $Boite nom    $Nom
	Box $Boite orient $Orient
	Box $Boite frame  $Frame
	Box $Boite debut  $Debut
	Box $Boite fin    $Fin
	Box $Boite long   $Long
	lappend ListeDeBoites $Boite
	lappend ListeDesGLIMMERs $Nom
    }

    return $ListeDesGLIMMERs

}

proc ChargeLesGO {{Type {}} {Options {}} {Density {}} {CheeseOrTree Tree}} {

    set Expect  "1e-30"
    set NbSbjct "10"

    global LesAccessPourLeGO
    global LesProjGscopePourLeGO
    global LesBoxGscopePourLeGO
    global LesBlastPPourLeGO
    global LesGOPourLeGO
    global LesRequetesPourLeGO
    global LesFichiersDPC2GO

    if {$Type == ""} {set Type [ChoixParmi [LesTypesOntologiques]]}
    if {$Options == ""} {set Options "JustMyGO"}

    ChargeLesGODeLAccess        $LesAccessPourLeGO
    ChargeLesGODuProjet         $LesProjGscopePourLeGO
    ChargeLesGODeLaBoiteGscope  $LesBoxGscopePourLeGO
    ChargeLesGODuBlast          $LesBlastPPourLeGO 
    ChargeLesGODeLaRequete      $LesRequetesPourLeGO 
    ChargeLesGODuGO             $LesGOPourLeGO 
    ChargeLesGODuDPC2GO         $LesFichiersDPC2GO

    if {    $LesAccessPourLeGO      != {} ||  $LesProjGscopePourLeGO  != {} ||  $LesBoxGscopePourLeGO   != {} ||  $LesBlastPPourLeGO      != {} ||  $LesRequetesPourLeGO    != {} ||  $LesFichiersDPC2GO      != {} } {
	if {$CheeseOrTree == "Tree"} {
	    IllustreOntology $Type $Options $Density
	} else {
	    IllustreLeCamembertOntologique $Type
	}
    } else {
	IllustreOntology $Type
    }
    return ""

}

proc ChargeLesGODeLAccess LesAccess {

    set TousLesGO {}
    foreach Access $LesAccess {
	foreach GO [Access2GO $Access] {
	    if {$GO == "" || [info exists TabTmp($GO)]} {continue}
	    
	    set Type [Onto $GO Type]
	    OntoMesGOSet $Type $Access 1

	    if {![OntoMesGOExists $Type LesGO]} {OntoMesGOSet $Type LesGO {}}
	    OntoMesGOAppend $Type LesGO $GO
	    
	    set LesAncetres  [TousLesAncetresOntologiques $Type $GO]
	    
	    OntoMesGOSet $GO Type           $Type
	    OntoMesGOSet $Type $GO          1
	    OntoMesGOSet $Type $GO Color    "green"
	    OntoMesGOSet $Type $GO Ancetres $LesAncetres
	    
	    if {![OntoMesGOExists $Type $GO LesAccess]} {
		OntoMesGOSet $Type $GO LesAccess {}
	    }
	    if {![OntoMesGOExists $Type $GO $Access]} {
		OntoMesGOAppend $Type $GO LesAccess $Access
		OntoMesGOSet $Type $GO $Access 1
	    }
	    foreach Ancetre $LesAncetres {
		if {![OntoMesGOExists $Type $Ancetre LesAccess]} {
		    OntoMesGOSet $Type $Ancetre LesAccess {}
		}
		if {![OntoMesGOExists $Type $Ancetre $Access]} {
		    OntoMesGOAppend $Type $Ancetre LesAccess $Access
		    OntoMesGOSet $Type $Ancetre $Access 1
		}
		
		OntoMesGOSet $Type $Ancetre          1
		OntoMesGOSet $Type Ancetre $Ancetre Color "green"
		if {[info exists TabTmp($Ancetre)]} {continue}
		set TabTmp($Ancetre) 1
		lappend TousLesGO $Ancetre
	    }
	    lappend TousLesGO $GO
	    set TabTmp($GO) 1
	}
    }

    ChargeLesGONothing LesAccess $LesAccess

    OntoMesGOSet TousLesGO $TousLesGO 

    if {[info exists TabTmp]} {unset TabTmp}
    return ""

}

proc ChargeLesGODeLaBoiteGscope LesNomsDesBoites {

    global RepertoireDuGenome 

    if {$LesNomsDesBoites == ""} {return}
    set FichierGO [ChoixParmi [glob -nocomplain "[RepertoireDuGenome]/fiches/GeneOntolog*"]]
    if {![file exists $FichierGO]} {return}

    set LesTypes  {}
    set TousLesGO {}

    set F [open $FichierGO]
    while {[gets $F Ligne]>=0} {
	set Ligne [string trim $Ligne]
	if {$Ligne == ""} {continue}
	set LaLigne [split $Ligne "\t"]

	set GO          [lindex $LaLigne 2]
	if {[string equal -nocase "GO:" [string range $GO 0 2]]} {
	    set Type [lindex $LaLigne 1]
	    if {$Type == "NoProteinFound" || $Type == "NoOntologyFound"} {continue}
	    set Def         [lindex $LaLigne 3]
	    set LesAncetres [lrange $LaLigne 4 end]	    
	} else {
	    set Cluster [lindex $LaLigne 1]
	    if {$Cluster == "NoClusterFound"} {continue}
	    set Access  [lindex $LaLigne 2]
	    if {$Access  == "NoProteinFound"} {continue}
	    set Type [lindex $LaLigne 3]
	    if {$Type  == "NoOntologyFound"} {continue}
	    set GO   [lindex $LaLigne 4]
	    set Def  [lindex $LaLigne 5]
	    set LesAncetres [lrange $LaLigne 6 end]
	}
	set Nom  [lindex $LaLigne 0]

	foreach NomBoite $LesNomsDesBoites {
	    if {$NomBoite == ""} {continue}
	    if {$Nom != $NomBoite} {continue}

	    if {![OntoMesGOExists $Type LesGO]} {OntoMesGOSet $Type LesGO {};lappend LesTypes $Type}
	    OntoMesGOAppend $Type LesGO     $GO
	    OntoMesGOSet    $GO   Type      $Type
	    OntoMesGOSet    $Type $GO       1
	    OntoMesGOSet    $Type $GO       Color    "green"
	    OntoMesGOSet    $Type $GO       Ancetres $LesAncetres
	    OntoMesGOSet    $Type $NomBoite 1
	    
	    if {![OntoMesGOExists $Type $GO LesNoms]} {OntoMesGOSet $Type $GO LesNoms {}}
	    if {[info exists Access]} {
		if {![OntoMesGOExists $Type $GO LesAccess]} {OntoMesGOSet $Type $GO LesAccess {}}
		if {![OntoMesGOExists $Type $GO $Access]} {
		    OntoMesGOAppend $Type $GO LesAccess $Access
		    OntoMesGOSet $Type $GO $Access 1
		}
	    }
	    if {![OntoMesGOExists $Type $GO $Nom]} {
		OntoMesGOAppend $Type $GO LesNoms $Nom
		OntoMesGOSet $Type $GO $Nom 1
	    }
	    foreach Ancetre $LesAncetres {
		if {![OntoMesGOExists $Type $Ancetre LesNoms]} {
		    OntoMesGOSet $Type $Ancetre LesNoms {}
		}
		if {![OntoMesGOExists $Type $Ancetre $Nom]} {
		    OntoMesGOAppend $Type $Ancetre LesNoms          $Nom
		    OntoMesGOSet $Type $Ancetre $Nom          1
		}
		if {[info exists Access]} {
		    if {![OntoMesGOExists $Type $Ancetre LesAccess]} {OntoMesGOSet $Type $Ancetre LesAccess {}}
		    if {![OntoMesGOExists $Type $Ancetre $Access]} {
			OntoMesGOAppend $Type $Ancetre LesAccess $Access
			OntoMesGOSet $Type $Ancetre $Access 1
		    }
		}

		OntoMesGOSet $Type $Ancetre          1
		OntoMesGOSet $Type Ancetre $Ancetre Color "green"
		if {[info exists TabTmp($Ancetre)]} {continue}
		set TabTmp($Ancetre) 1
		lappend TousLesGO $Ancetre
	    }
	    lappend TousLesGO $GO
	    set TabTmp($GO) 1
	}
    }
    close $F

    ChargeLesGONothing LesNoms $LesNomsDesBoites

    OntoMesGOSet TousLesGO $TousLesGO 

    if {[info exists TabTmp]} {unset TabTmp}

    return

}

proc ChargeLesGODeLaRequete LesRequetes {

    set TousLesGO {}

    foreach Requete $LesRequetes {
	foreach GO [Interroge2GO $Requete] {
	    set GO [string toupper $GO]
	    if {$GO == "" || [info exists TabTmp($GO)]} {continue}
	    
	    set Type [Onto $GO Type]
	    OntoMesGOSet $Type $Requete 1

	    if {![OntoMesGOExists $Type LesGO]} {OntoMesGOSet $Type LesGO {}}

	    OntoMesGOAppend $Type LesGO $GO
	    
	    set LesAncetres  [TousLesAncetresOntologiques $Type $GO]
	    
	    OntoMesGOSet $GO Type           $Type
	    OntoMesGOSet $Type $GO          1
	    OntoMesGOSet $Type $GO Color    "green"
	    OntoMesGOSet $Type $GO Ancetres $LesAncetres
	    
	    if {![OntoMesGOExists $Type $GO LesRequetes]} {
		OntoMesGOSet $Type $GO LesRequetes {}
	    }
	    if {![OntoMesGOExists $Type $GO $Requete]} {
		OntoMesGOAppend $Type $GO LesRequetes $Requete
		OntoMesGOSet $Type $GO $Requete 1
	    }
	    
	    foreach Ancetre $LesAncetres {
		if {![OntoMesGOExists $Type $Ancetre LesRequetes]} {
		    OntoMesGOSet $Type $Ancetre LesRequetes {}
		}
		if {![OntoMesGOExists $Type $Ancetre $Requete]} {
		    OntoMesGOAppend $Type $Ancetre LesRequetes $Requete
		    OntoMesGOSet $Type $Ancetre $Requete 1
		}
		
		OntoMesGOSet $Type $Ancetre          1
		OntoMesGOSet $Type Ancetre $Ancetre Color "green"
		if {[info exists TabTmp($Ancetre)]} {continue}
		set TabTmp($Ancetre) 1
		lappend TousLesGO $Ancetre
	    }
	    lappend TousLesGO $GO
	    set TabTmp($GO) 1
	}
    }

    ChargeLesGONothing LesRequetes $LesRequetes

    OntoMesGOSet TousLesGO $TousLesGO 

    if {[info exists TabTmp]} {unset TabTmp}
    return ""

}

proc ChargeLesGODuBlast {LesFichiers {Expect 1e-10} {NbSubject 20}} {

    set TousLesGO {}
    set TousLesGOFunction  {}
    set TousLesGOProcess   {}
    set TousLesGOComponent {}

    foreach Fichier $LesFichiers {
	if {![file exists $Fichier]} {Warne "$Fichier does not exist";continue}
	
	if {[OntoExists $Fichier]} {return}
	OntoSet $Fichier 1
	
	set LesHits     [LesHitsDuBlast_FC   $Fichier $Expect $NbSubject]
	if {$LesHits == {}} {
	    set LesHits [LesHitsDuBallast_FC $Fichier]
	}
	foreach LeHit $LesHits {
	    set BId    [lindex $LeHit 0]
	    set Access [lindex $LeHit 1]
	    
	    Espionne "$BId $Access"
	    
	    ChargeLesGODeLAccess $Access
	    set TousLesGO [concat $TousLesGO [OntoMesGO TousLesGO]]
	    
	    if {[OntoMesGOExists function LesGO]} {
		set TousLesGOFunction [concat $TousLesGOFunction [OntoMesGO function LesGO]]
	    }
	    if {[OntoMesGOExists process LesGO]} {
		set TousLesGOProcess [concat $TousLesGOProcess [OntoMesGO process LesGO]]
	    }
	    if {[OntoMesGOExists component LesGO]} {
		set TousLesGOComponent [concat $TousLesGOComponent [OntoMesGO component LesGO]]
	    }
	}
	
	foreach Type [LesTypesOntologiques] {
	    if {![OntoMesGOExists $Type LesGO]} {continue}
	    foreach GO [OntoMesGO $Type LesGO] {
		if {![OntoMesGOExists $Type $GO LesBlastP]} {
		    OntoMesGOSet $Type $GO LesBlastP {}
		}
		if {![OntoMesGOExists $Type $GO $Fichier]} {
		    OntoMesGOAppend $Type $GO LesBlastP $Fichier
		    OntoMesGOSet $Type $GO $Fichier 1
		}
		set LesAncetres  [TousLesAncetresOntologiques $Type $GO]
		foreach Ancetre $LesAncetres {
		    if {![OntoMesGOExists $Type $Ancetre LesBlastP]} {
			OntoMesGOSet $Type $Ancetre LesBlastP {}
		    }
		    if {![OntoMesGOExists $Type $Ancetre $Fichier]} {
			OntoMesGOAppend $Type $Ancetre LesBlastP $Fichier
			OntoMesGOSet $Type $Ancetre $Fichier 1
		    }
		}
	    }
	}
    }

    if {$TousLesGOFunction  != {} } {OntoMesGOSet function LesGO  $TousLesGOFunction} 
    if {$TousLesGOProcess   != {} } {OntoMesGOSet process LesGO   $TousLesGOProcess  }
    if {$TousLesGOComponent != {} } {OntoMesGOSet component LesGO $TousLesGOComponent}
    
    OntoMesGOSet TousLesGO [ElimineLesRedondancesDansUneListe $TousLesGO]
    return

}

proc ChargeLesGODuDPC2GO {LesFichiersDPC2GO {Methode ID3}} {

    Wup "Options of Methode ID3 or None"

    set LesTypes {}

    if {$Methode == "ID3"} {
	foreach FichierDPC2GO $LesFichiersDPC2GO {
	    set F [open $FichierDPC2GO]
	    while {[gets $F Ligne]>=0} {
		set Ligne [string trim $Ligne]
		if {$Ligne == ""} {continue}
		set LaLigne [split $Ligne "\t"]
		
		set Type        [lindex $LaLigne     2]
		if {$Type == "NoOntologyFound"} {continue}
		if {![info exists TabTmp($Type)          ]} {lappend LesTypes $Type;set TabTmp($Type) 1}
		if {![info exists TabTmp($Type,TousLesGO)]} {set TabTmp($Type,TousLesGO)               {}}
		set Cluster     [lindex $LaLigne     0]
		set Access      [lindex $LaLigne     1]
		set GO          [lindex $LaLigne     3]
		set LesAncetres [lrange $LaLigne 5 end]	
		
		##INITIALISATION####
		if {![info exists TabTmp($Type,$GO,LesClusters)        ]} {
		    set           TabTmp($Type,$GO,LesClusters)        {}
		}
		if {![info exists TabTmp($Type,$GO,LesAccess)          ]} {
		    set           TabTmp($Type,$GO,LesAccess)          {}
		}
		if {![info exists TabTmp($Type,$GO,$Cluster,LesAccess) ]} {
		    set           TabTmp($Type,$GO,$Cluster,LesAccess) {}
		}
		##REMPLISSAGE######
		if {![info exists TabTmp($Type,$GO,$Cluster)           ]} {
		    lappend       TabTmp($Type,$GO,LesClusters)        $Cluster
		    set           TabTmp($Type,$GO,$Cluster)           1
		}
		if {![info exists TabTmp($Type,$GO,$Cluster,$Access)   ]} {
		    lappend       TabTmp($Type,$GO,$Cluster,LesAccess) $Access
		    set           TabTmp($Type,$GO,$Cluster,$Access)   1
		}
		if {![info exists TabTmp($Type,$GO,$Access)            ]} {
		    lappend       TabTmp($Type,$GO,LesAccess)          $Access
		    set           TabTmp($Type,$GO,$Access)            1
		}
		if {![info exists TabTmp($Type,$GO)                    ]} {
		    lappend       TabTmp($Type,TousLesGO)             $GO
		    set           TabTmp($Type,$GO)                    1
		}
		foreach Ancetre $LesAncetres {
		    ##INITIALISATION####
		    if {![info exists TabTmp($Type,$GO,LesClusters)             ]} {
			set           TabTmp($Type,$GO,LesClusters)             {}
		    }
		    if {![info exists TabTmp($Type,$GO,LesAccess)               ]} {
			set           TabTmp($Type,$GO,LesAccess)               {}
		    }
		    if {![info exists TabTmp($Type,$GO,$Cluster,LesAccess)      ]} {
			set           TabTmp($Type,$GO,$Cluster,LesAccess)      {}
		    }
		    ##REMPLISSAGE######
		    if {![info exists TabTmp($Type,$Ancetre,$Cluster)           ]} {
			lappend       TabTmp($Type,$Ancetre,LesClusters)        $Cluster
			set           TabTmp($Type,$Ancetre,$Cluster)           1
		    }
		    if {![info exists TabTmp($Type,$Ancetre,$Cluster,$Access)   ]} {
			lappend       TabTmp($Type,$Ancetre,$Cluster,LesAccess) $Access
			set           TabTmp($Type,$Ancetre,$Cluster,$Access)   1
		    }
		    if {![info exists TabTmp($Type,$Ancetre,$Access)            ]} {
			lappend       TabTmp($Type,$Ancetre,LesAccess)          $Access
			set           TabTmp($Type,$Ancetre,$Access)            1
		    }
		    if {![info exists TabTmp($Type,$Ancetre)                    ]} {
			lappend       TabTmp($Type,TousLesGO)                   $Ancetre
			set           TabTmp($Type,$Ancetre)                    1
		    }
		}
	    }
	    close $F
	}
	foreach Type $LesTypes {
	    foreach GO [set TabTmp($Type,TousLesGO)] {
		if {[OntoMesGOExists $Type $GO AverageEntropy]} {continue}
		
		set LesNbAccessDesClusters {}
		foreach Cluster [set TabTmp($Type,$GO,LesClusters)] {
		    lappend  LesNbAccessDesClusters [llength [set TabTmp($Type,$GO,$Cluster,LesAccess)]]
		}
		if {$LesNbAccessDesClusters == {} } {continue}
		set Entropy [Entropy $LesNbAccessDesClusters]

		set LesContributions [Onto   $Type $GO         LesContributions]
		set LesEnfants       [Onto   $Type $GO         LesEnfants      ]
		set LesDescendants   [concat $LesContributions $LesEnfants     ]
		
		if {$LesDescendants == {}} {continue}
		set NbAccessTot [llength [set TabTmp($Type,$GO,LesAccess)]]
		set LesNbAccessDesClustersDesDescendants {}
		set NbAccessDesBranches 0
		foreach Descendant $LesDescendants {
		    if {![info exists TabTmp($Type,$Descendant,LesAccess)]} {continue}
		    set NbAccessDeLaBranche [llength [set TabTmp($Type,$Descendant,LesAccess)]]
		    set NbAccessDesBranches [expr $NbAccessDesBranches + $NbAccessDeLaBranche]

		    set LesNbAccessDesClusters {}
		    foreach Cluster [set TabTmp($Type,$Descendant,LesClusters)] {
			lappend LesNbAccessDesClusters [llength [set TabTmp($Type,$Descendant,$Cluster,LesAccess)]]
		    }
		    if {$LesNbAccessDesClusters == {}} {continue}
		    lappend LesNbAccessDesClustersDesDescendants $LesNbAccessDesClusters
		}
		if {$LesNbAccessDesClustersDesDescendants == {}} {continue}
		set AverageEntropy [AverageEntropy $LesNbAccessDesClustersDesDescendants $NbAccessTot]

		set DivisionEntropy 0
		foreach Descendant $LesDescendants {
		    if {![info exists TabTmp($Type,$Descendant,LesAccess)]} {continue}
		    if {[set TabTmp($Type,$Descendant,LesAccess)] == {}} {continue}
		    set NbAccessDeLaBranche [llength [set TabTmp($Type,$Descendant,LesAccess)]]

		    set Pi [expr $NbAccessDeLaBranche * 1.0 / $NbAccessDesBranches]
		    set PiLnPi [expr -1 * $Pi * log($Pi)/log(2)]

		    set DivisionEntropy [expr $DivisionEntropy + $PiLnPi]
		}

		OntoMesGOSet $Type $GO DivisionEntropy $DivisionEntropy
		OntoMesGOSet $Type $GO AverageEntropy $AverageEntropy
		OntoMesGOSet $Type $GO Entropy        $Entropy
	    }
	}

	foreach Type $LesTypes {
	    foreach GO [set TabTmp($Type,TousLesGO)] {    
		set LesContributions [Onto   $Type $GO         LesContributions]
		set LesEnfants       [Onto   $Type $GO         LesEnfants      ]
		set LesDescendants   [concat $LesContributions $LesEnfants     ]
		if {$LesDescendants == {}} {continue}

		set AE [OntoMesGO $Type $GO AverageEntropy]

		if {$AE == ""} {continue}

		set E [OntoMesGO $Type $GO Entropy]
		if {$E == ""} {continue}
		set DE [OntoMesGO $Type $GO DivisionEntropy]
		if {$AE == 0 || $DE == 0} {continue}
		if {[expr $AE + $DE] < $E} {
		    Espionne "$GO $AE $DE $E"
		    OntoMesGOSet $Type $GO Color "pink"
		}

		if {0} {
		    set SommeAEDesc 0
		    set nDesc       0
		    foreach Descendant $LesDescendants {
			if {![info exists TabTmp($Type,$Descendant,LesAccess)]}  {continue}
			if {![OntoMesGOExists $Type $GO Entropy       ]}  {continue}
			set AEDesc [OntoMesGO $Type $Descendant Entropy]		    
			if { $AEDesc == "" || $AEDesc == 0} {continue}
			incr nDesc
			set SommeAEDesc [expr $SommeAEDesc + $AEDesc]
		    }
		    if {$nDesc == 0 || $SommeAEDesc == 0} {continue}
		    #set AEDescTot [expr $SommeAEDesc / $nDesc]
		    set AEDescTot $SommeAEDesc
		    if {$AEDescTot < $AE} {
			#Espionne "$GO $AE $AEDescTot"
			OntoMesGOSet $Type $GO Color "pink"
		    }
		}
	    }
	}
    }

    set TousLesGO {}
    foreach FichierDPC2GO $LesFichiersDPC2GO {
	set F [open $FichierDPC2GO]
	while {[gets $F Ligne]>=0} {
	    if {![regexp -nocase {[0-9a-z]} $Ligne]} {continue}
	    set LaLigne [split $Ligne "\t"]
	    
	    set Cluster     [lindex $LaLigne     0]
	    set Access      [lindex $LaLigne     1]
	    
	    set Type        [lindex $LaLigne     2]
	    if {$Type == "NoOntologyFound"} {continue}
	    
	    set GO          [lindex $LaLigne     3]
	    set Definition  [lindex $LaLigne     4]
	    set LesAncetres [lrange $LaLigne 5 end]	
	    
	    if {![OntoMesGOExists $Type LesGO]} {OntoMesGOSet $Type LesGO {}}
	    
	    OntoMesGOAppend $Type LesGO $GO
	    OntoMesGOSet    $GO   Type  $Type
	    OntoMesGOSet    $Type $GO   1
	    if {![OntoMesGOExists $Type $GO Color]} {OntoMesGOSet $Type $GO Color "green"}
	    OntoMesGOSet    $Type $GO   Ancetres $LesAncetres
	    
	    if {![OntoMesGOExists $Type $GO LesClusters]} {
		OntoMesGOSet $Type $GO LesClusters {}
	    }
	    if {![OntoMesGOExists $Type $GO $Cluster]} {
		OntoMesGOAppend $Type $GO LesClusters $Cluster
		OntoMesGOSet $Type $GO $Cluster 1
	    }
	    if {![OntoMesGOExists $Type $GO LesAccess]} {
		OntoMesGOSet $Type $GO LesAccess {}
	    }
	    if {![OntoMesGOExists $Type $GO $Access]} {
	    OntoMesGOAppend $Type $GO LesAccess $Access
		OntoMesGOSet $Type $GO $Access 1
	    }
	    foreach Ancetre $LesAncetres {
		if {![OntoMesGOExists $Type $Ancetre LesClusters]} {
		    OntoMesGOSet $Type $Ancetre LesClusters {}
		}
		if {![OntoMesGOExists $Type $Ancetre $Cluster]} {
		    OntoMesGOAppend $Type $Ancetre LesClusters $Cluster
		    OntoMesGOSet $Type $Ancetre $Cluster 1
		}
		if {![OntoMesGOExists $Type $Ancetre LesAccess]} {
		    OntoMesGOSet $Type $Ancetre LesAccess {}
		}
		if {![OntoMesGOExists $Type $Ancetre $Access]} {
		    OntoMesGOAppend $Type $Ancetre LesAccess $Access
		    OntoMesGOSet $Type $Ancetre $Access 1
		}
		OntoMesGOSet $Type $Ancetre          1
		if {![OntoMesGOExists $Type $GO Color]} {OntoMesGOSet $Type $GO Color "green"}

		if {[info exists TabTmp($Ancetre)]} {continue}
		set TabTmp($Ancetre) 1
		lappend TousLesGO $Ancetre
	    }
	    lappend TousLesGO $GO
	    set TabTmp($GO) 1
	}
	close $F
    }

    OntoMesGOSet TousLesGO $TousLesGO     
    if {[info exists TabTmp]} {unset TabTmp}

    return

}

proc ChargeLesGODuGO LesGO {

    set TousLesGO {}
    foreach GO $LesGO {
	set Type [Onto $GO Type]
	if {$Type == "" || [info exists TabTmp($GO)]} {continue}
	if {![OntoMesGOExists $Type LesGO]} {OntoMesGOSet $Type LesGO {}}
	OntoMesGOAppend $Type LesGO $GO
	
	set LesAncetres  [TousLesAncetresOntologiques $Type $GO]
	
	OntoMesGOSet $GO Type           $Type
	OntoMesGOSet $Type $GO          1
	OntoMesGOSet $Type $GO Color    "green"
	OntoMesGOSet $Type $GO Ancetres $LesAncetres
	
	foreach Ancetre $LesAncetres {
	    OntoMesGOSet $Type $Ancetre          1
	    OntoMesGOSet $Type Ancetre $Ancetre Color "green"
	    if {[info exists TabTmp($Ancetre)]} {continue}
	    set TabTmp($Ancetre) 1
	    lappend TousLesGO $Ancetre
	}
	lappend TousLesGO $GO
	set TabTmp($GO) 1
    }
    ChargeLesGONothing LesGO $LesGO
    OntoMesGOSet TousLesGO $TousLesGO
    if {[info exists TabTmp]} {unset TabTmp}
    return

}

proc ChargeLesGODuProjet LesProjetsGscope {

    global RepertoireDuGenome

    if {$LesProjetsGscope == ""} {return}

    set TousLesGO {}
    foreach ProjetGscope $LesProjetsGscope {
	if {$ProjetGscope == ""} {continue}
	set LesNomsDesBoites {} 

	set FichierGO [ChoixParmi [glob -nocomplain "[RepertoireDuGenome]/../$ProjetGscope/fiches/GeneOntolog*"]]
	if {![file exists $FichierGO]} {return}

	set F [open $FichierGO]
	while {[gets $F Ligne]>=0} {
	    set Ligne [string trim $Ligne]
	    if {$Ligne == ""} {continue}
	    set LaLigne [split $Ligne "\t"]

	    set Nom  [lindex $LaLigne 0]
	    lappend  LesNomsDesBoites $Nom

	    set GO          [lindex $LaLigne 2]
	    if {[string equal -nocase "GO:" [string range $GO 0 2]]} {
		set Type [lindex $LaLigne 1]
		if {$Type == "NoProteinFound" || $Type == "NoOntologyFound"} {continue}
		set Def         [lindex $LaLigne 3]
		set LesAncetres [lrange $LaLigne 4 end]	    
	    } else {
		set Cluster [lindex $LaLigne 1]
		if {$Cluster == "NoClusterFound"} {continue}
		set Access  [lindex $LaLigne 2]
		if {$Access  == "NoProteinFound"} {continue}
		set Type [lindex $LaLigne 3]
		if {$Type  == "NoOntologyFound"} {continue}
		set GO   [lindex $LaLigne 4]
		set Def  [lindex $LaLigne 5]
		set LesAncetres [lrange $LaLigne 6 end]
	    }
	    
	    OntoMesGOSet    $Type $Nom          1
	    OntoMesGOSet    $Type $ProjetGscope 1

	    if {![OntoMesGOExists $Type LesGO]} {OntoMesGOSet $Type LesGO {}}
	    OntoMesGOAppend $Type LesGO $GO
	    OntoMesGOSet $GO Type           $Type
	    OntoMesGOSet $Type $GO          1
	    OntoMesGOSet $Type $GO Color    "green"
	    OntoMesGOSet $Type $GO Ancetres $LesAncetres
	    
	    if {![OntoMesGOExists $Type $GO LesProjetsGscope]} {
		OntoMesGOSet $Type $GO LesProjetsGscope {}
	    }
	    if {![OntoMesGOExists $Type $GO LesNoms]} {
		OntoMesGOSet $Type $GO LesNoms {}
	    }
	    if {[info exists Access]} {
		if {![OntoMesGOExists $Type $GO LesAccess]} {OntoMesGOSet $Type $GO LesAccess {}}
		if {![OntoMesGOExists $Type $GO $Access]} {
		    OntoMesGOAppend $Type $GO LesAccess $Access
		    OntoMesGOSet $Type $GO $Access 1
		}
	    }
	    if {![OntoMesGOExists $Type $GO $ProjetGscope]} {
		OntoMesGOAppend $Type $GO LesProjetsGscope $ProjetGscope
		OntoMesGOSet $Type $GO $ProjetGscope 1
	    }
	    if {![OntoMesGOExists $Type $GO $Nom]} {
		OntoMesGOAppend $Type $GO LesNoms $Nom
		OntoMesGOSet $Type $GO $Nom 1
	    }
	    foreach Ancetre $LesAncetres {
		if {![OntoMesGOExists $Type $Ancetre LesProjetsGscope]} {
		    OntoMesGOSet $Type $Ancetre LesProjetsGscope {}
		}
		if {![OntoMesGOExists $Type $Ancetre LesNoms]} {
		    OntoMesGOSet $Type $Ancetre LesNoms {}
		}
		if {[info exists Access]} {
		    if {![OntoMesGOExists $Type $Ancetre LesAccess]} {OntoMesGOSet $Type $Ancetre LesAccess {}}
		    if {![OntoMesGOExists $Type $Ancetre $Access]} {
			OntoMesGOAppend $Type $Ancetre LesAccess $Access
			OntoMesGOSet $Type $Ancetre $Access 1
		    }
		}
		if {![OntoMesGOExists $Type $Ancetre $ProjetGscope]} {
		    OntoMesGOAppend $Type $Ancetre LesProjetsGscope $ProjetGscope
		    OntoMesGOSet $Type $Ancetre $ProjetGscope 1
		}
		if {![OntoMesGOExists $Type $Ancetre $Nom]} {
		OntoMesGOAppend $Type $Ancetre LesNoms          $Nom
		    OntoMesGOSet $Type $Ancetre $Nom          1
		}
		
		OntoMesGOSet $Type $Ancetre          1
		OntoMesGOSet $Type Ancetre $Ancetre Color "green"
		if {[info exists TabTmp($Ancetre)]} {continue}
		set TabTmp($Ancetre) 1
		lappend TousLesGO $Ancetre
	    }
	    lappend TousLesGO $GO
	    set TabTmp($GO) 1
	}
	
	ChargeLesGONothing LesNoms [ElimineLesRedondancesDansUneListe $LesNomsDesBoites]

	close $F
    }

    ChargeLesGONothing LesProjetsGscope $LesProjetsGscope

    OntoMesGOSet TousLesGO $TousLesGO 
    if {[info exists TabTmp]} {unset TabTmp}

    return

}

proc ChargeLesGONothing {Quoi LesRequetesDeQuoi} {

    
    if {$LesRequetesDeQuoi == {}} {return ""}

    foreach Type [LesTypesOntologiques] {
	set GONothing     [Onto      $Type Nothing]
	set Niveau        [lindex    [Onto $Type $GONothing LesNiveaux] 0]
	set NivPere       [expr      $Niveau - 1]
	set LesAncetres   [Onto      $Type $NivPere]
	set GOPere        [lindex    $LesAncetres 0]

	foreach RequeteDeQuoi $LesRequetesDeQuoi {
	    if {[OntoMesGOExists $Type $RequeteDeQuoi]} {continue}

	    if {![OntoMesGOExists $Type  $GONothing]} {
		lappend TousLesGO $GONothing
		OntoMesGOAppend   $Type      LesGO           $GONothing
		OntoMesGOSet      $GONothing Type            $Type
		OntoMesGOSet      $Type      $GONothing      1
		OntoMesGOSet      $Type      $GONothing      Color    "white"
		OntoMesGOSet      $Type      $GONothing      Ancetres $LesAncetres
	    }
	    OntoMesGOSet         $Type      $RequeteDeQuoi  1
	    if {![OntoMesGOExists $Type $GONothing $Quoi]} {
		OntoMesGOSet         $Type $GONothing $Quoi {}
	    }
	    OntoMesGOAppend      $Type $GONothing $Quoi          $RequeteDeQuoi
	    OntoMesGOSet         $Type $GONothing $RequeteDeQuoi 1

	    if {![OntoMesGOExists $Type $GOPere $Quoi]} {
		OntoMesGOSet      $Type $GOPere $Quoi   {}
	    }
	    if {![OntoMesGOExists $Type $GOPere $RequeteDeQuoi   ]} {
		OntoMesGOAppend   $Type $GOPere $Quoi          $RequeteDeQuoi
		OntoMesGOSet      $Type $GOPere $RequeteDeQuoi 1
	    }
	    OntoMesGOSet $Type $GOPere          1
	    if {![info exists TabTmp($GOPere)]} {
		set     TabTmp($GOPere) 1
		lappend TousLesGO       $GOPere
	    }
	    set TabTmp($GONothing) 1
	}
    }
    if {[info exists TabTmp]} {unset TabTmp}
    OntoMesGOAppend $GONothing
    return ""

}

proc ChargeLesInfoDeLOligo {aInfoOligo FichierOligo} {

    Wup "Charge les infos du fichier avec les oligos"
    Wup "Voir InterrogeInfoOligo pour le questionner"
    Wup "MAJ 01/12/03 pour l absence des infos dans le fasta"
    Wup "MAJ 01/12/03 pour des seq sur plusieurs lignes et plusieurs seq par fichier"
    Wup "MAJ 15/12/03 parametre par defaut si ils ne sont calcules"

    upvar $aInfoOligo InfoOligo

    if {! [file exists $FichierOligo]} {set InfoOligo($FichierOligo,NotDone) 1;return "-2"}
    set LesOligos      ""
    set OnLeTient       0
    set SequenceStockee 0
    set i               0
    set DefautDebut     0

    set F [open "$FichierOligo"]
    while {[gets $F Ligne]>=0} {
	if {! [regexp -nocase {[a-z]+ || [0-9]+} $Ligne]} {continue}
	if {  [regexp -nocase "NoOligo"          $Ligne]} {set InfoOligo($FichierOligo,NoOligo) 1;return "-1"}
	#On accumule la sequence si pas sur une ligne
	if {[string range $Ligne 0 0] != ">"} {
	    if {! $OnLeTient} {continue}
	    lappend MaSequence $Ligne
	    set SequenceStockee 1
	    continue
	}
	#On a l entete une 2eme fois, il est temps de stocker la sequence
	if {$SequenceStockee=="1"} {
	    set MaSequence [join $MaSequence ""]
	    if {$TailleOligo == ""} {
		set TailleOligo [string length $MaSequence]
		set InfoOligo($FichierOligo,$NomOligo,Taille) $TailleOligo
	    }
	    if {$Fin == ""} {set Fin $TailleOligo}
	    if {$GC  == ""} {
		set GC [format "%.1f" [expr (([NombreDeBaseDe $MaSequence "G|C"])/($TailleOligo*1.0))*100.0]]
		set InfoOligo($FichierOligo,$NomOligo,GC)   $GC
	    }
	    
	    set ExpTm ""
	    set ExpTm [CalculTmDeLaSeq $MaSequence "" "" DNADNA]
	    set InfoOligo($FichierOligo,$NomOligo,ExpTm)    $ExpTm
	    set InfoOligo($FichierOligo,$NomOligo,Sequence) $MaSequence
	    set OnLeTient       0
	    set SequenceStockee 0
	    set MaSequence     ""
	} 
	#On a l entete et donc les infos, suivra la sequence
	incr i
	set OnLeTient    1
	set LigneSplitee ""
	set NomOligo     ""
	set TailleOligo  ""
	set OligoTm      ""
	set DebFin       ""
	set Debut        ""
	set Fin          ""
	set NbCandidats  ""
	set NbContigues  ""
	set GC           ""

	set LigneSplitee [split  $Ligne "\t"]
	set Entete       [lindex $LigneSplitee 0]
	set LesCandidats [join [lrange $LigneSplitee 5 end] " "] 
	set NomOligo     [lindex $Entete       1]
	set TailleOligo  [lindex $LigneSplitee 1]
	set OligoTm      [string trim [lindex $LigneSplitee 2]]
	set DebFin       [lindex $LigneSplitee 3]
	set Debut        [lindex $DebFin       0]
	set Fin          [lindex $DebFin       1]
	set CandCont     [lindex $LigneSplitee 4]
	set NbCandidats  [lindex $CandCont     0]
	set NbContigues  [lindex $CandCont     1]
	#set GC           [lindex $LigneSplitee 1]

	if {$NomOligo == ""} {set NomOligo "MaSeq${i}"}
	if {$Debut    == ""} {incr DefautDebut;set Debut $DefautDebut}

	set InfoOligo($FichierOligo,$NomOligo,Taille)       $TailleOligo
	set InfoOligo($FichierOligo,$NomOligo,GC)           $GC
	set InfoOligo($FichierOligo,$NomOligo,Tm)           $OligoTm
	set InfoOligo($FichierOligo,$NomOligo,Debut)        $Debut
	set InfoOligo($FichierOligo,$NomOligo,Fin)          $Fin
	set InfoOligo($FichierOligo,$NomOligo,NbCandidats)  $NbCandidats
	set InfoOligo($FichierOligo,$NomOligo,NbContigues)  $NbContigues
	set InfoOligo($FichierOligo,$NomOligo,LesCandidats) $LesCandidats
	set InfoOligo($FichierOligo,$Debut,$Fin,NomOligo)   $NomOligo
	lappend InfoOligo($FichierOligo,LesDebutFin)        [list $Debut $Fin]
	lappend InfoOligo($FichierOligo,LesNoms)            $NomOligo
    }
    close $F
    #On a fini de parcourir le fichier on stocke la sequence si elle ne l a pas encore ete
    if {$SequenceStockee} {
	set MaSequence [join $MaSequence ""]
	if {$TailleOligo == ""} {
	    set TailleOligo [string length $MaSequence]
	    set InfoOligo($FichierOligo,$NomOligo,Taille) $TailleOligo
	}
	if {$Fin == ""} {set Fin $TailleOligo}
	if {$GC  == ""} {
	    set GC [format "%.1f" [expr (([NombreDeBaseDe $MaSequence "G|C"])/($TailleOligo*1.0))*100.0]]
	    set InfoOligo($FichierOligo,$NomOligo,GC)   $GC
	}
	set ExpTm ""
	set ExpTm [CalculTmDeLaSeq $MaSequence "" "" DNADNA]
	set InfoOligo($FichierOligo,$NomOligo,ExpTm)    $ExpTm
	set InfoOligo($FichierOligo,$NomOligo,Sequence) $MaSequence
	set OnLeTient       0
	set SequenceStockee 0
	set MaSequence     ""
    } 
    return ""

}

proc ChargeLesInfoDePrimer {aInfoPrimer PAB} {

    Wup "Charge les info des Primer a dessiner"

    upvar $aInfoPrimer InfoPrimer

    set FichierPCR "[RepertoireDuGenome]/fiches/lesppcrsadessiner"

    if {! [file exists $FichierPCR]} {return "-1"}

    array set LesPPCRsADessiner [LesLignesDuFichier $FichierPCR]
    set LesPABs                 [array names LesPPCRsADessiner]

    foreach PAB $LesPABs {
	set LesPrimerSeqs ""
	foreach Trio [set LesPPCRsADessiner($PAB)] {
	    scan $Trio "%s %d %d %s %d %d %s %d %d" Frag dF fF A dA fA B dB fB
	    lappend LesPrimerSeqs [list $Frag $dF $fF]
	    lappend LesPrimerSeqs [list $A    $dA $fA]
	    lappend LesPrimerSeqs [list $B    $dB $fB]
	}
	set InfoPrimer($PAB) $LesPrimerSeqs
    }
    return ""

}

proc ChargeLesInfosDuFichierLog {aInfoDuLogDeLOligo FichierLog Debut Fin} {

    Wup "Charge les infos du fichier log qui sont complementaires de celles de InterrogeInfoDeLOligo"
    Wup "Peut a priori tout recuperer mais pour l instant"
    Wup "MAJ 20/04/04 champs Spec avec % ID, nb Contigue, les candidats"
    Wup "Voir InterrogeLesInfosDuFichierLog pour le questionner"

    upvar $aInfoDuLogDeLOligo InfoDuLogDeLOligo

    if {! [file exists $FichierLog]} {set InfoDuLogDeLOligo($FichierLog,$Debut,$Fin,NotDone) 1;return "-2"}

    set OnLeTient 0
    set LesLignes ""
    set Ligne     ""
    set F [open "$FichierLog"]
    while {[gets $F Ligne]>=0} {
	if {! [regexp -nocase {[a-z]+ || [0-9]+} $Ligne]} {continue}
	if {[regexp {^Moving on:} $Ligne]} {
	    set   MaLigne ""
	    regsub "^Moving on: " $Ligne "" MaLigne
	    scan $MaLigne "%s %s" ND NF
	    if {$OnLeTient} {break}
	    if {$Debut==$ND && $Fin==$NF} {
		set OnLeTient 1
		continue
	    }
	    continue
	}
	if {$OnLeTient} {
	    scan $Ligne "%s" PremierMot
	    set Facteur      1
	    set NbBIdentique ""
	    set NbBAlignee   ""
	    set NbContigue   ""
	    switch -exact -- $PremierMot {
		"Spec:"       {	
		    if {[regexp "We left NOTENOUGHIDENTICAL" $Ligne]} {
			continue
		    } else {
			regsub {Spec: We keep TOOMUCH[A-Z ]{9,10}} $Ligne "" Ligne
		    }
		    set LengthOligo  [expr [lindex $Ligne 1] - [lindex $Ligne 0] + 1]
		    set Facteur      [llength [lindex $Ligne 8]]
		    set NbBIdentique [lindex $Ligne  9]
		    set NbBAlignee   [lindex $Ligne 10]
		    set NbContigue   [lindex $Ligne 11]
		    set IdGlobal     [format "%.2f" [expr ((1.0*$NbBIdentique)/($LengthOligo*$Facteur))*100.0]]
		    lappend InfoDuLogDeLOligo($FichierLog,$Debut,$Fin,LesCandidats)                 [lindex $Ligne 4]
		    set     InfoDuLogDeLOligo($FichierLog,$Debut,$Fin,[lindex $Ligne 4],IDG)        $IdGlobal
		    set     InfoDuLogDeLOligo($FichierLog,$Debut,$Fin,[lindex $Ligne 4],NbContigue) $NbContigue
		}
		"Length:"     {continue}
		"Sequence:"   {continue}
		"Prohibited:" {continue}
		"GC:"         {continue}
		"Tm:"         {continue}
		"ID:"         {continue}
		"default"     {continue}
	    }
	}
    }
    close $F
    if {! [info exists InfoDuLogDeLOligo($FichierLog,$Debut,$Fin,LesCandidats)]} {
	 set           InfoDuLogDeLOligo($FichierLog,$Debut,$Fin,LesCandidats) ""
    }
    return ""

}

proc ChargeLesInterGenes {} {

    global RepertoireDuGenome
    global ListeDesInterGenes

    if { ! [file exists "$RepertoireDuGenome/fiches/bornesdesintergenes"]} {
	RecreeLeFichierBornesDesInterGenes
    }

    foreach Ligne [LesLignesDuFichier "$RepertoireDuGenome/fiches/bornesdesintergenes"] {

	ExtraireDe $Ligne Nom Debut Fin Orient

	set Long [expr $Fin-$Debut+1]
	set Orient "F"
	set Frame  "I"

	set  Boite        $Nom
	Box $Boite nom    $Nom
	Box $Boite orient $Orient
	Box $Boite frame  $Frame
	Box $Boite debut  $Debut
	Box $Boite fin    $Fin
	Box $Boite long   $Long

	lappend ListeDesInterGenes $Boite
    }
    return $ListeDesInterGenes

}

proc ChargeLesOrganismesAyantMemeOperon {} {

    global RepertoireDuGenome
    global LesOrganismesAyantMemeOperon
    global NotreOS
    global NotreOrga
    global DejaVuCetOrgaAyantMemeOperon
    global ListeCompleteDesOrganismesAyantMemeOperon

    set FichierOMO "$RepertoireDuGenome/fiches/organismesayantmemeoperon"
    if { ! [file exists $FichierOMO]} {
	set LesOrganismesAyantMemeOperon(Est-Il-Valide) 0
	return 0
    }
    set LesOrganismesAyantMemeOperon(Est-Il-Valide) 1
    foreach Ligne [LesLignesDuFichier $FichierOMO] {
	while {[regexp "  " $Ligne]} { regsub -all "  " $Ligne " " Ligne }
	set NomVoisinEtOrgas [split [string trim $Ligne] " "]
	if {[llength $NomVoisinEtOrgas] < 3} { continue }
	
	set Nom    [lindex $NomVoisinEtOrgas 0]
	set Voisin [lindex $NomVoisinEtOrgas 1]

	Wup "Attention, le voisin est ci dessous en premiere position"
	set LesOrgas {}
	foreach Orga [lrange $NomVoisinEtOrgas 1 end] {
	    if {[regexp -nocase "^$NotreOrga$" $Orga] } { continue }
	    lappend LesOrgas $Orga
	    if {[info exists DejaVuCetOrgaAyantMemeOperon($Orga)]} { continue }
	    set DejaVuCetOrgaAyantMemeOperon($Orga) 1
	    if { ! [EstUnPAB $Orga]} { lappend ListeCompleteDesOrganismesAyantMemeOperon $Orga }
	}

	set N [expr [llength $LesOrgas] -1]
	set OldN 0
	if {[info exists LesOrganismesAyantMemeOperon($Nom,Compte)]} {
	    set OldN [set LesOrganismesAyantMemeOperon($Nom,Compte)]
	}
	set LesOrganismesAyantMemeOperon($Nom,Compte) [Maxi $N $OldN]
	set OldNV 0
	if {[info exists LesOrganismesAyantMemeOperon($Voisin,Compte)]} {
	    set OldNV [set LesOrganismesAyantMemeOperon($Voisin,Compte)]
	}
	set LesOrganismesAyantMemeOperon($Voisin,Compte) [Maxi $N $OldNV]

	set LesOrganismesAyantMemeOperon($Nom) $LesOrgas
    }
    return 1

}

proc ChargeLesOrthologuesDe {} {

    global RepertoireDuGenome
    global LesOrthologuesDe

    JeMeSignale Patience

    set FichierOrganismesOrthologues "$RepertoireDuGenome/fiches/organismesorthologues"

    if { ! [file exists $FichierOrganismesOrthologues]} {
	set LesOrthologuesDe(Bidon) "EstCharge"
	return ""
    }

    foreach Ligne [LesLignesDuFichier $FichierOrganismesOrthologues] {
	set Liste [split $Ligne " "]
	set Nom [lindex $Ligne 0]

	Wup "On accepte le melange  Genre espece court Genre espece court court Genre espece court ..."

	set YaGenre 0
	foreach Mot [lrange $Ligne 1 end] {
	    if {$YaGenre} {
		lappend LesOrthologuesDe($Nom) "$Genre $Mot"
		set YaGenre 0
	    } else {
		if {[regexp {^[A-Z]} $Mot]} {
		    set YaGenre 1
		    set Genre $Mot
		} else {
		    lappend LesOrthologuesDe($Nom) "$Mot"
		}
	    }
