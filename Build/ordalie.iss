; Script generated by the Inno Setup Script Wizard.
    ; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
                          
#define MyAppName "ordalie"
#define MyAppVersion "3.5"
#define MyAppPublisher "Luc Moulinier and ICube/CSTB"
#define MyAppURL "https://bigest-icube.fr/ordalie/"
#define MyAppExeName "ordalie.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{B5A34DE3-93F5-4222-9BB8-6BD604AA7221}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={pf}\{#MyAppName}
DisableProgramGroupPage=yes
UsePreviousGroup=no
UsePreviousAppDir=no   
LicenseFile=O:\ordali-dev\Build\Ressources\LICENSE
InfoBeforeFile=O:\ordali-dev\Build\Ressources\before.txt
InfoAfterFile=O:\ordali-dev\Build\Ressources\after.txt
OutputDir=Installers
OutputBaseFilename=setup-ordalie
SetupIconFile=O:\ordali-dev\Build\Ressources\ordalie.ico
Compression=lzma
SolidCompression=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "french"; MessagesFile: "compiler:Languages\French.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"
[Dirs]
Name: "{app}"; 
Name: "{app}\lib"; Permissions: everyone-full
Name: "{app}\etc"; Permissions: everyone-full
Name: "{app}\doc"; Permissions: everyone-full
Name: "{app}\bin"; Permissions: everyone-full


[Files]
Source: "O:\ordali-dev\Build\win32-x86_64\ordalie.exe"; DestDir: "{app}"; Flags: ignoreversion; Permissions: users-full
Source: "O:\ordali-dev\Build\win32-x86_64\lib\*"; DestDir: "{app}\lib\"; Flags: ignoreversion recursesubdirs createallsubdirs; Permissions: users-full
Source: "O:\ordali-dev\Build\win32-x86_64\etc\*"; DestDir: "{app}\etc\"; Flags: ignoreversion recursesubdirs createallsubdirs; Permissions: users-full
Source: "O:\ordali-dev\Build\win32-x86_64\doc\*"; DestDir: "{app}\doc\"; Flags: ignoreversion recursesubdirs createallsubdirs; Permissions: users-full
Source: "O:\ordali-dev\Build\win32-x86_64\bin\*"; DestDir: "{app}\bin\"; Flags: ignoreversion recursesubdirs createallsubdirs; Permissions: users-full
; NOTE: Don't use "Flags: ignoreversion" on any shared system files; Permissions: users-full

[Icons]
Name: "{commonprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{commondesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent unchecked

